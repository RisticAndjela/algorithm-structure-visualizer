@inherits LayoutComponentBase

<div class="app-shell">
    <aside class="sidebar">
        <div class="sidebar-top">
            <a class="brand" href="/" aria-label="Algorithm Visualizer home">
                <span class="brand-mark" aria-hidden="true">
                    <span></span>
                    <span></span>
                    <span></span>
                </span>
                <span class="brand-copy">
                    <strong>Algorithm Visualizer</strong>
                    <small>Learn by seeing</small>
                </span>
            </a>

            <nav class="navigation" aria-label="Learning modules">
                <div class="nav-section">
                    <div class="nav-section-heading">
                        <span>Learn</span>
                        <span class="nav-count">1</span>
                    </div>
                    <NavLink href="/learn/concepts">
                        <span class="nav-glyph">?</span>
                        <span>Concepts &amp; memory</span>
                        <span class="nav-status live" title="Learning reference available"></span>
                    </NavLink>
                </div>

                <div class="nav-section">
                    <div class="nav-section-heading">
                        <span>Data Structures</span>
                        <span class="nav-count">8</span>
                    </div>

                    <NavLink href="/structures/queue-stack" title="Lesson 1 · Beginner">
                        <span class="nav-glyph">1</span>
                        <span>Queue &amp; Stack</span>
                        <span class="nav-status live" title="Interactive simulation available"></span>
                    </NavLink>
                    <NavLink href="/structures/bst" title="Lesson 2 · Beginner">
                        <span class="nav-glyph">2</span>
                        <span>Binary Search Tree</span>
                        <span class="nav-status live" title="Interactive simulation available"></span>
                    </NavLink>
                    <NavLink href="/structures/binary-heap" title="Lesson 3 · Beginner to intermediate">
                        <span class="nav-glyph">3</span>
                        <span>Binary Heap</span>
                        <span class="nav-status live" title="Interactive binary heap simulation available"></span>
                    </NavLink>
                    <NavLink href="/structures/heap" title="Lesson 4 · Intermediate">
                        <span class="nav-glyph">4</span>
                        <span>Heap (d-ary)</span>
                        <span class="nav-status live" title="Interactive generalized heap simulation available"></span>
                    </NavLink>
                    <NavLink href="/structures/avl" title="Lesson 5 · Intermediate">
                        <span class="nav-glyph">5</span>
                        <span>AVL Tree</span>
                        <span class="nav-status live" title="Interactive simulation available"></span>
                    </NavLink>
                    <NavLink href="/structures/matrix" title="Lesson 6 · Intermediate">
                        <span class="nav-glyph">6</span>
                        <span>Matrix</span>
                        <span class="nav-status live" title="Interactive Matrix simulation available"></span>
                    </NavLink>
                    <NavLink href="/structures/graph" title="Lesson 7 · Intermediate">
                        <span class="nav-glyph">7</span>
                        <span>Graph</span>
                        <span class="nav-status live" title="Interactive graph simulation available"></span>
                    </NavLink>
                    <NavLink href="/structures/red-black" title="Lesson 8 · Advanced">
                        <span class="nav-glyph">8</span>
                        <span>Red-Black Tree</span>
                        <span class="nav-status live" title="Interactive simulation available"></span>
                    </NavLink>
                </div>

                <div class="nav-section">
                    <div class="nav-section-heading">
                        <span>Sorting</span>
                        <span class="nav-count">6</span>
                    </div>

                    <NavLink href="/sorting/bubble" title="Lesson 1 · Beginner"><span class="nav-glyph">1</span><span>Bubble Sort</span><span class="nav-status live" title="Interactive Bubble Sort simulation available"></span></NavLink>
                    <NavLink href="/sorting/selection" title="Lesson 2 · Beginner"><span class="nav-glyph">2</span><span>Selection Sort</span><span class="nav-status live" title="Interactive Selection Sort simulation available"></span></NavLink>
                    <NavLink href="/sorting/insertion" title="Lesson 3 · Beginner"><span class="nav-glyph">3</span><span>Insertion Sort</span><span class="nav-status live" title="Interactive Insertion Sort simulation available"></span></NavLink>
                    <NavLink href="/sorting/merge" title="Lesson 4 · Intermediate"><span class="nav-glyph">4</span><span>Merge Sort</span><span class="nav-status live" title="Interactive Merge Sort simulation available"></span></NavLink>
                    <NavLink href="/sorting/quick" title="Lesson 5 · Intermediate · Planned"><span class="nav-glyph">5</span><span>Quick Sort</span><span class="nav-status soon"></span></NavLink>
                    <NavLink href="/sorting/heap" title="Lesson 6 · Advanced · Planned"><span class="nav-glyph">6</span><span>Heap Sort</span><span class="nav-status soon"></span></NavLink>
                </div>
            </nav>
        </div>

        <div class="sidebar-footer">
            <div class="learning-mode">
                <span class="learning-mode-icon" aria-hidden="true">✦</span>
                <span>
                    <strong>Learning mode</strong>
                    <small>Understand every step</small>
                </span>
            </div>
            <div class="status-key" aria-label="Module status legend">
                <span><i class="status-dot live"></i>Interactive</span>
                <span><i class="status-dot soon"></i>Planned</span>
            </div>
        </div>
    </aside>

    <div class="main-column">
        <header class="topbar">
            <div class="topbar-context">
                <span class="context-dot"></span>
                Interactive computer science playground
            </div>
            <a class="topbar-action" href="/sorting/bubble">
                Open first sorting lab
                <span aria-hidden="true">→</span>
            </a>
        </header>

        <main class="content">
            @Body
        </main>
    </div>
</div>
