        "linear-vs-binary-search" => "Linear Search vs Binary Search",
        "binary-search" => "Binary Search",
        "binary-search-complexity" => "Binary Search complexity",
        "binary-search-duplicates" => "Binary Search duplicates",
        "bfs" => "Breadth-First Search",
        "bfs-complexity" => "BFS complexity",
        "dfs" => "Depth-First Search",
        "dfs-complexity" => "DFS complexity",
        "dfs-stack" => "DFS: recursive vs explicit Stack",
        _ => "Concepts & Memory"
    };

    private string? FocusedLabHref => NormalizedTopic switch
    {
        "visual-vs-memory" or "memory" or "identity" => "/structures/queue-stack",
        "big-o" => "/sorting/bubble",
        "queue-stack" => "/structures/queue-stack",
        "bst" or "bst-balancing" => "/structures/bst",
        "binary-heap" => "/structures/binary-heap",
        "general-heap" => "/structures/heap",
        "avl-balance" => "/structures/avl",
        "matrix" or "matrix-compatibility" => "/structures/matrix",
        "graph" => "/structures/graph",
        "red-black" => "/structures/red-black",
        "bubble-sort" => "/sorting/bubble",
        "selection-sort" => "/sorting/selection",
        "insertion-sort" => "/sorting/insertion",
        "merge-sort" => "/sorting/merge",
        "quick-sort" => "/sorting/quick",
        "heap-sort" => "/sorting/heap",
        "linear-search" or "linear-search-complexity" => "/search/linear",
        "binary-search" or "binary-search-complexity" or "binary-search-duplicates" or "linear-vs-binary-search" => "/search/binary",
