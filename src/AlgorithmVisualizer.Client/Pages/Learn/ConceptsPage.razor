            return null;
        }

        return topic.Trim().ToLowerInvariant() switch
        {
            "lifo-fifo" => "queue-stack",
            "tree-height" => "bst",
            "matrices" => "matrix",
            "heap" => "binary-heap",
            var value => value
        };
    }

    private static bool IsKnownTopic(string topic) => topic switch
