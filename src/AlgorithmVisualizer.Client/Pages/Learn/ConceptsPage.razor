</div>

@code {
    [Parameter]
    public string? Topic { get; set; }

    private string? NormalizedTopic => NormalizeTopic(Topic);

    private bool HasFocusedTopic =>
        !string.IsNullOrWhiteSpace(NormalizedTopic) && IsKnownTopic(NormalizedTopic);

    private string? FocusedSection => NormalizedTopic switch
    {
        "binary-heap" or "general-heap" => "heap",
        "matrix-compatibility" => "matrix",
        "linear-search-complexity" => "linear-search",
        "binary-search-complexity" or "binary-search-duplicates" => "binary-search",
        "linear-vs-binary-search" => "binary-search",
        "bfs-complexity" => "bfs",
        "dfs-complexity" or "dfs-stack" => "dfs",
        _ => NormalizedTopic
    };

    private string PageTitleText => HasFocusedTopic
        ? $"{FocusedTitle} — Concepts & Memory"
        : "Learn the basics — Algorithm Visualizer";

    private string FocusedTitle => NormalizedTopic switch
    {
        "visual-vs-memory" => "Visual state vs memory state",
        "memory" => "Memory, references, Count and Capacity",
        "identity" => "Value vs identity",
        "big-o" => "Big-O and algorithmic growth",
        "queue-stack" => "Queue & Stack: LIFO and FIFO",
        "bst" => "Binary Search Tree: height and search paths",
        "bst-balancing" => "BST balancing with Day-Stout-Warren",
        "binary-heap" => "Binary Heap",
        "general-heap" => "Generalized d-ary Heap",
        "avl-balance" => "AVL balancing and rotations",
        "matrix" => "Matrix: dimensions and memory",
        "matrix-compatibility" => "Matrix operation compatibility",
        "graph" => "Graph: vertices, edges and adjacency",
        "red-black" => "Red-Black Tree invariants",
