        "dfs" or "dfs-complexity" or "dfs-stack" => "/search/dfs",
        _ => null
    };

    private string SectionClass(string section) =>
        HasFocusedTopic && string.Equals(FocusedSection, section, StringComparison.OrdinalIgnoreCase)
            ? "concept-section focused-topic"
            : "concept-section";

    private string CardClass(string topic, string baseClass) =>
        HasFocusedTopic && string.Equals(NormalizedTopic, topic, StringComparison.OrdinalIgnoreCase)
            ? $"{baseClass} focused-subtopic"
            : baseClass;

    private static string? NormalizeTopic(string? topic)
    {
        if (string.IsNullOrWhiteSpace(topic))
