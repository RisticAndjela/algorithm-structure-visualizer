@page "/sorting/bubble"
@using AlgorithmVisualizer.Core.Algorithms.Sorting.Bubble
@using AlgorithmVisualizer.Client.Components.Visualization.Sorting.Bubble
@implements IDisposable
@inject SimulationState SimulationState
@inject BubbleSortSimulation BubbleSort
@inject LearningSessionStore LearningStore
@inject PracticeProgressStore PracticeProgress

<PageTitle>Bubble Sort — Algorithm Visualizer</PageTitle>

<div class="bubble-page learning-module-page learning-module-shell">
    <section class="learn-launchpad" aria-labelledby="bubble-learn-title">
        <div class="learn-copy">
            <span class="section-kicker">LEARN FIRST</span>
            <h2 id="bubble-learn-title">Bubble Sort repeats one tiny rule: compare neighbors.</h2>
            <p>If the left neighbor is larger than the right neighbor, swap them. Repeat that local decision across the unsorted region until the array is ordered.</p>
            <a class="learn-launchpad-link" href="/learn/concepts#bubble-sort">Open Bubble Sort concepts & memory →</a>
        </div>
        <div class="learn-grid">
            <article class="learn-card purple"><span>NEIGHBORS</span><strong>Compare only a[j] and a[j+1]</strong><small>Bubble Sort never jumps across the array to compare distant values.</small></article>
            <article class="learn-card mint"><span>PASS</span><strong>Largest remaining value moves right</strong><small>After one complete pass, one more position at the end is final.</small></article>
            <article class="learn-card blue"><span>STABLE</span><strong>Equal values keep their order</strong><small>The implementation swaps only when left > right, never merely because values are equal.</small></article>
            <article class="learn-card gold"><span>MEMORY</span><strong>In-place with O(1) extra space</strong><small>The same array is updated through adjacent swaps; no second array is needed.</small></article>
        </div>
    </section>

    <header class="module-header">
        <div class="header-copy">
            <div class="module-eyebrow"><span>SORTING ALGORITHMS</span><span class="separator">/</span><span class="live-status"><i></i> Interactive</span></div>
            <h1>Bubble Sort</h1>
            <p>Build an array, predict the first comparison, then watch adjacent decisions create a sorted suffix.</p>
        </div>
        <div class="complexity-summary" aria-label="Bubble Sort complexity">
            <div><span>Selected mode</span><strong>@VariantLabel</strong><small>@VariantBestCaseNote</small></div>
            <div><span>Average / worst</span><strong>Θ(n²)</strong><small>both variants stay quadratic</small></div>
            <div><span>Extra space</span><strong>O(1)</strong><small>stable, in-place neighbor swaps</small></div>
        </div>
    </header>

    <section class="smart-tip" aria-label="bubble learning tip">
        <span class="tip-icon">✦</span>
        <div><strong>Before every step:</strong><p>Before each comparison, predict whether the highlighted neighbors should swap or stay.</p></div>
        <a href="/learn/concepts#bubble-sort">Why the sorted suffix is safe →</a>
    </section>

    <section class="implementation-section" aria-labelledby="bubble-implementation-title">
        <div class="section-heading-row">
            <div><span class="section-kicker">IMPLEMENTATION CHOICE</span><h2 id="bubble-implementation-title">Learn the basic algorithm, then turn on the useful optimization.</h2><p>Both modes sort correctly. The advanced mode changes only when the algorithm is allowed to stop.</p></div>
        </div>
        <div class="variant-grid">
            <button type="button" class="variant-card @(_variant == BubbleSortVariant.Basic ? "active" : string.Empty)" @onclick="() => SetVariant(BubbleSortVariant.Basic)" disabled="@IsBusy">
                <span>BASIC · CANONICAL</span><strong>Run every shrinking pass</strong><p>No early-exit flag. Even a sorted input performs all n(n−1)/2 comparisons, which makes the textbook nested-loop behavior easy to see.</p><small>Best Θ(n²) · Stable · O(1)</small>
            </button>
            <button type="button" class="variant-card @(_variant == BubbleSortVariant.Optimized ? "active" : string.Empty)" @onclick="() => SetVariant(BubbleSortVariant.Optimized)" disabled="@IsBusy">
                <span>ADVANCED · OPTIMIZED</span><strong>Stop after a no-swap pass</strong><p>Add one <code>swapped</code> flag. If a complete pass changes nothing, the remaining region is already ordered and the run ends immediately.</p><small>Best Θ(n) · Average/Worst Θ(n²) · Stable · O(1)</small>
            </button>
        </div>
        <div class="live-data-card">
            <div><span>REAL-TIME CRUD</span><strong>Restart required after INSERT, DELETE, or UPDATE</strong></div>
            <p>Bubble Sort reasons about a fixed array snapshot and a specific adjacent-pair trace. Changing the collection while a run is active invalidates its indexes, pass boundary, and sorted-suffix proof. The UI therefore locks editing during playback. After a mutation, start a new run.</p>
            <span class="compatibility-badge restart">READ safe · mutations restart</span>
        </div>
    </section>

    <section id="bubble-lab" class="builder-section" aria-labelledby="build-array-title">
        <div class="section-heading-row">
            <div class="heading-with-step">
                <span class="step-number">1</span>
                <div><span class="section-kicker">BUILD THE ARRAY</span><h2 id="build-array-title">Choose values you want to sort.</h2><p>Use 1–12 integers. Negative values and duplicates are allowed.</p></div>
            </div>
            <a class="concept-link" href="/learn/concepts#bubble-sort">How Bubble Sort works →</a>
        </div>

        <div class="array-builder">
            <label class="array-input">
                <span>VALUES</span>
                <input value="@_arrayText" @oninput="ArrayTextChanged" disabled="@IsBusy" aria-label="Bubble Sort array values" placeholder="Example: 5, 1, 4, 2, 8" />
                <small>Separate values with spaces or commas.</small>
            </label>
            <button class="primary-action" type="button" @onclick="ApplyArray" disabled="@IsBusy">Use this array</button>
        </div>

        <div class="preset-row" aria-label="Bubble Sort example arrays">
            <span>TRY AN EXAMPLE</span>
            <button type="button" @onclick="() => LoadPreset(Preset.Classic)" disabled="@IsBusy">Classic</button>
            <button type="button" @onclick="() => LoadPreset(Preset.NearlySorted)" disabled="@IsBusy">Nearly sorted</button>
            <button type="button" @onclick="() => LoadPreset(Preset.Reverse)" disabled="@IsBusy">Worst case</button>
            <button type="button" @onclick="() => LoadPreset(Preset.Duplicates)" disabled="@IsBusy">Duplicates</button>
            <button type="button" @onclick="() => LoadPreset(Preset.Sorted)" disabled="@IsBusy">Already sorted</button>
            <button type="button" @onclick="LoadRandom" disabled="@IsBusy">Random</button>
        </div>

        @if (!string.IsNullOrWhiteSpace(_inputError))
        {
            <div class="input-error" role="alert"><strong>Check the array.</strong><span>@_inputError</span></div>
        }

        <div class="current-array" aria-label="Current Bubble Sort input">
            <span>CURRENT INPUT</span>
            <div>
                @for (var index = 0; index < Current.Elements.Length; index++)
                {
                    <span><small>@index</small><strong>@Current.Elements[index].Value</strong></span>
                }
            </div>
        </div>
    </section>

    <section class="predict-section" aria-labelledby="prediction-title">
        <div class="prediction-copy">
            <span class="step-number">2</span>
            <div><span class="section-kicker">PREDICT FIRST</span><h2 id="prediction-title">What should happen to the first pair?</h2><p>Make the same decision the algorithm will make before you press Sort.</p></div>
        </div>

        @if (Current.Count >= 2)
        {
            <div class="prediction-card">
                <div class="prediction-pair"><strong>@Current.Elements[0].Value</strong><span>and</span><strong>@Current.Elements[1].Value</strong></div>
                <div class="prediction-actions">
                    <button type="button" @onclick="() => AnswerPrediction(PredictionChoice.Swap)" disabled="@IsBusy">Swap them</button>
                    <button type="button" @onclick="() => AnswerPrediction(PredictionChoice.Keep)" disabled="@IsBusy">Keep this order</button>
                </div>
                @if (_predictionChoice is not null)
                {
                    <p class="prediction-feedback @(_predictionCorrect ? "correct" : "incorrect")" aria-live="polite">@PredictionFeedback</p>
                }
            </div>
        }
        else
        {
            <div class="prediction-card empty"><strong>No comparison is needed.</strong><p>With fewer than two values, the array is already sorted.</p></div>
        }
    </section>

    <section class="lab-section" aria-labelledby="visualizer-title">
        <div class="lab-heading">
            <div>
                <span class="section-kicker">3 · WATCH THE ALGORITHM</span>
                <h2 id="visualizer-title">Follow every compare, decision, and swap.</h2>
            </div>
            <div class="lab-actions">
                <label class="popup-toggle"><input type="checkbox" checked="@_showRunPopups" @onchange="ToggleRunPopups" /><span>Open explanation after run</span></label>
                @if (_lastResult is not null)
                {
                    <button class="secondary-action" type="button" @onclick="OpenLastRunPopup">Last explanation</button>
                }
                <button class="sort-button" type="button" @onclick="RunSortAsync" disabled="@(IsBusy || Current.Count == 0)"><span>▶</span> Sort this array</button>
            </div>
        </div>

        <div class="state-tabs-row">
            <div class="state-tabs" role="tablist" aria-label="Bubble Sort state view">
                <button type="button" role="tab" aria-selected="@(_view == StateView.Visual)" class="@(_view == StateView.Visual ? "active" : string.Empty)" @onclick="() => SetStateView(StateView.Visual)">Visual state</button>
                <button type="button" role="tab" aria-selected="@(_view == StateView.Memory)" class="@(_view == StateView.Memory ? "active" : string.Empty)" @onclick="() => SetStateView(StateView.Memory)">Memory state</button>
            </div>
            <p>@(_view == StateView.Visual
                ? "The visual view shows adjacent comparisons, swaps, and the sorted suffix growing on the right."
                : "The memory view shows the same fixed array slots and element identities, so duplicate stability and in-place swaps are explicit.")</p>
        </div>

        <div class="lesson-reference-links" aria-label="Concepts and memory links">
            <a href="/learn/concepts#bubble-sort">Bubble Sort concepts →</a>
            <a href="/learn/concepts#bubble-sort">Bubble Sort memory & stability →</a>
        </div>

        <div class="visualizer-shell">
            @if (_view == StateView.Visual)
            {
                <BubbleSortVisualization Snapshot="@DisplayedSnapshot" />
            }
            else
            {
                <BubbleSortMemoryVisualization Snapshot="@DisplayedSnapshot" />
            }
        </div>

        <SimulationToolbar OnPlay="PlayTimelineAsync"
                           OnPause="PauseTimelineAsync"
                           OnStepBack="StepBackAsync"
                           OnStepForward="StepForwardAsync"
                           OnReset="ResetPlaybackAsync"
                           CanStepBack="@CanStepBack"
                           CanStepForwardOverride="@CanStepForward"
                           StepTextOverride="@DisplayedStepText"
                           TimelinePosition="@TimelinePosition"
                           TimelineCount="@TimelineCount" />

        <div class="run-dashboard" aria-label="Bubble Sort live metrics">
            <article><span>Pass</span><strong>@PassMetric</strong><small>A full left-to-right scan of the unsorted region.</small></article>
            <article><span>Comparisons</span><strong>@DisplayedSnapshot.Comparisons</strong><small>Each one checks exactly one adjacent pair.</small></article>
            <article><span>Swaps</span><strong>@DisplayedSnapshot.Swaps</strong><small>Only out-of-order neighbors exchange places.</small></article>
            <article><span>Fixed on right</span><strong>@DisplayedSnapshot.SortedCount / @DisplayedSnapshot.Count</strong><small>This suffix is already final.</small></article>
        </div>

        <div class="invariant-panel">
            <div><span>INVARIANT TO WATCH</span><h3>After pass p, the p largest finished values are fixed at the right.</h3><p>The algorithm never needs to compare that sorted suffix again. This is why each pass is one comparison shorter.</p></div>
            @if (_variant == BubbleSortVariant.Optimized)
            {
                <div class="early-exit-note"><span>OPTIMIZATION ACTIVE</span><strong>No swaps in a whole pass?</strong><p>Then every remaining adjacent pair is ordered, so the optimized run stops early.</p></div>
            }
            else
            {
                <div class="early-exit-note"><span>BASIC MODE</span><strong>No early exit on purpose.</strong><p>The canonical version continues through every shrinking pass so you can see the full nested-loop comparison pattern.</p></div>
            }
        </div>
    </section>

    <section class="algorithm-map" aria-labelledby="algorithm-map-title">
        <div class="section-heading-row">
            <div><span class="section-kicker">ALGORITHM MAP</span><h2 id="algorithm-map-title">The code idea is smaller than the animation.</h2><p>These are the exact decisions the Core implementation performs manually.</p></div>
            <a class="concept-link" href="/learn/concepts#big-o">Review Big-O →</a>
        </div>
        <div class="pseudo-grid">
            <div class="pseudo-code" aria-label="Bubble Sort pseudocode">
                <span>for each shrinking pass</span>
                @if (_variant == BubbleSortVariant.Optimized)
                {
                    <span class="indent">swapped = false</span>
                }
                <span class="indent">for each adjacent pair still unsorted</span>
                <span class="indent-two">compare a[j] and a[j+1]</span>
                <span class="indent-two">if a[j] &gt; a[j+1]</span>
                <span class="indent-three">swap manually</span>
                @if (_variant == BubbleSortVariant.Optimized)
                {
                    <span class="indent-three">swapped = true</span>
                    <span class="indent">if swapped == false → stop</span>
                }
            </div>
            <div class="why-cards">
                <article><span>Stable</span><strong>Equal values are never swapped just for being equal.</strong><p>That preserves their original relative order. Use the Duplicates example and watch the item numbers.</p></article>
                <article><span>In-place</span><strong>No second sorted array is created.</strong><p>The implementation uses one temporary reference while exchanging two neighboring slots.</p></article>
            </div>
        </div>
    </section>

    <section class="fit-section" aria-labelledby="bubble-fit-title">
        <div class="section-heading-row">
            <div><span class="section-kicker">WHEN SHOULD I USE IT?</span><h2 id="bubble-fit-title">Bubble Sort is useful mostly because it is simple, not because it scales well.</h2><p>Use the cards as a decision guide, not just as theory.</p></div>
        </div>
        <div class="fit-grid">
            <article class="fit-card good"><span>GOOD FIT</span><strong>Tiny inputs, teaching, or very simple code</strong><p>The optimized variant can also be reasonable for a very small array that is already or almost sorted and where implementation simplicity matters more than throughput.</p></article>
            <article class="fit-card avoid"><span>AVOID FOR</span><strong>Large or frequently changing collections</strong><p>Average and worst-case work stay Θ(n²), and arbitrary CRUD mutations require a new sorting run rather than continuing the old trace.</p></article>
            <article class="fit-card better"><span>BETTER NEXT CHOICE</span><strong>Choose an algorithm that matches the workload</strong><p>For nearly sorted data, Insertion Sort is usually the more natural upgrade. For larger data where stable predictable performance matters, move to Merge Sort.</p><div class="fit-links"><a href="/sorting/insertion">Insertion Sort →</a><a href="/sorting/merge">Merge Sort →</a></div></article>
        </div>
    </section>

    <section class="practice-section" aria-labelledby="bubble-practice-title">
        <div class="practice-heading">
            <div><span class="section-kicker">GUIDED PRACTICE</span><h2 id="bubble-practice-title">Prove each Bubble Sort behavior yourself.</h2></div>
            <div class="task-score"><strong>@_completedTaskIds.Count / @PracticeTasks.Count</strong><span>completed</span></div>
        </div>

        @if (_activeTaskId is not null)
        {
            var activeTask = PracticeTasks.First(task => task.Id == _activeTaskId.Value);
            <div class="active-task-banner"><span>ACTIVE TASK @activeTask.Id.ToString("00")</span><strong>@activeTask.Title</strong><small>@GetActiveTaskProgressText(activeTask.Id)</small></div>
        }

        <div class="practice-grid">
            @foreach (var task in PracticeTasks)
            {
                var completed = _completedTaskIds.Contains(task.Id);
                var active = _activeTaskId == task.Id;
                <PracticeTaskCard TaskId="@task.Id"
                                  Title="@task.Title"
                                  Description="@task.Goal"
                                  InputText="@FormatValues(task.Input)"
                                  HelpHref="/learn/concepts#bubble-sort"
                                  Completed="@completed"
                                  Active="@active"
                                  Busy="@IsBusy"
                                  HasEvidence="@(GetTaskEvidence(task.Id) is not null)"
                                  Start="@(() => StartTask(task.Id))"
                                  OpenEvidence="@(() => OpenTaskEvidence(task.Id))" />
            }
        </div>
    </section>
    <NextLessonCard Title="Selection Sort"
                    Description="Keep quadratic time, but separate searching for the next minimum from moving it into place."
                    Href="/sorting/selection"
                    Level="02 · Beginner"
                    LinkLabel="Open Selection Sort" />

</div>

<PracticeEvidencePopup Evidence="@_practiceEvidencePopup" OnClose="CloseTaskEvidence" />

@if (_lastRunPopupOpen && _lastResult is not null)
{
    <div class="run-popup-backdrop" role="presentation" @onclick="CloseLastRunPopup">
        <section class="run-popup" role="dialog" aria-modal="true" aria-labelledby="bubble-run-popup-title" @onclick="IgnorePopupClick" @onclick:stopPropagation="true">
            <header>
                <div><span class="section-kicker">WHAT JUST HAPPENED?</span><h2 id="bubble-run-popup-title">@RunHeadline</h2></div>
                <button class="popup-close" type="button" @onclick="CloseLastRunPopup" aria-label="Close result explanation">×</button>
            </header>
            <div class="popup-tabs" role="tablist">
                <button type="button" class="@(_popupTab == ResultPopupTab.Action ? "active" : string.Empty)" @onclick="() => _popupTab = ResultPopupTab.Action">Run</button>
                <button type="button" class="@(_popupTab == ResultPopupTab.Complexity ? "active" : string.Empty)" @onclick="() => _popupTab = ResultPopupTab.Complexity">Complexity</button>
                <button type="button" class="@(_popupTab == ResultPopupTab.Memory ? "active" : string.Empty)" @onclick="() => _popupTab = ResultPopupTab.Memory">Memory &amp; stability</button>
            </div>

            @if (_popupTab == ResultPopupTab.Action)
            {
                <div class="popup-body">
                    <div class="popup-metrics"><div><span>Mode</span><strong>@VariantLabelFor(_lastResult.Variant)</strong></div><div><span>Comparisons</span><strong>@_lastResult.Comparisons</strong></div><div><span>Swaps</span><strong>@_lastResult.Swaps</strong></div><div><span>Early exit</span><strong>@(_lastResult.UsedEarlyExit ? "Yes" : "No")</strong></div></div>
                    <h3>@RunActionExplanation</h3>
                    <p><strong>@FormatValues(_lastResult.InitialValues)</strong> became <strong>@FormatValues(_lastResult.SortedValues)</strong>. Step back through the timeline if you want to find exactly where one value moved.</p>
                </div>
            }
            else if (_popupTab == ResultPopupTab.Complexity)
            {
                <div class="popup-body">
                    <h3>@RunComplexityHeadline</h3>
                    <p>@RunComplexityExplanation</p>
                    <div class="complexity-line"><span>Best</span><strong>@_lastResult.BestCaseComplexity</strong><span>Average</span><strong>Θ(n²)</strong><span>Worst</span><strong>Θ(n²)</strong></div>
                    <a class="popup-concept-link" href="/learn/concepts#big-o">Open the Big-O guide →</a>
                </div>
            }
            else
            {
                <div class="popup-body">
                    <h3>Swaps changed positions, not item identity.</h3>
                    <p>The Core algorithm uses one fixed element array and one temporary reference for each swap. Equal values are not swapped when they are equal, so their original item order remains stable. This run's stability check: <strong>@(_lastResult.Stable ? "preserved" : "not preserved")</strong>.</p>
                    <a class="popup-concept-link" href="/learn/concepts#bubble-sort">Open Bubble Sort concepts &amp; memory →</a>
                </div>
            }
        </section>
    </div>
}

@code {
    private const string ModuleKey = "bubble-sort";
    private const string CompletedTasksStorageKey = "algorithm-visualizer.bubble-sort.completed-tasks.v1";
    private const string PopupSettingStorageKey = "algorithm-visualizer.bubble-sort.result-popups.v1";

    private readonly List<RunFrame> _frames = [];
    private readonly HashSet<int> _completedTaskIds = [];
    private readonly List<BubbleSortResult> _practiceResults = [];
    private PracticeModuleProgress _practiceProgress = new();
    private PracticeCompletionEvidence? _practiceEvidencePopup;

    private static readonly IReadOnlyList<PracticeTaskDefinition> PracticeTasks =
    [
        new(1, "Trace Basic Bubble Sort", "Use Basic mode on an input containing 5, 1, 4, 2, 8 in that order. Extra values are allowed; verify that the run uses the full shrinking-pass schedule without early exit.", [5, 1, 4, 2, 8], BubbleSortVariant.Basic),
        new(2, "Trigger the optimized early exit", "Use Optimized mode on an ordered array. One no-swap pass must prove that the run can stop.", [1, 2, 3, 4, 5], BubbleSortVariant.Optimized),
        new(3, "Create the quadratic worst case", "Use Basic mode on a reverse array and observe every possible adjacent inversion being swapped.", [5, 4, 3, 2, 1], BubbleSortVariant.Basic),
        new(4, "Prove duplicate stability", "Use Basic mode, sort duplicate 3s, then open Memory state. Their item numbers must keep the same relative order.", [3, 2, 3, 1, 3], BubbleSortVariant.Basic),
        new(5, "Test the one-item boundary", "Use Basic mode on one value and prove that no comparison or swap is needed.", [42], BubbleSortVariant.Basic)
    ];

    private string _arrayText = "5, 1, 4, 2, 8";
    private string? _inputError;
    private string? _lastCapturedStep;
    private int _frameIndex = -1;
    private BubbleSortResult? _lastResult;
    private PredictionChoice? _predictionChoice;
    private bool _predictionCorrect;
    private bool _showRunPopups = true;
    private bool _lastRunPopupOpen;
    private bool _storageLoaded;
    private bool _memoryOpenedDuringTask;
    private int? _activeTaskId;
    private StateView _view = StateView.Visual;
    private ResultPopupTab _popupTab = ResultPopupTab.Action;
    private BubbleSortVariant _variant = BubbleSortVariant.Basic;

    private bool IsBusy => SimulationState.IsRunning;
    private BubbleSortSnapshot Current => BubbleSort.CreateSnapshot();
    private bool CanStepBack => _frameIndex > 0;
    private bool CanStepForward => (_frames.Count > 0 && _frameIndex < _frames.Count - 1) || SimulationState.IsRunning;
    private int TimelineCount => _frames.Count;
    private int TimelinePosition => _frameIndex >= 0 ? _frameIndex + 1 : 0;
    private RunFrame? DisplayedFrame => _frameIndex >= 0 && _frameIndex < _frames.Count ? _frames[_frameIndex] : null;
    private string DisplayedStepText => DisplayedFrame?.StepText ?? SimulationState.CurrentStepText;
    private BubbleSortSnapshot DisplayedSnapshot => DisplayedFrame?.Snapshot ?? BubbleSort.CreateSnapshot();
    private string PassMetric => DisplayedSnapshot.CurrentPass == 0 ? "—" : DisplayedSnapshot.CurrentPass.ToString();
    private string VariantLabel => VariantLabelFor(_variant);
    private string VariantBestCaseNote => _variant == BubbleSortVariant.Optimized ? "best Θ(n) with no-swap early exit" : "best Θ(n²) because every pass runs";
    private static string VariantLabelFor(BubbleSortVariant variant) => variant == BubbleSortVariant.Optimized ? "Optimized" : "Basic";

    private string PredictionFeedback
    {
        get
        {
            if (Current.Count < 2 || _predictionChoice is null) return string.Empty;
            var left = Current.Elements[0].Value;
            var right = Current.Elements[1].Value;
            var action = left > right ? "swap" : "keep";
            return _predictionCorrect
                ? $"Correct. {left} {(left > right ? ">" : "≤")} {right}, so Bubble Sort will {action} this first pair."
                : $"Not this time. {left} {(left > right ? ">" : "≤")} {right}, so the rule says {action}.";
        }
    }

    private string RunHeadline => _lastResult is null
        ? "Bubble Sort run complete"
        : _lastResult.UsedEarlyExit
            ? $"Sorted in {_lastResult.Passes} pass{(_lastResult.Passes == 1 ? string.Empty : "es")} with an early exit"
            : $"Sorted in {_lastResult.Passes} full passes";

    private string RunActionExplanation => _lastResult is null
        ? string.Empty
        : _lastResult.Swaps == 0
            ? "The algorithm checked the remaining adjacent pairs and never found an inversion to repair."
            : $"The algorithm repaired {_lastResult.Swaps} out-of-order adjacent pair{(_lastResult.Swaps == 1 ? string.Empty : "s")} while the sorted suffix grew from right to left.";

    private string RunComplexityHeadline => _lastResult is null
        ? string.Empty
        : _lastResult.Variant == BubbleSortVariant.Basic
            ? "Basic Bubble Sort deliberately performs the full comparison schedule."
            : _lastResult.UsedEarlyExit
                ? "This run demonstrated why optimized Bubble Sort can finish early."
                : "The optimized mode was active, but this input never produced an early-exit pass.";

    private string RunComplexityExplanation => _lastResult is null
        ? string.Empty
        : _lastResult.Variant == BubbleSortVariant.Basic
            ? $"Basic mode has no no-swap shortcut, so it runs the canonical shrinking passes even when the data becomes sorted early. This run used {_lastResult.Comparisons} comparisons. Best, average, and worst comparison growth are Θ(n²)."
            : _lastResult.UsedEarlyExit
                ? $"The no-swap check ended the algorithm as soon as a complete pass proved the remaining region sorted. This run used {_lastResult.Comparisons} comparisons. Optimized best case is Θ(n), but average and worst cases remain Θ(n²)."
                : $"The input kept requiring swaps through the available passes, so Optimized mode found no no-swap proof to stop early. This run used {_lastResult.Comparisons} comparisons; reverse order still produces Θ(n²).";

    protected override void OnInitialized()
    {
        BubbleSort.LoadValues([5, 1, 4, 2, 8]);
        SimulationState.Changed += HandleSimulationChanged;
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender || _storageLoaded) return;
        _storageLoaded = true;
        try
        {
            _practiceProgress = PracticeProgress.Load(ModuleKey, CompletedTasksStorageKey, PracticeTasks.Select(task => task.Id));
            _completedTaskIds.Clear();
            foreach (var id in _practiceProgress.CompletedTaskIds) _completedTaskIds.Add(id);

            var popupSetting = LearningStore.GetItem(PopupSettingStorageKey);
            if (bool.TryParse(popupSetting, out var showPopups)) _showRunPopups = showPopups;
        }
        catch
        {
            // Browser persistence is optional; sorting remains fully usable without it.
        }
        await InvokeAsync(StateHasChanged);
    }

    private void ArrayTextChanged(ChangeEventArgs args)
    {
        _arrayText = args.Value?.ToString() ?? string.Empty;
        _inputError = null;
    }

    private void ApplyArray()
    {
        if (IsBusy) return;
        if (!TryParseArray(_arrayText, out var values, out var error))
        {
            _inputError = error;
            return;
        }
        LoadValues(values);
    }

    private void LoadPreset(Preset preset)
    {
        var values = preset switch
        {
            Preset.NearlySorted => new[] { 1, 2, 4, 3, 5, 6 },
            Preset.Reverse => new[] { 6, 5, 4, 3, 2, 1 },
            Preset.Duplicates => new[] { 3, 2, 3, 1, 3 },
            Preset.Sorted => new[] { 1, 2, 3, 4, 5, 6 },
            _ => new[] { 5, 1, 4, 2, 8 }
        };
        LoadValues(values);
    }

    private void LoadRandom()
    {
        if (IsBusy) return;
        var values = new int[7];
        for (var index = 0; index < values.Length; index++)
        {
            values[index] = Random.Shared.Next(-5, 16);
        }
        LoadValues(values);
    }

    private void LoadValues(int[] values)
    {
        ClearReview();
        BubbleSort.LoadValues(values);
        _arrayText = FormatValues(values);
        _inputError = null;
        _predictionChoice = null;
        _predictionCorrect = false;
    }

    private static bool TryParseArray(string input, out int[] values, out string error)
    {
        var parts = (input ?? string.Empty).Split([',', ';', ' ', '\n', '\r', '\t'], StringSplitOptions.RemoveEmptyEntries | StringSplitOptions.TrimEntries);
        if (parts.Length == 0)
        {
            values = [];
            error = "Enter at least one integer.";
            return false;
        }
        if (parts.Length > 12)
        {
            values = [];
            error = "Keep this learning view to at most 12 values so every comparison stays readable.";
            return false;
        }

        values = new int[parts.Length];
        for (var index = 0; index < parts.Length; index++)
        {
            if (!int.TryParse(parts[index], out values[index]))
            {
                values = [];
                error = $"“{parts[index]}” is not a whole number.";
                return false;
            }
        }

        error = string.Empty;
        return true;
    }

    private void AnswerPrediction(PredictionChoice choice)
    {
        if (Current.Count < 2 || IsBusy) return;
        _predictionChoice = choice;
        var shouldSwap = Current.Elements[0].Value > Current.Elements[1].Value;
        _predictionCorrect = shouldSwap == (choice == PredictionChoice.Swap);
    }

    private async Task RunSortAsync()
    {
        if (IsBusy || Current.Count == 0) return;
        PrepareRun();
        BubbleSort.ResetVisualState();
        var token = SimulationState.Start("Bubble Sort is ready to compare the first adjacent pair.");
        try
        {
            var result = await BubbleSort.SortAsync(_variant, token);
            if (!IsCurrent(token)) return;
            FinishRun(result);
        }
        catch (OperationCanceledException) when (token.IsCancellationRequested)
        {
        }
        catch (Exception ex)
        {
            _inputError = $"The sorting run stopped: {ex.Message}";
            if (IsCurrent(token)) SimulationState.Complete("The run stopped because of an error.");
        }
    }

    private void FinishRun(BubbleSortResult result)
    {
        _lastResult = result;
        RecordPracticeResult(result);
        SimulationState.Complete($"Sorted. {result.Comparisons} comparisons, {result.Swaps} swaps, {result.Passes} passes.");
        _popupTab = ResultPopupTab.Action;
        _lastRunPopupOpen = _showRunPopups;
    }

    private void PrepareRun()
    {
        _inputError = null;
        _memoryOpenedDuringTask = _view == StateView.Memory;
        _lastRunPopupOpen = false;
        _frames.Clear();
        _frameIndex = -1;
        _lastCapturedStep = null;
    }

    private void Capture()
    {
        var step = SimulationState.CurrentStepText;
        if (step == _lastCapturedStep) return;
        var tail = _frameIndex < 0 || _frameIndex == _frames.Count - 1;
        _frames.Add(new RunFrame(step, BubbleSort.CreateSnapshot()));
        _lastCapturedStep = step;
        if (tail) _frameIndex = _frames.Count - 1;
    }

    private void HandleSimulationChanged()
    {
        if (SimulationState.IsRunning) Capture();
        _ = InvokeAsync(StateHasChanged);
    }

    private bool IsCurrent(CancellationToken token) => !token.IsCancellationRequested && SimulationState.SimulationCancellationToken == token;

    private void ClearReview()
    {
        SimulationState.Reset();
        _frames.Clear();
        _frameIndex = -1;
        _lastCapturedStep = null;
        _lastResult = null;
        _lastRunPopupOpen = false;
    }

    private Task PlayTimelineAsync()
    {
        if (_frames.Count > 0) _frameIndex = _frames.Count - 1;
        SimulationState.Resume();
        return InvokeAsync(StateHasChanged);
    }

    private Task PauseTimelineAsync()
    {
        SimulationState.Pause();
        return Task.CompletedTask;
    }

    private Task StepBackAsync()
    {
        if (SimulationState.IsRunning && !SimulationState.IsPaused) SimulationState.Pause();
        if (_frameIndex > 0) _frameIndex--;
        return InvokeAsync(StateHasChanged);
    }

    private Task StepForwardAsync()
    {
        if (_frameIndex >= 0 && _frameIndex < _frames.Count - 1)
        {
            _frameIndex++;
            return InvokeAsync(StateHasChanged);
        }
        if (SimulationState.IsRunning) SimulationState.Step();
        return Task.CompletedTask;
    }

    private Task ResetPlaybackAsync()
    {
        SimulationState.Reset();
        _frames.Clear();
        _frameIndex = -1;
        _lastCapturedStep = null;
        return InvokeAsync(StateHasChanged);
    }

    private void SetStateView(StateView view)
    {
        _view = view;
        if (view == StateView.Memory && _practiceResults.Count > 0)
        {
            _memoryOpenedDuringTask = true;
            EvaluatePracticeTasks();
        }
    }

    private void StartTask(int taskId)
    {
        if (IsBusy) return;
        var task = PracticeTasks.First(item => item.Id == taskId);
        _activeTaskId = taskId;
        _memoryOpenedDuringTask = false;
        _variant = task.Variant;
        LoadValues(CloneValues(task.Input));
    }

    private void RecordPracticeResult(BubbleSortResult result)
    {
        _practiceResults.Add(result);
        if (_practiceResults.Count > 24) _practiceResults.RemoveAt(0);
        EvaluatePracticeTasks();
    }

    private void EvaluatePracticeTasks()
    {
        if (_practiceResults.Count == 0) return;
        var result = _practiceResults[^1];

        foreach (var task in PracticeTasks)
        {
            if (_completedTaskIds.Contains(task.Id) && GetTaskEvidence(task.Id) is not null && _activeTaskId != task.Id) continue;
            var completed = task.Id switch
            {
                1 => result.Variant == BubbleSortVariant.Basic &&
                     PracticeRules.ContainsOrderedSubsequence(result.InitialValues, task.Input) &&
                     PracticeRules.IsNonDecreasing(result.SortedValues) && result.Passes > 0 && !result.UsedEarlyExit,
                2 => result.Variant == BubbleSortVariant.Optimized &&
                     result.InitialValues.Length >= task.Input.Length &&
                     PracticeRules.IsNonDecreasing(result.InitialValues) &&
                     result.Swaps == 0 && result.UsedEarlyExit && result.Passes == 1,
                3 => result.Variant == BubbleSortVariant.Basic &&
                     result.InitialValues.Length >= task.Input.Length &&
                     PracticeRules.IsStrictlyDescending(result.InitialValues) &&
                     result.Comparisons == PracticeRules.QuadraticPairCount(result.InitialValues.Length) &&
                     result.Swaps == PracticeRules.QuadraticPairCount(result.InitialValues.Length),
                4 => result.Variant == BubbleSortVariant.Basic &&
                     PracticeRules.ContainsOrderedSubsequence(result.InitialValues, task.Input) &&
                     PracticeRules.HasDuplicate(result.InitialValues) && result.Stable && _memoryOpenedDuringTask,
                5 => result.Variant == BubbleSortVariant.Basic && result.InitialValues.Length == 1 && result.Comparisons == 0 && result.Swaps == 0,
                _ => false
            };

            if (completed) CompletePracticeTask(task, result);
        }
    }

    private void CompletePracticeTask(PracticeTaskDefinition task, BubbleSortResult result)
    {
        var evidence = new PracticeCompletionEvidence(
            task.Id,
            task.Title,
            result.UsedEarlyExit ? $"{VariantLabelFor(result.Variant)} stopped after a no-swap proof" : $"{VariantLabelFor(result.Variant)} Bubble Sort completed",
            result.Swaps == 0
                ? "The run inspected adjacent pairs without needing a swap."
                : $"The run repaired {result.Swaps} adjacent inversion(s) while the sorted suffix grew from right to left.",
            $"The same fixed array was reused with O(1) temporary swap storage. Stable duplicate order was {(result.Stable ? "preserved" : "not preserved")}.",
            result.Variant == BubbleSortVariant.Optimized
                ? "The no-swap pass is a real proof that the remaining array is sorted; it improves the best case without changing the quadratic worst case."
                : "The Basic version exposes the complete shrinking-pass schedule, making the quadratic comparison pattern easy to see.",
            [
                new("Input", FormatValues(result.InitialValues)),
                new("Comparisons", result.Comparisons.ToString()),
                new("Swaps", result.Swaps.ToString()),
                new("Passes", result.Passes.ToString())
            ],
            $"{VariantLabelFor(result.Variant)} · {FormatValues(result.InitialValues)} → {FormatValues(result.SortedValues)}");

        _completedTaskIds.Add(task.Id);
        PracticeProgress.Complete(ModuleKey, _practiceProgress, task.Id, evidence);
        if (_activeTaskId == task.Id) _activeTaskId = null;
    }

    private PracticeCompletionEvidence? GetTaskEvidence(int taskId) => PracticeProgress.GetEvidence(_practiceProgress, taskId);
    private void OpenTaskEvidence(int taskId) => _practiceEvidencePopup = GetTaskEvidence(taskId);
    private void CloseTaskEvidence() => _practiceEvidencePopup = null;

    private string GetActiveTaskProgressText(int taskId)
    {
        if (_practiceResults.Count == 0)
        {
            return taskId == 4
                ? "Input is loaded. Run Bubble Sort, then open Memory state to inspect duplicate item identity."
                : "Input is loaded. Predict the first pair if you want, then run Bubble Sort.";
        }

        var result = _practiceResults[^1];
        return taskId switch
        {
            1 => $"Need Basic mode with the requested values in order and no early exit. Last run: {VariantLabelFor(result.Variant)}, {result.Comparisons} comparisons, {result.Swaps} swaps, {result.Passes} passes.",
            2 => $"Need one no-swap pass. Last run: {result.Passes} pass(es), {result.Swaps} swaps, early exit={(result.UsedEarlyExit ? "yes" : "no")}.",
            3 => $"Need a reverse input so every inversion is exposed. Last run: n={result.InitialValues.Length}, {result.Comparisons} comparisons, {result.Swaps} swaps.",
            4 => $"Stable result={(result.Stable ? "yes" : "no")}; Memory state opened={(_memoryOpenedDuringTask ? "yes" : "no")}.",
            5 => $"Need zero work. Last run: {result.Comparisons} comparisons and {result.Swaps} swaps.",
            _ => string.Empty
        };
    }

    private void PersistCompletedTasks()
    {
        try
        {
            var json = System.Text.Json.JsonSerializer.Serialize(_completedTaskIds.OrderBy(id => id).ToArray());
            LearningStore.SetItem(CompletedTasksStorageKey, json);
        }
        catch
        {
        }
    }

    private void ToggleRunPopups(ChangeEventArgs args)
    {
        _showRunPopups = args.Value is bool value ? value : bool.TryParse(args.Value?.ToString(), out var parsed) && parsed;
        try
        {
            LearningStore.SetItem(PopupSettingStorageKey, _showRunPopups.ToString());
        }
        catch
        {
        }
    }

    private void OpenLastRunPopup()
    {
        if (_lastResult is null) return;
        _popupTab = ResultPopupTab.Action;
        _lastRunPopupOpen = true;
    }

    private void CloseLastRunPopup() => _lastRunPopupOpen = false;
    private static void IgnorePopupClick() { }

    private static int[] CloneValues(int[] source)
    {
        var copy = new int[source.Length];
        for (var index = 0; index < source.Length; index++) copy[index] = source[index];
        return copy;
    }

    private static bool SameValues(int[] left, int[] right)
    {
        if (left.Length != right.Length) return false;
        for (var index = 0; index < left.Length; index++)
        {
            if (left[index] != right[index]) return false;
        }
        return true;
    }

    private void SetVariant(BubbleSortVariant variant)
    {
        if (IsBusy || _variant == variant) return;
        _variant = variant;
        ClearReview();
    }

    private static string FormatValues(int[] values) => string.Join(", ", values);

    public void Dispose() => SimulationState.Changed -= HandleSimulationChanged;

    private sealed record RunFrame(string StepText, BubbleSortSnapshot Snapshot);
    private sealed record PracticeTaskDefinition(int Id, string Title, string Goal, int[] Input, BubbleSortVariant Variant);
    private enum StateView { Visual, Memory }
    private enum ResultPopupTab { Action, Complexity, Memory }
    private enum PredictionChoice { Swap, Keep }
    private enum Preset { Classic, NearlySorted, Reverse, Duplicates, Sorted }
}
