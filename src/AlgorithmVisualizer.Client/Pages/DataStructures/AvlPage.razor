@page "/structures/avl"
@implements IDisposable
@using System.Text.Json
@using AlgorithmVisualizer.Client.Components.Visualization.Trees
@using AlgorithmVisualizer.Core.DataStructures.Trees.Avl
@inject SimulationState SimulationState
@inject AvlSimulation Tree
@inject LearningSessionStore LearningStore
@inject PracticeProgressStore PracticeProgress

<PageTitle>AVL Tree Lab — Algorithm Visualizer</PageTitle>

<div class="avl-page">
    <section class="learn-launchpad" aria-labelledby="avl-learn-title">
        <div class="learn-copy">
            <span class="section-kicker">LEARN FIRST</span>
            <h2 id="avl-learn-title">BST ordering stays. AVL adds one repair rule.</h2>
            <p>Insert and search follow the same left/right rule as our BST. After a mutation, AVL walks upward, measures balance, and rotates only when a node becomes too heavy on one side.</p>
            <ConceptLink Href="/learn/concepts/avl-balance">Open AVL balance &amp; rotations →</ConceptLink>
        </div>
        <div class="learn-grid">
            <article class="learn-card purple"><span>BALANCE</span><strong>BF = h(left) − h(right)</strong><small>Every node must finish with balance factor −1, 0, or +1.</small></article>
            <article class="learn-card mint"><span>LL / RR</span><strong>One rotation</strong><small>An outside-heavy path is repaired with one right or left rotation.</small></article>
            <article class="learn-card blue"><span>LR / RL</span><strong>Two rotations</strong><small>An inside-heavy path first straightens the child, then repairs the ancestor.</small></article>
            <article class="learn-card gold"><span>GUARANTEE</span><strong>O(log n)</strong><small>Unlike an ordinary BST, AVL actively prevents the tree from becoming a long chain.</small></article>
        </div>
    </section>

    <header class="module-header">
        <div class="header-copy">
            <div class="module-eyebrow">
                <span>DATA STRUCTURES</span>
                <span class="separator">/</span>
                <span class="live-status"><i></i> Interactive lab</span>
            </div>
            <h1>AVL Tree</h1>
            <p>Use the BST rule to place values, then watch cached heights, balance factors, and real node references change through LL, RR, LR, and RL rotations.</p>
        </div>
        <div class="complexity-summary">
            <div><span>SEARCH</span><strong>O(log n)</strong><small>balanced root-to-node path</small></div>
            <div><span>INSERT</span><strong>O(log n)</strong><small>BST insert + upward repair</small></div>
            <div><span>DELETE</span><strong>O(log n)</strong><small>BST delete + upward repair</small></div>
        </div>
    </header>

    <section class="smart-tip" aria-label="AVL learning tip">
        <span class="tip-icon">✦</span>
        <div>
            <strong>Before a rotation:</strong>
            <p>read the first unbalanced node's BF, then inspect its heavy child. That pair tells you LL, RR, LR, or RL before anything moves.</p>
        </div>
        <ConceptLink Href="/learn/concepts/avl-balance">How to choose the rotation →</ConceptLink>
    </section>

    <section class="lab-shell">
        <div class="lab-heading">
            <div>
                <span class="section-kicker">PLAYGROUND</span>
                <h2>Trigger an imbalance, then watch the tree repair itself.</h2>
            </div>
            <div class="lab-options">
                @if (_lastResult is not null)
                {
                    <button class="last-run-button" type="button" @onclick="OpenLastRunPopup">Last run explanation</button>
                }
                <label class="popup-toggle">
                    <input type="checkbox" checked="@_showRunPopups" @onchange="ToggleRunPopups" />
                    <span>Result popups</span>
                </label>
            </div>
        </div>

        <section class="operation-panel" aria-label="AVL Tree operations">
            <div class="value-card">
                <label>
                    <span class="control-label">VALUE / KEY</span>
                    <InputNumber TValue="int?" @bind-Value="_value" disabled="@IsBusy" placeholder="e.g. 50" />
                </label>
                <small>Keys are unique. Insertion uses our BST ordering first, then AVL balancing.</small>
                <div class="sample-values" aria-label="Suggested AVL values">
                    <span>Try:</span>
                    @foreach (var sample in SampleValues)
                    {
                        <button type="button" @onclick="() => SetValue(sample)" disabled="@IsBusy">@sample</button>
                    }
                </div>
            </div>

            <div class="operation-card insert-card">
                <div class="operation-heading"><span class="operation-glyph">+</span><span><strong>Insert</strong><small>BST placement + rebalance</small></span></div>
                <button class="primary-action" type="button" @onclick="InsertAsync" disabled="@(!CanRunValueOperation)">Insert value <span>↘</span></button>
            </div>

            <div class="operation-card search-card">
                <div class="operation-heading"><span class="operation-glyph">?</span><span><strong>Search</strong><small>Follow one comparison path</small></span></div>
                <button type="button" @onclick="SearchAsync" disabled="@(!CanRunValueOperation)">Search value <span>→</span></button>
            </div>

            <div class="operation-card delete-card">
                <div class="operation-heading"><span class="operation-glyph">−</span><span><strong>Delete</strong><small>BST delete + rebalance upward</small></span></div>
                <button class="delete-action" type="button" @onclick="DeleteAsync" disabled="@(!CanRunValueOperation)">Delete value <span>×</span></button>
            </div>

            <div class="operation-card reset-card">
                <div class="operation-heading"><span class="operation-glyph">↺</span><span><strong>Reset tree</strong><small>Start another shape</small></span></div>
                <button type="button" @onclick="ClearTreeAsync" disabled="@IsBusy">Clear AVL</button>
            </div>
        </section>

        <div class="sample-sequence">
            <span class="section-kicker">ROTATION RECIPES</span>
            <p><strong>LL:</strong> 30, 20, 10 · <strong>RR:</strong> 10, 20, 30 · <strong>LR:</strong> 30, 10, 20 · <strong>RL:</strong> 10, 30, 20. Clear the tree between recipes and predict the final root before the rotation.</p>
        </div>

        @if (!string.IsNullOrWhiteSpace(_errorMessage))
        {
            <div class="error-message" role="alert"><span>!</span><p>@_errorMessage</p></div>
        }

        <SimulationToolbar OnPlay="PlayTimelineAsync"
                           OnPause="PauseTimelineAsync"
                           OnStepBack="StepBackAsync"
                           OnStepForward="StepForwardAsync"
                           OnReset="ResetPlaybackAsync"
                           CanStepBack="@CanStepBack"
                           CanStepForwardOverride="@CanStepForward"
                           StepTextOverride="@DisplayedStepText"
                           TimelinePosition="@TimelinePosition"
                           TimelineCount="@TimelineCount" />

        <div class="state-tabs-row">
            <div class="state-tabs" role="tablist" aria-label="AVL simulation view">
                <button type="button" role="tab" aria-selected="@(_activeStateView == StateView.Visual)" class="@GetStateTabClass(StateView.Visual)" @onclick="() => SetStateView(StateView.Visual)">Visual state</button>
                <button type="button" role="tab" aria-selected="@(_activeStateView == StateView.Memory)" class="@GetStateTabClass(StateView.Memory)" @onclick="() => SetStateView(StateView.Memory)">Memory state</button>
            </div>
            <p>@(_activeStateView == StateView.Visual
                ? "Visual state shows ordering plus each node's cached height and balance factor, so an imbalance is visible before a rotation."
                : "Memory state shows the root reference, parent/left/right links, cached height, and how rotations rewire real node objects.")</p>
        </div>

        <div class="lesson-reference-links" aria-label="Concepts and memory links">
            <ConceptLink Href="/learn/concepts/avl-balance">AVL concepts →</ConceptLink>
            <ConceptLink Href="/learn/concepts/visual-vs-memory">AVL links & memory →</ConceptLink>
        </div>

        @if (_activeStateView == StateView.Visual)
        {
            <AvlVisualization Root="@DisplayedRoot" Count="@DisplayedCount" Height="@DisplayedHeight" />
        }
        else
        {
            <AvlMemoryVisualization Root="@DisplayedRoot" Count="@DisplayedCount" Height="@DisplayedHeight" />
        }
    </section>

    <section class="practice-section" aria-labelledby="practice-title">
        <div class="practice-heading">
            <div>
                <span class="section-kicker">GUIDED PRACTICE</span>
                <h2 id="practice-title">Prove you understand the structure, not just the animation.</h2>
            </div>
            <div class="task-score"><strong>@_completedTaskIds.Count / @PracticeTasks.Count</strong><span>completed</span></div>
        </div>

        @if (_activeTaskId is not null)
        {
            var activeTask = PracticeTasks.First(task => task.Id == _activeTaskId);
            <div class="active-task-banner">
                <span>ACTIVE TASK @activeTask.Id.ToString("00")</span>
                <strong>@activeTask.Title</strong>
                <small>@GetActiveTaskProgressText(activeTask.Id)</small>
            </div>
        }

        <div class="task-grid">
            @foreach (var task in PracticeTasks)
            {
                var completed = _completedTaskIds.Contains(task.Id);
                var active = _activeTaskId == task.Id;
                <PracticeTaskCard TaskId="@task.Id"
                                  Title="@task.Title"
                                  Steps="@task.Steps"
                                  HelpHref="@task.HelpHref"
                                  Completed="@completed"
                                  Active="@active"
                                  Busy="@IsBusy"
                                  HasEvidence="@(GetTaskEvidence(task.Id) is not null)"
                                  Start="@(() => StartTask(task.Id))"
                                  OpenEvidence="@(() => OpenTaskEvidence(task.Id))" />
            }
        </div>
    </section>
    <NextLessonCard Title="Vector"
                    Description="Switch from linked tree references to fixed indexed numeric storage before extending the idea into Matrix rows and columns."
                    Href="/structures/vector"
                    Level="06 · Intermediate"
                    LinkLabel="Open Vector lesson" />

</div>

<PracticeEvidencePopup Evidence="@_practiceEvidencePopup" OnClose="CloseTaskEvidence" />

@if (_lastRunPopupOpen && _lastResult is not null)
{
    <div class="run-popup-backdrop" role="presentation" @onclick="CloseLastRunPopup">
        <section class="run-popup" role="dialog" aria-modal="true" aria-labelledby="avl-run-popup-title" @onclick="IgnorePopupClick" @onclick:stopPropagation="true">
            <header>
                <div>
                    <span class="section-kicker">LAST RUN</span>
                    <h2 id="avl-run-popup-title">@GetResultHeadline(_lastResult)</h2>
                </div>
                <button class="popup-close" type="button" @onclick="CloseLastRunPopup" aria-label="Close result explanation">×</button>
            </header>

            <div class="popup-tabs" role="tablist">
                <button type="button" class="@(_popupTab == ResultPopupTab.Run ? "active" : string.Empty)" @onclick="() => _popupTab = ResultPopupTab.Run">What happened</button>
                <button type="button" class="@(_popupTab == ResultPopupTab.Memory ? "active" : string.Empty)" @onclick="() => _popupTab = ResultPopupTab.Memory">Tree shape &amp; memory</button>
            </div>

            @if (_popupTab == ResultPopupTab.Run)
            {
                <div class="popup-body">
                    <div class="popup-metrics">
                        <div><span>Key comparisons</span><strong>@_lastResult.Comparisons</strong></div>
                        <div><span>Successor checks</span><strong>@_lastResult.SuccessorChecks</strong></div>
                        <div><span>Balance checks</span><strong>@_lastResult.RebalanceChecks</strong></div>
                        <div><span>Primitive rotations</span><strong>@_lastResult.RotationCount</strong></div>
                        <div><span>First repair case</span><strong>@GetRotationCaseLabel(_lastResult.FirstRotationCase)</strong></div>
                        <div><span>This run</span><strong>@_lastResult.CurrentRunComplexity</strong></div>
                        <div><span>Worst-case rule</span><strong>@_lastResult.WorstCaseComplexity</strong></div>
                    </div>
                    <div class="popup-explainer @(_lastResult.Succeeded ? "success" : string.Empty)">
                        <strong>@GetPlainRunSummary(_lastResult)</strong>
                        <p>@GetComplexityExplanation(_lastResult)</p>
                    </div>
                    <ConceptLink class="popup-learn" Href="/learn/concepts/avl-balance">Learn how AVL keeps h logarithmic →</ConceptLink>
                </div>
            }
            else
            {
                <div class="popup-body">
                    <div class="popup-metrics shape">
                        <div><span>Count</span><strong>@_lastResult.InitialCount → @_lastResult.FinalCount</strong></div>
                        <div><span>Height</span><strong>@_lastResult.HeightBefore → @_lastResult.HeightAfter</strong></div>
                        <div><span>Delete case</span><strong>@GetDeleteCaseLabel(_lastResult.DeleteCase)</strong></div>
                        <div><span>First repair</span><strong>@GetRotationCaseLabel(_lastResult.FirstRotationCase)</strong></div>
                    </div>
                    <div class="popup-explainer">
                        <strong>@GetMemoryHeadline(_lastResult)</strong>
                        <p>@GetMemoryExplanation(_lastResult)</p>
                    </div>
                    <ConceptLink class="popup-learn" Href="/learn/concepts/visual-vs-memory">Visual state vs Memory state →</ConceptLink>
                </div>
            }

            <footer>
                <label class="popup-toggle inside"><input type="checkbox" checked="@_showRunPopups" @onchange="ToggleRunPopups" /><span>Show automatically after future AVL runs</span></label>
            </footer>
        </section>
    </div>
}

@code {
    private const string ModuleKey = "avl";
    private const string CompletedTasksStorageKey = "algorithm-visualizer.avl.completed-tasks.v1";
    private const string PopupSettingStorageKey = "algorithm-visualizer.avl.result-popups.v1";

    private readonly List<RunFrame> _runFrames = [];
    private readonly HashSet<int> _completedTaskIds = [];
    private PracticeModuleProgress _practiceProgress = new();
    private PracticeCompletionEvidence? _practiceEvidencePopup;
    private readonly List<PracticeEvent> _practiceEvents = [];

    private static readonly int[] SampleValues = [30, 20, 10, 40, 50, 25, 35];
    private static readonly IReadOnlyList<PracticeTaskDefinition> PracticeTasks =
    [
        new(1, "Trigger an LL repair", ["Clear the tree.", "Insert 30, then 20, then 10.", "Predict that 20 becomes the new root before the right rotation."], "/learn/concepts/avl-balance"),
        new(2, "Trigger an RR repair", ["Clear the tree.", "Insert 10, then 20, then 30.", "Predict that 20 becomes the new root before the left rotation."], "/learn/concepts/avl-balance"),
        new(3, "Trigger an LR repair", ["Clear the tree.", "Insert 30, then 10, then 20.", "Watch the child rotate first, then the unbalanced ancestor."], "/learn/concepts/avl-balance"),
        new(4, "Trigger an RL repair", ["Clear the tree.", "Insert 10, then 30, then 20.", "Watch the mirrored two-rotation repair."], "/learn/concepts/avl-balance"),
        new(5, "Delete and rebalance", ["Build 9, 5, 10, 0, 6, 11, -1, 1, 2.", "Delete 10 and observe an upward rebalance.", "Open Memory state to inspect the rewired references."], "/learn/concepts/visual-vs-memory"),
        new(6, "Search after rotations", ["Build any AVL tree that has rotated.", "Search for one value that exists.", "Search for one missing value and compare where the balanced paths stop."], "/learn/concepts/big-o")
    ];

    private int? _value;
    private string? _errorMessage;
    private string? _lastCapturedStepText;
    private int _frameIndex = -1;
    private bool _showRunPopups = true;
    private bool _lastRunPopupOpen;
    private bool _storageLoaded;
    private bool _memoryOpenedDuringTask;
    private int? _activeTaskId;
    private int _practiceSequence;
    private StateView _activeStateView = StateView.Visual;
    private ResultPopupTab _popupTab = ResultPopupTab.Run;
    private AvlOperationResult? _lastResult;

    private bool IsBusy => SimulationState.IsRunning;
    private bool CanRunValueOperation => !IsBusy && _value.HasValue;
    private bool CanStepBack => _frameIndex > 0;
    private bool CanStepForward => (_runFrames.Count > 0 && _frameIndex < _runFrames.Count - 1) || SimulationState.IsRunning;
    private int TimelineCount => _runFrames.Count;
    private int TimelinePosition => _frameIndex >= 0 ? _frameIndex + 1 : 0;
    private RunFrame? CurrentFrame => _frameIndex >= 0 && _frameIndex < _runFrames.Count ? _runFrames[_frameIndex] : null;
    private string DisplayedStepText => CurrentFrame?.StepText ?? SimulationState.CurrentStepText;
    private AvlNodeSnapshot? DisplayedRoot => CurrentFrame is not null ? CurrentFrame.Root : Tree.CreateSnapshot();
    private int DisplayedCount => CurrentFrame?.Count ?? Tree.Count;
    private int DisplayedHeight => CurrentFrame?.Height ?? Tree.Height;

    protected override void OnInitialized()
    {
        SimulationState.Changed += HandleStateChanged;
        Tree.Changed += HandleTreeChanged;
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender || _storageLoaded)
        {
            return;
        }

        _storageLoaded = true;
        try
        {
            _practiceProgress = PracticeProgress.Load(ModuleKey, CompletedTasksStorageKey, PracticeTasks.Select(task => task.Id));
            _completedTaskIds.Clear();
            foreach (var id in _practiceProgress.CompletedTaskIds) _completedTaskIds.Add(id);

            var popupSetting = LearningStore.GetItem(PopupSettingStorageKey);
            if (bool.TryParse(popupSetting, out var showPopups))
            {
                _showRunPopups = showPopups;
            }
        }
        catch
        {
            // The AVL lab remains fully usable if session-state restoration fails.
        }

        await InvokeAsync(StateHasChanged);
    }

    private Task InsertAsync() => RunValueResultOperationAsync(AvlOperationKind.Insert, Tree.InsertAsync);
    private Task SearchAsync() => RunValueResultOperationAsync(AvlOperationKind.Search, Tree.SearchAsync);
    private Task DeleteAsync() => RunValueResultOperationAsync(AvlOperationKind.Delete, Tree.DeleteAsync);

    private async Task RunValueResultOperationAsync(
        AvlOperationKind operationKind,
        Func<int, CancellationToken, Task<AvlOperationResult>> operation)
    {
        if (!_value.HasValue)
        {
            _errorMessage = "Enter a number first.";
            await InvokeAsync(StateHasChanged);
            return;
        }

        if (SimulationState.IsRunning)
        {
            return;
        }

        var value = _value.Value;
        PrepareNewRun();
        var runToken = SimulationState.Start($"Starting AVL {operationKind.ToString().ToLowerInvariant()} for {value}.");

        try
        {
            var result = await operation(value, runToken);
            if (!IsCurrentRun(runToken))
            {
                return;
            }

            _lastResult = result;
            RecordPracticeEvent(new PracticeEvent(operationKind, value, result.Succeeded, result.DuplicateRejected, result.DeleteCase, result.FirstRotationCase, result.RotationCount, result.InitialCount, result.FinalCount));
            SimulationState.SetCurrentStep("Run complete.");
            SimulationState.Complete();
            _popupTab = operationKind == AvlOperationKind.Delete ? ResultPopupTab.Memory : ResultPopupTab.Run;
            _lastRunPopupOpen = _showRunPopups;
        }
        catch (OperationCanceledException) when (runToken.IsCancellationRequested)
        {
        }
        catch (Exception exception)
        {
            _errorMessage = $"Something went wrong: {exception.Message}";
            if (IsCurrentRun(runToken))
            {
                SimulationState.Complete("The run stopped because of an error.");
            }
        }
    }

    private async Task ClearTreeAsync()
    {
        if (SimulationState.IsRunning)
        {
            return;
        }

        PrepareNewRun();
        var runToken = SimulationState.Start("Resetting the AVL lab.");

        try
        {
            await Tree.ClearAsync(runToken);
            if (IsCurrentRun(runToken))
            {
                SimulationState.SetCurrentStep("Tree reset complete.");
                SimulationState.Complete();
                RecordPracticeEvent(new PracticeEvent(null, null, false, false, AvlDeleteCase.None, AvlRotationCase.None, 0, 0, 0, IsReset: true));
            }
        }
        catch (OperationCanceledException) when (runToken.IsCancellationRequested)
        {
        }
        catch (Exception exception)
        {
            _errorMessage = $"Something went wrong: {exception.Message}";
            if (IsCurrentRun(runToken)) SimulationState.Complete("The reset stopped because of an error.");
        }
    }

    private void PrepareNewRun()
    {
        _errorMessage = null;
        _memoryOpenedDuringTask = _activeStateView == StateView.Memory;
        _lastRunPopupOpen = false;
        _runFrames.Clear();
        _frameIndex = -1;
        _lastCapturedStepText = null;
    }

    private void CaptureFrame()
    {
        var stepText = SimulationState.CurrentStepText;
        if (string.Equals(stepText, _lastCapturedStepText, StringComparison.Ordinal))
        {
            return;
        }

        var wasAtTail = _frameIndex < 0 || _frameIndex == _runFrames.Count - 1;
        _runFrames.Add(new RunFrame(stepText, Tree.CreateSnapshot(), Tree.Count, Tree.Height));
        _lastCapturedStepText = stepText;
        if (wasAtTail)
        {
            _frameIndex = _runFrames.Count - 1;
        }
    }

    private Task PlayTimelineAsync()
    {
        if (_runFrames.Count > 0)
        {
            _frameIndex = _runFrames.Count - 1;
        }

        SimulationState.Resume();
        return InvokeAsync(StateHasChanged);
    }

    private Task PauseTimelineAsync()
    {
        SimulationState.Pause();
        return Task.CompletedTask;
    }

    private Task StepBackAsync()
    {
        if (SimulationState.IsRunning && !SimulationState.IsPaused)
        {
            SimulationState.Pause();
        }

        if (_frameIndex > 0)
        {
            _frameIndex--;
        }

        return InvokeAsync(StateHasChanged);
    }

    private Task StepForwardAsync()
    {
        if (_frameIndex >= 0 && _frameIndex < _runFrames.Count - 1)
        {
            _frameIndex++;
            return InvokeAsync(StateHasChanged);
        }

        if (SimulationState.IsRunning)
        {
            SimulationState.Step();
        }

        return Task.CompletedTask;
    }

    private Task ResetPlaybackAsync()
    {
        SimulationState.Reset();
        _runFrames.Clear();
        _frameIndex = -1;
        _lastCapturedStepText = null;
        return InvokeAsync(StateHasChanged);
    }

    private void SetValue(int value)
    {
        if (!IsBusy)
        {
            _value = value;
            _errorMessage = null;
        }
    }

    private void SetStateView(StateView view)
    {
        _activeStateView = view;
        if (view == StateView.Memory && _lastResult is not null)
        {
            _memoryOpenedDuringTask = true;
            EvaluatePracticeTasks();
        }
    }

    private string GetStateTabClass(StateView view) => _activeStateView == view ? "active" : string.Empty;

    private void StartTask(int taskId)
    {
        if (IsBusy) return;
        _activeTaskId = taskId;
        _memoryOpenedDuringTask = false;
    }

    private void RecordPracticeEvent(PracticeEvent practiceEvent)
    {
        _practiceEvents.Add(practiceEvent with { Sequence = ++_practiceSequence });
        if (_practiceEvents.Count > 256) _practiceEvents.RemoveAt(0);
        EvaluatePracticeTasks();
    }

    private void EvaluatePracticeTasks()
    {
        if (_lastResult is null) return;
        foreach (var task in PracticeTasks)
        {
            if (_completedTaskIds.Contains(task.Id) && GetTaskEvidence(task.Id) is not null && _activeTaskId != task.Id) continue;
            var completed = task.Id switch
            {
                1 => _lastResult.Operation == AvlOperationKind.Insert && _lastResult.Succeeded && _lastResult.FirstRotationCase == AvlRotationCase.LL,
                2 => _lastResult.Operation == AvlOperationKind.Insert && _lastResult.Succeeded && _lastResult.FirstRotationCase == AvlRotationCase.RR,
                3 => _lastResult.Operation == AvlOperationKind.Insert && _lastResult.Succeeded && _lastResult.FirstRotationCase == AvlRotationCase.LR,
                4 => _lastResult.Operation == AvlOperationKind.Insert && _lastResult.Succeeded && _lastResult.FirstRotationCase == AvlRotationCase.RL,
                5 => _memoryOpenedDuringTask && _lastResult.Operation == AvlOperationKind.Delete && _lastResult.Succeeded && _lastResult.RotationCount > 0,
                6 => _lastResult.Operation == AvlOperationKind.Search &&
                     _practiceEvents.Any(e => e.Operation == AvlOperationKind.Search && e.Succeeded) &&
                     _practiceEvents.Any(e => e.Operation == AvlOperationKind.Search && !e.Succeeded),
                _ => false
            };
            if (completed) CompletePracticeTask(task, _lastResult);
        }
    }

    private void CompletePracticeTask(PracticeTaskDefinition task, AvlOperationResult result)
    {
        var evidence = new PracticeCompletionEvidence(
            task.Id,
            task.Title,
            GetResultHeadline(result),
            GetPlainRunSummary(result),
            GetMemoryExplanation(result),
            GetComplexityExplanation(result),
            [
                new("Operation", result.Operation.ToString()),
                new("Checks", result.TotalChecks.ToString()),
                new("Rotations", result.RotationCount.ToString()),
                new("Rotation case", GetRotationCaseLabel(result.FirstRotationCase)),
                new("Height", $"{result.HeightBefore} → {result.HeightAfter}")
            ],
            $"Target {result.RequestedValue} · {GetRotationCaseLabel(result.FirstRotationCase)}");
        _completedTaskIds.Add(task.Id);
        PracticeProgress.Complete(ModuleKey, _practiceProgress, task.Id, evidence);
        if (_activeTaskId == task.Id) _activeTaskId = null;
    }

    private PracticeCompletionEvidence? GetTaskEvidence(int taskId) => PracticeProgress.GetEvidence(_practiceProgress, taskId);
    private void OpenTaskEvidence(int taskId) => _practiceEvidencePopup = GetTaskEvidence(taskId);
    private void CloseTaskEvidence() => _practiceEvidencePopup = null;

    private string GetActiveTaskProgressText(int taskId) => taskId switch
    {
        1 => "Clear, then insert 30 → 20 → 10 until the run reports LL.",
        2 => "Clear, then insert 10 → 20 → 30 until the run reports RR.",
        3 => "Clear, then insert 30 → 10 → 20 until the run reports LR.",
        4 => "Clear, then insert 10 → 30 → 20 until the run reports RL.",
        5 => _memoryOpenedDuringTask ? "Memory state opened — finish a Delete that performs at least one rotation." : "Trigger a rotating Delete, then open Memory state.",
        6 => "Complete one successful Search and one Search that reaches an empty child link.",
        _ => string.Empty
    };

    private void PersistCompletedTasks()
    {
        try
        {
            LearningStore.SetItem(CompletedTasksStorageKey, JsonSerializer.Serialize(_completedTaskIds.OrderBy(id => id).ToArray()));
        }
        catch
        {
        }
    }

    private void ToggleRunPopups(ChangeEventArgs args)
    {
        _showRunPopups = args.Value is bool boolValue
            ? boolValue
            : bool.TryParse(args.Value?.ToString(), out var parsed) && parsed;

        try
        {
            LearningStore.SetItem(PopupSettingStorageKey, _showRunPopups.ToString());
        }
        catch
        {
        }
    }

    private void OpenLastRunPopup()
    {
        if (_lastResult is null)
        {
            return;
        }

        _popupTab = _lastResult.Operation == AvlOperationKind.Delete ? ResultPopupTab.Memory : ResultPopupTab.Run;
        _lastRunPopupOpen = true;
    }

    private static void IgnorePopupClick()
    {
    }

    private void CloseLastRunPopup() => _lastRunPopupOpen = false;

    private static string GetResultHeadline(AvlOperationResult result) => result.Operation switch
    {
        AvlOperationKind.Insert when result.DuplicateRejected => $"Insert: {result.RequestedValue} already exists",
        AvlOperationKind.Insert => $"Inserted {result.RequestedValue}",
        AvlOperationKind.Search when result.Succeeded => $"Found {result.RequestedValue}",
        AvlOperationKind.Search => $"Search: {result.RequestedValue} not found",
        AvlOperationKind.Delete when result.Succeeded => $"Deleted {result.RequestedValue}",
        AvlOperationKind.Delete => $"Delete: {result.RequestedValue} not found",
        _ => "AVL run complete"
    };

    private static string GetPlainRunSummary(AvlOperationResult result)
    {
        if (result.DuplicateRejected)
        {
            return "The BST comparison path reached an equal key, so this strict AVL tree rejected the duplicate before any rebalance work.";
        }

        if (!result.Succeeded)
        {
            return "The required child link became null before a matching key was found. The tree stayed unchanged.";
        }

        if (result.Operation == AvlOperationKind.Search)
        {
            return "Search used the same ordering rule as BST and did not rotate the tree.";
        }

        if (result.RotationCount == 0)
        {
            return result.Operation == AvlOperationKind.Insert
                ? "The node was inserted by the BST rule, every checked ancestor stayed within AVL balance, so no rotation was needed."
                : $"The target was removed with the {GetDeleteCaseLabel(result.DeleteCase).ToLowerInvariant()} BST delete case, and every checked ancestor stayed balanced.";
        }

        return result.Operation == AvlOperationKind.Insert
            ? $"The node was inserted by the BST rule, then AVL repaired the first imbalance as {GetRotationCaseLabel(result.FirstRotationCase)} using {result.RotationCount} primitive rotation(s)."
            : $"The target was removed with the {GetDeleteCaseLabel(result.DeleteCase).ToLowerInvariant()} BST delete case, then AVL rebalanced upward with {result.RotationCount} primitive rotation(s).";
    }

    private static string GetComplexityExplanation(AvlOperationResult result)
    {
        if (result.InitialCount == 0)
        {
            return "An empty tree needs only a root check, so this particular run is constant work.";
        }

        var successorPart = result.SuccessorChecks > 0
            ? $" A two-child delete also used {result.SuccessorChecks} successor check(s)."
            : string.Empty;
        var rebalancePart = result.RebalanceChecks > 0
            ? $" The mutation then checked balance at {result.RebalanceChecks} ancestor node(s) and performed {result.RotationCount} primitive rotation(s)."
            : string.Empty;

        return $"This run used {result.Comparisons} key comparison(s). Here k = {result.TotalChecks} total observed check(s), so the concrete run is {result.CurrentRunComplexity}. AVL keeps height O(log n), so search, insert, and delete remain O(log n) in the worst case.{successorPart}{rebalancePart}";
    }

    private static string GetMemoryHeadline(AvlOperationResult result)
    {
        if (result.RotationCount > 0)
        {
            return "The rotation changed parent/left/right references while preserving every participating node object's identity and BST order.";
        }

        if (result.Operation == AvlOperationKind.Delete && result.Succeeded)
        {
            return result.DeleteCase switch
            {
                AvlDeleteCase.Leaf => "A parent-to-leaf reference became null; no rotation was necessary.",
                AvlDeleteCase.OneChild => "The surrounding reference was redirected to the removed node's child; no rotation was necessary.",
                AvlDeleteCase.TwoChildren => "The successor node object was rewired into the removed node's position; no further rotation was necessary.",
                _ => "The tree references were updated."
            };
        }

        return "The visual layout and the object-reference layout describe the same AVL tree from two different angles.";
    }

    private static string GetMemoryExplanation(AvlOperationResult result)
    {
        if (result.Operation == AvlOperationKind.Search)
        {
            return "Search only followed existing left/right references. It did not change cached heights, move node objects, or rotate any links.";
        }

        if (result.DuplicateRejected)
        {
            return "No new node object was connected, so Count, cached heights, and the reference graph stayed unchanged.";
        }

        if (!result.Succeeded)
        {
            return "The requested key was not found, so the reference graph and cached heights stayed unchanged.";
        }

        var rotationExplanation = result.RotationCount > 0
            ? $" The AVL repair then rewired links using {result.RotationCount} primitive rotation(s); the first diagnosed case was {GetRotationCaseLabel(result.FirstRotationCase)}."
            : " All checked balance factors were already valid, so no rotation rewired the tree.";

        if (result.Operation == AvlOperationKind.Insert)
        {
            return "A new custom node object was attached at the empty BST child link. Heights were recomputed while walking toward the root." + rotationExplanation;
        }

        return result.DeleteCase switch
        {
            AvlDeleteCase.Leaf => "The leaf was disconnected from its parent. Heights were recomputed upward." + rotationExplanation,
            AvlDeleteCase.OneChild => "The removed node was bypassed so its existing child object kept its identity. Heights were recomputed upward." + rotationExplanation,
            AvlDeleteCase.TwoChildren => "This implementation transplants the real in-order-successor node object instead of copying its value. Heights were recomputed after rewiring." + rotationExplanation,
            _ => "The reference graph changed through explicit custom-node rewiring." + rotationExplanation
        };
    }

    private static string GetDeleteCaseLabel(AvlDeleteCase deleteCase) => deleteCase switch
    {
        AvlDeleteCase.Leaf => "Leaf",
        AvlDeleteCase.OneChild => "One child",
        AvlDeleteCase.TwoChildren => "Two children",
        _ => "—"
    };

    private static string GetRotationCaseLabel(AvlRotationCase rotationCase) => rotationCase switch
    {
        AvlRotationCase.LL => "LL",
        AvlRotationCase.RR => "RR",
        AvlRotationCase.LR => "LR",
        AvlRotationCase.RL => "RL",
        _ => "None"
    };

    private bool IsCurrentRun(CancellationToken runToken) =>
        !runToken.IsCancellationRequested && SimulationState.SimulationCancellationToken == runToken;

    private void HandleStateChanged()
    {
        if (SimulationState.IsRunning)
        {
            CaptureFrame();
        }

        RequestRender();
    }

    private void HandleTreeChanged() => RequestRender();
    private void RequestRender() => _ = InvokeAsync(StateHasChanged);

    public void Dispose()
    {
        SimulationState.Changed -= HandleStateChanged;
        Tree.Changed -= HandleTreeChanged;
    }

    private sealed record RunFrame(string StepText, AvlNodeSnapshot? Root, int Count, int Height);
    private sealed record PracticeTaskDefinition(int Id, string Title, IReadOnlyList<string> Steps, string HelpHref);
    private sealed record PracticeEvent(
        AvlOperationKind? Operation,
        int? Value,
        bool Succeeded,
        bool DuplicateRejected,
        AvlDeleteCase DeleteCase,
        AvlRotationCase RotationCase,
        int RotationCount,
        int InitialCount,
        int FinalCount,
        int Sequence = -1,
        bool IsReset = false);

    private enum StateView { Visual, Memory }
    private enum ResultPopupTab { Run, Memory }
}
