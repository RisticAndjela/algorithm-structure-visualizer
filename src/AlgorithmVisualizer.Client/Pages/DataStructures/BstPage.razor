    private static string GetResultHeadline(BstOperationResult result) => result.Operation switch
    {
        BstOperationKind.Insert when result.DuplicateRejected => $"Insert: {result.RequestedValue} already exists",
        BstOperationKind.Insert => $"Inserted {result.RequestedValue}",
        BstOperationKind.Search when result.Succeeded => $"Found {result.RequestedValue}",
        BstOperationKind.Search => $"Search: {result.RequestedValue} not found",
        BstOperationKind.Delete when result.Succeeded => $"Deleted {result.RequestedValue}",
        BstOperationKind.Delete => $"Delete: {result.RequestedValue} not found",
        BstOperationKind.Balance when result.Succeeded => $"Balanced BST: h {result.HeightBefore} → {result.HeightAfter}",
        BstOperationKind.Balance => "BST balance: nothing to change",
        _ => "BST run complete"
    };

    private static string GetPlainRunSummary(BstOperationResult result)
    {
        if (result.DuplicateRejected)
        {
            return "The comparison path reached an equal key, so this strict BST rejected the duplicate.";
        }

        if (result.Operation == BstOperationKind.Balance && !result.Succeeded)
        {
            return "The tree had no shape to rebalance, so no references changed.";
        }

        if (!result.Succeeded)
        {
            return "The required child link became null before a matching key was found.";
        }

        return result.Operation switch
        {
            BstOperationKind.Insert => "The new node was connected exactly where the comparison path reached an empty child link.",
            BstOperationKind.Search => "The search stopped as soon as the highlighted node matched the target.",
            BstOperationKind.Delete => $"The target was removed using the {GetDeleteCaseLabel(result.DeleteCase).ToLowerInvariant()} delete case.",
            BstOperationKind.Balance => $"DSW first built a right-only vine, then compressed it into a shorter BST using {result.TotalRotations} rotation(s).",
            _ => "The operation completed."
        };
    }

    private static string GetComplexityExplanation(BstOperationResult result)
    {
        if (result.Operation == BstOperationKind.Balance)
        {
            return $"Day-Stout-Warren visits and rewires nodes a constant number of times, so balancing is O(n) time. This implementation uses the existing node links and only a few node references/counters, so the algorithmic extra space is O(1). It performed {result.VineRotations} vine rotation(s) and {result.CompressionRotations} compression rotation(s) across {result.CompressionPasses} compression pass(es).";
        }

        if (result.InitialCount == 0)
        {
            return "An empty tree needs only a root check, so this run is constant work.";
        }

        var successorPart = result.SuccessorChecks > 0
            ? $" The two-child delete also used {result.SuccessorChecks} check(s) to find the successor."
            : string.Empty;

        return $"This run followed part of a root-to-node path and used {result.Comparisons} key comparison(s). BST search, insert, and delete are O(h), where h is tree height.{successorPart}";
    }

    private static string GetMemoryHeadline(BstOperationResult result)
    {
        if (result.Operation == BstOperationKind.Balance && result.Succeeded)
        {
            return "Balancing rewired the root/parent/left/right references; it did not replace the node objects.";
        }

        if (result.Operation != BstOperationKind.Delete || !result.Succeeded)
        {
            return "The visual layout and the object-reference layout describe the same tree from two different angles.";
        }

        return result.DeleteCase switch
        {
            BstDeleteCase.Leaf => "A single parent-to-leaf reference became null.",
            BstDeleteCase.OneChild => "The parent reference was redirected to the removed node's only child.",
            BstDeleteCase.TwoChildren => "The successor node object was rewired into the removed node's position.",
            _ => "The tree references were updated."
        };
    }

    private static string GetMemoryExplanation(BstOperationResult result)
    {
        if (result.Operation == BstOperationKind.Balance && result.Succeeded)
        {
            return $"DSW reused all {result.FinalCount} existing node objects. A rotation changes which object is root and which objects each parent/left/right reference points to, but each node keeps the same value and short ID. Count stays unchanged while height can decrease.";
        }

        if (result.Operation == BstOperationKind.Insert && result.Succeeded)
        {
            return "A new node object was created and exactly one parent left/right reference was connected to it. The screen coordinates are not memory addresses.";
        }

        if (result.DuplicateRejected)
        {
            return "No new node object was connected, so Count and the tree's reference graph stayed unchanged.";
        }

        if (result.Operation == BstOperationKind.Search)
        {
            return "Search only followed existing references. It did not rearrange or copy any node objects.";
        }

        if (result.Operation == BstOperationKind.Delete && result.Succeeded)
        {
            return result.DeleteCase switch
            {
                BstDeleteCase.Leaf => "The removed leaf had no children. Disconnecting its parent link is enough; if nothing else references that node object, .NET can reclaim it later.",
                BstDeleteCase.OneChild => "The child node object keeps its identity. The surrounding reference simply skips the removed node and points directly to that child.",
                BstDeleteCase.TwoChildren => "This implementation does not copy the successor value into the target object. It moves the successor node by changing parent/left/right references, preserving the successor's identity.",
                _ => "The tree reference graph changed without using a built-in collection operation."
            };
        }

        return "No node was removed, so the tree's object-reference graph stayed unchanged.";
    }

    private static string GetResultLearnHref(BstOperationResult result) =>
        result.Operation == BstOperationKind.Balance
            ? "/learn/concepts/bst-balancing"
            : "/learn/concepts/bst";

    private static string GetResultLearnLabel(BstOperationResult result) =>
        result.Operation == BstOperationKind.Balance
            ? "Learn the two DSW phases →"
            : "Learn why BST operations depend on h →";

    private static string GetDeleteCaseLabel(BstDeleteCase deleteCase) => deleteCase switch
    {
        BstDeleteCase.Leaf => "Leaf",
        BstDeleteCase.OneChild => "One child",
        BstDeleteCase.TwoChildren => "Two children",
        _ => "—"
    };

    private bool IsCurrentRun(CancellationToken runToken) =>
        !runToken.IsCancellationRequested && SimulationState.SimulationCancellationToken == runToken;

    private void HandleStateChanged()
    {
        if (SimulationState.IsRunning)
        {
            CaptureFrame();
        }

        RequestRender();
    }

    private void HandleTreeChanged() => RequestRender();
    private void RequestRender() => _ = InvokeAsync(StateHasChanged);

    public void Dispose()
    {
        SimulationState.Changed -= HandleStateChanged;
        Tree.Changed -= HandleTreeChanged;
    }

    private sealed record RunFrame(string StepText, BstNodeSnapshot? Root, int Count, int Height);
    private sealed record PracticeTaskDefinition(int Id, string Title, IReadOnlyList<string> Steps, string HelpHref);
    private sealed record PracticeEvent(
        BstOperationKind? Operation,
        int? Value,
        bool Succeeded,
        bool DuplicateRejected,
        BstDeleteCase DeleteCase,
        int InitialCount,
        int FinalCount,
        int HeightBefore = 0,
        int HeightAfter = 0,
        int Sequence = -1,
        bool IsReset = false);

    private enum StateView { Visual, Memory }
    private enum ResultPopupTab { Run, Memory }
}
