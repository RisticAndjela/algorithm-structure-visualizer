@page "/structures/bst"
@implements IDisposable
@using System.Text.Json
@using AlgorithmVisualizer.Client.Components.Visualization.Trees
@using AlgorithmVisualizer.Core.DataStructures.Trees.Bst
@inject SimulationState SimulationState
@inject BstSimulation Tree
@inject LearningSessionStore LearningStore
@inject PracticeProgressStore PracticeProgress

<PageTitle>Binary Search Tree Lab — Algorithm Visualizer</PageTitle>

<div class="bst-page">
    <section class="learn-launchpad" aria-labelledby="bst-learn-title">
        <div class="learn-copy">
            <span class="section-kicker">LEARN FIRST</span>
            <h2 id="bst-learn-title">One comparison decides the next branch.</h2>
            <p>A BST repeats one rule: smaller goes left, larger goes right. Search, insert, and delete all depend on that ordering. This lab also lets you explicitly rebalance an existing BST so you can compare shape before and after.</p>
            <ConceptLink Href="/learn/concepts/bst-balancing">Open BST height &amp; balancing →</ConceptLink>
        </div>
        <div class="learn-grid">
            <article class="learn-card purple"><span>ORDER</span><strong>left &lt; node &lt; right</strong><small>This lab rejects duplicate keys so the invariant stays strict.</small></article>
            <article class="learn-card mint"><span>SEARCH</span><strong>Discard a whole side</strong><small>Each comparison chooses only one child link to follow.</small></article>
            <article class="learn-card blue"><span>DELETE</span><strong>3 structural cases</strong><small>Leaf, one child, or two children with an in-order successor.</small></article>
            <article class="learn-card gold"><span>BALANCE</span><strong>Shape controls h</strong><small>A normal BST does not self-balance. The explicit DSW action lets you repair a skewed shape and watch the references rotate.</small></article>
        </div>
    </section>

    <header class="module-header">
        <div class="header-copy">
            <div class="module-eyebrow">
                <span>DATA STRUCTURES</span>
                <span class="separator">/</span>
                <span class="live-status"><i></i> Interactive lab</span>
            </div>
            <h1>Binary Search Tree</h1>
            <p>Build the tree yourself, inspect each comparison, then switch to Memory state to see the node references behind the drawing.</p>
        </div>
        <div class="complexity-summary">
            <div><span>SEARCH</span><strong>O(h)</strong><small>follow one root-to-node path</small></div>
            <div><span>INSERT</span><strong>O(h)</strong><small>find one empty child link</small></div>
            <div><span>DELETE</span><strong>O(h)</strong><small>search + local rewiring</small></div>
            <div><span>BALANCE</span><strong>O(n)</strong><small>DSW vine + compression</small></div>
        </div>
    </header>

    <section class="smart-tip" aria-label="BST learning tip">
        <span class="tip-icon">✦</span>
        <div>
            <strong>Before every step:</strong>
            <p>compare the target with the highlighted node and predict whether the next link will be left or right.</p>
        </div>
        <ConceptLink Href="/learn/concepts/big-o">Why height changes the cost →</ConceptLink>
    </section>

    <section class="lab-shell">
        <div class="lab-heading">
            <div>
                <span class="section-kicker">PLAYGROUND</span>
                <h2>Build a shape, then test its paths.</h2>
            </div>
            <div class="lab-options">
                @if (_lastResult is not null)
                {
                    <button class="last-run-button" type="button" @onclick="OpenLastRunPopup">Last run explanation</button>
                }
                <label class="popup-toggle">
                    <input type="checkbox" checked="@_showRunPopups" @onchange="ToggleRunPopups" />
                    <span>Result popups</span>
                </label>
            </div>
        </div>

        <section class="operation-panel" aria-label="Binary Search Tree operations">
            <div class="value-card">
                <label>
                    <span class="control-label">VALUE / KEY</span>
                    <InputNumber TValue="int?" @bind-Value="_value" disabled="@IsBusy" placeholder="e.g. 50" />
                </label>
                <small>The same number cannot be inserted twice in this BST.</small>
                <div class="sample-values" aria-label="Suggested BST values">
                    <span>Try:</span>
                    @foreach (var sample in SampleValues)
                    {
                        <button type="button" @onclick="() => SetValue(sample)" disabled="@IsBusy">@sample</button>
                    }
                </div>
            </div>

            <div class="operation-card insert-card">
                <div class="operation-heading"><span class="operation-glyph">+</span><span><strong>Insert</strong><small>Find an empty ordered link</small></span></div>
                <button class="primary-action" type="button" @onclick="InsertAsync" disabled="@(!CanRunValueOperation)">Insert value <span>↘</span></button>
            </div>

            <div class="operation-card search-card">
                <div class="operation-heading"><span class="operation-glyph">?</span><span><strong>Search</strong><small>Follow one comparison path</small></span></div>
                <button type="button" @onclick="SearchAsync" disabled="@(!CanRunValueOperation)">Search value <span>→</span></button>
            </div>

            <div class="operation-card delete-card">
                <div class="operation-heading"><span class="operation-glyph">−</span><span><strong>Delete</strong><small>Handle the node's child case</small></span></div>
                <button class="delete-action" type="button" @onclick="DeleteAsync" disabled="@(!CanRunValueOperation)">Delete value <span>×</span></button>
            </div>

            <div class="operation-card reset-card">
                <div class="operation-heading"><span class="operation-glyph">↺</span><span><strong>Reset tree</strong><small>Start another shape</small></span></div>
                <button type="button" @onclick="ClearTreeAsync" disabled="@IsBusy">Clear BST</button>
            </div>

            <div class="operation-card balance-card">
                <div class="operation-heading"><span class="operation-glyph">⇄</span><span><strong>Balance BST</strong><small>Run Day–Stout–Warren</small></span></div>
                <button class="balance-action" type="button" @onclick="BalanceTreeAsync" disabled="@(!CanBalanceTree)">Balance tree</button>
            </div>
        </section>

        <div class="sample-sequence">
            <span class="section-kicker">GOOD FIRST TREE</span>
            <p>Insert <strong>50, 30, 70, 20, 40, 60, 80</strong> for delete cases. To test balancing, reset and insert <strong>10, 20, 30, 40, 50, 60, 70</strong>, note the height, then run <strong>Balance BST</strong>.</p>
        </div>

        @if (!string.IsNullOrWhiteSpace(_errorMessage))
        {
            <div class="error-message" role="alert"><span>!</span><p>@_errorMessage</p></div>
        }

        <SimulationToolbar OnPlay="PlayTimelineAsync"
                           OnPause="PauseTimelineAsync"
                           OnStepBack="StepBackAsync"
                           OnStepForward="StepForwardAsync"
                           OnReset="ResetPlaybackAsync"
                           CanStepBack="@CanStepBack"
                           CanStepForwardOverride="@CanStepForward"
                           StepTextOverride="@DisplayedStepText"
                           TimelinePosition="@TimelinePosition"
                           TimelineCount="@TimelineCount" />

        <div class="state-tabs-row">
            <div class="state-tabs" role="tablist" aria-label="BST simulation view">
                <button type="button" role="tab" aria-selected="@(_activeStateView == StateView.Visual)" class="@GetStateTabClass(StateView.Visual)" @onclick="() => SetStateView(StateView.Visual)">Visual state</button>
                <button type="button" role="tab" aria-selected="@(_activeStateView == StateView.Memory)" class="@GetStateTabClass(StateView.Memory)" @onclick="() => SetStateView(StateView.Memory)">Memory state</button>
            </div>
            <p>@(_activeStateView == StateView.Visual
                ? "Visual state places smaller values left and larger values right so the search path is easy to read."
                : "Memory state shows the root reference and each node object's parent, left, and right references. During Balance BST, DSW changes these links with rotations while preserving node IDs and values.")</p>
        </div>

        <div class="lesson-reference-links" aria-label="Concepts and memory links">
            <ConceptLink Href="/learn/concepts/bst">BST concepts →</ConceptLink>
            <ConceptLink Href="/learn/concepts/visual-vs-memory">BST visual vs memory →</ConceptLink>
        </div>

        @if (_activeStateView == StateView.Visual)
        {
            <BstVisualization Root="@DisplayedRoot" Count="@DisplayedCount" Height="@DisplayedHeight" />
        }
        else
        {
            <BstMemoryVisualization Root="@DisplayedRoot" Count="@DisplayedCount" Height="@DisplayedHeight" />
        }
    </section>

    <section class="practice-section" aria-labelledby="practice-title">
        <div class="practice-heading">
            <div>
                <span class="section-kicker">GUIDED PRACTICE</span>
                <h2 id="practice-title">Prove you understand the structure, not just the animation.</h2>
            </div>
            <div class="task-score"><strong>@_completedTaskIds.Count / @PracticeTasks.Count</strong><span>completed</span></div>
        </div>

        @if (_activeTaskId is not null)
        {
            var activeTask = PracticeTasks.First(task => task.Id == _activeTaskId);
            <div class="active-task-banner">
                <span>ACTIVE TASK @activeTask.Id.ToString("00")</span>
                <strong>@activeTask.Title</strong>
                <small>@GetActiveTaskProgressText(activeTask.Id)</small>
            </div>
        }

        <div class="task-grid">
            @foreach (var task in PracticeTasks)
            {
                var completed = _completedTaskIds.Contains(task.Id);
                var active = _activeTaskId == task.Id;
                <PracticeTaskCard TaskId="@task.Id"
                                  Title="@task.Title"
                                  Steps="@task.Steps"
                                  HelpHref="@task.HelpHref"
                                  Completed="@completed"
                                  Active="@active"
                                  Busy="@IsBusy"
                                  HasEvidence="@(GetTaskEvidence(task.Id) is not null)"
                                  Start="@(() => StartTask(task.Id))"
                                  OpenEvidence="@(() => OpenTaskEvidence(task.Id))" />
            }
        </div>
    </section>
    <NextLessonCard Title="Binary Heap"
                    Description="Reuse tree thinking, then learn a complete-tree layout stored by array indexes."
                    Href="/structures/binary-heap"
                    Level="03 · Beginner → Intermediate"
                    LinkLabel="Open Binary Heap lesson" />

</div>

<PracticeEvidencePopup Evidence="@_practiceEvidencePopup" OnClose="CloseTaskEvidence" />

@if (_lastRunPopupOpen && _lastResult is not null)
{
    <div class="run-popup-backdrop" role="presentation" @onclick="CloseLastRunPopup">
        <section class="run-popup" role="dialog" aria-modal="true" aria-labelledby="bst-run-popup-title" @onclick="IgnorePopupClick" @onclick:stopPropagation="true">
            <header>
                <div>
                    <span class="section-kicker">LAST RUN</span>
                    <h2 id="bst-run-popup-title">@GetResultHeadline(_lastResult)</h2>
                </div>
                <button class="popup-close" type="button" @onclick="CloseLastRunPopup" aria-label="Close result explanation">×</button>
            </header>

            <div class="popup-tabs" role="tablist">
                <button type="button" class="@(_popupTab == ResultPopupTab.Run ? "active" : string.Empty)" @onclick="() => _popupTab = ResultPopupTab.Run">What happened</button>
                <button type="button" class="@(_popupTab == ResultPopupTab.Memory ? "active" : string.Empty)" @onclick="() => _popupTab = ResultPopupTab.Memory">Tree shape &amp; memory</button>
            </div>

            @if (_popupTab == ResultPopupTab.Run)
            {
                <div class="popup-body">
                    @if (_lastResult.Operation == BstOperationKind.Balance)
                    {
                        <div class="popup-metrics">
                            <div><span>Vine rotations</span><strong>@_lastResult.VineRotations</strong></div>
                            <div><span>Compression rotations</span><strong>@_lastResult.CompressionRotations</strong></div>
                            <div><span>This run</span><strong>@_lastResult.CurrentRunComplexity</strong></div>
                            <div><span>Height</span><strong>@_lastResult.HeightBefore → @_lastResult.HeightAfter</strong></div>
                        </div>
                    }
                    else
                    {
                        <div class="popup-metrics">
                            <div><span>Node comparisons</span><strong>@_lastResult.Comparisons</strong></div>
                            <div><span>Successor checks</span><strong>@_lastResult.SuccessorChecks</strong></div>
                            <div><span>This run</span><strong>@_lastResult.CurrentRunComplexity</strong></div>
                            <div><span>Worst-case rule</span><strong>@_lastResult.WorstCaseComplexity</strong></div>
                        </div>
                    }
                    <div class="popup-explainer @(_lastResult.Succeeded ? "success" : string.Empty)">
                        <strong>@GetPlainRunSummary(_lastResult)</strong>
                        <p>@GetComplexityExplanation(_lastResult)</p>
                    </div>
                    <a class="popup-learn" href="@GetResultLearnHref(_lastResult)">@GetResultLearnLabel(_lastResult)</a>
                </div>
            }
            else
            {
                <div class="popup-body">
                    <div class="popup-metrics shape">
                        <div><span>Count</span><strong>@_lastResult.InitialCount → @_lastResult.FinalCount</strong></div>
                        <div><span>Height</span><strong>@_lastResult.HeightBefore → @_lastResult.HeightAfter</strong></div>
                        @if (_lastResult.Operation == BstOperationKind.Balance)
                        {
                            <div><span>Total rotations</span><strong>@_lastResult.TotalRotations</strong></div>
                        }
                        else
                        {
                            <div><span>Delete case</span><strong>@GetDeleteCaseLabel(_lastResult.DeleteCase)</strong></div>
                        }
                    </div>
                    <div class="popup-explainer">
                        <strong>@GetMemoryHeadline(_lastResult)</strong>
                        <p>@GetMemoryExplanation(_lastResult)</p>
                    </div>
                    <ConceptLink class="popup-learn" Href="/learn/concepts/visual-vs-memory">Visual state vs Memory state →</ConceptLink>
                </div>
            }

            <footer>
                <label class="popup-toggle inside"><input type="checkbox" checked="@_showRunPopups" @onchange="ToggleRunPopups" /><span>Show automatically after future BST runs</span></label>
            </footer>
        </section>
    </div>
}

@code {
    private const string ModuleKey = "bst";
    private const string CompletedTasksStorageKey = "algorithm-visualizer.bst.completed-tasks.v1";
    private const string PopupSettingStorageKey = "algorithm-visualizer.bst.result-popups.v1";

    private readonly List<RunFrame> _runFrames = [];
    private readonly HashSet<int> _completedTaskIds = [];
    private PracticeModuleProgress _practiceProgress = new();
    private PracticeCompletionEvidence? _practiceEvidencePopup;
    private readonly List<PracticeEvent> _practiceEvents = [];

    private static readonly int[] SampleValues = [50, 30, 70, 20, 40, 60, 80];
    private static readonly IReadOnlyList<PracticeTaskDefinition> PracticeTasks =
    [
        new(1, "Build a real BST", ["Insert at least five different values.", "Use both a left and a right branch.", "Notice that the drawing follows the comparison rule."], "/learn/concepts/bst"),
        new(2, "Search: found and missing", ["Search for one value that exists.", "Search for one value that does not exist.", "Compare where each path stops."], "/learn/concepts/big-o"),
        new(3, "Delete a leaf", ["Build a tree with at least one leaf.", "Delete a node with no children.", "Confirm only its parent link becomes empty."], "/learn/concepts/memory"),
        new(4, "Delete a node with one child", ["Create a node that has exactly one child.", "Delete that parent node.", "Watch its child move into the old position."], "/learn/concepts/memory"),
        new(5, "Delete a node with two children", ["Delete a node that has both left and right children.", "Watch the simulator find the in-order successor.", "Open Memory state after the delete."], "/learn/concepts/visual-vs-memory"),
        new(6, "Try a duplicate key", ["Insert any value once.", "Insert the same value again.", "Confirm the second insert is rejected and Count does not change."], "/learn/concepts/bst"),
        new(7, "Balance a skewed BST", ["Reset and insert increasing values such as 10, 20, 30, 40, 50, 60, 70.", "Run Balance BST and step through vine + compression phases.", "Open Memory state and verify the same node IDs remain while links change."], "/learn/concepts/bst-balancing")
    ];

    private int? _value;
    private string? _errorMessage;
    private string? _lastCapturedStepText;
    private int _frameIndex = -1;
    private bool _showRunPopups = true;
    private bool _lastRunPopupOpen;
    private bool _storageLoaded;
    private bool _memoryOpenedDuringTask;
    private int? _activeTaskId;
    private int _practiceSequence;
    private StateView _activeStateView = StateView.Visual;
    private ResultPopupTab _popupTab = ResultPopupTab.Run;
    private BstOperationResult? _lastResult;

    private bool IsBusy => SimulationState.IsRunning;
    private bool CanRunValueOperation => !IsBusy && _value.HasValue;
    private bool CanBalanceTree => !IsBusy && Tree.Count > 1;
    private bool CanStepBack => _frameIndex > 0;
    private bool CanStepForward => (_runFrames.Count > 0 && _frameIndex < _runFrames.Count - 1) || SimulationState.IsRunning;
    private int TimelineCount => _runFrames.Count;
    private int TimelinePosition => _frameIndex >= 0 ? _frameIndex + 1 : 0;
    private RunFrame? CurrentFrame => _frameIndex >= 0 && _frameIndex < _runFrames.Count ? _runFrames[_frameIndex] : null;
    private string DisplayedStepText => CurrentFrame?.StepText ?? SimulationState.CurrentStepText;
    private BstNodeSnapshot? DisplayedRoot => CurrentFrame is not null ? CurrentFrame.Root : Tree.CreateSnapshot();
    private int DisplayedCount => CurrentFrame?.Count ?? Tree.Count;
    private int DisplayedHeight => CurrentFrame?.Height ?? Tree.Height;

    protected override void OnInitialized()
    {
        SimulationState.Changed += HandleStateChanged;
        Tree.Changed += HandleTreeChanged;
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender || _storageLoaded)
        {
            return;
        }

        _storageLoaded = true;
        try
        {
            _practiceProgress = PracticeProgress.Load(ModuleKey, CompletedTasksStorageKey, PracticeTasks.Select(task => task.Id));
            _completedTaskIds.Clear();
            foreach (var id in _practiceProgress.CompletedTaskIds) _completedTaskIds.Add(id);

            var popupSetting = LearningStore.GetItem(PopupSettingStorageKey);
            if (bool.TryParse(popupSetting, out var showPopups))
            {
                _showRunPopups = showPopups;
            }
        }
        catch
        {
            // The BST lab remains fully usable if session-state restoration fails.
        }

        await InvokeAsync(StateHasChanged);
    }

    private Task InsertAsync() => RunValueResultOperationAsync(BstOperationKind.Insert, Tree.InsertAsync);
    private Task SearchAsync() => RunValueResultOperationAsync(BstOperationKind.Search, Tree.SearchAsync);
    private Task DeleteAsync() => RunValueResultOperationAsync(BstOperationKind.Delete, Tree.DeleteAsync);

    private async Task BalanceTreeAsync()
    {
        if (SimulationState.IsRunning || Tree.Count <= 1)
        {
            return;
        }

        PrepareNewRun();
        var runToken = SimulationState.Start("Starting explicit BST balance with Day-Stout-Warren.");

        try
        {
            var result = await Tree.BalanceAsync(runToken);
            if (!IsCurrentRun(runToken))
            {
                return;
            }

            _lastResult = result;
            RecordPracticeEvent(new PracticeEvent(
                BstOperationKind.Balance, null, result.Succeeded, false, BstDeleteCase.None,
                result.InitialCount, result.FinalCount, HeightBefore: result.HeightBefore, HeightAfter: result.HeightAfter));
            SimulationState.SetCurrentStep("BST balance complete.");
            SimulationState.Complete();
            _popupTab = ResultPopupTab.Run;
            _lastRunPopupOpen = _showRunPopups;
        }
        catch (OperationCanceledException) when (runToken.IsCancellationRequested)
        {
        }
        catch (Exception exception)
        {
            _errorMessage = $"Something went wrong: {exception.Message}";
            if (IsCurrentRun(runToken))
            {
                SimulationState.Complete("The balance run stopped because of an error.");
            }
        }
    }

    private async Task RunValueResultOperationAsync(
        BstOperationKind operationKind,
        Func<int, CancellationToken, Task<BstOperationResult>> operation)
    {
        if (!_value.HasValue)
        {
            _errorMessage = "Enter a number first.";
            await InvokeAsync(StateHasChanged);
            return;
        }

        if (SimulationState.IsRunning)
        {
            return;
        }

        var value = _value.Value;
        PrepareNewRun();
        var runToken = SimulationState.Start($"Starting BST {operationKind.ToString().ToLowerInvariant()} for {value}.");

        try
        {
            var result = await operation(value, runToken);
            if (!IsCurrentRun(runToken))
            {
                return;
            }

            _lastResult = result;
            RecordPracticeEvent(new PracticeEvent(operationKind, value, result.Succeeded, result.DuplicateRejected, result.DeleteCase, result.InitialCount, result.FinalCount));
            SimulationState.SetCurrentStep("Run complete.");
            SimulationState.Complete();
            _popupTab = operationKind == BstOperationKind.Delete ? ResultPopupTab.Memory : ResultPopupTab.Run;
            _lastRunPopupOpen = _showRunPopups;
        }
        catch (OperationCanceledException) when (runToken.IsCancellationRequested)
        {
        }
        catch (Exception exception)
        {
            _errorMessage = $"Something went wrong: {exception.Message}";
            if (IsCurrentRun(runToken))
            {
                SimulationState.Complete("The run stopped because of an error.");
            }
        }
    }

    private async Task ClearTreeAsync()
    {
        if (SimulationState.IsRunning)
        {
            return;
        }

        PrepareNewRun();
        var runToken = SimulationState.Start("Resetting the BST lab.");

        try
        {
            await Tree.ClearAsync(runToken);
            if (IsCurrentRun(runToken))
            {
                SimulationState.SetCurrentStep("Tree reset complete.");
                SimulationState.Complete();
                RecordPracticeEvent(new PracticeEvent(null, null, false, false, BstDeleteCase.None, 0, 0, IsReset: true));
            }
        }
        catch (OperationCanceledException) when (runToken.IsCancellationRequested)
        {
        }
        catch (Exception exception)
        {
            _errorMessage = $"Something went wrong: {exception.Message}";
            if (IsCurrentRun(runToken)) SimulationState.Complete("The reset stopped because of an error.");
        }
    }

    private void PrepareNewRun()
    {
        _errorMessage = null;
        _memoryOpenedDuringTask = _activeStateView == StateView.Memory;
        _lastRunPopupOpen = false;
        _runFrames.Clear();
        _frameIndex = -1;
        _lastCapturedStepText = null;
    }

    private void CaptureFrame()
    {
        var stepText = SimulationState.CurrentStepText;
        if (string.Equals(stepText, _lastCapturedStepText, StringComparison.Ordinal))
        {
            return;
        }

        var wasAtTail = _frameIndex < 0 || _frameIndex == _runFrames.Count - 1;
        _runFrames.Add(new RunFrame(stepText, Tree.CreateSnapshot(), Tree.Count, Tree.Height));
        _lastCapturedStepText = stepText;
        if (wasAtTail)
        {
            _frameIndex = _runFrames.Count - 1;
        }
    }

    private Task PlayTimelineAsync()
    {
        if (_runFrames.Count > 0)
        {
            _frameIndex = _runFrames.Count - 1;
        }

        SimulationState.Resume();
        return InvokeAsync(StateHasChanged);
    }

    private Task PauseTimelineAsync()
    {
        SimulationState.Pause();
        return Task.CompletedTask;
    }

    private Task StepBackAsync()
    {
        if (SimulationState.IsRunning && !SimulationState.IsPaused)
        {
            SimulationState.Pause();
        }

        if (_frameIndex > 0)
        {
            _frameIndex--;
        }

        return InvokeAsync(StateHasChanged);
    }

    private Task StepForwardAsync()
    {
        if (_frameIndex >= 0 && _frameIndex < _runFrames.Count - 1)
        {
            _frameIndex++;
            return InvokeAsync(StateHasChanged);
        }

        if (SimulationState.IsRunning)
        {
            SimulationState.Step();
        }

        return Task.CompletedTask;
    }

    private Task ResetPlaybackAsync()
    {
        SimulationState.Reset();
        _runFrames.Clear();
        _frameIndex = -1;
        _lastCapturedStepText = null;
        return InvokeAsync(StateHasChanged);
    }

    private void SetValue(int value)
    {
        if (!IsBusy)
        {
            _value = value;
            _errorMessage = null;
        }
    }

    private void SetStateView(StateView view)
    {
        _activeStateView = view;
        if (view == StateView.Memory && _lastResult is not null)
        {
            _memoryOpenedDuringTask = true;
            EvaluatePracticeTasks();
        }
    }

    private string GetStateTabClass(StateView view) => _activeStateView == view ? "active" : string.Empty;

    private void StartTask(int taskId)
    {
        if (IsBusy) return;
        _activeTaskId = taskId;
        _memoryOpenedDuringTask = false;
    }

    private void RecordPracticeEvent(PracticeEvent practiceEvent)
    {
        _practiceEvents.Add(practiceEvent with { Sequence = ++_practiceSequence });
        if (_practiceEvents.Count > 256) _practiceEvents.RemoveAt(0);
        EvaluatePracticeTasks();
    }

    private void EvaluatePracticeTasks()
    {
        if (_lastResult is null) return;
        foreach (var task in PracticeTasks)
        {
            if (_completedTaskIds.Contains(task.Id) && GetTaskEvidence(task.Id) is not null && _activeTaskId != task.Id) continue;
            var completed = task.Id switch
            {
                1 => _lastResult.Operation == BstOperationKind.Insert && _lastResult.Succeeded && HasBuiltBranchingTree(),
                2 => _lastResult.Operation == BstOperationKind.Search &&
                     _practiceEvents.Any(e => e.Operation == BstOperationKind.Search && e.Succeeded) &&
                     _practiceEvents.Any(e => e.Operation == BstOperationKind.Search && !e.Succeeded),
                3 => _lastResult.Operation == BstOperationKind.Delete && _lastResult.Succeeded && _lastResult.DeleteCase == BstDeleteCase.Leaf,
                4 => _lastResult.Operation == BstOperationKind.Delete && _lastResult.Succeeded && _lastResult.DeleteCase == BstDeleteCase.OneChild,
                5 => _memoryOpenedDuringTask && _lastResult.Operation == BstOperationKind.Delete && _lastResult.Succeeded && _lastResult.DeleteCase == BstDeleteCase.TwoChildren,
                6 => _lastResult.Operation == BstOperationKind.Insert && _lastResult.DuplicateRejected,
                7 => _memoryOpenedDuringTask && _lastResult.Operation == BstOperationKind.Balance && _lastResult.Succeeded && _lastResult.HeightAfter < _lastResult.HeightBefore,
                _ => false
            };
            if (completed) CompletePracticeTask(task, _lastResult);
        }
    }

    private void CompletePracticeTask(PracticeTaskDefinition task, BstOperationResult result)
    {
        var evidence = new PracticeCompletionEvidence(
            task.Id,
            task.Title,
            GetResultHeadline(result),
            GetPlainRunSummary(result),
            GetMemoryExplanation(result),
            GetComplexityExplanation(result),
            [
                new("Operation", result.Operation.ToString()),
                new("Count", $"{result.InitialCount} → {result.FinalCount}"),
                new("Height", $"{result.HeightBefore} → {result.HeightAfter}"),
                new("Delete case", GetDeleteCaseLabel(result.DeleteCase))
            ],
            $"Target value {result.RequestedValue}");
        _completedTaskIds.Add(task.Id);
        PracticeProgress.Complete(ModuleKey, _practiceProgress, task.Id, evidence);
        if (_activeTaskId == task.Id) _activeTaskId = null;
    }

    private PracticeCompletionEvidence? GetTaskEvidence(int taskId) => PracticeProgress.GetEvidence(_practiceProgress, taskId);
    private void OpenTaskEvidence(int taskId) => _practiceEvidencePopup = GetTaskEvidence(taskId);
    private void CloseTaskEvidence() => _practiceEvidencePopup = null;

    private bool HasBuiltBranchingTree()
    {
        var successfulInserts = _practiceEvents
            .Where(e => e.Operation == BstOperationKind.Insert && e.Succeeded && e.Value.HasValue)
            .Select(e => e.Value!.Value)
            .ToArray();

        if (successfulInserts.Length < 5)
        {
            return false;
        }

        var first = successfulInserts[0];
        return successfulInserts.Any(value => value < first) && successfulInserts.Any(value => value > first);
    }

    private string GetActiveTaskProgressText(int taskId) => taskId switch
    {
        1 => "Insert five unique values and make sure at least one goes left and one goes right of the first value.",
        2 => "Complete one successful Search and one Search that reaches an empty link.",
        3 => "You need one successful Delete whose result says Leaf.",
        4 => "You need one successful Delete whose result says One child.",
        5 => _memoryOpenedDuringTask ? "Memory state opened — finish a successful two-child Delete." : "Finish a two-child Delete, then open Memory state.",
        6 => "Insert a value, then insert that exact value again.",
        7 => _memoryOpenedDuringTask
            ? "Memory state opened — finish a Balance BST run that reduces tree height."
            : "Build a skewed tree, run Balance BST, then open Memory state to inspect the rewired references.",
        _ => string.Empty
    };

