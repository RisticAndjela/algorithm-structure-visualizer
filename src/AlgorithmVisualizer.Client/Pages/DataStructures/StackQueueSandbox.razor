@page "/structures/queue-stack"
@implements IDisposable
@inject SimulationState SimulationState
@inject StackSimulation Stack
@inject QueueSimulation Queue

<PageTitle>Queue & Stack Lab — Algorithm Visualizer</PageTitle>

<div class="sandbox-page">
    <header class="module-header">
        <div class="header-copy">
            <div class="module-eyebrow">
                <span>DATA STRUCTURES</span>
                <span class="separator">/</span>
                <span class="live-status"><i></i> Interactive lab</span>
            </div>
            <h1>Queue &amp; Stack</h1>
            <p>Learn how order changes behavior. Run real mutations, control the pace, and watch each pointer move before the next state is committed.</p>
        </div>
        <div class="concept-summary">
            <div><span>STACK</span><strong>LIFO</strong><small>Last in, first out</small></div>
            <div><span>QUEUE</span><strong>FIFO</strong><small>First in, first out</small></div>
            <div><span>CORE OPS</span><strong>O(1)</strong><small>Push / pop / enqueue / dequeue</small></div>
        </div>
    </header>

    <section class="smart-tip" aria-label="Learning tip">
        <span class="smart-tip-icon">✦</span>
        <div>
            <strong>Predict before you click.</strong>
            <p>Choose a value and say where it will appear before running the operation. Then use <b>Step</b> to check your mental model one state change at a time.</p>
        </div>
        <div class="tip-question"><span>ASK YOURSELF</span><strong>Which end can this structure modify?</strong></div>
    </section>

    <section class="lab-shell">
        <div class="lab-heading">
            <div>
                <span class="section-kicker">PLAYGROUND</span>
                <h2>Build a state, then inspect how it changes.</h2>
            </div>
            <span class="live-pill"><i></i> Runtime connected</span>
        </div>

        <section class="operation-panel" aria-label="Queue and stack operations">
            <div class="value-card">
                <label class="value-input">
                    <span class="control-label">VALUE</span>
                    <InputNumber TValue="int?" @bind-Value="_newValue" disabled="@IsBusy" placeholder="e.g. 8" />
                </label>
                <small>One integer can be sent to either structure.</small>
            </div>

            <div class="operation-group stack-operations">
                <div class="operation-title">
                    <span class="operation-glyph stack-glyph" aria-hidden="true">S</span>
                    <span><strong>Stack</strong><small>Operate only at the top</small></span>
                </div>
                <div class="operation-actions">
                    <button class="action-primary" type="button" @onclick="PushAsync" disabled="@(!CanAddValue)">Push <span>↑</span></button>
                    <button type="button" @onclick="PopAsync" disabled="@IsBusy">Pop <span>↓</span></button>
                    <button class="action-quiet" type="button" @onclick="ClearStackAsync" disabled="@IsBusy">Clear</button>
                </div>
            </div>

            <div class="operation-group queue-operations">
                <div class="operation-title">
                    <span class="operation-glyph queue-glyph" aria-hidden="true">Q</span>
                    <span><strong>Queue</strong><small>Enter rear, leave front</small></span>
                </div>
                <div class="operation-actions">
                    <button class="action-primary" type="button" @onclick="EnqueueAsync" disabled="@(!CanAddValue)">Enqueue <span>→</span></button>
                    <button type="button" @onclick="DequeueAsync" disabled="@IsBusy">Dequeue <span>→</span></button>
                    <button class="action-quiet" type="button" @onclick="ClearQueueAsync" disabled="@IsBusy">Clear</button>
                </div>
            </div>
        </section>

        @if (!string.IsNullOrWhiteSpace(_errorMessage))
        {
            <div class="error-message" role="alert">
                <span>!</span>
                <p>@_errorMessage</p>
            </div>
        }

        <SimulationToolbar />

        <SimulationViewport>
            <div class="visualization-grid">
                <StackVisualization Elements="Stack.Items" />
                <QueueVisualization Elements="Queue.Items" />
            </div>
        </SimulationViewport>
    </section>

    <section class="learn-below">
        <div class="learn-heading">
            <span class="section-kicker">MAKE IT STICK</span>
            <h2>Same storage idea. Different access rule.</h2>
            <p>The fastest way to distinguish these structures is to stop memorizing names and ask which element is legally accessible next.</p>
        </div>
        <div class="comparison-grid">
            <article>
                <div class="compare-top"><span>01</span><strong>Stack mental model</strong></div>
                <p>Think of a stack of plates. You can add or remove only the plate currently exposed at the top.</p>
                <div class="rule"><span>Rule</span><strong>Newest item leaves first.</strong></div>
            </article>
            <article>
                <div class="compare-top"><span>02</span><strong>Queue mental model</strong></div>
                <p>Think of a line of people. New arrivals join the rear; service always happens from the front.</p>
                <div class="rule"><span>Rule</span><strong>Oldest item leaves first.</strong></div>
            </article>
            <article class="challenge-card">
                <div class="compare-top"><span>✦</span><strong>Try this</strong></div>
                <p>Add <b>3, 7, 2</b> to both structures. Before removing anything, predict the first value each structure will return.</p>
                <div class="rule"><span>Goal</span><strong>Explain the difference without using LIFO/FIFO.</strong></div>
            </article>
        </div>
    </section>
</div>

@code {
    private int? _newValue;
    private string? _errorMessage;

    private bool IsBusy => SimulationState.IsRunning;
    private bool CanAddValue => !IsBusy && _newValue.HasValue;

    protected override void OnInitialized()
    {
        SimulationState.Changed += HandleStateChanged;
        Stack.Changed += HandleStructureChanged;
        Queue.Changed += HandleStructureChanged;
    }

    private Task PushAsync() => RunValueOperationAsync(
        "Starting stack push.",
        (value, token) => Stack.PushAsync(value, token));

    private Task EnqueueAsync() => RunValueOperationAsync(
        "Starting queue enqueue.",
        (value, token) => Queue.EnqueueAsync(value, token));

    private Task PopAsync() => RunOperationAsync(
        "Starting stack pop.",
        token => Stack.PopAsync(token));

    private Task DequeueAsync() => RunOperationAsync(
        "Starting queue dequeue.",
        token => Queue.DequeueAsync(token));

    private Task ClearStackAsync() => RunOperationAsync(
        "Starting stack clear.",
        token => Stack.ClearAsync(token));

    private Task ClearQueueAsync() => RunOperationAsync(
        "Starting queue clear.",
        token => Queue.ClearAsync(token));

    private Task RunValueOperationAsync(
        string initialStepText,
        Func<int, CancellationToken, Task> operation)
    {
        if (!_newValue.HasValue)
        {
            _errorMessage = "Enter an integer value before adding an element.";
            return InvokeAsync(StateHasChanged);
        }

        var value = _newValue.Value;
        _newValue = null;
        return RunOperationAsync(initialStepText, token => operation(value, token));
    }

    private async Task RunOperationAsync(
        string initialStepText,
        Func<CancellationToken, Task> operation)
    {
        if (SimulationState.IsRunning)
        {
            return;
        }

        _errorMessage = null;
        var runToken = SimulationState.Start(initialStepText);

        try
        {
            await operation(runToken);

            if (IsCurrentRun(runToken))
            {
                SimulationState.Complete();
            }
        }
        catch (OperationCanceledException) when (runToken.IsCancellationRequested)
        {
            // Reset or a newer simulation owns the playback state now.
        }
        catch (Exception exception)
        {
            _errorMessage = $"Operation failed: {exception.Message}";

            if (IsCurrentRun(runToken))
            {
                SimulationState.Complete("The operation stopped because of an error.");
            }
        }
    }

    private bool IsCurrentRun(CancellationToken runToken) =>
        !runToken.IsCancellationRequested &&
        SimulationState.SimulationCancellationToken == runToken;

    private void HandleStateChanged() => RequestRender();
    private void HandleStructureChanged() => RequestRender();

    private void RequestRender()
    {
        _ = InvokeAsync(StateHasChanged);
    }

    public void Dispose()
    {
        SimulationState.Changed -= HandleStateChanged;
        Stack.Changed -= HandleStructureChanged;
        Queue.Changed -= HandleStructureChanged;
    }
}
