    private string MultiplicationRuleText => MultiplicationCompatible
        ? $"{Matrix.ColumnsA} = {Matrix.RowsB}, so the result will be {Matrix.RowsA} × {Matrix.ColumnsB}."
        : $"A has {Matrix.ColumnsA} column(s), but B has {Matrix.RowsB} row(s). Try it to see why multiplication stops.";
    private string SolveRuleText => SolveCompatible
        ? $"Ready: A is square and B has {Matrix.RowsB} matching row(s)."
        : "Needs square A, the same number of rows in B, and at most 8 columns in the visual [A | B] workspace.";
    private MatrixWorkspaceSnapshot CurrentSnapshot => Matrix.CreateSnapshot();
    private MatrixWorkspaceSnapshot DisplayedSnapshot => _frameIndex >= 0 && _frameIndex < _runFrames.Count ? _runFrames[_frameIndex].Snapshot : CurrentSnapshot;
    private bool CanStepBack => _frameIndex > 0;
    private bool CanStepForward => (_runFrames.Count > 0 && _frameIndex < _runFrames.Count - 1) || SimulationState.IsRunning;
    private int TimelineCount => _runFrames.Count;
    private int TimelinePosition => _frameIndex >= 0 ? _frameIndex + 1 : 0;
    private string DisplayedStepText => _frameIndex >= 0 && _frameIndex < _runFrames.Count ? _runFrames[_frameIndex].StepText : SimulationState.CurrentStepText;

    protected override void OnInitialized()
    {
        Matrix = new MatrixSimulation(SimulationState);
        SimulationState.Changed += HandleStateChanged;
        Matrix.Changed += HandleMatrixChanged;
        SyncDimensions();
        RefreshProperties();
        SyncBulkTextFromCurrent();
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender) return;
        try
        {
            _practiceProgress = PracticeProgress.Load(ModuleKey, CompletedTasksStorageKey, PracticeTasks.Select(task => task.Id));
            foreach (var id in _practiceProgress.CompletedTaskIds) _completedTasks.Add(id);

            var popupSetting = LearningStore.GetItem(PopupSettingStorageKey);
            if (bool.TryParse(popupSetting, out var showPopups)) _showRunPopups = showPopups;
        }
        catch { }
        await InvokeAsync(StateHasChanged);
