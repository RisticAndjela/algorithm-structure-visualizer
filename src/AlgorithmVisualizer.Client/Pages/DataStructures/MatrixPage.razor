    private void UpdateA(MatrixCellEditRequest edit) => UpdateCell(MatrixSlot.A, edit);
    private void UpdateB(MatrixCellEditRequest edit) => UpdateCell(MatrixSlot.B, edit);

    private void UpdateCell(MatrixSlot slot, MatrixCellEditRequest edit)
    {
        if (IsBusy) return;
        Matrix.SetCell(slot, edit.Row, edit.Column, edit.Value);
        _manualInputError = null;
        _errorMessage = null;
        _lastResult = null;
        RefreshProperties();
        ClearTimeline();
        SyncBulkTextFromCurrent(slot);
        MarkCustomInputChanged(slot);
    }

    private void ApplyMatrixText(MatrixSlot slot)
    {
        if (IsBusy) return;

        var text = slot == MatrixSlot.A ? _matrixAText : _matrixBText;
        if (!TryParseMatrixText(text, out var rows, out var columns, out var values, out var error))
        {
            _manualInputError = $"Matrix {slot}: {error}";
            return;
        }

        Matrix.Resize(slot, rows, columns);
        var index = 0;
        for (var row = 0; row < rows; row++)
        {
            for (var column = 0; column < columns; column++)
            {
                Matrix.SetCell(slot, row, column, values[index++]);
            }
        }

        SyncDimensions();
        RefreshProperties();
        ClearTimeline();
        _lastResult = null;
        _errorMessage = null;
        _manualInputError = null;
        SyncBulkTextFromCurrent(slot);
        MarkCustomInputChanged(slot);
    }

    private void LoadCurrentIntoText(MatrixSlot slot)
    {
        if (IsBusy) return;
        SyncBulkTextFromCurrent(slot);
        _manualInputError = null;
    }

    private void SyncBulkTextFromCurrent(MatrixSlot? slot = null)
    {
        var snapshot = Matrix.CreateSnapshot();
        if (slot is null or MatrixSlot.A) _matrixAText = FormatMatrixText(snapshot.A);
        if (slot is null or MatrixSlot.B) _matrixBText = FormatMatrixText(snapshot.B);
    }

    private static bool TryParseMatrixText(string? text, out int rows, out int columns, out double[] values, out string error)
    {
        rows = 0;
        columns = 0;
        values = Array.Empty<double>();
        error = string.Empty;

        if (string.IsNullOrWhiteSpace(text))
        {
            error = "Enter at least one row of values.";
            return false;
        }

        var rawRows = text.Replace("[", string.Empty).Replace("]", string.Empty)
            .Split(new[] { '\r', '\n', ';' }, StringSplitOptions.RemoveEmptyEntries | StringSplitOptions.TrimEntries);
        if (rawRows.Length is < 1 or > 8)
        {
            error = "Use between 1 and 8 rows.";
            return false;
        }

        var parsedRows = new double[rawRows.Length][];
        for (var row = 0; row < rawRows.Length; row++)
        {
            var tokens = TokenizeMatrixRow(rawRows[row]);
            if (tokens.Length is < 1 or > 8)
            {
                error = $"Row {row + 1} must contain between 1 and 8 values.";
                return false;
            }

            if (row == 0) columns = tokens.Length;
            else if (tokens.Length != columns)
            {
                error = $"Every row must have {columns} values; row {row + 1} has {tokens.Length}.";
                return false;
            }

            parsedRows[row] = new double[columns];
            for (var column = 0; column < columns; column++)
            {
                if (!TryParseFiniteNumber(tokens[column], out var value))
                {
                    error = $"'{tokens[column]}' at row {row + 1}, column {column + 1} is not a valid number.";
                    return false;
                }

                parsedRows[row][column] = value;
            }
        }

        rows = parsedRows.Length;
        values = new double[rows * columns];
        var target = 0;
        for (var row = 0; row < rows; row++)
        {
            for (var column = 0; column < columns; column++) values[target++] = parsedRows[row][column];
        }

        return true;
    }

    private static string[] TokenizeMatrixRow(string row)
    {
        var whitespaceTokens = row.Split((char[]?)null, StringSplitOptions.RemoveEmptyEntries | StringSplitOptions.TrimEntries);
        if (whitespaceTokens.Length > 1)
        {
            for (var i = 0; i < whitespaceTokens.Length; i++) whitespaceTokens[i] = whitespaceTokens[i].Trim().Trim(',');
            return whitespaceTokens;
        }

        return row.Split(',', StringSplitOptions.RemoveEmptyEntries | StringSplitOptions.TrimEntries);
    }

    private static bool TryParseFiniteNumber(string token, out double value)
    {
        var parsed = double.TryParse(token, NumberStyles.Float, CultureInfo.CurrentCulture, out value) ||
                     double.TryParse(token, NumberStyles.Float, CultureInfo.InvariantCulture, out value);
        if (!parsed && token.Contains(',') && !token.Contains('.'))
            parsed = double.TryParse(token.Replace(',', '.'), NumberStyles.Float, CultureInfo.InvariantCulture, out value);
        return parsed && !double.IsNaN(value) && !double.IsInfinity(value);
    }

    private static string FormatMatrixText(MatrixGridSnapshot grid)
    {
        var lines = new string[grid.Rows];
        for (var row = 0; row < grid.Rows; row++)
        {
            var cells = new string[grid.Columns];
            for (var column = 0; column < grid.Columns; column++)
                cells[column] = Math.Round(grid.GetValue(row, column), 6).ToString("0.######", CultureInfo.InvariantCulture);
            lines[row] = string.Join(" ", cells);
        }
        return string.Join(Environment.NewLine, lines);
    }

    private void Resize(MatrixSlot slot)
    {
        if (IsBusy) return;
        var rows = Math.Clamp(slot == MatrixSlot.A ? _rowsA : _rowsB, 1, 8);
        var columns = Math.Clamp(slot == MatrixSlot.A ? _colsA : _colsB, 1, 8);
        Matrix.Resize(slot, rows, columns);
        if (slot == MatrixSlot.A) { _rowsA = rows; _colsA = columns; } else { _rowsB = rows; _colsB = columns; }
        RefreshProperties();
        ClearTimeline();
        SyncBulkTextFromCurrent(slot);
        _lastResult = null;
        _errorMessage = null;
        _manualInputError = null;
    }

    private void LoadPreset(MatrixSlot slot, MatrixPreset preset)
    {
        if (IsBusy) return;
        Matrix.LoadPreset(slot, preset);
        SyncDimensions();
        RefreshProperties();
        ClearTimeline();
        SyncBulkTextFromCurrent(slot);
        _lastResult = null;
        _errorMessage = null;
        _manualInputError = null;
        if (preset == MatrixPreset.GraphAdjacency)
        {
            _graphAdjacencyLoadedDuringTask = true;
            EvaluatePracticeTasks();
        }
    }
    private void CopyAToB() { if (IsBusy) return; Matrix.CopyAToB(); SyncDimensions(); RefreshProperties(); ClearTimeline(); SyncBulkTextFromCurrent(MatrixSlot.B); _lastResult = null; _errorMessage = null; _manualInputError = null; }
    private void SwapAB() { if (IsBusy) return; Matrix.SwapAB(); SyncDimensions(); RefreshProperties(); ClearTimeline(); SyncBulkTextFromCurrent(); _lastResult = null; _errorMessage = null; _manualInputError = null; }
    private void CopyResultTo(MatrixSlot slot) { if (IsBusy) return; Matrix.CopyResultTo(slot); SyncDimensions(); RefreshProperties(); ClearTimeline(); SyncBulkTextFromCurrent(slot); _lastResult = null; _errorMessage = null; _manualInputError = null; }

    private Task ScalarMultiplyAsync() => RunAsync("scalar multiplication", token => Matrix.ScalarMultiplyAsync(_scalar, token));
    private Task PowerAsync() => RunAsync("matrix power", token => Matrix.PowerAsync(_power, token));
    private Task MinorAsync() => RunAsync("minor", token => Matrix.MinorAsync(_minorRow - 1, _minorColumn - 1, token));
    private Task CofactorAsync() => RunAsync("cofactor", token => Matrix.CofactorAsync(_minorRow - 1, _minorColumn - 1, token));
    private Task SwapRowsAsync() => RunAsync("row swap", token => Matrix.SwapRowsAsync(_rowOne - 1, _rowTwo - 1, token), mutatesInput: true);
    private Task ScaleRowAsync() => RunAsync("row scaling", token => Matrix.ScaleRowAsync(_rowOne - 1, _rowFactor, token), mutatesInput: true);
    private Task AddScaledRowAsync() => RunAsync("row replacement", token => Matrix.AddScaledRowAsync(_rowOne - 1, _rowTwo - 1, _rowFactor, token), mutatesInput: true);

    private async Task RunAsync(string name, Func<CancellationToken, Task<MatrixOperationResult>> operation, bool mutatesInput = false)
    {
        if (IsBusy) return;
        _errorMessage = null;
        _lastResult = null;
        _lastRunPopupOpen = false;
        ClearTimeline();
        var token = SimulationState.Start($"Starting matrix {name}.");
        try
        {
            var result = await operation(token);
            if (!IsCurrentRun(token)) return;
            _lastResult = result;
            if (!result.Succeeded) _errorMessage = result.Summary;
            if (mutatesInput)
            {
                RefreshProperties();
                SyncBulkTextFromCurrent(MatrixSlot.A);
            }
            RecordPracticeResult(result);
            SimulationState.SetCurrentStep(result.Summary);
            SimulationState.Complete();
            _popupTab = ResultPopupTab.Action;
            _lastRunPopupOpen = _showRunPopups;
        }
        catch (OperationCanceledException) when (token.IsCancellationRequested) { }
        catch (Exception exception)
        {
            _errorMessage = exception.Message;
            if (IsCurrentRun(token)) SimulationState.Complete("The matrix run stopped because of an error.");
        }
    }

    private void CaptureFrame()
    {
        var text = SimulationState.CurrentStepText;
        if (string.Equals(text, _lastCapturedStepText, StringComparison.Ordinal)) return;
        var atTail = _frameIndex < 0 || _frameIndex == _runFrames.Count - 1;
        _runFrames.Add(new RunFrame(text, Matrix.CreateSnapshot()));
        _lastCapturedStepText = text;
        if (atTail) _frameIndex = _runFrames.Count - 1;
    }

    private Task PlayTimelineAsync() { if (_runFrames.Count > 0) _frameIndex = _runFrames.Count - 1; SimulationState.Resume(); return InvokeAsync(StateHasChanged); }
    private Task PauseTimelineAsync() { SimulationState.Pause(); return Task.CompletedTask; }
    private Task StepBackAsync() { if (SimulationState.IsRunning && !SimulationState.IsPaused) SimulationState.Pause(); if (_frameIndex > 0) _frameIndex--; return InvokeAsync(StateHasChanged); }
    private Task StepForwardAsync()
    {
        _steppedDuringTask = true;
        EvaluatePracticeTasks();
        if (_frameIndex >= 0 && _frameIndex < _runFrames.Count - 1) { _frameIndex++; return InvokeAsync(StateHasChanged); }
        if (SimulationState.IsRunning) SimulationState.Step();
        return Task.CompletedTask;
    }
    private Task ResetPlaybackAsync() { SimulationState.Reset(); ClearTimeline(); return InvokeAsync(StateHasChanged); }
    private void SetView(StateView view)
    {
        _activeView = view;
        if (view == StateView.Memory)
        {
            _memoryOpenedDuringTask = true;
            EvaluatePracticeTasks();
        }
    }

    private void RefreshProperties() { _propertiesA = Matrix.Analyze(MatrixSlot.A); _propertiesB = Matrix.Analyze(MatrixSlot.B); }
    private void SyncDimensions() { var s = Matrix.CreateSnapshot(); _rowsA = s.A.Rows; _colsA = s.A.Columns; _rowsB = s.B.Rows; _colsB = s.B.Columns; }
    private void ClearTimeline() { _runFrames.Clear(); _frameIndex = -1; _lastCapturedStepText = null; }
    private bool IsCurrentRun(CancellationToken token) => !token.IsCancellationRequested && SimulationState.SimulationCancellationToken == token;

    private static string[] PropertyLabels(MatrixProperties p)
    {
        var values = new List<string>();
        values.Add(p.IsSquare ? "Square" : "Rectangular");
        if (p.IsZero) values.Add("Zero");
        if (p.IsIdentity) values.Add("Identity");
        if (p.IsDiagonal) values.Add("Diagonal");
        if (p.IsUpperTriangular) values.Add("Upper triangular");
        if (p.IsLowerTriangular) values.Add("Lower triangular");
        if (p.IsSymmetric) values.Add("Symmetric");
        if (p.Trace.HasValue) values.Add($"trace={Math.Round(p.Trace.Value, 4)}");
        return values.ToArray();
    }

    private void StartTask(int taskId)
    {
        if (IsBusy) return;
        _activeTaskId = taskId;
        _memoryOpenedDuringTask = false;
        _graphAdjacencyLoadedDuringTask = false;
        _customInputChangedDuringTask = false;
        _matrixAEditedDuringTask = false;
        _steppedDuringTask = false;
    }

    private void MarkCustomInputChanged(MatrixSlot slot)
    {
        _customInputChangedDuringTask = true;
        if (slot == MatrixSlot.A) _matrixAEditedDuringTask = true;
        EvaluatePracticeTasks();
    }

    private void RecordPracticeResult(MatrixOperationResult result)
    {
        _practiceResults.Add(result);
        var snapshot = Matrix.CreateSnapshot();
        _practiceRuns.Add(new MatrixPracticeRun(
            result, snapshot.A.Rows, snapshot.A.Columns, snapshot.B.Rows, snapshot.B.Columns,
            _steppedDuringTask, _customInputChangedDuringTask, _matrixAEditedDuringTask, _graphAdjacencyLoadedDuringTask));
        if (_practiceResults.Count > 64) _practiceResults.RemoveRange(0, _practiceResults.Count - 64);
        if (_practiceRuns.Count > 64) _practiceRuns.RemoveRange(0, _practiceRuns.Count - 64);
        EvaluatePracticeTasks();
        _steppedDuringTask = false;
        _customInputChangedDuringTask = false;
        _matrixAEditedDuringTask = false;
    }

    private void EvaluatePracticeTasks()
    {
        foreach (var task in PracticeTasks)
        {
            if (_completedTasks.Contains(task.Id) && GetTaskEvidence(task.Id) is not null && _activeTaskId != task.Id) continue;

            MatrixPracticeRun? run = task.Id switch
            {
                1 => _practiceRuns.LastOrDefault(x => x.Result.Operation == MatrixOperationKind.Multiply && x.Result.Succeeded && x.RowsA == 2 && x.ColumnsA == 3 && x.RowsB == 3 && x.ColumnsB == 4),
                2 => _practiceRuns.LastOrDefault(x => x.Result.Operation == MatrixOperationKind.Add && !x.Result.Succeeded),
                3 => _practiceRuns.LastOrDefault(x => x.Result.Operation == MatrixOperationKind.Multiply && x.Result.Succeeded && x.RowsA == 2 && x.ColumnsA == 2 && x.RowsB == 2 && x.ColumnsB == 2 && x.Stepped),
                4 => _practiceRuns.LastOrDefault(x => x.Result.Operation == MatrixOperationKind.Rref && x.Result.Succeeded && x.RowsA == 3 && x.ColumnsA == 3 && x.MatrixAEdited),
                5 => _practiceRuns.LastOrDefault(x => x.Result.Operation == MatrixOperationKind.Inverse && x.Result.Succeeded && x.RowsA == x.ColumnsA && x.RowsA is 2 or 3),
                6 => _practiceRuns.LastOrDefault(x =>
                    (x.Result.Operation == MatrixOperationKind.Determinant && Math.Abs(x.Result.ScalarResult ?? 1d) < 1e-9) ||
                    (x.Result.Operation == MatrixOperationKind.Inverse && !x.Result.Succeeded && x.Result.Summary.Contains("singular", StringComparison.OrdinalIgnoreCase))),
                9 => _practiceRuns.LastOrDefault(x => x.Result.Succeeded && x.CustomInputChanged),
                _ => null
            };

            if (task.Id == 7 && _graphAdjacencyLoadedDuringTask && _memoryOpenedDuringTask)
            {
                CompletePracticeTask(task, run?.Result ?? _lastResult, "Graph adjacency preset + Memory state");
                continue;
            }
            if (task.Id == 8 && _memoryOpenedDuringTask)
            {
                CompletePracticeTask(task, run?.Result ?? _lastResult, "Row-major Memory state inspected");
                continue;
            }
            if (run is not null) CompletePracticeTask(task, run.Result, $"A={run.RowsA}×{run.ColumnsA}, B={run.RowsB}×{run.ColumnsB}");
        }
    }

    private void CompletePracticeTask(PracticeTask task, MatrixOperationResult? result, string caseSummary)
    {
        PracticeCompletionEvidence evidence;
        if (result is not null)
        {
            evidence = new PracticeCompletionEvidence
            {
                TaskId = task.Id, TaskTitle = task.Title, Headline = GetActionHeadline(result),
                ActionExplanation = GetActionExplanation(result), MemoryExplanation = GetMemoryExplanation(result),
                WhyItMatters = GetWhyExplanation(result), CaseSummary = caseSummary,
                Metrics = [new("Operation", result.Operation.ToString()), new("Status", result.Succeeded ? "Completed" : "Rejected"), new("Arithmetic ops", result.ArithmeticOperations.ToString()), new("Row ops", result.RowOperations.ToString()), new("Complexity", result.Complexity)]
            };
        }
        else
        {
            var snapshot = Matrix.CreateSnapshot();
            evidence = new PracticeCompletionEvidence
            {
                TaskId = task.Id, TaskTitle = task.Title, Headline = caseSummary,
                ActionExplanation = "The required matrix view/state was reached through normal interaction, so the task auto-completed without requiring an exact preset sequence beyond its learning goal.",
                MemoryExplanation = "Memory state maps every matrix coordinate to the contiguous row-major backing array with index = row × columns + column.",
                WhyItMatters = "The task checks the concept demonstrated by the current state instead of requiring one hardcoded click sequence.",
                CaseSummary = caseSummary, Metrics = [new("A", $"{snapshot.A.Rows}×{snapshot.A.Columns}"), new("B", $"{snapshot.B.Rows}×{snapshot.B.Columns}")]
            };
        }

        PracticeProgress.Complete(ModuleKey, _practiceProgress, task.Id, evidence);
        _completedTasks.Add(task.Id);
        if (_activeTaskId == task.Id) _activeTaskId = null;
    }

    private PracticeCompletionEvidence? GetTaskEvidence(int taskId) => PracticeProgress.GetEvidence(_practiceProgress, taskId);
    private void OpenTaskEvidence(int taskId) => _practiceEvidencePopup = GetTaskEvidence(taskId);
    private void CloseTaskEvidence() => _practiceEvidencePopup = null;

    private string GetActiveTaskProgressText(int taskId) => taskId switch
    {
        1 => $"Need A=2×3, B=3×4, then a successful A×B run. Current A={Matrix.RowsA}×{Matrix.ColumnsA}, B={Matrix.RowsB}×{Matrix.ColumnsB}.",
        2 => "Make A and B incompatible for A+B, then run addition and let the simulator reject the shape mismatch.",
        3 => $"Need two 2×2 inputs, use Step forward during the run, and complete A×B. Current A={Matrix.RowsA}×{Matrix.ColumnsA}, B={Matrix.RowsB}×{Matrix.ColumnsB}, stepped={(_steppedDuringTask ? "yes" : "no")}.",
        4 => $"Need A=3×3, edit at least one value in A during this task, then complete RREF. A edited={(_matrixAEditedDuringTask ? "yes" : "no")}.",
        5 => $"Need a successful inverse for a non-singular 2×2 or 3×3 A. Current A={Matrix.RowsA}×{Matrix.ColumnsA}.",
        6 => "Build a singular A, then run determinant until det(A)=0 or run inverse and observe the singular rejection.",
        7 => $"Load the Graph adjacency preset and open Memory state. Preset loaded={(_graphAdjacencyLoadedDuringTask ? "yes" : "no")}, Memory opened={(_memoryOpenedDuringTask ? "yes" : "no")}.",
        8 => $"Open Memory state and compare row/column positions with the row-major backing slots. Memory opened={(_memoryOpenedDuringTask ? "yes" : "no")}.",
        9 => $"Make a custom edit or apply pasted values, then complete any successful matrix operation. Custom input={(_customInputChangedDuringTask ? "yes" : "no")}.",
        _ => string.Empty
    };

    private void ToggleRunPopups(ChangeEventArgs args)
    {
        _showRunPopups = args.Value is bool boolValue
            ? boolValue
            : bool.TryParse(args.Value?.ToString(), out var parsed) && parsed;

        try
        {
            LearningStore.SetItem(PopupSettingStorageKey, _showRunPopups.ToString());
        }
        catch { }
    }

    private void OpenLastRunPopup()
    {
        if (_lastResult is null) return;
        _popupTab = ResultPopupTab.Action;
        _lastRunPopupOpen = true;
    }

    private void CloseLastRunPopup() => _lastRunPopupOpen = false;
    private static void IgnorePopupClick() { }

    private static string GetActionHeadline(MatrixOperationResult result) => result.Operation switch
    {
        MatrixOperationKind.Multiply => result.Succeeded ? "Each result cell came from one row-column dot product." : "The matrix dimensions do not satisfy the multiplication rule.",
        MatrixOperationKind.Add or MatrixOperationKind.Subtract or MatrixOperationKind.Hadamard => result.Succeeded ? "The operation visited matching cell positions." : "Cell-wise operations require equal matrix shapes.",
        MatrixOperationKind.Ref or MatrixOperationKind.Rref or MatrixOperationKind.Rank => "Pivot selection and row elimination produced the reduced form.",
        MatrixOperationKind.Inverse => result.Succeeded ? "Gauss–Jordan transformed [A|I] until the left side became I." : "A missing pivot exposed a singular matrix.",
        MatrixOperationKind.Determinant => "Elimination reduced determinant work to pivot and row-operation bookkeeping.",
        MatrixOperationKind.Solve => result.Succeeded ? "The augmented system was reduced until the solution block could be read." : "The system did not have the unique solution required by this lab action.",
        MatrixOperationKind.Trace => "Only the main diagonal contributed to the trace.",
        MatrixOperationKind.Transpose => "Rows and columns exchanged roles.",
        MatrixOperationKind.Power => "Repeated matrix multiplication built the requested integer power.",
        MatrixOperationKind.Minor or MatrixOperationKind.Cofactor => "The selected row and column were removed before evaluating the smaller determinant.",
        MatrixOperationKind.SwapRows or MatrixOperationKind.ScaleRow or MatrixOperationKind.AddScaledRow => "One elementary row operation changed A in place.",
        _ => result.Succeeded ? "The simulator completed the matrix operation step by step." : "The simulator rejected the operation before producing an invalid result."
    };

    private static string GetActionExplanation(MatrixOperationResult result)
    {
        var scalar = result.ScalarResult.HasValue ? $" Scalar result: {FormatPopupNumber(result.ScalarResult.Value)}." : string.Empty;
        var integer = result.IntegerResult.HasValue ? $" Integer result: {result.IntegerResult.Value}." : string.Empty;
        return $"{result.Summary} The recorded run used {result.ArithmeticOperations} arithmetic operation(s) and {result.RowOperations} elementary row operation(s), with the teaching complexity shown as {result.Complexity}.{scalar}{integer}";
    }

    private static string GetMemoryExplanation(MatrixOperationResult result) => result.Operation switch
    {
        MatrixOperationKind.Transpose => "Visual state shows values changing row/column position. Memory state shows the resulting matrix again as contiguous row-major slots, where index = row × columns + column.",
        MatrixOperationKind.SwapRows or MatrixOperationKind.ScaleRow or MatrixOperationKind.AddScaledRow => "These actions mutate Matrix A itself. The grid changes mathematically, and the same changed values occupy A's row-major backing-array slots immediately afterward.",
        MatrixOperationKind.Ref or MatrixOperationKind.Rref or MatrixOperationKind.Determinant or MatrixOperationKind.Inverse or MatrixOperationKind.Solve or MatrixOperationKind.Rank => "The elimination workspace is still stored as a flat row-major array. Pivot, candidate and eliminated colors are simulation state; they do not create a different matrix data structure.",
        _ => "A matrix coordinate is converted to one flat storage slot with index = row × columns + column. The visual grid is easier to reason about, while Memory state exposes the contiguous array used by ManualMatrix."
    };

    private static string GetWhyHeadline(MatrixOperationResult result) => result.Operation switch
    {
        MatrixOperationKind.Multiply => "Matrix multiplication is the bridge to transforms, graphs and machine learning.",
        MatrixOperationKind.Ref or MatrixOperationKind.Rref or MatrixOperationKind.Inverse or MatrixOperationKind.Solve or MatrixOperationKind.Rank => "Row operations turn systems and matrix properties into a sequence of local, explainable steps.",
        MatrixOperationKind.Determinant => "The determinant tells you whether a square matrix collapses information or stays invertible.",
        MatrixOperationKind.Transpose => "Transpose changes orientation without changing the underlying set of values.",
        MatrixOperationKind.Trace => "Trace compresses the main diagonal into one useful scalar.",
        _ => "The operation teaches how matrix shape controls what calculations are legal."
    };

    private static string GetWhyExplanation(MatrixOperationResult result) => result.Operation switch
    {
        MatrixOperationKind.Multiply => "The row-column rule is reused in graphics transformations, neural-network layers, linear systems and many graph formulations. That is why dimension compatibility is part of the algorithm, not just input validation.",
        MatrixOperationKind.Add or MatrixOperationKind.Subtract or MatrixOperationKind.Hadamard => "Cell-wise operations compare the same coordinates, so equal dimensions are a structural requirement. The rejected case is useful because it makes that rule visible instead of silently reshaping data.",
        MatrixOperationKind.Inverse => "An inverse exists only when the matrix is non-singular. Watching Gauss–Jordan fail at a missing pivot makes the mathematical condition concrete.",
        MatrixOperationKind.Ref or MatrixOperationKind.Rref or MatrixOperationKind.Solve or MatrixOperationKind.Rank => "Gaussian elimination is one reusable mechanism behind solving systems, identifying pivots, measuring rank and constructing inverses.",
        MatrixOperationKind.Determinant => "A zero determinant signals singularity. That links directly to inverse existence and to whether a linear transformation preserves full dimensional information.",
        MatrixOperationKind.Transpose => "Transpose appears whenever rows and columns change roles, including dot products, covariance calculations and graph adjacency reasoning.",
        MatrixOperationKind.Power => "Repeated powers model repeated linear transformations and repeated transition steps; the simulation makes the repeated multiplication cost explicit.",
        MatrixOperationKind.Minor or MatrixOperationKind.Cofactor => "Minors and cofactors expose how a larger determinant can be decomposed into smaller determinant problems.",
        MatrixOperationKind.SwapRows or MatrixOperationKind.ScaleRow or MatrixOperationKind.AddScaledRow => "These are the legal building blocks of Gaussian elimination, so practicing them directly makes REF, RREF, inverse and solve easier to understand.",
        _ => "Matrices appear anywhere data is organized by two coordinates. The lab keeps both the mathematical rule and the concrete storage visible."
    };

    private static string FormatPopupNumber(double value) => Math.Round(value, 6).ToString("0.######", CultureInfo.InvariantCulture);

    private async Task PersistTasksAsync()
    {
        try { LearningStore.SetItem(CompletedTasksStorageKey, JsonSerializer.Serialize(_completedTasks.OrderBy(x => x).ToArray())); } catch { }
    }

    private void HandleStateChanged() { if (SimulationState.IsRunning) CaptureFrame(); RequestRender(); }
    private void HandleMatrixChanged() => RequestRender();
    private void RequestRender() => _ = InvokeAsync(StateHasChanged);
    public void Dispose() { SimulationState.Changed -= HandleStateChanged; Matrix.Changed -= HandleMatrixChanged; }

    private sealed record RunFrame(string StepText, MatrixWorkspaceSnapshot Snapshot);
    private sealed record MatrixPracticeRun(MatrixOperationResult Result, int RowsA, int ColumnsA, int RowsB, int ColumnsB, bool Stepped, bool CustomInputChanged, bool MatrixAEdited, bool GraphAdjacencyLoaded);
    private sealed record PracticeTask(int Id, string Title, string Description, string HelpHref);
    private enum StateView { Visual, Memory }
    private enum ResultPopupTab { Action, Memory, Why }
}
