    private bool IsBusy => SimulationState.IsRunning;
    private bool SameShape => Matrix.RowsA == Matrix.RowsB && Matrix.ColumnsA == Matrix.ColumnsB;
    private bool MultiplicationCompatible => Matrix.ColumnsA == Matrix.RowsB;
    private bool ASquare => Matrix.RowsA == Matrix.ColumnsA;
    private bool SolveCompatible => ASquare && Matrix.RowsB == Matrix.RowsA && Matrix.ColumnsA + Matrix.ColumnsB <= 8;
    private string AdditionRuleText => SameShape
        ? $"Current shapes match: {Matrix.RowsA} × {Matrix.ColumnsA}."
