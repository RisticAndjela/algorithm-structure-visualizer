@page "/structures/matrix"
@using System.Text.Json
@using System.Globalization
@using AlgorithmVisualizer.Core.DataStructures.Matrix
@using AlgorithmVisualizer.Client.Components.Visualization.Matrix
@implements IDisposable
@inject SimulationState SimulationState
@inject LearningSessionStore LearningStore
@inject PracticeProgressStore PracticeProgress

<PageTitle>Matrix — Algorithm Visualizer</PageTitle>

<div class="matrix-page">
    <section class="learn-launchpad" aria-labelledby="matrix-learn-title">
        <div class="learn-copy">
            <span class="section-kicker">LEARN FIRST</span>
            <h2 id="matrix-learn-title">A matrix is just a table of numbers with rules.</h2>
            <p>
                Start with the shape: <strong>rows × columns</strong>. Then watch one operation at a time.
                You do not need to memorize formulas before using this lab — the simulator shows which cells are read, what is written, and why an operation is valid or invalid.
            </p>
            <div class="learn-actions">
                <a class="primary-link" href="#matrix-workspace">Start with the matrices ↓</a>
                <ConceptLink Href="/learn/concepts/matrix">Matrix concepts &amp; memory →</ConceptLink>
            </div>
        </div>
        <div class="matrix-intuition" aria-label="Simple 2 by 3 matrix example">
            <div class="intuition-title"><span>2 × 3</span><strong>2 rows · 3 columns</strong></div>
            <div class="intuition-grid">
                <span>1</span><span>2</span><span>3</span>
                <span>4</span><span>5</span><span>6</span>
            </div>
            <div class="intuition-notes">
                <span><i class="row-dot"></i>Rows go left → right</span>
                <span><i class="column-dot"></i>Columns go top ↓ bottom</span>
            </div>
            <p>Cell <strong>[2,3]</strong> is the value <strong>6</strong>: row 2, column 3.</p>
        </div>
    </section>

    <header class="module-header">
        <div class="header-copy">
            <div class="module-eyebrow"><span>DATA STRUCTURES</span><span class="separator">/</span><span class="live-status"><i></i> Interactive</span></div>
            <h1>Matrix</h1>
            <p>Build A and B, choose one operation, then follow the calculation cell by cell.</p>
        </div>
        <div class="learning-path" aria-label="Matrix lab workflow">
            <div class="path-step"><span>1</span><div><strong>Build</strong><small>Edit the numbers</small></div></div>
            <div class="path-arrow" aria-hidden="true">→</div>
            <div class="path-step"><span>2</span><div><strong>Choose</strong><small>Pick one operation</small></div></div>
            <div class="path-arrow" aria-hidden="true">→</div>
            <div class="path-step"><span>3</span><div><strong>Watch</strong><small>Step through the result</small></div></div>
        </div>
    </header>

    <section id="matrix-workspace" class="guided-section build-section" aria-labelledby="build-title">
        <div class="section-heading-row">
            <div class="section-heading-copy">
                <span class="step-number">1</span>
                <div><span class="section-kicker">BUILD THE INPUT</span><h2 id="build-title">Start with the two matrices.</h2><p>Click a cell and type. Resize only when you need a different shape; examples and paste tools stay tucked away until you want them.</p></div>
            </div>
            <div class="shape-checker" aria-label="Current dimension compatibility">
                <div><span>A</span><strong>@Matrix.RowsA × @Matrix.ColumnsA</strong></div>
                <div><span>B</span><strong>@Matrix.RowsB × @Matrix.ColumnsB</strong></div>
                <div class="compatibility-line @(SameShape ? "ready" : "warning")"><i></i><span>A ± B</span><strong>@(SameShape ? "ready" : "needs same shape")</strong></div>
                <div class="compatibility-line @(MultiplicationCompatible ? "ready" : "warning")"><i></i><span>A × B</span><strong>@(MultiplicationCompatible ? $"→ {Matrix.RowsA} × {Matrix.ColumnsB}" : $"needs {Matrix.ColumnsA} = {Matrix.RowsB}")</strong></div>
            </div>
        </div>

        <section class="matrix-editors" aria-label="Editable matrices">
            <article class="editor-card matrix-a-card">
                <header class="editor-header">
                    <div class="matrix-name"><span class="matrix-letter">A</span><div><strong>Matrix A</strong><small>Main input</small></div></div>
                    <div class="shape-controls" aria-label="Resize Matrix A">
                        <label><span>Rows</span><InputNumber TValue="int" @bind-Value="_rowsA" min="1" max="8" disabled="@IsBusy" /></label>
                        <span class="times">×</span>
                        <label><span>Columns</span><InputNumber TValue="int" @bind-Value="_colsA" min="1" max="8" disabled="@IsBusy" /></label>
                        <button class="resize-button" @onclick="() => Resize(MatrixSlot.A)" disabled="@IsBusy">Apply shape</button>
                    </div>
                </header>

                <div class="editor-instruction"><span>Click any white cell</span><p>Type a number, then press Enter or click outside the cell.</p></div>
                <div class="editor-scroll"><MatrixEditor Snapshot="@CurrentSnapshot.A" Disabled="@IsBusy" OnCellChanged="UpdateA" /></div>

                <div class="quick-presets">
                    <span>Try an example</span>
                    <button @onclick="() => LoadPreset(MatrixSlot.A, MatrixPreset.Sequence)" disabled="@IsBusy">1, 2, 3…</button>
                    <button @onclick="() => LoadPreset(MatrixSlot.A, MatrixPreset.Identity)" disabled="@IsBusy">Identity</button>
                    <button @onclick="() => LoadPreset(MatrixSlot.A, MatrixPreset.RandomSmall)" disabled="@IsBusy">Random</button>
                    <button @onclick="() => LoadPreset(MatrixSlot.A, MatrixPreset.Zero)" disabled="@IsBusy">Clear to 0</button>
                </div>

                <div class="property-strip" aria-label="Matrix A properties">
                    <span class="property-label">A is:</span>
                    @foreach (var label in PropertyLabels(_propertiesA))
                    {
                        <span>@label</span>
                    }
                </div>

                <details class="input-more">
                    <summary><span>More ways to fill A</span><small>paste values · special examples</small></summary>
                    <div class="input-more-body">
                        <div class="bulk-entry">
                            <div><strong>Paste a whole matrix</strong><small>One row per line. Spaces or commas are accepted; the shape is detected automatically.</small></div>
                            <textarea @bind="_matrixAText" @bind:event="oninput" disabled="@IsBusy" aria-label="Matrix A bulk values" placeholder="1 2 3&#10;4 5 6"></textarea>
                            <div class="bulk-entry-actions">
                                <button class="primary" @onclick="() => ApplyMatrixText(MatrixSlot.A)" disabled="@IsBusy">Use these values</button>
                                <button @onclick="() => LoadCurrentIntoText(MatrixSlot.A)" disabled="@IsBusy">Copy current A here</button>
                            </div>
                        </div>
                        <div class="special-presets"><span>Special examples</span><button @onclick="() => LoadPreset(MatrixSlot.A, MatrixPreset.Diagonal)" disabled="@IsBusy">Diagonal</button><button @onclick="() => LoadPreset(MatrixSlot.A, MatrixPreset.Symmetric)" disabled="@IsBusy">Symmetric</button><button @onclick="() => LoadPreset(MatrixSlot.A, MatrixPreset.GraphAdjacency)" disabled="@IsBusy">Graph adjacency</button></div>
                    </div>
                </details>
            </article>

            <article class="editor-card matrix-b-card">
                <header class="editor-header">
                    <div class="matrix-name"><span class="matrix-letter">B</span><div><strong>Matrix B</strong><small>Second input</small></div></div>
                    <div class="shape-controls" aria-label="Resize Matrix B">
                        <label><span>Rows</span><InputNumber TValue="int" @bind-Value="_rowsB" min="1" max="8" disabled="@IsBusy" /></label>
                        <span class="times">×</span>
                        <label><span>Columns</span><InputNumber TValue="int" @bind-Value="_colsB" min="1" max="8" disabled="@IsBusy" /></label>
                        <button class="resize-button" @onclick="() => Resize(MatrixSlot.B)" disabled="@IsBusy">Apply shape</button>
                    </div>
                </header>

                <div class="editor-instruction"><span>Click any white cell</span><p>B is needed for A+B, A−B, A⊙B, A×B and A·X=B.</p></div>
                <div class="editor-scroll"><MatrixEditor Snapshot="@CurrentSnapshot.B" Disabled="@IsBusy" OnCellChanged="UpdateB" /></div>

                <div class="quick-presets">
                    <span>Try an example</span>
                    <button @onclick="() => LoadPreset(MatrixSlot.B, MatrixPreset.Identity)" disabled="@IsBusy">Identity</button>
                    <button @onclick="() => LoadPreset(MatrixSlot.B, MatrixPreset.Sequence)" disabled="@IsBusy">1, 2, 3…</button>
                    <button @onclick="() => LoadPreset(MatrixSlot.B, MatrixPreset.RandomSmall)" disabled="@IsBusy">Random</button>
                    <button @onclick="() => LoadPreset(MatrixSlot.B, MatrixPreset.Zero)" disabled="@IsBusy">Clear to 0</button>
                </div>

                <div class="property-strip" aria-label="Matrix B properties">
                    <span class="property-label">B is:</span>
                    @foreach (var label in PropertyLabels(_propertiesB))
                    {
                        <span>@label</span>
                    }
                </div>

                <details class="input-more">
                    <summary><span>More ways to fill B</span><small>paste values · special examples</small></summary>
                    <div class="input-more-body">
                        <div class="bulk-entry">
                            <div><strong>Paste a whole matrix</strong><small>One row per line. Spaces or commas are accepted; the shape is detected automatically.</small></div>
                            <textarea @bind="_matrixBText" @bind:event="oninput" disabled="@IsBusy" aria-label="Matrix B bulk values" placeholder="7 8 9&#10;10 11 12"></textarea>
                            <div class="bulk-entry-actions">
                                <button class="primary" @onclick="() => ApplyMatrixText(MatrixSlot.B)" disabled="@IsBusy">Use these values</button>
                                <button @onclick="() => LoadCurrentIntoText(MatrixSlot.B)" disabled="@IsBusy">Copy current B here</button>
                            </div>
                        </div>
                        <div class="special-presets"><span>Special examples</span><button @onclick="() => LoadPreset(MatrixSlot.B, MatrixPreset.Diagonal)" disabled="@IsBusy">Diagonal</button><button @onclick="() => LoadPreset(MatrixSlot.B, MatrixPreset.Symmetric)" disabled="@IsBusy">Symmetric</button><button @onclick="() => LoadPreset(MatrixSlot.B, MatrixPreset.GraphAdjacency)" disabled="@IsBusy">Graph adjacency</button></div>
                    </div>
                </details>
            </article>
        </section>

        @if (!string.IsNullOrWhiteSpace(_manualInputError))
        {
            <div class="error-message manual-input-error" role="alert"><strong>Check the values.</strong><span>@_manualInputError</span></div>
        }
    </section>

    <section class="guided-section operations-section" aria-labelledby="operations-title">
        <div class="section-heading-row compact-heading">
            <div class="section-heading-copy">
                <span class="step-number">2</span>
                <div><span class="section-kicker">CHOOSE ONE OPERATION</span><h2 id="operations-title">What do you want to see happen?</h2><p>Start with one of the four core ideas. Each card tells you the rule before you run it.</p></div>
            </div>
            <ConceptLink class="concept-link" Href="/learn/concepts/matrix-compatibility">Why dimensions matter →</ConceptLink>
        </div>

        <div class="starter-operation-grid">
            <article class="starter-operation">
                <div class="operation-card-top"><span class="operation-symbol">+</span><span class="status-pill @(SameShape ? "ready" : "warning")">@(SameShape ? "Ready now" : "Shape mismatch")</span></div>
                <h3>Add A + B</h3>
                <p>Add cells in the same position: <strong>[1,1] with [1,1]</strong>, then [1,2] with [1,2], and so on.</p>
                <div class="rule-box"><span>Rule</span><strong>A and B need the same shape.</strong><small>@AdditionRuleText</small></div>
                <button @onclick='() => RunAsync("addition", Matrix.AddAsync)' disabled="@IsBusy">Run A + B <span>O(r·c)</span></button>
            </article>

            <article class="starter-operation featured">
                <div class="operation-card-top"><span class="operation-symbol">×</span><span class="status-pill @(MultiplicationCompatible ? "ready" : "warning")">@(MultiplicationCompatible ? "Ready now" : "Check dimensions")</span></div>
                <h3>Multiply A × B</h3>
                <p>Build each result cell from <strong>one row of A</strong> and <strong>one column of B</strong>.</p>
                <div class="rule-box"><span>Rule</span><strong>A columns = B rows.</strong><small>@MultiplicationRuleText</small></div>
                <button class="primary" @onclick='() => RunAsync("matrix multiplication", Matrix.MultiplyAsync)' disabled="@IsBusy">Run A × B <span>O(r·c·k)</span></button>
            </article>

            <article class="starter-operation">
                <div class="operation-card-top"><span class="operation-symbol">T</span><span class="status-pill ready">Always available</span></div>
                <h3>Transpose A</h3>
                <p>Turn rows into columns. A value at <strong>[row,column]</strong> moves to <strong>[column,row]</strong>.</p>
                <div class="rule-box"><span>Result</span><strong>@Matrix.ColumnsA × @Matrix.RowsA</strong><small>@Matrix.RowsA × @Matrix.ColumnsA becomes @Matrix.ColumnsA × @Matrix.RowsA.</small></div>
                <button @onclick='() => RunAsync("transpose A", token => Matrix.TransposeAsync(MatrixSlot.A, token))' disabled="@IsBusy">Run Aᵀ <span>O(r·c)</span></button>
            </article>

            <article class="starter-operation">
                <div class="operation-card-top"><span class="operation-symbol">R</span><span class="status-pill ready">Step-by-step</span></div>
                <h3>Reduce A to RREF</h3>
                <p>Watch pivots and row operations simplify the matrix until every pivot is isolated.</p>
                <div class="rule-box"><span>Watch for</span><strong>pivot → scale → eliminate</strong><small>This is the mechanism behind solving systems and finding rank.</small></div>
                <button @onclick='() => RunAsync("reduced row echelon form", Matrix.RrefAsync)' disabled="@IsBusy">Run RREF(A) <span>O(n³)</span></button>
            </article>
        </div>

        <details class="all-operations">
            <summary><div><strong>All matrix operations</strong><small>Open when you want transpose B, determinant, inverse, scalar multiplication, minors, solving systems or manual row operations.</small></div><span>Show tools</span></summary>
            <div class="all-operations-body">
                <article class="tool-group">
                    <header><span>Arithmetic</span><p>Operations that combine values or repeat multiplication.</p></header>
                    <div class="tool-buttons">
                        <button @onclick='() => RunAsync("subtraction", Matrix.SubtractAsync)' disabled="@IsBusy"><strong>A − B</strong><small>same-position subtraction</small></button>
                        <button @onclick='() => RunAsync("Hadamard product", Matrix.HadamardAsync)' disabled="@IsBusy"><strong>A ⊙ B</strong><small>element-wise multiplication</small></button>
                        <label class="tool-input"><span>Scalar</span><InputNumber TValue="double" @bind-Value="_scalar" disabled="@IsBusy" /></label>
                        <button @onclick="ScalarMultiplyAsync" disabled="@IsBusy"><strong>scalar × A</strong><small>scale every cell</small></button>
                        <label class="tool-input"><span>Power k</span><InputNumber TValue="int" @bind-Value="_power" min="0" max="8" disabled="@IsBusy" /></label>
                        <button @onclick="PowerAsync" disabled="@IsBusy"><strong>Aᵏ</strong><small>repeated multiplication</small></button>
                    </div>
                </article>

                <article class="tool-group">
                    <header><span>Inspect &amp; transform</span><p>Read a property of A or derive a related matrix.</p></header>
                    <div class="tool-buttons">
                        <button @onclick='() => RunAsync("transpose B", token => Matrix.TransposeAsync(MatrixSlot.B, token))' disabled="@IsBusy"><strong>Bᵀ</strong><small>rows become columns</small></button>
                        <button @onclick='() => RunAsync("trace", Matrix.TraceAsync)' disabled="@IsBusy"><strong>trace(A)</strong><small>sum main diagonal</small></button>
                        <button @onclick='() => RunAsync("determinant", Matrix.DeterminantAsync)' disabled="@IsBusy"><strong>det(A)</strong><small>square matrices only</small></button>
                        <button @onclick='() => RunAsync("inverse", Matrix.InverseAsync)' disabled="@IsBusy"><strong>A⁻¹</strong><small>inverse if non-singular</small></button>
                        <button @onclick='() => RunAsync("rank", Matrix.RankAsync)' disabled="@IsBusy"><strong>rank(A)</strong><small>count independent pivots</small></button>
                        <button @onclick='() => RunAsync("row echelon form", Matrix.RefAsync)' disabled="@IsBusy"><strong>REF(A)</strong><small>forward elimination</small></button>
                    </div>
                    <div class="parameter-row">
                        <span class="parameter-title">Minor / cofactor cell</span>
                        <label>Row <InputNumber TValue="int" @bind-Value="_minorRow" min="1" max="8" disabled="@IsBusy" /></label>
                        <label>Column <InputNumber TValue="int" @bind-Value="_minorColumn" min="1" max="8" disabled="@IsBusy" /></label>
                        <button @onclick="MinorAsync" disabled="@IsBusy">Minor</button>
                        <button @onclick="CofactorAsync" disabled="@IsBusy">Cofactor</button>
                    </div>
                </article>

                <article class="tool-group full-width">
                    <header><span>Systems &amp; row operations</span><p>Use Gaussian elimination as a full algorithm, or perform its elementary steps yourself.</p></header>
                    <div class="solve-strip">
                        <div><strong>Solve A·X = B</strong><span>@SolveRuleText</span></div>
                        <button class="primary" @onclick='() => RunAsync("solve A X = B", Matrix.SolveAsync)' disabled="@IsBusy">Solve system</button>
                    </div>
                    <div class="row-operations-panel">
                        <div class="row-op-explanation"><strong>Manual row operation</strong><span>Choose rows and a factor, then apply exactly one legal elimination step to A.</span></div>
                        <div class="row-operation-grid">
                            <label>Target row <InputNumber TValue="int" @bind-Value="_rowOne" min="1" max="8" disabled="@IsBusy" /></label>
                            <label>Other / source row <InputNumber TValue="int" @bind-Value="_rowTwo" min="1" max="8" disabled="@IsBusy" /></label>
                            <label>Factor <InputNumber TValue="double" @bind-Value="_rowFactor" disabled="@IsBusy" /></label>
                            <button @onclick="SwapRowsAsync" disabled="@IsBusy">@($"Swap R{_rowOne} ↔ R{_rowTwo}")</button>
                            <button @onclick="ScaleRowAsync" disabled="@IsBusy">@($"R{_rowOne} ← {_rowFactor}·R{_rowOne}")</button>
                            <button @onclick="AddScaledRowAsync" disabled="@IsBusy">@($"R{_rowOne} ← R{_rowOne} + {_rowFactor}·R{_rowTwo}")</button>
                        </div>
                    </div>
                </article>
            </div>
        </details>
    </section>

    <section class="guided-section simulation-stage" aria-labelledby="watch-title">
        <div class="section-heading-row compact-heading">
            <div class="section-heading-copy">
                <span class="step-number">3</span>
                <div><span class="section-kicker">WATCH THE ALGORITHM</span><h2 id="watch-title">Follow one step at a time.</h2><p>The colored cells tell you what the algorithm is doing. Use Step forward/back when you want to inspect a calculation slowly.</p></div>
            </div>
            <div class="lab-options">
                @if (_lastResult is not null)
                {
                    <button class="last-run-button" type="button" @onclick="OpenLastRunPopup">Explain last run</button>
                }
                <label class="popup-toggle"><input type="checkbox" checked="@_showRunPopups" @onchange="ToggleRunPopups" /><span>Auto explanation</span></label>
            </div>
        </div>

        @if (!string.IsNullOrWhiteSpace(_errorMessage))
        {
            <div class="error-message" role="alert"><strong>This operation cannot run yet.</strong><span>@_errorMessage</span></div>
        }

        <SimulationToolbar OnPlay="PlayTimelineAsync" OnPause="PauseTimelineAsync" OnStepBack="StepBackAsync" OnStepForward="StepForwardAsync" OnReset="ResetPlaybackAsync"
                           CanStepBack="@CanStepBack" CanStepForwardOverride="@CanStepForward" StepTextOverride="@DisplayedStepText" TimelinePosition="@TimelinePosition" TimelineCount="@TimelineCount" />

        <div class="state-tabs-row">
            <div class="state-tabs" role="tablist"><button class="@(_activeView == StateView.Visual ? "active" : string.Empty)" @onclick="() => SetView(StateView.Visual)">Visual state</button><button class="@(_activeView == StateView.Memory ? "active" : string.Empty)" @onclick="() => SetView(StateView.Memory)">Memory state</button></div>
            <div class="state-context"><p>@DisplayedSnapshot.FocusText</p><div class="lesson-reference-links"><ConceptLink Href="/learn/concepts/matrix">Matrix concepts →</ConceptLink><ConceptLink Href="/learn/concepts/visual-vs-memory">Concepts &amp; memory →</ConceptLink></div></div>
        </div>

        @if (_activeView == StateView.Visual)
        {
            <div class="state-legend" aria-label="Visualization color legend"><span><i class="read"></i><strong>Read</strong> value being used</span><span><i class="write"></i><strong>Write</strong> result being changed</span><span><i class="pivot"></i><strong>Pivot</strong> elimination anchor</span><span><i class="candidate"></i><strong>Row</strong> selected row</span><span><i class="eliminated"></i><strong>Eliminate</strong> value being cleared</span><span><i class="done"></i><strong>Done</strong> completed cell</span></div>
            <div class="visual-workspace">
                <MatrixVisualization Snapshot="@DisplayedSnapshot.A" Title="A" Subtitle="input" />
                <MatrixVisualization Snapshot="@DisplayedSnapshot.B" Title="B" Subtitle="input" />
                <MatrixVisualization Snapshot="@DisplayedSnapshot.Result" Title="@DisplayedSnapshot.ResultLabel" Subtitle="result / algorithm workspace" />
            </div>
        }
        else
        {
            <div class="memory-intro"><strong>Same numbers, different view.</strong><span>The grid is the learner-friendly view. Memory State shows how those values map to row-major storage.</span></div>
            <div class="memory-workspace"><MatrixMemoryVisualization Snapshot="@DisplayedSnapshot.A" Title="A" /><MatrixMemoryVisualization Snapshot="@DisplayedSnapshot.B" Title="B" /><MatrixMemoryVisualization Snapshot="@DisplayedSnapshot.Result" Title="@DisplayedSnapshot.ResultLabel" /></div>
        }

        <details class="continue-tools">
            <summary><div><strong>Continue with this result</strong><small>Reuse matrices without typing them again.</small></div><span>Open helpers</span></summary>
            <div class="workspace-shortcuts"><button @onclick="CopyAToB" disabled="@IsBusy">Copy A → B</button><button @onclick="SwapAB" disabled="@IsBusy">Swap A ↔ B</button><button @onclick="() => CopyResultTo(MatrixSlot.A)" disabled="@IsBusy">Result → A</button><button @onclick="() => CopyResultTo(MatrixSlot.B)" disabled="@IsBusy">Result → B</button></div>
        </details>
    </section>

    <section class="why-section">
        <div><span class="section-kicker">WHY MATRICES MATTER</span><h2>The same grid idea appears in many different subjects.</h2></div>
        <div class="why-grid">
            <article><span>GRAPH</span><h3>Adjacency</h3><p>Cell [i,j] can encode a connection or edge weight between two vertices.</p></article>
            <article><span>3D / GRAPHICS</span><h3>Transforms</h3><p>Rotation, scale and projection use matrix multiplication to transform coordinates.</p></article>
            <article><span>ML / DATA</span><h3>Features &amp; weights</h3><p>Datasets and model parameters are naturally organized as rows and columns.</p></article>
            <article><span>EQUATIONS</span><h3>Linear systems</h3><p>Gaussian elimination turns many equations into a sequence of understandable row operations.</p></article>
        </div>
    </section>

    <section class="practice-section">
        <div class="practice-heading"><div><span class="section-kicker">GUIDED PRACTICE</span><h2>Prove you understand the shape and the steps.</h2></div><div class="task-score"><strong>@_completedTasks.Count / @PracticeTasks.Length</strong><span>completed</span></div></div>
        @if (_activeTaskId is not null)
        {
            var activeTask = PracticeTasks.First(task => task.Id == _activeTaskId.Value);
            <div class="active-task-banner"><span>ACTIVE TASK @activeTask.Id.ToString("00")</span><strong>@activeTask.Title</strong><small>@GetActiveTaskProgressText(activeTask.Id)</small></div>
        }
        <div class="task-grid">
            @foreach (var task in PracticeTasks)
            {
                var completed = _completedTasks.Contains(task.Id);
                var active = _activeTaskId == task.Id;
                <PracticeTaskCard TaskId="@task.Id"
                                  Title="@task.Title"
                                  Description="@task.Description"
                                  HelpHref="@task.HelpHref"
                                  Completed="@completed"
                                  Active="@active"
                                  Busy="@IsBusy"
                                  HasEvidence="@(GetTaskEvidence(task.Id) is not null)"
                                  Start="@(() => StartTask(task.Id))"
                                  OpenEvidence="@(() => OpenTaskEvidence(task.Id))" />
            }
        </div>
    </section>
    <NextLessonCard Title="Graph"
                    Description="Reuse the matrix idea as one graph representation, then compare it with adjacency lists."
                    Href="/structures/graph"
                    Level="08 · Intermediate"
                    LinkLabel="Open Graph lesson" />

</div>

<PracticeEvidencePopup Evidence="@_practiceEvidencePopup" OnClose="CloseTaskEvidence" />

@if (_lastRunPopupOpen && _lastResult is not null)
{
    <div class="run-popup-backdrop" role="presentation" @onclick="CloseLastRunPopup">
        <section class="run-popup" role="dialog" aria-modal="true" aria-labelledby="matrix-run-popup-title" @onclick="IgnorePopupClick" @onclick:stopPropagation="true">
            <header><div><span class="section-kicker">WHAT JUST HAPPENED?</span><h2 id="matrix-run-popup-title">@_lastResult.Summary</h2></div><button class="popup-close" type="button" @onclick="CloseLastRunPopup" aria-label="Close result explanation">×</button></header>
            <div class="popup-tabs" role="tablist"><button type="button" class="@(_popupTab == ResultPopupTab.Action ? "active" : string.Empty)" @onclick="() => _popupTab = ResultPopupTab.Action">Action</button><button type="button" class="@(_popupTab == ResultPopupTab.Memory ? "active" : string.Empty)" @onclick="() => _popupTab = ResultPopupTab.Memory">Memory</button><button type="button" class="@(_popupTab == ResultPopupTab.Why ? "active" : string.Empty)" @onclick="() => _popupTab = ResultPopupTab.Why">Why it matters</button></div>
            @if (_popupTab == ResultPopupTab.Action)
            {
                <div class="popup-body"><div class="popup-metrics"><div><span>Arithmetic ops</span><strong>@_lastResult.ArithmeticOperations</strong></div><div><span>Row ops</span><strong>@_lastResult.RowOperations</strong></div><div><span>Complexity</span><strong>@_lastResult.Complexity</strong></div><div><span>Status</span><strong>@(_lastResult.Succeeded ? "Completed" : "Rejected")</strong></div></div><h3>@GetActionHeadline(_lastResult)</h3><p>@GetActionExplanation(_lastResult)</p></div>
            }
            else if (_popupTab == ResultPopupTab.Memory)
            {
                <div class="popup-body"><h3>The mathematical grid and the backing storage are two views of the same values.</h3><p>@GetMemoryExplanation(_lastResult)</p><ConceptLink class="popup-concept-link" Href="/learn/concepts/visual-vs-memory">Open Concepts &amp; Memory →</ConceptLink></div>
            }
            else
            {
                <div class="popup-body"><h3>@GetWhyHeadline(_lastResult)</h3><p>@GetWhyExplanation(_lastResult)</p><ConceptLink class="popup-concept-link" Href="/learn/concepts/matrix">Open the Matrix concept guide →</ConceptLink></div>
            }
            <footer><label class="popup-toggle inside"><input type="checkbox" checked="@_showRunPopups" @onchange="ToggleRunPopups" /><span>Show automatically after future Matrix runs</span></label></footer>
        </section>
    </div>
}

@code {
