@page "/deep-learning/mlp"
@using System.Globalization
@using AlgorithmVisualizer.Core.MachineLearning.DeepLearning.Common
@using AlgorithmVisualizer.Core.MachineLearning.DeepLearning.Mlp
@implements IDisposable
@inject SimulationState SimulationState
@inject MlpSimulation MlpLab
@inject LearningSessionStore LearningStore
@inject PracticeProgressStore PracticeProgress

<PageTitle>Neural Network / MLP — Deep Learning — Algorithm Visualizer</PageTitle>

<div class="learning-module-page learning-module-shell ml-module-page">
    <section class="learn-launchpad" aria-labelledby="mlp-learn-title">
        <div class="learn-copy"><span class="section-kicker">LEARN FIRST</span><h2 id="mlp-learn-title">An MLP is not one giant formula — it is a sequence of neuron layers.</h2><p>Every hidden neuron reads the same input vector with different weights. Their activation values form a new vector, which the output neuron then reads.</p><ConceptLink class="learn-launchpad-link" Href="/learn/concepts/mlp">Open MLP concepts &amp; memory →</ConceptLink></div>
        <div class="learn-grid"><article class="learn-card purple"><span>1 · INPUT</span><strong>Start with one feature vector.</strong><small>The first layer stores data, not learned activation.</small></article><article class="learn-card blue"><span>2 · HIDDEN</span><strong>Each hidden neuron learns a different weighted view.</strong><small>Different rows of W₁ produce different z values.</small></article><article class="learn-card mint"><span>3 · ACTIVATE</span><strong>The hidden layer becomes a new representation.</strong><small>Its outputs are the next layer's inputs.</small></article><article class="learn-card gold"><span>4 · OUTPUT</span><strong>One final neuron combines hidden features.</strong><small>The output activation turns its score into the model prediction.</small></article></div>
    </section>

    <header class="module-header"><div class="header-copy"><div class="module-eyebrow"><span>DEEP LEARNING · PHASE 2 STEP 10</span><span class="separator">/</span><span class="live-status"><i></i> Interactive</span></div><h1>Neural Network / MLP</h1><p>Trace a one-hidden-layer dense network without hiding the weights, biases, pre-activations, or layer boundaries.</p></div><div class="complexity-summary"><div><span>Forward work</span><strong>Θ(I·H)</strong><small>I inputs × H hidden neurons</small></div><div><span>Parameters</span><strong>I·H + 2H + 1</strong><small>two dense connections + biases</small></div><div><span>Edit during run</span><strong>Restart</strong><small>one forward trace uses fixed weights</small></div></div></header>

    <section class="smart-tip"><span class="tip-icon">✦</span><div><strong>Layer output is a vector.</strong><p>The important jump from one neuron to an MLP is that hidden activations become a reusable representation. The next layer does not read the raw inputs directly.</p></div><ConceptLink Href="/learn/concepts/mlp">See layer memory →</ConceptLink></section>

    <section class="builder-section" aria-labelledby="mlp-build-title">
        <div class="section-heading-row"><div class="heading-with-step"><span class="step-number">1</span><div><span class="section-kicker">BUILD THE NETWORK</span><h2 id="mlp-build-title">Choose a small network you can still inspect neuron by neuron.</h2><p>Presets keep the architecture readable. Advanced settings expose the actual row-major weights.</p></div></div></div>
        <div class="preset-row"><span>TRY AN EXAMPLE</span>@foreach(var preset in Enum.GetValues<Preset>()){<button class="@(preset==_preset?"active":string.Empty)" @onclick="() => LoadPreset(preset)" disabled="@IsBusy">@PresetName(preset)</button>}</div>
        <div class="dl-builder-card">
            <div class="dl-mode-row"><span>HIDDEN ACTIVATION</span>@foreach(var activation in HiddenActivationChoices){<button class="secondary-action @(_hiddenActivation==activation?"active":string.Empty)" @onclick="() => SetHiddenActivation(activation)" disabled="@IsBusy">@ActivationMath.DisplayName(activation)</button>}</div>
            <div class="dl-control-grid two"><label><span>INPUT VECTOR</span><input value="@_inputsText" @oninput="InputsChanged" disabled="@IsBusy" /></label><label><span>HIDDEN NEURONS</span><input value="@_hiddenCount" @oninput="HiddenCountChanged" disabled="@IsBusy" inputmode="numeric" /></label></div>
            <div class="dl-inline-actions"><button class="secondary-action" type="button" @onclick="ToggleAdvanced" disabled="@IsBusy">@(_showAdvanced?"Hide weights":"Inspect / edit weights")</button></div>
            @if(_showAdvanced){<div class="dl-advanced"><div class="dl-control-grid two"><label><span>W₁ · ROW-MAJOR</span><input value="@_hiddenWeightsText" @oninput="HiddenWeightsChanged" disabled="@IsBusy" /></label><label><span>HIDDEN BIASES</span><input value="@_hiddenBiasesText" @oninput="HiddenBiasesChanged" disabled="@IsBusy" /></label><label><span>W₂ · HIDDEN → OUTPUT</span><input value="@_outputWeightsText" @oninput="OutputWeightsChanged" disabled="@IsBusy" /></label><label><span>OUTPUT BIAS</span><input value="@_outputBiasText" @oninput="OutputBiasChanged" disabled="@IsBusy" /></label></div></div>}
            @if(!string.IsNullOrWhiteSpace(_inputError)){<div class="input-error" role="alert"><strong>Check the network.</strong><span>@_inputError</span></div>}
        </div>
    </section>

    <section class="predict-section"><div class="prediction-copy"><span class="step-number">2</span><div><span class="section-kicker">PREDICT FIRST</span><h2>Where will the final sigmoid output land?</h2><p>Choose a probability band before the hidden layer is evaluated.</p></div></div><div class="prediction-card"><div class="prediction-actions"><button class="@PredictionClass(OutputBand.Low)" @onclick="() => SetPrediction(OutputBand.Low)" disabled="@IsBusy">Below 0.33</button><button class="@PredictionClass(OutputBand.Middle)" @onclick="() => SetPrediction(OutputBand.Middle)" disabled="@IsBusy">0.33–0.66</button><button class="@PredictionClass(OutputBand.High)" @onclick="() => SetPrediction(OutputBand.High)" disabled="@IsBusy">Above 0.66</button></div>@if(_predictionAnswered){<p class="prediction-feedback @(_predictionCorrect?"correct":"incorrect")">@PredictionFeedback</p>}</div></section>

    <section class="lab-section">
        <div class="lab-heading"><div class="heading-with-step"><span class="step-number">3</span><div><span class="section-kicker">WATCH THE FORWARD PASS</span><h2>Input vector → hidden representation → output.</h2></div></div><div class="lab-actions"><label class="popup-toggle"><input type="checkbox" checked="@_showRunPopups" @onchange="ToggleRunPopups" /><span>Open explanation after run</span></label>@if(_lastResult is not null){<button class="secondary-action" @onclick="OpenLastRunPopup">Last explanation</button>}<button class="sort-button" @onclick="RunAsync" disabled="@IsBusy"><span>▶</span> Run forward pass</button></div></div>

        <SimulationToolbar Compact="true" OnPlay="PlayTimelineAsync" OnPause="PauseTimelineAsync" OnStepBack="StepBackAsync" OnStepForward="StepForwardAsync" OnReset="ResetPlaybackAsync" CanStepBack="@CanStepBack" CanStepForwardOverride="@CanStepForward" StepTextOverride="@DisplayedStepText" TimelinePosition="@TimelinePosition" TimelineCount="@TimelineCount" />

        <RunMetricStrip Items="@LiveRunMetrics" AriaLabel="MLP live metrics" />

        <div class="state-tabs-row"><div class="state-tabs"><button class="@(_view==StateView.Visual?"active":string.Empty)" @onclick="() => _view=StateView.Visual">Visual state</button><button class="@(_view==StateView.Memory?"active":string.Empty)" @onclick="() => _view=StateView.Memory">Memory state</button></div><p>@ViewExplanation</p></div>

        <div class="state-surface ml-state-surface">@if(_view==StateView.Visual){<div class="ml-visual-board"><MlpNetwork Snapshot="@DisplayedSnapshot" /></div>}else{<div class="dl-memory-grid"><article class="dl-memory-card"><span>INPUT VECTOR</span><strong>@Vector(DisplayedSnapshot.Inputs)</strong><small>ManualVector · @DisplayedSnapshot.Inputs.Length components</small></article><article class="dl-memory-card"><span>W₁ MATRIX</span><strong>@MatrixText(DisplayedSnapshot.HiddenWeights,DisplayedSnapshot.HiddenCount,DisplayedSnapshot.Inputs.Length)</strong><small>ManualMatrix rows = hidden neurons.</small></article><article class="dl-memory-card"><span>HIDDEN z / a</span><strong>@Vector(DisplayedSnapshot.HiddenPreActivations) → @Vector(DisplayedSnapshot.HiddenActivations)</strong><small>The layer caches pre-activations and activation outputs separately.</small></article><article class="dl-memory-card"><span>W₂ + OUTPUT</span><strong>@Vector(DisplayedSnapshot.OutputWeights) · b=@F(DisplayedSnapshot.OutputBias)</strong><small>z=@F(DisplayedSnapshot.OutputPreActivation) → ŷ=@F(DisplayedSnapshot.Output)</small></article></div>}</div>
        <div class="lesson-reference-links"><ConceptLink Href="/learn/concepts/mlp">MLP concepts →</ConceptLink><ConceptLink Href="/learn/concepts/neuron-activations">Review one neuron →</ConceptLink><ConceptLink Href="/structures/matrix">Matrix storage →</ConceptLink></div>

    </section>

    <section class="fit-section"><div class="section-heading-row"><div><span class="section-kicker">WHEN SHOULD I USE IT?</span><h2>Use an MLP when several learned nonlinear features must combine to explain the target.</h2></div></div><div class="fit-grid"><article class="fit-card good"><span>GOOD FIT</span><strong>Dense numeric inputs with nonlinear interactions</strong><p>Hidden neurons can learn different intermediate views and combine them in later layers.</p></article><article class="fit-card avoid"><span>AVOID FOR</span><strong>Small problems where interpretability dominates</strong><p>A tree or linear model can be easier to inspect, validate, and explain when the relationship is simple.</p></article><article class="fit-card better"><span>BETTER ALTERNATIVE</span><strong>Use Decision Tree for explicit threshold rules</strong><p>Use the neuron lesson when you need to isolate one weighted sum. Continue to Backpropagation when the question becomes how weights learn.</p><div class="fit-links"><a href="/ml-foundations/decision-tree">Decision Tree →</a><a href="/deep-learning/backpropagation">Backpropagation →</a></div></article></div></section>

    <section class="practice-section"><div class="practice-heading"><div><span class="section-kicker">GUIDED PRACTICE</span><h2>Read hidden representations instead of only the final output.</h2></div><strong>@_completedTaskIds.Count / @PracticeTasks.Length complete</strong></div><div class="practice-grid">@foreach(var task in PracticeTasks){<PracticeTaskCard TaskId="@task.Id" Title="@task.Title" Description="@task.Goal" InputText="@task.Suggested" HelpHref="/learn/concepts/mlp" Completed="@_completedTaskIds.Contains(task.Id)" Active="@(_activeTaskId==task.Id)" Busy="@IsBusy" HasEvidence="@(GetTaskEvidence(task.Id)is not null)" Start="@(() => StartTask(task.Id))" OpenEvidence="@(() => OpenTaskEvidence(task.Id))" />}</div></section>
    <NextLessonCard Eyebrow="NEXT DEEP-LEARNING LESSON" Level="11 · Interactive" Title="Backpropagation" Description="Reverse the same network: start at loss, compute deltas, then assign a gradient to every weight and bias." Href="/deep-learning/backpropagation" LinkLabel="Open Backpropagation" />
</div>

@if(_lastRunPopupOpen&&_lastResult is not null){<div class="run-popup-backdrop" @onclick="CloseLastRunPopup"><section class="run-popup" role="dialog" aria-modal="true" @onclick:stopPropagation="true"><header><div><span class="section-kicker">LAST RUN</span><h2>Forward output @_lastResult.Output.ToString("0.###")</h2></div><button class="popup-close" @onclick="CloseLastRunPopup">×</button></header><div class="popup-body"><p>@_lastResult.Summary</p><div class="popup-metrics"><div><span>INPUTS</span><strong>@_lastResult.InputCount</strong></div><div><span>HIDDEN</span><strong>@_lastResult.HiddenCount</strong></div><div><span>CONNECTIONS</span><strong>@_lastResult.ConnectionCount</strong></div><div><span>OUTPUT</span><strong>@F(_lastResult.Output)</strong></div></div><p class="popup-memory">The network stores W₁ as a row-major ManualMatrix, hidden vectors as ManualVector values, and W₂ as one output-weight vector. Forward pass never needs a framework neural-network library.</p></div></section></div>}
<PracticeEvidencePopup Evidence="@_practiceEvidencePopup" OnClose="CloseTaskEvidence" />

@code {
    private IReadOnlyList<RunMetricItem> LiveRunMetrics => [new("PHASE", DisplayedSnapshot.Phase.ToString()), new("ACTIVE HIDDEN", DisplayedSnapshot.ActiveHiddenNeuron < 0 ? "—" : $"h{DisplayedSnapshot.ActiveHiddenNeuron + 1}"), new("HIDDEN VECTOR", Vector(DisplayedSnapshot.HiddenActivations)), new("OUTPUT", F(DisplayedSnapshot.Output))];
    private const string ModuleKey="mlp"; private const string PopupKey="algorithm-visualizer.mlp.show-run-popup.v1"; private static readonly ActivationKind[] HiddenActivationChoices=[ActivationKind.ReLU,ActivationKind.Tanh,ActivationKind.Sigmoid]; private readonly List<RunFrame> _frames=[]; private PracticeModuleProgress _practiceProgress=new(); private HashSet<int> _completedTaskIds=[]; private PracticeCompletionEvidence? _practiceEvidencePopup; private MlpRunResult? _lastResult; private string? _lastCapturedStep; private string? _inputError; private string _inputsText="1, -0.5",_hiddenWeightsText="0.8, -0.4, -0.3, 0.9",_hiddenBiasesText="0.1, -0.2",_outputWeightsText="1.1, -0.7",_outputBiasText="0.05";private int _hiddenCount=2;private ActivationKind _hiddenActivation=ActivationKind.ReLU;private Preset? _preset=Preset.Balanced;private bool _showAdvanced,_showRunPopups=true,_lastRunPopupOpen,_predictionAnswered,_predictionCorrect;private OutputBand? _prediction;private int _frameIndex=-1;private int? _activeTaskId;private StateView _view=StateView.Visual;
    private static readonly PracticeTaskDefinition[] PracticeTasks=[new(1,"Clamp one hidden neuron","Use the ReLU gate preset and verify at least one hidden activation is zero.","ReLU gate",Preset.ReluGate),new(2,"Keep signed hidden features","Use tanh and verify the hidden layer contains a negative activation.","Tanh signed",Preset.TanhSigned),new(3,"Add a third hidden feature","Run the three-neuron network and inspect a three-value hidden representation.","3 hidden neurons",Preset.ThreeHidden),new(4,"See sigmoid compression","Use sigmoid hidden units and verify every hidden activation stays between 0 and 1.","Sigmoid hidden",Preset.SigmoidHidden)];
    private MlpSnapshot DisplayedSnapshot=>_frameIndex>=0&&_frameIndex<_frames.Count?_frames[_frameIndex].Snapshot:MlpLab.CreateSnapshot();private string DisplayedStepText=>_frameIndex>=0&&_frameIndex<_frames.Count?_frames[_frameIndex].StepText:SimulationState.CurrentStepText;private bool IsBusy=>SimulationState.IsRunning;private int TimelineCount=>_frames.Count;private int TimelinePosition=>_frameIndex<0?0:_frameIndex+1;private bool CanStepBack=>_frameIndex>0;private bool CanStepForward=>(_frameIndex>=0&&_frameIndex<_frames.Count-1)||SimulationState.IsRunning;private string ViewExplanation=>_view==StateView.Visual?"Read the network layer by layer. The weight panels sit between the vectors they connect.":"Inspect the actual row-major W₁ matrix, hidden z/a vectors, W₂ vector, and output scalars.";private string PredictionFeedback=>_predictionCorrect?"Correct — the final sigmoid landed in that band.":$"The output was {F(_lastResult?.Output??0d)}.";
    protected override void OnInitialized(){SimulationState.Changed+=HandleSimulationChanged;try{_showRunPopups=!bool.TryParse(LearningStore.GetItem(PopupKey),out var saved)||saved;}catch{_showRunPopups=true;}_practiceProgress=PracticeProgress.Load(ModuleKey,null,PracticeTasks.Select(t=>t.Id));_completedTaskIds=_practiceProgress.CompletedTaskIds;ApplyInputs();}
    private void ToggleAdvanced()=>_showAdvanced=!_showAdvanced; private void InputsChanged(ChangeEventArgs e){_inputsText=e.Value?.ToString()??"";_preset=null;ApplyInputs();} private void HiddenCountChanged(ChangeEventArgs e){if(int.TryParse(e.Value?.ToString(),out var n)){_hiddenCount=Math.Clamp(n,1,6);_preset=null;ApplyInputs();}} private void HiddenWeightsChanged(ChangeEventArgs e){_hiddenWeightsText=e.Value?.ToString()??"";_preset=null;ApplyInputs();}private void HiddenBiasesChanged(ChangeEventArgs e){_hiddenBiasesText=e.Value?.ToString()??"";_preset=null;ApplyInputs();}private void OutputWeightsChanged(ChangeEventArgs e){_outputWeightsText=e.Value?.ToString()??"";_preset=null;ApplyInputs();}private void OutputBiasChanged(ChangeEventArgs e){_outputBiasText=e.Value?.ToString()??"";_preset=null;ApplyInputs();}private void SetHiddenActivation(ActivationKind a){if(IsBusy)return;_hiddenActivation=a;_preset=null;ApplyInputs();}private void SetPrediction(OutputBand b){_prediction=b;_predictionAnswered=false;_predictionCorrect=false;}
    private void LoadPreset(Preset p){if(IsBusy)return;_preset=p;switch(p){case Preset.Balanced:_inputsText="1, -0.5";_hiddenCount=2;_hiddenWeightsText="0.8, -0.4, -0.3, 0.9";_hiddenBiasesText="0.1, -0.2";_outputWeightsText="1.1, -0.7";_outputBiasText="0.05";_hiddenActivation=ActivationKind.ReLU;break;case Preset.ReluGate:_inputsText="1, 2";_hiddenCount=2;_hiddenWeightsText="-1, -0.5, 0.6, 0.7";_hiddenBiasesText="0, 0";_outputWeightsText="0.8, 0.8";_outputBiasText="0";_hiddenActivation=ActivationKind.ReLU;break;case Preset.TanhSigned:_inputsText="1, -1";_hiddenCount=2;_hiddenWeightsText="1, 0.2, -0.8, 0.5";_hiddenBiasesText="0, -0.2";_outputWeightsText="0.7, -0.4";_outputBiasText="0.1";_hiddenActivation=ActivationKind.Tanh;break;case Preset.ThreeHidden:_inputsText="1, 0.5";_hiddenCount=3;_hiddenWeightsText="0.8, -0.2, -0.4, 0.9, 0.5, 0.5";_hiddenBiasesText="0.1, 0, -0.1";_outputWeightsText="0.8, -0.5, 0.6";_outputBiasText="0.05";_hiddenActivation=ActivationKind.ReLU;break;case Preset.SigmoidHidden:_inputsText="2, -1";_hiddenCount=2;_hiddenWeightsText="1.2, 0.4, -0.7, 1.1";_hiddenBiasesText="0.2, -0.3";_outputWeightsText="1, 1";_outputBiasText="-0.5";_hiddenActivation=ActivationKind.Sigmoid;break;}ApplyInputs();}
    private void ApplyInputs(){if(!TryVector(_inputsText,out var inputs)||!TryVector(_hiddenWeightsText,out var hw)||!TryVector(_hiddenBiasesText,out var hb)||!TryVector(_outputWeightsText,out var ow)||!double.TryParse(_outputBiasText,NumberStyles.Float,CultureInfo.InvariantCulture,out var ob)){_inputError="Use comma-separated finite numbers and one finite output bias.";return;}try{MlpLab.Configure(new MlpConfiguration(inputs,_hiddenCount,hw,hb,ow,ob,_hiddenActivation,ActivationKind.Sigmoid));_inputError=null;ClearReview();}catch(ArgumentException ex){_inputError=ex.Message;}StateHasChanged();}
    private async Task RunAsync(){ApplyInputs();if(_inputError is not null)return;_frames.Clear();_frameIndex=-1;_lastCapturedStep=null;var token=SimulationState.Start("Starting MLP forward pass.");Capture();try{var r=await MlpLab.ExecuteAsync(token);if(!IsCurrent(token))return;_lastResult=r;SimulationState.Complete(r.Summary);Capture();EvaluatePrediction(r);RecordPractice(r);if(_showRunPopups)OpenLastRunPopup();}catch(OperationCanceledException)when(!IsCurrent(token)){} }
    private void Capture(){var step=SimulationState.CurrentStepText;if(step==_lastCapturedStep)return;var follow=_frameIndex<0||_frameIndex==_frames.Count-1;_frames.Add(new RunFrame(step,MlpLab.CreateSnapshot()));_lastCapturedStep=step;if(follow)_frameIndex=_frames.Count-1;}private void HandleSimulationChanged(){if(SimulationState.IsRunning)Capture();_=InvokeAsync(StateHasChanged);}private bool IsCurrent(CancellationToken t)=>!t.IsCancellationRequested&&SimulationState.SimulationCancellationToken==t;private void ClearReview(){SimulationState.Reset();_frames.Clear();_frameIndex=-1;_lastCapturedStep=null;_lastResult=null;_lastRunPopupOpen=false;_predictionAnswered=false;}
    private Task PlayTimelineAsync(){if(_frames.Count>0)_frameIndex=_frames.Count-1;SimulationState.Resume();return InvokeAsync(StateHasChanged);}private Task PauseTimelineAsync(){SimulationState.Pause();return Task.CompletedTask;}private Task StepBackAsync(){if(SimulationState.IsRunning&&!SimulationState.IsPaused)SimulationState.Pause();if(_frameIndex>0)_frameIndex--;return InvokeAsync(StateHasChanged);}private Task StepForwardAsync(){if(_frameIndex>=0&&_frameIndex<_frames.Count-1){_frameIndex++;return InvokeAsync(StateHasChanged);}if(SimulationState.IsRunning)SimulationState.Step();return Task.CompletedTask;}private Task ResetPlaybackAsync(){SimulationState.Reset();_frames.Clear();_frameIndex=-1;_lastCapturedStep=null;return InvokeAsync(StateHasChanged);}
    private static OutputBand Band(double v)=>v<.33?OutputBand.Low:v>.66?OutputBand.High:OutputBand.Middle;private void EvaluatePrediction(MlpRunResult r){if(_prediction is null)return;_predictionAnswered=true;_predictionCorrect=_prediction==Band(r.Output);}private string PredictionClass(OutputBand b)=>_prediction==b?"active":string.Empty;
    private void ToggleRunPopups(ChangeEventArgs e){_showRunPopups=e.Value is bool b&&b;LearningStore.SetItem(PopupKey,_showRunPopups.ToString());}private void OpenLastRunPopup()=>_lastRunPopupOpen=_lastResult is not null;private void CloseLastRunPopup()=>_lastRunPopupOpen=false;
    private void StartTask(int id){var t=PracticeTasks.First(x=>x.Id==id);_activeTaskId=id;LoadPreset(t.Preset);}private void RecordPractice(MlpRunResult r){if(_activeTaskId is null)return;var t=PracticeTasks.First(x=>x.Id==_activeTaskId);var ok=t.Preset switch{Preset.ReluGate=>r.HiddenActivations.Any(x=>Math.Abs(x)<1e-9),Preset.TanhSigned=>r.HiddenActivations.Any(x=>x<0),Preset.ThreeHidden=>r.HiddenCount==3,Preset.SigmoidHidden=>r.HiddenActivations.All(x=>x>=0&&x<=1),_=>false};if(!ok)return;var ev=new PracticeCompletionEvidence(t.Id,t.Title,r.Summary,$"Hidden layer = {Vector(r.HiddenActivations)}; final output = {F(r.Output)}.","W₁ is a ManualMatrix. Hidden activations and W₂ are ManualVector values; every neuron loop is explicit.","The hidden layer is a learned representation, not just a decorative set of circles.",[new("Hidden",r.HiddenCount.ToString()),new("Hidden a",Vector(r.HiddenActivations)),new("Output",F(r.Output))],$"hidden={Vector(r.HiddenActivations)} · output={F(r.Output)}");_completedTaskIds.Add(t.Id);PracticeProgress.Complete(ModuleKey,_practiceProgress,t.Id,ev);_activeTaskId=null;}
    private PracticeCompletionEvidence? GetTaskEvidence(int id)=>PracticeProgress.GetEvidence(_practiceProgress,id);private void OpenTaskEvidence(int id)=>_practiceEvidencePopup=GetTaskEvidence(id);private void CloseTaskEvidence()=>_practiceEvidencePopup=null;
    private static bool TryVector(string text,out double[] values){var parts=text.Split(',',StringSplitOptions.RemoveEmptyEntries|StringSplitOptions.TrimEntries);values=new double[parts.Length];if(parts.Length<1||parts.Length>40)return false;for(var i=0;i<parts.Length;i++)if(!double.TryParse(parts[i],NumberStyles.Float,CultureInfo.InvariantCulture,out values[i])||!double.IsFinite(values[i]))return false;return true;}private static string Vector(IReadOnlyList<double> v)=>"["+string.Join(", ",v.Select(value => F(value)))+"]";private static string MatrixText(double[] raw,int rows,int cols){var lines=new string[rows];for(var r=0;r<rows;r++){var row=new double[cols];for(var c=0;c<cols;c++)row[c]=raw[r*cols+c];lines[r]=Vector(row);}return string.Join(" · ",lines);}private static string F(double v)=>Math.Abs(v)<1e-10?"0":v.ToString("0.###",CultureInfo.InvariantCulture);private static string PresetName(Preset p)=>p switch{Preset.Balanced=>"Balanced",Preset.ReluGate=>"ReLU gate",Preset.TanhSigned=>"Tanh signed",Preset.ThreeHidden=>"3 hidden",Preset.SigmoidHidden=>"Sigmoid hidden",_=>p.ToString()};public void Dispose()=>SimulationState.Changed-=HandleSimulationChanged;
    private sealed record RunFrame(string StepText,MlpSnapshot Snapshot);private sealed record PracticeTaskDefinition(int Id,string Title,string Goal,string Suggested,Preset Preset);private enum Preset{Balanced,ReluGate,TanhSigned,ThreeHidden,SigmoidHidden}private enum OutputBand{Low,Middle,High}private enum StateView{Visual,Memory}
}
