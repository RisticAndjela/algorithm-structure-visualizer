@page "/deep-learning/neuron-activations"
@using System.Globalization
@using AlgorithmVisualizer.Core.MachineLearning.DeepLearning.Common
@using AlgorithmVisualizer.Core.MachineLearning.DeepLearning.Neuron
@implements IDisposable
@inject SimulationState SimulationState
@inject NeuronSimulation NeuronLab
@inject LearningSessionStore LearningStore
@inject PracticeProgressStore PracticeProgress

<PageTitle>Neuron + Activation Functions — Deep Learning — Algorithm Visualizer</PageTitle>

<div class="learning-module-page learning-module-shell ml-module-page">
    <section class="learn-launchpad" aria-labelledby="neuron-learn-title">
        <div class="learn-copy"><span class="section-kicker">LEARN FIRST</span><h2 id="neuron-learn-title">A neuron does two jobs: build one score, then transform it.</h2><p>First compute <strong>z = w·x + b</strong>. Then an activation decides how that score leaves the neuron. Keeping those two stages separate makes MLPs and Backpropagation much easier to read.</p><ConceptLink class="learn-launchpad-link" Href="/learn/concepts/neuron-activations">Open Neuron + Activations concepts &amp; memory →</ConceptLink></div>
        <div class="learn-grid">
            <article class="learn-card purple"><span>1 · MULTIPLY</span><strong>Each input has its own weight.</strong><small>xᵢ × wᵢ measures that branch's contribution.</small></article>
            <article class="learn-card blue"><span>2 · SUM</span><strong>Add every contribution and bias.</strong><small>The result is the pre-activation z.</small></article>
            <article class="learn-card mint"><span>3 · ACTIVATE</span><strong>Transform the same z.</strong><small>ReLU, sigmoid, tanh, and Leaky ReLU behave differently.</small></article>
            <article class="learn-card gold"><span>4 · COMPARE</span><strong>Range and saturation matter.</strong><small>The activation changes what later layers can represent and learn.</small></article>
        </div>
    </section>

    <header class="module-header"><div class="header-copy"><div class="module-eyebrow"><span>DEEP LEARNING · PHASE 2 STEP 10</span><span class="separator">/</span><span class="live-status"><i></i> Interactive</span></div><h1>Neuron + Activation Functions</h1><p>Trace a real weighted sum, then send the same pre-activation through different nonlinearities.</p></div><div class="complexity-summary"><div><span>Forward work</span><strong>Θ(n)</strong><small>one multiply per input</small></div><div><span>Parameters</span><strong>n + 1</strong><small>weights + bias</small></div><div><span>Edit during run</span><strong>Restart</strong><small>frames describe one parameter snapshot</small></div></div></header>

    <section class="smart-tip"><span class="tip-icon">✦</span><div><strong>Activation is not the weighted sum.</strong><p>If z is wrong, changing the activation cannot fix the underlying dot product. Watch exactly where the value changes.</p></div><ConceptLink Href="/learn/concepts/neuron-activations">Compare activation ranges →</ConceptLink></section>

    <section class="builder-section" aria-labelledby="neuron-build-title">
        <div class="section-heading-row"><div class="heading-with-step"><span class="step-number">1</span><div><span class="section-kicker">BUILD ONE NEURON</span><h2 id="neuron-build-title">Choose an example, then choose the activation.</h2><p>Inputs, weights, and bias update the teaching neuron immediately; there is no separate Apply command.</p></div></div></div>
        <div class="preset-row"><span>TRY AN EXAMPLE</span>@foreach (var preset in Enum.GetValues<Preset>()){<button type="button" class="@(preset==_preset?"active":string.Empty)" @onclick="() => LoadPreset(preset)" disabled="@IsBusy">@PresetName(preset)</button>}</div>
        <div class="dl-builder-card">
            <div class="dl-mode-row"><span>ACTIVATION</span>@foreach (var activation in ActivationChoices){<button type="button" class="secondary-action @(_activation==activation?"active":string.Empty)" @onclick="() => SetActivation(activation)" disabled="@IsBusy">@ActivationMath.DisplayName(activation)</button>}</div>
            <div class="dl-control-grid">
                <label><span>INPUT VECTOR · x</span><input value="@_inputsText" @oninput="InputsChanged" disabled="@IsBusy" /></label>
                <label><span>WEIGHT VECTOR · w</span><input value="@_weightsText" @oninput="WeightsChanged" disabled="@IsBusy" /></label>
                <label><span>BIAS · b</span><input value="@_biasText" @oninput="BiasChanged" disabled="@IsBusy" inputmode="decimal" /></label>
            </div>
            @if (!string.IsNullOrWhiteSpace(_inputError)){<div class="input-error" role="alert"><strong>Check the neuron.</strong><span>@_inputError</span></div>}
        </div>
    </section>

    <section class="predict-section" aria-labelledby="neuron-predict-title"><div class="prediction-copy"><span class="step-number">2</span><div><span class="section-kicker">PREDICT FIRST</span><h2 id="neuron-predict-title">What sign will the final activation output have?</h2><p>Commit before the weighted contributions are revealed.</p></div></div><div class="prediction-card"><div class="prediction-actions"><button class="@PredictionClass(OutputSign.Negative)" @onclick="() => SetPrediction(OutputSign.Negative)" disabled="@IsBusy">Negative</button><button class="@PredictionClass(OutputSign.Zero)" @onclick="() => SetPrediction(OutputSign.Zero)" disabled="@IsBusy">Zero</button><button class="@PredictionClass(OutputSign.Positive)" @onclick="() => SetPrediction(OutputSign.Positive)" disabled="@IsBusy">Positive</button></div>@if(_predictionAnswered){<p class="prediction-feedback @(_predictionCorrect?"correct":"incorrect")">@PredictionFeedback</p>}</div></section>

    <section class="lab-section" aria-labelledby="neuron-lab-title">
        <div class="lab-heading"><div class="heading-with-step"><span class="step-number">3</span><div><span class="section-kicker">WATCH THE VALUE FLOW</span><h2 id="neuron-lab-title">Contribution → z → activation.</h2></div></div><div class="lab-actions"><label class="popup-toggle"><input type="checkbox" checked="@_showRunPopups" @onchange="ToggleRunPopups" /><span>Open explanation after run</span></label>@if(_lastResult is not null){<button class="secondary-action" type="button" @onclick="OpenLastRunPopup">Last explanation</button>}<button class="sort-button" type="button" @onclick="RunAsync" disabled="@IsBusy"><span>▶</span> Run neuron</button></div></div>
        <SimulationToolbar OnPlay="PlayTimelineAsync" OnPause="PauseTimelineAsync" OnStepBack="StepBackAsync" OnStepForward="StepForwardAsync" OnReset="ResetPlaybackAsync" CanStepBack="@CanStepBack" CanStepForwardOverride="@CanStepForward" StepTextOverride="@DisplayedStepText" TimelinePosition="@TimelinePosition" TimelineCount="@TimelineCount" />
        <div class="state-tabs-row"><div class="state-tabs" role="tablist"><button class="@(_view==StateView.Visual?"active":string.Empty)" @onclick="() => _view=StateView.Visual">Visual state</button><button class="@(_view==StateView.Memory?"active":string.Empty)" @onclick="() => _view=StateView.Memory">Memory state</button></div><p>@ViewExplanation</p></div>
        <div class="lesson-reference-links"><ConceptLink Href="/learn/concepts/neuron-activations">Neuron concepts →</ConceptLink><ConceptLink Href="/structures/vector">Vector / dot product →</ConceptLink></div>
        <div class="state-surface ml-state-surface">
            @if(_view==StateView.Visual){<div class="ml-visual-board" tabindex="0"><NeuronFlow Snapshot="@DisplayedSnapshot" /></div>}
            else{<div class="dl-memory-grid"><article class="dl-memory-card"><span>INPUT VECTOR</span><strong>@Vector(DisplayedSnapshot.Inputs)</strong><small>ManualVector stores the current inputs.</small></article><article class="dl-memory-card"><span>WEIGHT VECTOR</span><strong>@Vector(DisplayedSnapshot.Weights)</strong><small>One aligned weight per input.</small></article><article class="dl-memory-card"><span>CONTRIBUTIONS</span><strong>@Vector(DisplayedSnapshot.Contributions)</strong><small>Each slot is xᵢ × wᵢ.</small></article><article class="dl-memory-card"><span>SCALARS</span><strong>b=@F(DisplayedSnapshot.Bias) · z=@F(DisplayedSnapshot.PreActivation) · a=@F(DisplayedSnapshot.Output)</strong><small>The activation consumes one scalar z and returns one scalar a.</small></article></div>}
        </div>
        <div class="run-dashboard compact-run-metrics"><div><span>PHASE</span><strong>@DisplayedSnapshot.Phase</strong></div><div><span>ACTIVE INPUT</span><strong>@(DisplayedSnapshot.ActiveInputIndex<0?"—":$"x{DisplayedSnapshot.ActiveInputIndex+1}")</strong></div><div><span>z</span><strong>@F(DisplayedSnapshot.PreActivation)</strong></div><div><span>OUTPUT</span><strong>@F(DisplayedSnapshot.Output)</strong></div></div>
    </section>

    <section class="fit-section"><div class="section-heading-row"><div><span class="section-kicker">WHEN SHOULD I USE IT?</span><h2>Use a neuron when you need one learnable weighted score followed by a controlled nonlinearity.</h2></div></div><div class="fit-grid"><article class="fit-card good"><span>GOOD FIT</span><strong>Building blocks of dense neural networks</strong><p>Weights learn which inputs matter; activations let stacked layers model nonlinear relationships.</p></article><article class="fit-card avoid"><span>AVOID FOR</span><strong>Problems where one weighted boundary is already sufficient</strong><p>A full neural network adds parameters and training cost. Linear or Logistic Regression may be easier to explain and validate.</p></article><article class="fit-card better"><span>BETTER ALTERNATIVE</span><strong>Use an MLP when one neuron cannot express the pattern</strong><p>Multiple hidden neurons can learn different intermediate features before one output combines them.</p><div class="fit-links"><a href="/deep-learning/mlp">MLP →</a><a href="/ml-foundations/logistic-regression">Logistic Regression →</a></div></article></div></section>

    <section class="practice-section"><div class="practice-heading"><div><span class="section-kicker">GUIDED PRACTICE</span><h2>Make activation behavior visible.</h2></div><strong>@_completedTaskIds.Count / @PracticeTasks.Length complete</strong></div><div class="practice-grid">@foreach(var task in PracticeTasks){<PracticeTaskCard TaskId="@task.Id" Title="@task.Title" Description="@task.Goal" InputText="@task.Suggested" HelpHref="/learn/concepts/neuron-activations" Completed="@_completedTaskIds.Contains(task.Id)" Active="@(_activeTaskId==task.Id)" Busy="@IsBusy" HasEvidence="@(GetTaskEvidence(task.Id)is not null)" Start="@(() => StartTask(task.Id))" OpenEvidence="@(() => OpenTaskEvidence(task.Id))" />}</div></section>

    <NextLessonCard Eyebrow="NEXT DEEP-LEARNING LESSON" Level="11 · Interactive" Title="Neural Network / MLP" Description="Connect several neurons into a hidden layer and trace a complete forward pass through the network." Href="/deep-learning/mlp" LinkLabel="Open MLP" />
</div>

@if(_lastRunPopupOpen && _lastResult is not null){<div class="run-popup-backdrop" @onclick="CloseLastRunPopup"><section class="run-popup" role="dialog" aria-modal="true" @onclick:stopPropagation="true"><header><div><span class="section-kicker">LAST RUN</span><h2>@ActivationMath.DisplayName(_lastResult.Activation): z @_lastResult.PreActivation.ToString("0.###") → @_lastResult.Output.ToString("0.###")</h2></div><button class="popup-close" @onclick="CloseLastRunPopup">×</button></header><div class="popup-body"><p>@_lastResult.Summary</p><div class="popup-metrics"><div><span>INPUTS</span><strong>@_lastResult.InputCount</strong></div><div><span>BIAS</span><strong>@F(_lastResult.Bias)</strong></div><div><span>z</span><strong>@F(_lastResult.PreActivation)</strong></div><div><span>OUTPUT</span><strong>@F(_lastResult.Output)</strong></div></div><p class="popup-memory">ManualVector stores inputs, weights, and branch contributions. The neuron then needs only the scalar z and scalar activation output.</p></div></section></div>}
<PracticeEvidencePopup Evidence="@_practiceEvidencePopup" OnClose="CloseTaskEvidence" />

@code {
    private const string ModuleKey="neuron-activations"; private const string PopupKey="algorithm-visualizer.neuron.show-run-popup.v1";
    private static readonly ActivationKind[] ActivationChoices=[ActivationKind.ReLU,ActivationKind.Sigmoid,ActivationKind.Tanh,ActivationKind.LeakyReLU];
    private readonly List<RunFrame> _frames=[]; private PracticeModuleProgress _practiceProgress=new(); private HashSet<int> _completedTaskIds=[]; private PracticeCompletionEvidence? _practiceEvidencePopup; private NeuronRunResult? _lastResult; private string? _lastCapturedStep; private string? _inputError; private string _inputsText="1, 2"; private string _weightsText="0.8, -0.4"; private string _biasText="0.5"; private ActivationKind _activation=ActivationKind.ReLU; private Preset? _preset=Preset.PositiveRelu; private OutputSign? _prediction; private bool _predictionAnswered,_predictionCorrect,_showRunPopups=true,_lastRunPopupOpen; private int _frameIndex=-1; private int? _activeTaskId; private StateView _view=StateView.Visual;
    private static readonly PracticeTaskDefinition[] PracticeTasks=[new(1,"Clamp a negative score","Run ReLU with a negative z and verify the output becomes zero.","ReLU clips negative",Preset.ClippedRelu),new(2,"Find sigmoid midpoint","Make z exactly zero and verify sigmoid returns 0.5.","Sigmoid midpoint",Preset.SigmoidMidpoint),new(3,"Keep a negative signal","Use Leaky ReLU on a negative z and verify a small negative output survives.","Leaky negative",Preset.LeakyNegative),new(4,"Compare tanh range","Run a negative tanh example and verify its output stays between -1 and 0.","Tanh negative",Preset.TanhNegative)];
    private NeuronSnapshot DisplayedSnapshot=>_frameIndex>=0&&_frameIndex<_frames.Count?_frames[_frameIndex].Snapshot:NeuronLab.CreateSnapshot(); private string DisplayedStepText=>_frameIndex>=0&&_frameIndex<_frames.Count?_frames[_frameIndex].StepText:SimulationState.CurrentStepText; private bool IsBusy=>SimulationState.IsRunning; private int TimelineCount=>_frames.Count; private int TimelinePosition=>_frameIndex<0?0:_frameIndex+1; private bool CanStepBack=>_frameIndex>0; private bool CanStepForward=>(_frameIndex>=0&&_frameIndex<_frames.Count-1)||SimulationState.IsRunning; private string ViewExplanation=>_view==StateView.Visual?"Follow aligned x × w contributions into z, then watch the activation transform only that scalar.":"Inspect the real ManualVector-backed inputs, weights, contributions, and the two scalar neuron values."; private string PredictionFeedback=>_predictionCorrect?"Correct — the output sign matched your prediction.":$"The final output was {SignOf(_lastResult?.Output??0d).ToString().ToLowerInvariant()}.";
    protected override void OnInitialized(){SimulationState.Changed+=HandleSimulationChanged;try{_showRunPopups=!bool.TryParse(LearningStore.GetItem(PopupKey),out var saved)||saved;}catch{_showRunPopups=true;}_practiceProgress=PracticeProgress.Load(ModuleKey,null,PracticeTasks.Select(t=>t.Id));_completedTaskIds=_practiceProgress.CompletedTaskIds;ApplyInputs();}
    private void InputsChanged(ChangeEventArgs e){_inputsText=e.Value?.ToString()??"";_preset=null;ApplyInputs();} private void WeightsChanged(ChangeEventArgs e){_weightsText=e.Value?.ToString()??"";_preset=null;ApplyInputs();} private void BiasChanged(ChangeEventArgs e){_biasText=e.Value?.ToString()??"";_preset=null;ApplyInputs();} private void SetActivation(ActivationKind a){if(IsBusy)return;_activation=a;_preset=null;ApplyInputs();} private void SetPrediction(OutputSign p){_prediction=p;_predictionAnswered=false;_predictionCorrect=false;}
    private void LoadPreset(Preset p){if(IsBusy)return;_preset=p;switch(p){case Preset.PositiveRelu:_inputsText="1, 2";_weightsText="0.8, -0.4";_biasText="0.5";_activation=ActivationKind.ReLU;break;case Preset.ClippedRelu:_inputsText="1, 2";_weightsText="-1, -0.5";_biasText="0";_activation=ActivationKind.ReLU;break;case Preset.SigmoidMidpoint:_inputsText="2, -1";_weightsText="0.5, 1";_biasText="0";_activation=ActivationKind.Sigmoid;break;case Preset.TanhNegative:_inputsText="1, 1";_weightsText="-0.7, -0.4";_biasText="0.1";_activation=ActivationKind.Tanh;break;case Preset.LeakyNegative:_inputsText="1, 2";_weightsText="-1, -0.5";_biasText="0";_activation=ActivationKind.LeakyReLU;break;}ApplyInputs();}
    private void ApplyInputs(){if(!TryVector(_inputsText,out var x)||!TryVector(_weightsText,out var w)){_inputError="Enter comma-separated finite input and weight values.";return;}if(x.Length!=w.Length){_inputError="Input and weight vectors must have the same length.";return;}if(!double.TryParse(_biasText,NumberStyles.Float,CultureInfo.InvariantCulture,out var b)||!double.IsFinite(b)){_inputError="Bias must be a finite number.";return;}try{NeuronLab.Configure(new NeuronConfiguration(x,w,b,_activation));_inputError=null;ClearReview();}catch(ArgumentException ex){_inputError=ex.Message;}StateHasChanged();}
    private async Task RunAsync(){ApplyInputs();if(_inputError is not null)return;_frames.Clear();_frameIndex=-1;_lastCapturedStep=null;_lastRunPopupOpen=false;var token=SimulationState.Start("Starting neuron forward pass.");Capture();try{var result=await NeuronLab.ExecuteAsync(token);if(!IsCurrent(token))return;_lastResult=result;SimulationState.Complete(result.Summary);Capture();EvaluatePrediction(result);RecordPractice(result);if(_showRunPopups)OpenLastRunPopup();}catch(OperationCanceledException)when(!IsCurrent(token)){} }
    private void Capture(){var step=SimulationState.CurrentStepText;if(step==_lastCapturedStep)return;var follow=_frameIndex<0||_frameIndex==_frames.Count-1;_frames.Add(new RunFrame(step,NeuronLab.CreateSnapshot()));_lastCapturedStep=step;if(follow)_frameIndex=_frames.Count-1;} private void HandleSimulationChanged(){if(SimulationState.IsRunning)Capture();_=InvokeAsync(StateHasChanged);} private bool IsCurrent(CancellationToken token)=>!token.IsCancellationRequested&&SimulationState.SimulationCancellationToken==token; private void ClearReview(){SimulationState.Reset();_frames.Clear();_frameIndex=-1;_lastCapturedStep=null;_lastResult=null;_lastRunPopupOpen=false;_predictionAnswered=false;}
    private Task PlayTimelineAsync(){if(_frames.Count>0)_frameIndex=_frames.Count-1;SimulationState.Resume();return InvokeAsync(StateHasChanged);} private Task PauseTimelineAsync(){SimulationState.Pause();return Task.CompletedTask;} private Task StepBackAsync(){if(SimulationState.IsRunning&&!SimulationState.IsPaused)SimulationState.Pause();if(_frameIndex>0)_frameIndex--;return InvokeAsync(StateHasChanged);} private Task StepForwardAsync(){if(_frameIndex>=0&&_frameIndex<_frames.Count-1){_frameIndex++;return InvokeAsync(StateHasChanged);}if(SimulationState.IsRunning)SimulationState.Step();return Task.CompletedTask;} private Task ResetPlaybackAsync(){SimulationState.Reset();_frames.Clear();_frameIndex=-1;_lastCapturedStep=null;return InvokeAsync(StateHasChanged);}
    private void EvaluatePrediction(NeuronRunResult r){if(_prediction is null)return;_predictionAnswered=true;_predictionCorrect=_prediction==SignOf(r.Output);} private static OutputSign SignOf(double v)=>Math.Abs(v)<1e-9?OutputSign.Zero:v>0?OutputSign.Positive:OutputSign.Negative; private string PredictionClass(OutputSign p)=>_prediction==p?"active":string.Empty;
    private void ToggleRunPopups(ChangeEventArgs e){_showRunPopups=e.Value is bool b&&b;LearningStore.SetItem(PopupKey,_showRunPopups.ToString());} private void OpenLastRunPopup()=>_lastRunPopupOpen=_lastResult is not null; private void CloseLastRunPopup()=>_lastRunPopupOpen=false;
    private void StartTask(int id){var t=PracticeTasks.First(x=>x.Id==id);_activeTaskId=id;LoadPreset(t.Preset);} private void RecordPractice(NeuronRunResult r){if(_activeTaskId is null)return;var t=PracticeTasks.First(x=>x.Id==_activeTaskId);var ok=t.Preset switch{Preset.ClippedRelu=>Math.Abs(r.Output)<1e-9,Preset.SigmoidMidpoint=>Math.Abs(r.Output-.5d)<1e-9,Preset.LeakyNegative=>r.Output<0&&r.Output>-1,Preset.TanhNegative=>r.Output<0&&r.Output>=-1,_=>false};if(!ok)return;var ev=new PracticeCompletionEvidence(t.Id,t.Title,r.Summary,$"z={F(r.PreActivation)} became output={F(r.Output)} through {ActivationMath.DisplayName(r.Activation)}.","Inputs, weights and contributions are aligned ManualVector values; z and the activation output are scalars.","The same weighted score can behave very differently under different nonlinearities.",[new("Activation",ActivationMath.DisplayName(r.Activation)),new("z",F(r.PreActivation)),new("Output",F(r.Output))],$"{ActivationMath.DisplayName(r.Activation)} · z={F(r.PreActivation)} · a={F(r.Output)}");_completedTaskIds.Add(t.Id);PracticeProgress.Complete(ModuleKey,_practiceProgress,t.Id,ev);_activeTaskId=null;}
    private PracticeCompletionEvidence? GetTaskEvidence(int id)=>PracticeProgress.GetEvidence(_practiceProgress,id);private void OpenTaskEvidence(int id)=>_practiceEvidencePopup=GetTaskEvidence(id);private void CloseTaskEvidence()=>_practiceEvidencePopup=null;
    private static bool TryVector(string text,out double[] values){var parts=text.Split(',',StringSplitOptions.RemoveEmptyEntries|StringSplitOptions.TrimEntries);values=new double[parts.Length];if(parts.Length<1||parts.Length>8)return false;for(var i=0;i<parts.Length;i++)if(!double.TryParse(parts[i],NumberStyles.Float,CultureInfo.InvariantCulture,out values[i])||!double.IsFinite(values[i]))return false;return true;} private static string Vector(IReadOnlyList<double> v)=>"["+string.Join(", ",v.Select(value => F(value)))+"]";private static string F(double v)=>Math.Abs(v)<1e-10?"0":v.ToString("0.###",CultureInfo.InvariantCulture);private static string PresetName(Preset p)=>p switch{Preset.PositiveRelu=>"Positive ReLU",Preset.ClippedRelu=>"ReLU clips",Preset.SigmoidMidpoint=>"Sigmoid midpoint",Preset.TanhNegative=>"Tanh negative",Preset.LeakyNegative=>"Leaky negative",_=>p.ToString()}; public void Dispose()=>SimulationState.Changed-=HandleSimulationChanged;
    private sealed record RunFrame(string StepText,NeuronSnapshot Snapshot);private sealed record PracticeTaskDefinition(int Id,string Title,string Goal,string Suggested,Preset Preset);private enum Preset{PositiveRelu,ClippedRelu,SigmoidMidpoint,TanhNegative,LeakyNegative}private enum OutputSign{Negative,Zero,Positive}private enum StateView{Visual,Memory}
}
