@page "/ml-foundations/gradient-descent"
@using System.Globalization
@using AlgorithmVisualizer.Core.MachineLearning.Optimization.GradientDescent
@implements IDisposable
@inject SimulationState SimulationState
@inject GradientDescentSimulation GradientLab
@inject LearningSessionStore LearningStore
@inject PracticeProgressStore PracticeProgress

<PageTitle>Gradient Descent — Machine Learning — Algorithm Visualizer</PageTitle>

<div class="gd-page learning-module-page learning-module-shell ml-module-page">
    <section class="learn-launchpad" aria-labelledby="gd-learn-title">
        <div class="learn-copy">
            <span class="section-kicker">LEARN FIRST</span>
            <h2 id="gd-learn-title">Gradient Descent repeats one simple idea: check the slope, take a small step downhill, and repeat.</h2>
            <p>The slope tells us which way goes uphill. We move the other way. The learning rate controls how large that move is.</p>
            <ConceptLink class="learn-launchpad-link" Href="/learn/concepts/gradient-descent">Open Gradient Descent concepts &amp; memory →</ConceptLink>
        </div>
        <div class="learn-grid">
            <article class="learn-card purple"><span>1 · MEASURE</span><strong>Loss tells us how bad the current point is.</strong><small>Lower is better in this lesson.</small></article>
            <article class="learn-card blue"><span>2 · DIRECTION</span><strong>The gradient tells us which way goes uphill.</strong><small>Gradient Descent moves in the opposite direction.</small></article>
            <article class="learn-card mint"><span>3 · STEP</span><strong>The learning rate is the step size.</strong><small>Too small is slow. Too large can jump past the minimum.</small></article>
            <article class="learn-card gold"><span>4 · STOP</span><strong>Stop when the slope is small enough.</strong><small>The tolerance decides what “small enough” means.</small></article>
        </div>
    </section>

    <header class="module-header">
        <div class="header-copy">
            <div class="module-eyebrow"><span>MACHINE LEARNING · PHASE 1 STEP 1</span><span class="separator">/</span><span class="live-status"><i></i> Interactive</span></div>
            <h1>Gradient Descent</h1>
            <p>Choose a starting point and step size. Then watch the C# loop calculate the slope, move the parameters and decide whether to stop.</p>
        </div>
        <div class="complexity-summary" aria-label="Gradient Descent complexity">
            <div><span>Work</span><strong>Θ(k·n)</strong><small>k steps across n parameters</small></div>
            <div><span>Working memory</span><strong>O(n)</strong><small>current and next vectors</small></div>
            <div><span>Edit during run</span><strong>Restart</strong><small>a run uses one fixed setup</small></div>
        </div>
    </header>

    <section class="smart-tip" aria-label="Gradient Descent learning tip">
        <span class="tip-icon">✦</span>
        <div><strong>Remember the minus sign.</strong><p>The gradient points uphill. Subtracting it is what makes the next point move downhill.</p></div>
        <ConceptLink Href="/learn/concepts/gradient-descent-update">See the update rule →</ConceptLink>
    </section>

    <section class="implementation-section" aria-labelledby="gd-implementation-title">
        <div class="section-heading-row">
            <div><span class="section-kicker">IMPLEMENTATION CHOICE</span><h2 id="gd-implementation-title">Choose how the step size behaves.</h2></div>
        </div>
        <div class="variant-grid">
            <button type="button" class="variant-card @(_variant == GradientDescentVariant.FixedLearningRate ? "active" : string.Empty)" @onclick="() => SelectVariant(GradientDescentVariant.FixedLearningRate)" disabled="@IsBusy">
                <span>BASIC · SAME STEP SIZE</span><strong>Use one learning rate for the whole run</strong><p>Best for learning the core rule first.</p><small>η stays constant</small>
            </button>
            <button type="button" class="variant-card @(_variant == GradientDescentVariant.LearningRateDecay ? "active" : string.Empty)" @onclick="() => SelectVariant(GradientDescentVariant.LearningRateDecay)" disabled="@IsBusy">
                <span>ADVANCED · SHRINKING STEP</span><strong>Make the learning rate smaller over time</strong><p>Start with larger moves, then become more careful.</p><small>η decreases each step</small>
            </button>
        </div>
    </section>

    <section class="builder-section" aria-labelledby="gd-build-title">
        <div class="section-heading-row">
            <div class="heading-with-step"><span class="step-number">1</span><div><span class="section-kicker">BUILD THE INPUT</span><h2 id="gd-build-title">Choose an example, a starting point and a step size.</h2><p>The picture uses two parameters so you can see the path. Advanced stopping settings stay hidden until you ask for them.</p></div></div>
            <ConceptLink Href="/learn/concepts/gradient-descent-learning-rate">What is step size? →</ConceptLink>
        </div>

        <div class="graph-source-grid">
            <div class="preset-panel">
                <span class="control-label">START WITH AN EXAMPLE</span>
                <div class="preset-row">
                    <button type="button" class="@PresetButtonClass(Preset.Balanced)" @onclick="() => LoadPreset(Preset.Balanced)" disabled="@IsBusy">Normal step</button>
                    <button type="button" class="@PresetButtonClass(Preset.Slow)" @onclick="() => LoadPreset(Preset.Slow)" disabled="@IsBusy">Too small step</button>
                    <button type="button" class="@PresetButtonClass(Preset.Overshoot)" @onclick="() => LoadPreset(Preset.Overshoot)" disabled="@IsBusy">Too large step</button>
                    <button type="button" class="@PresetButtonClass(Preset.AtMinimum)" @onclick="() => LoadPreset(Preset.AtMinimum)" disabled="@IsBusy">Already at minimum</button>
                    <button type="button" class="@PresetButtonClass(Preset.Shifted)" @onclick="() => LoadPreset(Preset.Shifted)" disabled="@IsBusy">Different target</button>
                </div>
            </div>
            <div class="graph-lab-panel">
                <span class="control-label">LOSS SHAPE</span>
                <strong>@CurrentObjectiveTitle</strong>
                <small>@CurrentObjectiveDescription</small>
            </div>
        </div>

        <div class="optimizer-settings-card">
            <div class="settings-grid basic-settings-grid">
                <label><span>START · PARAMETER 1</span><input value="@_theta0Text" @oninput="Theta0Changed" disabled="@IsBusy" inputmode="decimal" /></label>
                <label><span>START · PARAMETER 2</span><input value="@_theta1Text" @oninput="Theta1Changed" disabled="@IsBusy" inputmode="decimal" /></label>
                <label><span>STEP SIZE · LEARNING RATE</span><input value="@_learningRateText" @oninput="LearningRateChanged" disabled="@IsBusy" inputmode="decimal" /></label>
            </div>
            <div class="settings-actions">
                <button class="secondary-action" type="button" @onclick="ToggleAdvancedSettings" disabled="@IsBusy">@(_showAdvancedSettings ? "Hide advanced settings" : "Show advanced settings")</button>
                <button class="primary-action apply-settings" type="button" @onclick="ApplyInputs" disabled="@IsBusy">Use these values</button>
            </div>

            @if (_showAdvancedSettings)
            {
                <div class="advanced-settings-panel">
                    <div class="advanced-settings-copy"><span>ADVANCED SETTINGS</span><p>You can ignore these at first. They control when the run stops and, in Advanced mode, how quickly the step size shrinks.</p></div>
                    <div class="settings-grid advanced-settings-grid">
                        <label><span>MAX STEPS</span><input value="@_iterationsText" @oninput="IterationsChanged" disabled="@IsBusy" inputmode="numeric" /></label>
                        <label><span>STOP WHEN SLOPE ≤</span><input value="@_toleranceText" @oninput="ToleranceChanged" disabled="@IsBusy" inputmode="decimal" /></label>
                        @if (_variant == GradientDescentVariant.LearningRateDecay)
                        {
                            <label><span>STEP-SHRINK RATE</span><input value="@_decayText" @oninput="DecayChanged" disabled="@IsBusy" inputmode="decimal" /></label>
                        }
                    </div>
                </div>
            }
        </div>

        @if (!string.IsNullOrWhiteSpace(_inputError))
        {
            <div class="input-message warning" role="alert">@_inputError</div>
        }
    </section>

    <section class="predict-section ml-predict-split" aria-labelledby="gd-predict-title">
        <div class="heading-with-step"><span class="step-number">2</span><div><span class="section-kicker">PREDICT</span><h2 id="gd-predict-title">Will the first step make the loss better or worse?</h2><p>Choose before you run it. The simulator checks the real first update.</p></div></div>
        <div class="prediction-card">
            <div class="prediction-actions">
                <button type="button" class="@PredictionButtonClass(LossPrediction.Down)" @onclick="() => SetPrediction(LossPrediction.Down)" disabled="@IsBusy">Loss goes down</button>
                <button type="button" class="@PredictionButtonClass(LossPrediction.Up)" @onclick="() => SetPrediction(LossPrediction.Up)" disabled="@IsBusy">Loss goes up</button>
                <button type="button" class="@PredictionButtonClass(LossPrediction.Same)" @onclick="() => SetPrediction(LossPrediction.Same)" disabled="@IsBusy">Almost unchanged</button>
            </div>
            @if (_predictionAnswered)
            {
                <p class="prediction-feedback @(_predictionCorrect ? "correct" : "incorrect")">@PredictionFeedback</p>
            }
        </div>
    </section>

    <section class="lab-section" aria-labelledby="gd-lab-title">
        <div class="lab-heading">
            <div class="heading-with-step"><span class="step-number">3</span><div><span class="section-kicker">WATCH THE REAL C# RUN</span><h2 id="gd-lab-title">Watch one loop repeat: slope → step → new point.</h2></div></div>
            <div class="lab-actions">
                <label class="popup-toggle"><input type="checkbox" checked="@_showRunPopups" @onchange="ToggleRunPopups" /><span>Open explanation after run</span></label>
                @if (_lastResult is not null)
                {
                    <button class="secondary-action" type="button" @onclick="OpenLastRunPopup">Last explanation</button>
                }
                <button class="sort-button" type="button" @onclick="RunAsync" disabled="@IsBusy"><span>▶</span> Run Gradient Descent</button>
            </div>
        </div>

        <SimulationToolbar Compact="true" OnPlay="PlayTimelineAsync" OnPause="PauseTimelineAsync" OnStepBack="StepBackAsync" OnStepForward="StepForwardAsync" OnReset="ResetPlaybackAsync" CanStepBack="@CanStepBack" CanStepForwardOverride="@CanStepForward" StepTextOverride="@DisplayedStepText" TimelinePosition="@TimelinePosition" TimelineCount="@TimelineCount" />

        <RunMetricStrip Items="@LiveRunMetrics" AriaLabel="Gradient Descent live metrics" />

        <div class="state-tabs-row">
            <div class="state-tabs" role="tablist">
                <button type="button" role="tab" aria-selected="@(_view == StateView.Visual)" class="@(_view == StateView.Visual ? "active" : string.Empty)" @onclick="() => _view = StateView.Visual">Visual state</button>
                <button type="button" role="tab" aria-selected="@(_view == StateView.Memory)" class="@(_view == StateView.Memory ? "active" : string.Empty)" @onclick="() => _view = StateView.Memory">Memory state</button>
            </div>
            <p>@ViewExplanation</p>
        </div>

        <div class="state-surface ml-state-surface">
            @if (_view == StateView.Visual)
            {
                <div class="gd-visual-state">
                    <GradientLandscape Snapshot="@DisplayedSnapshot" />
                    <GradientUpdateInsight Snapshot="@DisplayedSnapshot" />
                </div>
            }
            else
            {
                <section class="gd-memory-state" aria-label="Gradient Descent memory state">
                    <div class="memory-intro"><span>MEMORY STATE</span><strong>The same update, stored as four aligned arrays</strong><p>Current point → slope → step → next point. Index 0 always refers to parameter 1; index 1 always refers to parameter 2.</p></div>
                    <div class="memory-vector-row">
                        <span><small>CURRENT · θ</small><strong>@FormatVector(DisplayedSnapshot.Parameters)</strong></span>
                        <span><small>SLOPE · ∇J</small><strong>@FormatVector(DisplayedSnapshot.Gradient)</strong></span>
                        <span><small>STEP · η∇J</small><strong>@FormatVector(DisplayedSnapshot.ScaledGradient)</strong></span>
                        <span><small>NEXT · θ′</small><strong>@FormatVector(DisplayedSnapshot.NextParameters)</strong></span>
                    </div>
                    <div class="table-scroll"><table><thead><tr><th>Index</th><th>Byte offset</th><th>θ[]</th><th>gradient[]</th><th>η∇J[]</th><th>next θ[]</th><th>Current role</th></tr></thead><tbody>
                    @for (var index = 0; index < DisplayedSnapshot.Parameters.Length; index++)
                    {
                        var active = DisplayedSnapshot.CurrentIndex == index;
                        <tr class="@(active ? "current" : string.Empty)"><td>@index</td><td>@(index * sizeof(double))</td><td>@Format(DisplayedSnapshot.Parameters[index])</td><td>@Format(DisplayedSnapshot.Gradient[index])</td><td>@Format(DisplayedSnapshot.ScaledGradient[index])</td><td>@Format(DisplayedSnapshot.NextParameters[index])</td><td>@(active ? PhaseRole : "stable slot")</td></tr>
                    }
                    </tbody></table></div>
                    <div class="memory-note"><strong>Working memory grows with the number of parameters.</strong><span>The rewind timeline is teaching-only history; it is separate from the optimizer itself.</span></div>
                </section>
            }
        </div>
        <div class="lesson-reference-links"><ConceptLink Href="/learn/concepts/gradient-descent">Algorithm rule →</ConceptLink><ConceptLink Href="/learn/concepts/gradient-descent-loss">Loss surface →</ConceptLink><ConceptLink Href="/learn/concepts/gradient-descent-learning-rate">What is step size? →</ConceptLink><ConceptLink Href="/learn/concepts/gradient-descent-convergence">Convergence →</ConceptLink></div>
    </section>

    <section class="fit-section" aria-labelledby="gd-fit-title">
        <div class="section-heading-row"><div><span class="section-kicker">WHEN SHOULD I USE IT?</span><h2 id="gd-fit-title">Use Gradient Descent when a differentiable loss can be improved through repeated parameter updates.</h2><p>It is an optimizer, not a prediction model: the useful choice depends on the loss surface and a sensible learning rate.</p></div></div>
        <div class="fit-grid">
            <article class="fit-card good"><span>GOOD FIT</span><strong>Many adjustable parameters with a usable gradient</strong><p>The same update rule scales from a few model parameters to much larger differentiable models.</p></article>
            <article class="fit-card avoid"><span>AVOID FOR</span><strong>Objectives with no useful gradient or a step size you cannot stabilize</strong><p>A tiny learning rate can stall progress while an oversized one can overshoot or diverge.</p></article>
            <article class="fit-card better"><span>BETTER ALTERNATIVE</span><strong>Use a closed-form solution when the problem genuinely has a simple one</strong><p>Do not iterate just for the sake of iteration. The next lesson shows why Gradient Descent is still useful when fitting a model step by step.</p><div class="fit-links"><a href="/ml-foundations/linear-regression">Open Linear Regression →</a></div></article>
        </div>
    </section>

    <section class="practice-section" aria-labelledby="gd-practice-title">
        <div class="practice-heading"><div><span class="section-kicker">GUIDED PRACTICE</span><h2 id="gd-practice-title">Learn what changes when the step size changes.</h2><p>Each task loads a useful example, but completion is checked from what the optimizer actually does.</p></div><strong>@_completedTaskIds.Count / @PracticeTasks.Length complete</strong></div>
        <div class="practice-grid">
            @foreach (var task in PracticeTasks)
            {
                <PracticeTaskCard TaskId="@task.Id" Title="@task.Title" Description="@task.Goal" InputText="@task.Suggested" HelpHref="/learn/concepts/gradient-descent" Completed="@_completedTaskIds.Contains(task.Id)" Active="@(_activeTaskId == task.Id)" Busy="@IsBusy" HasEvidence="@(GetTaskEvidence(task.Id) is not null)" Start="@(() => StartTask(task.Id))" OpenEvidence="@(() => OpenTaskEvidence(task.Id))" />
            }
        </div>
    </section>

    <NextLessonCard Eyebrow="NEXT MACHINE-LEARNING LESSON" Level="02 · Interactive" Title="Linear Regression" Description="Use the optimizer you just learned to fit a real prediction model to training points." Href="/ml-foundations/linear-regression" LinkLabel="Open Linear Regression" />
</div>

@if (_lastRunPopupOpen && _lastResult is not null)
{
    <div class="run-popup-backdrop" role="presentation" @onclick="CloseLastRunPopup">
        <section class="run-popup" role="dialog" aria-modal="true" @onclick:stopPropagation="true">
            <header><div><span class="section-kicker">LAST RUN</span><h2>@LastRunHeadline</h2></div><button type="button" class="popup-close" @onclick="CloseLastRunPopup">×</button></header>
            <div class="popup-body">
                <p>@RunActionExplanation(_lastResult)</p>
                <div class="popup-metrics">
                    <div><span>LOSS</span><strong>@Format(_lastResult.InitialLoss) → @Format(_lastResult.FinalLoss)</strong></div>
                    <div><span>UPDATES</span><strong>@_lastResult.IterationsCompleted</strong></div>
                    <div><span>RESULT</span><strong>@_lastResult.StopReason</strong></div>
                    <div><span>FINAL θ</span><strong>@FormatVector(_lastResult.FinalParameters)</strong></div>
                </div>
                <p class="popup-memory">@RunMlExplanation(_lastResult)</p>
            </div>
        </section>
    </div>
}

<PracticeEvidencePopup Evidence="@_practiceEvidencePopup" OnClose="CloseTaskEvidence" />

@code {
    private IReadOnlyList<RunMetricItem> LiveRunMetrics => [new("PHASE", PhaseRole), new("ITERATION", DisplayedSnapshot.Iteration.ToString()), new("LOSS", Format(DisplayedSnapshot.Loss)), new("GRADIENT NORM", DisplayedSnapshot.Phase == GradientDescentPhase.Ready ? "—" : Format(DisplayedSnapshot.GradientNorm)), new("EFFECTIVE η", Format(DisplayedSnapshot.EffectiveLearningRate))];
    private const string ModuleKey = "gradient-descent";
    private const string PopupSettingStorageKey = "algorithm-visualizer.gradient-descent.show-run-popup.v1";
    private readonly List<RunFrame> _frames = [];
    private readonly List<GradientDescentRunResult> _practiceResults = [];
    private PracticeModuleProgress _practiceProgress = new();
    private HashSet<int> _completedTaskIds = [];
    private PracticeCompletionEvidence? _practiceEvidencePopup;
    private GradientDescentRunResult? _lastResult;
    private string? _lastCapturedStep;
    private string _theta0Text = "5";
    private string _theta1Text = "-3";
    private string _learningRateText = "0.2";
    private string _iterationsText = "30";
    private string _toleranceText = "0.01";
    private string _decayText = "0.15";
    private string? _inputError;
    private ObjectivePreset _objective = ObjectivePreset.Balanced;
    private Preset? _preset = Preset.Balanced;
    private GradientDescentVariant _variant = GradientDescentVariant.FixedLearningRate;
    private bool _showRunPopups = true;
    private bool _showAdvancedSettings;
    private bool _lastRunPopupOpen;
    private bool _predictionAnswered;
    private bool _predictionCorrect;
    private LossPrediction? _prediction;
    private int _frameIndex = -1;
    private int? _activeTaskId;
    private StateView _view = StateView.Visual;

    private static readonly ObjectiveOption[] ObjectiveOptions =
    [
        new(ObjectivePreset.Balanced, "SIMPLE", "Simple bowl", "The best point is [0, 0]. Both directions slope toward it."),
        new(ObjectivePreset.NarrowValley, "STEEP + SHALLOW", "Uneven bowl", "One direction changes much faster than the other."),
        new(ObjectivePreset.Shifted, "MOVED MINIMUM", "Different target", "The best point is [2, -1], so the goal is not always zero.")
    ];

    private static readonly PracticeTaskDefinition[] PracticeTasks =
    [
        new(1, "Make the loss smaller", "Run a stable example and finish with a lower loss than you started with.", "Try Normal step", Preset.Balanced),
        new(2, "Start at the minimum", "Load a point that is already best and confirm that there is almost nowhere to move.", "Try Already at minimum", Preset.AtMinimum),
        new(3, "Use a step that is too large", "Make the run move away from the minimum instead of settling toward it.", "Try Too large step", Preset.Overshoot),
        new(4, "Shrink the step over time", "Use the Advanced variant and finish with a smaller step size than the one you started with.", "Try Advanced · shrinking step", Preset.Decay),
        new(5, "Use a step that is too small", "Finish the allowed number of steps while still improving too slowly to reach the stop rule.", "Try Too small step", Preset.Slow),
        new(6, "Find a minimum that is not zero", "Use the moved target and finish near [2, -1].", "Try Different target", Preset.Shifted)
    ];

    private GradientDescentSnapshot Current => GradientLab.CreateSnapshot();
    private GradientDescentSnapshot DisplayedSnapshot => _frameIndex >= 0 && _frameIndex < _frames.Count ? _frames[_frameIndex].Snapshot : Current;
    private string DisplayedStepText => _frameIndex >= 0 && _frameIndex < _frames.Count ? _frames[_frameIndex].StepText : SimulationState.CurrentStepText;
    private int TimelineCount => _frames.Count;
    private int TimelinePosition => _frameIndex < 0 ? 0 : _frameIndex + 1;
    private bool CanStepBack => _frameIndex > 0;
    private bool CanStepForward => (_frameIndex >= 0 && _frameIndex < _frames.Count - 1) || SimulationState.IsRunning;
    private bool IsBusy => SimulationState.IsRunning;
    private string ViewExplanation => _view == StateView.Visual ? "See where the current point is and how each committed step moves toward or away from the minimum." : "See the same update as four aligned vectors: current point, slope, step and next point.";
    private string PhaseRole => DisplayedSnapshot.Phase switch { GradientDescentPhase.ComputingGradient => "gradient component", GradientDescentPhase.ScalingGradient => "scaled gradient", GradientDescentPhase.UpdatingParameters => "vector subtraction", GradientDescentPhase.EvaluatingLoss => "loss evaluation", _ => "current component" };
    private string PredictionFeedback => _predictionCorrect ? "Correct — your first-step prediction matched the actual loss change." : $"Not quite. The first committed update made loss {ActualFirstStepDirection}.";
    private string ActualFirstStepDirection => FirstStepDirection(_lastResult);
    private string LastRunHeadline => _lastResult is null ? "Gradient Descent run" : _lastResult.Diverged ? "The steps moved away from the minimum." : _lastResult.Converged ? "The slope became small enough to stop." : "The run used all allowed steps.";
    private string CurrentObjectiveTitle => ObjectiveOptions.First(option => option.Kind == _objective).Title;
    private string CurrentObjectiveDescription => ObjectiveOptions.First(option => option.Kind == _objective).Description;

    protected override void OnInitialized()
    {
        SimulationState.Changed += HandleSimulationChanged;
        try { _showRunPopups = !bool.TryParse(LearningStore.GetItem(PopupSettingStorageKey), out var saved) || saved; } catch { _showRunPopups = true; }
        _practiceProgress = PracticeProgress.Load(ModuleKey, null, PracticeTasks.Select(task => task.Id));
        _completedTaskIds = _practiceProgress.CompletedTaskIds;
        ApplyInputs();
    }

    private void Theta0Changed(ChangeEventArgs args) { _theta0Text = args.Value?.ToString() ?? string.Empty; ClearPresetSelection(); ClearReview(); }
    private void Theta1Changed(ChangeEventArgs args) { _theta1Text = args.Value?.ToString() ?? string.Empty; ClearPresetSelection(); ClearReview(); }
    private void LearningRateChanged(ChangeEventArgs args) { _learningRateText = args.Value?.ToString() ?? string.Empty; ClearPresetSelection(); ClearReview(); }
    private void IterationsChanged(ChangeEventArgs args) { _iterationsText = args.Value?.ToString() ?? string.Empty; ClearPresetSelection(); ClearReview(); }
    private void ToleranceChanged(ChangeEventArgs args) { _toleranceText = args.Value?.ToString() ?? string.Empty; ClearPresetSelection(); ClearReview(); }
    private void DecayChanged(ChangeEventArgs args) { _decayText = args.Value?.ToString() ?? string.Empty; ClearPresetSelection(); ClearReview(); }
    private void SelectObjective(ObjectivePreset kind) { if (IsBusy) return; _objective = kind; ClearPresetSelection(); ClearReview(); ApplyInputs(); }
    private void SelectVariant(GradientDescentVariant variant) { if (IsBusy) return; _variant = variant; ClearPresetSelection(); ClearReview(); ApplyInputs(); }
    private void SetPrediction(LossPrediction value) { if (IsBusy) return; _prediction = value; _predictionAnswered = false; }
    private string PredictionButtonClass(LossPrediction value) => _prediction == value ? "active" : string.Empty;
    private string PresetButtonClass(Preset value) => _preset == value ? "active" : string.Empty;
    private void ClearPresetSelection() => _preset = null;
    private void ToggleAdvancedSettings() { if (!IsBusy) _showAdvancedSettings = !_showAdvancedSettings; }

    private void ApplyInputs()
    {
        if (!TryParseDouble(_theta0Text, out var theta0) || !TryParseDouble(_theta1Text, out var theta1)) { _inputError = "Both starting parameters must be finite real numbers."; return; }
        if (!TryParseDouble(_learningRateText, out var learningRate)) { _inputError = "Learning rate must be a real number."; return; }
        if (!int.TryParse(_iterationsText, NumberStyles.Integer, CultureInfo.InvariantCulture, out var iterations)) { _inputError = "Maximum updates must be a whole number."; return; }
        if (!TryParseDouble(_toleranceText, out var tolerance)) { _inputError = "Gradient tolerance must be a real number."; return; }
        if (!TryParseDouble(_decayText, out var decay)) { _inputError = "Decay must be a real number."; return; }
        if (!double.IsFinite(theta0) || !double.IsFinite(theta1) || !double.IsFinite(learningRate) || !double.IsFinite(tolerance) || !double.IsFinite(decay)) { _inputError = "NaN and infinity are not accepted in this learning lab."; return; }
        if (learningRate <= 0d) { _inputError = "Learning rate must be greater than 0."; return; }
        if (iterations is < 1 or > 40) { _inputError = "Use between 1 and 40 updates in the visual lesson."; return; }
        if (tolerance <= 0d) { _inputError = "Gradient tolerance must be greater than 0."; return; }
        if (decay < 0d) { _inputError = "Decay cannot be negative."; return; }

        var landscape = GetLandscape(_objective);
        _inputError = null;
        try
        {
            GradientLab.Configure(new GradientDescentConfiguration([theta0, theta1], landscape.Target, landscape.Curvature, learningRate, iterations, tolerance, decay));
        }
        catch (ArgumentException ex)
        {
            _inputError = ex.Message;
            return;
        }
        ClearReview();
        StateHasChanged();
    }

    private async Task RunAsync()
    {
        ApplyInputs();
        if (!string.IsNullOrWhiteSpace(_inputError)) return;
        _frames.Clear(); _frameIndex = -1; _lastCapturedStep = null; _lastRunPopupOpen = false;
        var token = SimulationState.Start($"Starting {VariantLabel(_variant)} Gradient Descent.");
        Capture();
        try
        {
            var result = await GradientLab.ExecuteAsync(_variant, token);
            if (!IsCurrent(token)) return;
            _lastResult = result;
            SimulationState.Complete(result.Summary);
            Capture();
            EvaluatePrediction(result);
            RecordPracticeResult(result);
            if (_showRunPopups) OpenLastRunPopup();
        }
        catch (OperationCanceledException) { }
        finally { await InvokeAsync(StateHasChanged); }
    }

    private void Capture()
    {
        var step = SimulationState.CurrentStepText;
        if (step == _lastCapturedStep) return;
        var followTail = _frameIndex < 0 || _frameIndex == _frames.Count - 1;
        _frames.Add(new RunFrame(step, GradientLab.CreateSnapshot()));
        _lastCapturedStep = step;
        if (followTail) _frameIndex = _frames.Count - 1;
    }

    private void HandleSimulationChanged() { if (SimulationState.IsRunning) Capture(); _ = InvokeAsync(StateHasChanged); }
    private bool IsCurrent(CancellationToken token) => !token.IsCancellationRequested && SimulationState.SimulationCancellationToken == token;
    private void ClearReview() { SimulationState.Reset(); _frames.Clear(); _frameIndex = -1; _lastCapturedStep = null; _lastRunPopupOpen = false; _lastResult = null; _predictionAnswered = false; }
    private Task PlayTimelineAsync() { if (_frames.Count > 0) _frameIndex = _frames.Count - 1; SimulationState.Resume(); return InvokeAsync(StateHasChanged); }
    private Task PauseTimelineAsync() { SimulationState.Pause(); return Task.CompletedTask; }
    private Task StepBackAsync() { if (SimulationState.IsRunning && !SimulationState.IsPaused) SimulationState.Pause(); if (_frameIndex > 0) _frameIndex--; return InvokeAsync(StateHasChanged); }
    private Task StepForwardAsync() { if (_frameIndex >= 0 && _frameIndex < _frames.Count - 1) { _frameIndex++; return InvokeAsync(StateHasChanged); } if (SimulationState.IsRunning) SimulationState.Step(); return Task.CompletedTask; }
    private Task ResetPlaybackAsync() { SimulationState.Reset(); _frames.Clear(); _frameIndex = -1; _lastCapturedStep = null; return InvokeAsync(StateHasChanged); }

    private void EvaluatePrediction(GradientDescentRunResult result)
    {
        _predictionAnswered = _prediction.HasValue;
        if (!_predictionAnswered) return;
        _predictionCorrect = FirstStepPrediction(result) == _prediction.Value;
    }

    private static LossPrediction FirstStepPrediction(GradientDescentRunResult result)
    {
        if (result.History.Length < 2) return LossPrediction.Same;
        var delta = result.History[1].Loss - result.History[0].Loss;
        if (Math.Abs(delta) <= 1e-9) return LossPrediction.Same;
        return delta < 0d ? LossPrediction.Down : LossPrediction.Up;
    }

    private static string FirstStepDirection(GradientDescentRunResult? result) => result is null ? "unavailable" : FirstStepPrediction(result) switch { LossPrediction.Down => "go down", LossPrediction.Up => "go up", _ => "stay almost unchanged" };

    private void StartTask(int taskId)
    {
        if (IsBusy) return;
        var task = PracticeTasks.First(item => item.Id == taskId);
        _activeTaskId = taskId;
        LoadPreset(task.Preset, keepActiveTask: true);
    }

    private void LoadPreset(Preset preset, bool keepActiveTask = false)
    {
        if (IsBusy) return;
        _preset = preset;
        switch (preset)
        {
            case Preset.Slow: SetInputs(ObjectivePreset.Balanced, 5d, -3d, 0.01d, 6, 0.000001d, 0.15d, GradientDescentVariant.FixedLearningRate); break;
            case Preset.Overshoot: SetInputs(ObjectivePreset.Balanced, 5d, -3d, 1.2d, 20, 0.01d, 0.15d, GradientDescentVariant.FixedLearningRate); break;
            case Preset.AtMinimum: SetInputs(ObjectivePreset.Shifted, 2d, -1d, 0.2d, 20, 0.01d, 0.15d, GradientDescentVariant.FixedLearningRate); break;
            case Preset.Narrow: SetInputs(ObjectivePreset.NarrowValley, -4d, 4d, 0.8d, 20, 0.01d, 0.15d, GradientDescentVariant.FixedLearningRate); break;
            case Preset.Decay: SetInputs(ObjectivePreset.NarrowValley, -4d, 4d, 0.55d, 30, 0.01d, 0.55d, GradientDescentVariant.LearningRateDecay); break;
            case Preset.Shifted: SetInputs(ObjectivePreset.Shifted, -3d, 3d, 0.25d, 30, 0.02d, 0.15d, GradientDescentVariant.FixedLearningRate); break;
            default: SetInputs(ObjectivePreset.Balanced, 5d, -3d, 0.2d, 30, 0.01d, 0.15d, GradientDescentVariant.FixedLearningRate); break;
        }
        _prediction = null;
        _predictionAnswered = false;
        ApplyInputs();
        if (!keepActiveTask) _activeTaskId = null;
    }

    private void SetInputs(ObjectivePreset objective, double theta0, double theta1, double learningRate, int iterations, double tolerance, double decay, GradientDescentVariant variant)
    {
        _objective = objective; _theta0Text = Format(theta0); _theta1Text = Format(theta1); _learningRateText = Format(learningRate); _iterationsText = iterations.ToString(CultureInfo.InvariantCulture); _toleranceText = Format(tolerance); _decayText = Format(decay); _variant = variant;
    }

    private void RecordPracticeResult(GradientDescentRunResult result)
    {
        _practiceResults.Add(result);
        if (_practiceResults.Count > 40) _practiceResults.RemoveAt(0);
        foreach (var task in PracticeTasks)
        {
            if (_completedTaskIds.Contains(task.Id) && GetTaskEvidence(task.Id) is not null && _activeTaskId != task.Id) continue;
            var complete = task.Id switch
            {
                1 => !result.Diverged && result.FinalLoss < result.InitialLoss,
                2 => result.Converged && result.InitialLoss <= 1e-12,
                3 => result.Diverged,
                4 => result.Variant == GradientDescentVariant.LearningRateDecay && !result.Diverged && result.FinalLearningRate < result.InitialLearningRate && result.FinalLoss < result.InitialLoss,
                5 => !result.Diverged && result.StopReason == GradientDescentStopReason.MaximumIterations,
                6 => result.Converged && IsShiftedLandscape(result.Target, result.Curvature) && result.FinalLoss < result.InitialLoss,
                _ => false
            };
            if (complete) CompletePracticeTask(task, result);
        }
    }

    private void CompletePracticeTask(PracticeTaskDefinition task, GradientDescentRunResult result)
    {
        var evidence = new PracticeCompletionEvidence(
            task.Id,
            task.Title,
            result.Summary,
            RunActionExplanation(result),
            "Current θ, gradient, scaled gradient and next θ are stored as project-owned ManualVector instances. O(k·n) history is kept only so this visualizer can rewind the run.",
            RunMlExplanation(result),
            [new("Variant", VariantLabel(result.Variant)), new("η start", Format(result.InitialLearningRate)), new("η final", Format(result.FinalLearningRate)), new("Initial loss", Format(result.InitialLoss)), new("Final loss", Format(result.FinalLoss)), new("Updates", result.IterationsCompleted.ToString(CultureInfo.InvariantCulture))],
            $"target={FormatVector(result.Target)} · curvature={FormatVector(result.Curvature)} · start={FormatVector(result.InitialParameters)} · end={FormatVector(result.FinalParameters)}");
        _completedTaskIds.Add(task.Id);
        PracticeProgress.Complete(ModuleKey, _practiceProgress, task.Id, evidence);
        if (_activeTaskId == task.Id) _activeTaskId = null;
    }

    private PracticeCompletionEvidence? GetTaskEvidence(int taskId) => PracticeProgress.GetEvidence(_practiceProgress, taskId);
    private void OpenTaskEvidence(int taskId) => _practiceEvidencePopup = GetTaskEvidence(taskId);
    private void CloseTaskEvidence() => _practiceEvidencePopup = null;
    private string GetActiveTaskProgressText(int taskId) => _practiceResults.Count == 0 ? "Suggested settings are loaded. Completion is checked from the actual optimization behavior, not the preset button." : $"Last run: loss {Format(_practiceResults[^1].InitialLoss)} → {Format(_practiceResults[^1].FinalLoss)} · {_practiceResults[^1].StopReason}.";

    private void ToggleRunPopups(ChangeEventArgs args) { _showRunPopups = args.Value is bool value ? value : bool.TryParse(args.Value?.ToString(), out var parsed) && parsed; try { LearningStore.SetItem(PopupSettingStorageKey, _showRunPopups.ToString()); } catch { } }
    private void OpenLastRunPopup() { if (_lastResult is null) return; _lastRunPopupOpen = true; }
    private void CloseLastRunPopup() => _lastRunPopupOpen = false;

    private static string RunActionExplanation(GradientDescentRunResult result) => $"The run started with loss {Format(result.InitialLoss)} and finished at {Format(result.FinalLoss)} after {result.IterationsCompleted} step(s). Each step measured the slope, scaled it by the chosen step size, and moved in the opposite direction.";
    private static string RunMlExplanation(GradientDescentRunResult result) => result.Diverged ? "The direction was downhill, but the step was so large that it kept jumping past the useful region." : result.Converged ? "The slope is now small enough for this lesson to treat the current point as finished." : result.Variant == GradientDescentVariant.LearningRateDecay ? "The run kept making progress while the Advanced variant gradually reduced the step size." : "The run stopped because it used every allowed step. A smaller step can be correct but still need more time.";
    private static string VariantLabel(GradientDescentVariant variant) => variant == GradientDescentVariant.LearningRateDecay ? "Learning-rate decay" : "Fixed learning rate";
    private static (double[] Target, double[] Curvature) GetLandscape(ObjectivePreset preset) => preset switch { ObjectivePreset.NarrowValley => ([1.5d, -1.5d], [0.25d, 4d]), ObjectivePreset.Shifted => ([2d, -1d], [1d, 1.5d]), _ => ([0d, 0d], [1d, 2d]) };
    private static bool IsNarrowLandscape(IReadOnlyList<double> target, IReadOnlyList<double> curvature) => target.Count == 2 && curvature.Count == 2 && Math.Abs(target[0] - 1.5d) < 1e-9 && Math.Abs(target[1] + 1.5d) < 1e-9 && Math.Abs(curvature[0] - 0.25d) < 1e-9 && Math.Abs(curvature[1] - 4d) < 1e-9;
    private static bool IsShiftedLandscape(IReadOnlyList<double> target, IReadOnlyList<double> curvature) => target.Count == 2 && curvature.Count == 2 && Math.Abs(target[0] - 2d) < 1e-9 && Math.Abs(target[1] + 1d) < 1e-9 && Math.Abs(curvature[0] - 1d) < 1e-9 && Math.Abs(curvature[1] - 1.5d) < 1e-9;
    private static bool TryParseDouble(string? text, out double value) => double.TryParse(text, NumberStyles.Float, CultureInfo.InvariantCulture, out value) || double.TryParse(text, NumberStyles.Float, CultureInfo.CurrentCulture, out value);
    private static string Format(double value) => Math.Abs(value) < 1e-12 ? "0" : value.ToString("0.####", CultureInfo.InvariantCulture);
    private static string FormatVector(IReadOnlyList<double> values) { var parts = new string[values.Count]; for (var index = 0; index < values.Count; index++) parts[index] = Format(values[index]); return $"[{string.Join(", ", parts)}]"; }

    public void Dispose() => SimulationState.Changed -= HandleSimulationChanged;

    private sealed record RunFrame(string StepText, GradientDescentSnapshot Snapshot);
    private sealed record ObjectiveOption(ObjectivePreset Kind, string Kicker, string Title, string Description);
    private sealed record PracticeTaskDefinition(int Id, string Title, string Goal, string Suggested, Preset Preset);
    private enum ObjectivePreset { Balanced, NarrowValley, Shifted }
    private enum LossPrediction { Down, Up, Same }
    private enum StateView { Visual, Memory }
    private enum Preset { Balanced, Slow, Overshoot, AtMinimum, Narrow, Decay, Shifted }
}
