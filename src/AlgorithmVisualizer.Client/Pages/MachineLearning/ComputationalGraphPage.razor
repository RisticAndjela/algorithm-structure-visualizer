@page "/deep-learning/computational-graph"
@using System.Globalization
@using AlgorithmVisualizer.Core.MachineLearning.DeepLearning.ComputationalGraph
@implements IDisposable
@inject SimulationState SimulationState
@inject ComputationalGraphSimulation GraphLab
@inject LearningSessionStore LearningStore
@inject PracticeProgressStore PracticeProgress

<PageTitle>Computational Graph — Deep Learning — Algorithm Visualizer</PageTitle>

<div class="cg-page learning-module-page learning-module-shell ml-module-page">
    <section class="learn-launchpad" aria-labelledby="cg-learn-title">
        <div class="learn-copy">
            <span class="section-kicker">LEARN FIRST</span>
            <h2 id="cg-learn-title">A computational graph turns one formula into explicit value dependencies.</h2>
            <p>Inputs already have values. Operation nodes wait until every dependency exists, compute one result, store it, and make downstream nodes ready.</p>
            <ConceptLink class="learn-launchpad-link" Href="/learn/concepts/computational-graph">Open Computational Graph concepts &amp; memory →</ConceptLink>
        </div>
        <div class="learn-grid">
            <article class="learn-card purple"><span>1 · VALUES</span><strong>Inputs are source nodes.</strong><small>They hold scalar values before any operation runs.</small></article>
            <article class="learn-card blue"><span>2 · DEPENDENCIES</span><strong>Edges say what an operation needs.</strong><small>Position on screen never decides execution order.</small></article>
            <article class="learn-card mint"><span>3 · FORWARD</span><strong>Run only ready operations.</strong><small>Store every intermediate result for downstream nodes.</small></article>
            <article class="learn-card gold"><span>4 · REUSE</span><strong>Keep the same graph structure.</strong><small>Later Backpropagation will traverse these dependencies in reverse.</small></article>
        </div>
    </section>

    <header class="module-header">
        <div class="header-copy">
            <div class="module-eyebrow"><span>DEEP LEARNING · PHASE 2 STEP 10</span><span class="separator">/</span><span class="live-status"><i></i> Interactive</span></div>
            <h1>Computational Graph</h1>
            <p>Make scalar calculations explicit as value nodes, operation nodes, and dependency edges, then evaluate the graph one ready operation at a time.</p>
        </div>
        <div class="complexity-summary" aria-label="Computational Graph teaching implementation complexity">
            <div><span>Forward scan</span><strong>O(V² + E)</strong><small>explicit readiness scan</small></div>
            <div><span>One operation</span><strong>O(1)</strong><small>scalar teaching ops</small></div>
            <div><span>Graph state</span><strong>O(V + E)</strong><small>nodes + dependencies</small></div>
        </div>
    </header>

    <section class="smart-tip" aria-label="Computational Graph learning tip">
        <span class="tip-icon">✦</span>
        <div><strong>The graph stores dependency, not drawing order.</strong><p>Two operations can be visually next to each other and both be ready. A node runs only when all values on its incoming edges already exist.</p></div>
        <ConceptLink Href="/graph-algorithms/topological">Compare dependency ordering →</ConceptLink>
    </section>

    <section class="builder-section" aria-labelledby="cg-build-title">
        <div class="section-heading-row">
            <div class="heading-with-step"><span class="step-number">1</span><div><span class="section-kicker">BUILD THE EXPRESSION</span><h2 id="cg-build-title">Choose a graph shape, then edit only the input values.</h2><p>The topology stays small on purpose so the dependency rule remains obvious during playback.</p></div></div>
            <ConceptLink Href="/learn/concepts/computational-graph">What is a dependency edge? →</ConceptLink>
        </div>

        <div class="preset-row cg-preset-row" aria-label="Computational graph examples">
            <span>START WITH</span>
            <button type="button" class="@PresetClass(Preset.WeightedBias)" @onclick="() => LoadPreset(Preset.WeightedBias)" disabled="@IsBusy">Weighted + bias</button>
            <button type="button" class="@PresetClass(Preset.BranchMerge)" @onclick="() => LoadPreset(Preset.BranchMerge)" disabled="@IsBusy">Branch &amp; merge</button>
            <button type="button" class="@PresetClass(Preset.SquareSum)" @onclick="() => LoadPreset(Preset.SquareSum)" disabled="@IsBusy">Square a sum</button>
        </div>
        <details class="more-examples">
            <summary>More graph shapes</summary>
            <div class="preset-row"><button type="button" class="@PresetClass(Preset.TwoBranches)" @onclick="() => LoadPreset(Preset.TwoBranches)" disabled="@IsBusy">Two weighted branches</button></div>
            <p>This case has two independent multiplies before the final add, so more than one operation can become ready at the same time.</p>
        </details>

        <div class="cg-builder">
            <section class="expression-card">
                <span>EXPRESSION</span>
                <strong>@CurrentExpression</strong>
                <p>@CurrentExpressionExplanation</p>
                <div class="expression-flow" aria-label="Expression stages"><span>input values</span><b>→</b><span>ready operations</span><b>→</b><span>stored intermediate values</span><b>→</b><span>output</span></div>
            </section>
            <section class="input-card">
                <div class="input-heading"><div><span>INPUT VALUES</span><strong>Edit the source nodes.</strong></div><small>The graph updates whenever all values are valid.</small></div>
                <div class="cg-input-grid">
                    @for (var index = 0; index < _inputs.Length; index++)
                    {
                        var inputIndex = index;
                        <label><span>@_inputs[index].Symbol</span><input type="text" inputmode="decimal" value="@_inputs[index].Text" @oninput="args => InputChanged(inputIndex, args)" disabled="@IsBusy" /><small>@_inputs[index].Label</small></label>
                    }
                </div>
            </section>
        </div>
        @if (!string.IsNullOrWhiteSpace(_inputError)) { <div class="input-error" role="alert"><strong>Check the input values.</strong><span>@_inputError</span></div> }
    </section>

    <section class="predict-section" aria-labelledby="cg-predict-title">
        <div class="prediction-card">
            <div class="prediction-copy"><span class="step-number">2</span><div><span class="section-kicker">PREDICT BEFORE PLAYBACK</span><h2 id="cg-predict-title">What sign will the final output have?</h2><p>Estimate the complete expression before the graph reveals its intermediate values.</p></div></div>
            <div class="prediction-actions">
                <button type="button" class="@PredictionClass(OutputSign.Negative)" @onclick="() => SetPrediction(OutputSign.Negative)" disabled="@IsBusy">Negative</button>
                <button type="button" class="@PredictionClass(OutputSign.Zero)" @onclick="() => SetPrediction(OutputSign.Zero)" disabled="@IsBusy">Zero</button>
                <button type="button" class="@PredictionClass(OutputSign.Positive)" @onclick="() => SetPrediction(OutputSign.Positive)" disabled="@IsBusy">Positive</button>
            </div>
            @if (_predictionAnswered) { <p class="prediction-feedback @(_predictionCorrect ? "correct" : "incorrect")">@PredictionFeedback</p> }
        </div>
    </section>

    <section class="lab-section" aria-labelledby="cg-lab-title">
        <div class="lab-heading">
            <div class="heading-with-step"><span class="step-number">3</span><div><span class="section-kicker">WATCH THE FORWARD PASS</span><h2 id="cg-lab-title">Ready → evaluate → store → unlock the next node.</h2></div></div>
            <div class="lab-actions">
                <label class="popup-toggle"><input type="checkbox" checked="@_showRunPopups" @onchange="ToggleRunPopups" /><span>Open explanation after run</span></label>
                @if (_lastResult is not null) { <button class="secondary-action" type="button" @onclick="OpenLastRunPopup">Last explanation</button> }
                <button class="sort-button" type="button" @onclick="RunAsync" disabled="@IsBusy"><span>▶</span> Run forward pass</button>
            </div>
        </div>

        <SimulationToolbar OnPlay="PlayTimelineAsync" OnPause="PauseTimelineAsync" OnStepBack="StepBackAsync" OnStepForward="StepForwardAsync" OnReset="ResetPlaybackAsync" CanStepBack="@CanStepBack" CanStepForwardOverride="@CanStepForward" StepTextOverride="@DisplayedStepText" TimelinePosition="@TimelinePosition" TimelineCount="@TimelineCount" />

        <div class="state-tabs-row">
            <div class="state-tabs" role="tablist" aria-label="Computational Graph state view">
                <button type="button" role="tab" aria-selected="@(_view == StateView.Visual)" class="@(_view == StateView.Visual ? "active" : string.Empty)" @onclick="() => _view = StateView.Visual">Visual state</button>
                <button type="button" role="tab" aria-selected="@(_view == StateView.Memory)" class="@(_view == StateView.Memory ? "active" : string.Empty)" @onclick="() => _view = StateView.Memory">Memory state</button>
            </div>
            <p>@ViewExplanation</p>
        </div>

        <div class="lesson-reference-links" aria-label="Computational Graph concept links">
            <ConceptLink Href="/learn/concepts/computational-graph">Computational Graph concepts →</ConceptLink>
            <ConceptLink Href="/graph-algorithms/topological">Dependency ordering →</ConceptLink>
            <ConceptLink Href="/ml-foundations/pca">Previous lesson: PCA →</ConceptLink>
        </div>

        <div class="state-surface ml-state-surface" tabindex="0">
            @if (_view == StateView.Visual)
            {
                <ComputationalGraphPlot Snapshot="@DisplayedSnapshot" />
            }
            else
            {
                <section class="cg-memory" aria-label="Computational Graph memory state">
                    <div class="memory-intro"><span>MEMORY STATE</span><strong>Each node stores identity, dependency indexes, value state, and execution status.</strong><p>Inputs begin with values. Operation nodes keep dependency IDs and receive one stored scalar only after every dependency is computed.</p></div>
                    <div class="memory-summary-strip">
                        <span><small>NODES</small><strong>@DisplayedSnapshot.NodeCount</strong></span>
                        <span><small>OPERATIONS</small><strong>@DisplayedSnapshot.OperationCount</strong></span>
                        <span><small>READY</small><strong>@DisplayedSnapshot.ReadyCount</strong></span>
                        <span><small>ORDER</small><strong>@EvaluationSequenceText(DisplayedSnapshot)</strong></span>
                    </div>
                    <div class="table-scroll"><table><thead><tr><th>ID</th><th>Node</th><th>Kind</th><th>Depends on</th><th>Value</th><th>Status</th><th>Eval #</th></tr></thead><tbody>
                    @foreach (var node in DisplayedSnapshot.Nodes)
                    {
                        <tr><td>@node.Id</td><td>@node.Label</td><td>@KindText(node.Kind)</td><td>@DependencyText(node)</td><td>@(node.HasValue ? Format(node.Value) : "—")</td><td>@MemoryStatus(node)</td><td>@(node.EvaluationOrder > 0 ? node.EvaluationOrder.ToString(CultureInfo.InvariantCulture) : "—")</td></tr>
                    }
                    </tbody></table></div>
                    <div class="memory-note"><strong>No automatic-differentiation or graph scheduler is hidden here.</strong><span>The Core stores arrays of nodes and dependency indexes, scans readiness explicitly, evaluates scalar operations with C# arithmetic, and writes each intermediate value itself. Backpropagation is intentionally not implemented in Step 10.</span></div>
                </section>
            }
        </div>

        <div class="run-dashboard compact-run-metrics cg-run-dashboard" aria-label="Computational Graph live metrics">
            <div><span>PHASE</span><strong>@PhaseText(DisplayedSnapshot.Phase)</strong></div>
            <div><span>READY</span><strong>@DisplayedSnapshot.ReadyCount</strong></div>
            <div><span>COMPUTED</span><strong>@DisplayedSnapshot.ComputedCount / @DisplayedSnapshot.NodeCount</strong></div>
            <div><span>OUTPUT</span><strong>@OutputMetric(DisplayedSnapshot)</strong></div>
        </div>
    </section>

    <section class="fit-section" aria-labelledby="cg-fit-title">
        <div class="section-heading-row"><div><span class="section-kicker">WHEN SHOULD I USE IT?</span><h2 id="cg-fit-title">Use a computational graph when the dependency structure itself needs to be inspected, reused, or differentiated.</h2><p>The graph adds bookkeeping, but that bookkeeping is exactly what later automatic differentiation and neural-network training need.</p></div></div>
        <div class="fit-grid">
            <article class="fit-card good"><span>GOOD FIT</span><strong>Multi-step numeric models with reusable intermediate values</strong><p>Neural networks, loss functions, and differentiable programs benefit when every operation and dependency is explicit.</p></article>
            <article class="fit-card avoid"><span>AVOID FOR</span><strong>One-off arithmetic where dependency inspection adds no value</strong><p>For a tiny calculation you never need to trace or differentiate, a normal expression is simpler and has less bookkeeping.</p></article>
            <article class="fit-card better"><span>BETTER ALTERNATIVE</span><strong>Use ordinary code when you only need the final number</strong><p>Use the graph when you need the path to that number. The next lesson puts a neuron onto this same dependency model.</p><div class="fit-links"><a href="/deep-learning/neuron-activations">Neuron + Activations →</a></div></article>
        </div>
    </section>

    <section class="practice-section" aria-labelledby="cg-practice-title">
        <div class="practice-heading"><div><span class="section-kicker">GUIDED PRACTICE</span><h2 id="cg-practice-title">Verify chains, branching, merging, and stored intermediate values.</h2><p>Tasks complete from the actual output and operation execution sequence produced by the Core graph.</p></div><strong>@_completedTaskIds.Count / @PracticeTasks.Length complete</strong></div>
        <div class="practice-grid">
            @foreach (var task in PracticeTasks)
            {
                <PracticeTaskCard TaskId="@task.Id" Title="@task.Title" Description="@task.Goal" InputText="@task.Suggested" HelpHref="/learn/concepts/computational-graph" Completed="@_completedTaskIds.Contains(task.Id)" Active="@(_activeTaskId == task.Id)" Busy="@IsBusy" HasEvidence="@(GetTaskEvidence(task.Id) is not null)" Start="@(() => StartTask(task.Id))" OpenEvidence="@(() => OpenTaskEvidence(task.Id))" />
            }
        </div>
    </section>

    <NextLessonCard Eyebrow="NEXT DEEP-LEARNING LESSON" Level="11 · Planned" Title="Neuron + Activation Functions" Description="Reuse the computational graph for weighted inputs, bias, and a visible activation function such as ReLU, sigmoid, or tanh." Href="/deep-learning/neuron-activations" LinkLabel="Preview Neuron + Activations" />
</div>

@if (_lastRunPopupOpen && _lastResult is not null)
{
    <div class="run-popup-backdrop" role="presentation" @onclick="CloseLastRunPopup">
        <section class="run-popup" role="dialog" aria-modal="true" aria-labelledby="cg-run-popup-title" @onclick:stopPropagation="true">
            <header><div><span class="section-kicker">LAST RUN</span><h2 id="cg-run-popup-title">@RunHeadline(_lastResult)</h2></div><button type="button" class="popup-close" @onclick="CloseLastRunPopup" aria-label="Close result explanation">×</button></header>
            <div class="popup-body">
                <p>@RunActionExplanation(_lastResult)</p>
                <div class="popup-metrics"><div><span>OUTPUT</span><strong>@Format(_lastResult.OutputValue)</strong></div><div><span>OPERATIONS</span><strong>@_lastResult.OperationCount</strong></div><div><span>EDGES</span><strong>@_lastResult.EdgeCount</strong></div><div><span>ORDER</span><strong>@ResultSequenceText(_lastResult)</strong></div></div>
                <p class="popup-memory">@RunMemoryExplanation(_lastResult)</p>
            </div>
        </section>
    </div>
}

<PracticeEvidencePopup Evidence="@_practiceEvidencePopup" OnClose="CloseTaskEvidence" />

@code {
    private const string ModuleKey = "computational-graph";
    private const string PopupSettingStorageKey = "algorithm-visualizer.computational-graph.show-run-popup.v1";

    private readonly List<RunFrame> _frames = [];
    private PracticeModuleProgress _practiceProgress = new();
    private HashSet<int> _completedTaskIds = [];
    private PracticeCompletionEvidence? _practiceEvidencePopup;
    private ComputationalGraphRunResult? _lastResult;
    private string? _lastCapturedStep;
    private string? _inputError;
    private InputEditor[] _inputs = WeightedBiasInputs();
    private Preset _preset = Preset.WeightedBias;
    private bool _showRunPopups = true;
    private bool _lastRunPopupOpen;
    private OutputSign? _prediction;
    private bool _predictionAnswered;
    private bool _predictionCorrect;
    private int _frameIndex = -1;
    private int? _activeTaskId;
    private StateView _view = StateView.Visual;

    private static readonly PracticeTaskDefinition[] PracticeTasks =
    [
        new(1, "Evaluate a weighted value + bias", "Run x × w + b and finish with output 5 in dependency order.", "Weighted + bias · x=2, w=3, b=-1", Preset.WeightedBias),
        new(2, "Branch one input into two operations", "Make x feed both x+y and x−y before those branches merge.", "Branch & merge · output 15", Preset.BranchMerge),
        new(3, "Use a unary square node", "Add x+b first, then let one square node consume that stored intermediate value.", "Square a sum · output 25", Preset.SquareSum),
        new(4, "Merge two independent weighted branches", "Compute two multiplies before the final add combines their stored values.", "Two weighted branches · output -1", Preset.TwoBranches),
        new(5, "Produce an exact zero", "Change a weighted+bias graph so the intermediate product is cancelled by the bias.", "x=2, w=2, b=-4 · output 0", Preset.ZeroOutput)
    ];

    private ComputationalGraphSnapshot Current => GraphLab.CreateSnapshot();
    private ComputationalGraphSnapshot DisplayedSnapshot => _frameIndex >= 0 && _frameIndex < _frames.Count ? _frames[_frameIndex].Snapshot : Current;
    private string DisplayedStepText => _frameIndex >= 0 && _frameIndex < _frames.Count ? _frames[_frameIndex].StepText : SimulationState.CurrentStepText;
    private int TimelineCount => _frames.Count;
    private int TimelinePosition => _frameIndex < 0 ? 0 : _frameIndex + 1;
    private bool CanStepBack => _frameIndex > 0;
    private bool CanStepForward => (_frameIndex >= 0 && _frameIndex < _frames.Count - 1) || SimulationState.IsRunning;
    private bool IsBusy => SimulationState.IsRunning;
    private string ViewExplanation => _view == StateView.Visual ? "See dependency edges unlock operation nodes and watch each stored value become available to downstream work." : "See the exact node records: dependency IDs, value presence, ready/computed flags, and forward evaluation order.";
    private string CurrentExpression => _preset switch { Preset.BranchMerge => "(x + y) × (x − y)", Preset.SquareSum => "(x + b)²", Preset.TwoBranches => "(x × w) + (y × v)", _ => "(x × w) + b" };
    private string CurrentExpressionExplanation => _preset switch { Preset.BranchMerge => "The same two inputs fan out into two ready operations, then those results merge.", Preset.SquareSum => "A unary square must wait until the add node has stored x+b.", Preset.TwoBranches => "Two independent multiplies can become ready together before the final add.", _ => "The add node cannot run until multiplication has produced its intermediate value." };
    private string PredictionFeedback => _lastResult is null ? string.Empty : _predictionCorrect ? $"Correct — the final output was {Format(_lastResult.OutputValue)}." : $"Not quite. The final output was {Format(_lastResult.OutputValue)}, so its sign was {SignText(SignOf(_lastResult.OutputValue)).ToLowerInvariant()}.";

    protected override void OnInitialized()
    {
        SimulationState.Changed += HandleSimulationChanged;
        try { _showRunPopups = !bool.TryParse(LearningStore.GetItem(PopupSettingStorageKey), out var saved) || saved; } catch { _showRunPopups = true; }
        _practiceProgress = PracticeProgress.Load(ModuleKey, null, PracticeTasks.Select(task => task.Id));
        _completedTaskIds = _practiceProgress.CompletedTaskIds;
        ConfigureCurrentGraph();
    }

    private void InputChanged(int index, ChangeEventArgs args)
    {
        if (index < 0 || index >= _inputs.Length) return;
        _inputs[index].Text = args.Value?.ToString() ?? string.Empty;
        _prediction = null;
        ClearReview();
        TryConfigureCurrentGraph();
    }

    private void SetPrediction(OutputSign sign) { if (IsBusy) return; _prediction = sign; _predictionAnswered = false; _predictionCorrect = false; }

    private bool TryConfigureCurrentGraph()
    {
        if (!TryReadInputs(out var values, out var error)) { _inputError = error; return false; }
        _inputError = null;
        try { GraphLab.Configure(BuildConfiguration(_preset, values)); }
        catch (ArgumentException ex) { _inputError = ex.Message; return false; }
        StateHasChanged();
        return true;
    }

    private void ConfigureCurrentGraph()
    {
        TryConfigureCurrentGraph();
        ClearReview();
    }

    private async Task RunAsync()
    {
        if (!TryConfigureCurrentGraph()) return;
        _frames.Clear(); _frameIndex = -1; _lastCapturedStep = null; _lastRunPopupOpen = false;
        var token = SimulationState.Start("Starting computational graph forward pass.");
        Capture();
        try
        {
            var result = await GraphLab.ExecuteAsync(token);
            if (!IsCurrent(token)) return;
            _lastResult = result;
            SimulationState.Complete(result.Summary);
            Capture();
            EvaluatePrediction(result);
            RecordPracticeResult(result);
            if (_showRunPopups) OpenLastRunPopup();
        }
        catch (OperationCanceledException) { }
        catch (InvalidOperationException ex)
        {
            if (IsCurrent(token)) { _inputError = ex.Message; SimulationState.Complete("The graph could not complete its forward pass."); Capture(); }
        }
        finally { await InvokeAsync(StateHasChanged); }
    }

    private void Capture()
    {
        var step = SimulationState.CurrentStepText;
        if (step == _lastCapturedStep) return;
        var followTail = _frameIndex < 0 || _frameIndex == _frames.Count - 1;
        _frames.Add(new RunFrame(step, GraphLab.CreateSnapshot()));
        _lastCapturedStep = step;
        if (followTail) _frameIndex = _frames.Count - 1;
    }

    private void HandleSimulationChanged() { if (SimulationState.IsRunning) Capture(); _ = InvokeAsync(StateHasChanged); }
    private bool IsCurrent(CancellationToken token) => !token.IsCancellationRequested && SimulationState.SimulationCancellationToken == token;
    private void ClearReview() { SimulationState.Reset(); _frames.Clear(); _frameIndex = -1; _lastCapturedStep = null; _lastRunPopupOpen = false; _lastResult = null; _predictionAnswered = false; }
    private Task PlayTimelineAsync() { if (_frames.Count > 0) _frameIndex = _frames.Count - 1; SimulationState.Resume(); return InvokeAsync(StateHasChanged); }
    private Task PauseTimelineAsync() { SimulationState.Pause(); return Task.CompletedTask; }
    private Task StepBackAsync() { if (SimulationState.IsRunning && !SimulationState.IsPaused) SimulationState.Pause(); if (_frameIndex > 0) _frameIndex--; return InvokeAsync(StateHasChanged); }
    private Task StepForwardAsync() { if (_frameIndex >= 0 && _frameIndex < _frames.Count - 1) { _frameIndex++; return InvokeAsync(StateHasChanged); } if (SimulationState.IsRunning) SimulationState.Step(); return Task.CompletedTask; }
    private Task ResetPlaybackAsync() { SimulationState.Reset(); _frames.Clear(); _frameIndex = -1; _lastCapturedStep = null; return InvokeAsync(StateHasChanged); }

    private void EvaluatePrediction(ComputationalGraphRunResult result)
    {
        _predictionAnswered = _prediction.HasValue;
        if (_predictionAnswered) _predictionCorrect = _prediction == SignOf(result.OutputValue);
    }

    private void LoadPreset(Preset preset, bool keepActiveTask = false)
    {
        if (IsBusy) return;
        _preset = preset;
        _inputs = preset switch { Preset.BranchMerge => BranchMergeInputs(), Preset.SquareSum => SquareSumInputs(), Preset.TwoBranches => TwoBranchesInputs(), Preset.ZeroOutput => ZeroOutputInputs(), _ => WeightedBiasInputs() };
        _prediction = null; _predictionAnswered = false;
        ConfigureCurrentGraph();
        if (!keepActiveTask) _activeTaskId = null;
    }

    private void StartTask(int taskId)
    {
        if (IsBusy) return;
        var task = PracticeTasks.First(item => item.Id == taskId);
        _activeTaskId = taskId;
        LoadPreset(task.Preset, keepActiveTask: true);
    }

    private void RecordPracticeResult(ComputationalGraphRunResult result)
    {
        if (_activeTaskId is not int taskId) return;
        var task = PracticeTasks.First(item => item.Id == taskId);
        if (!TaskSatisfied(task, result)) return;
        CompletePracticeTask(task, result);
    }

    private static bool TaskSatisfied(PracticeTaskDefinition task, ComputationalGraphRunResult result) => task.Id switch
    {
        1 => Nearly(result.OutputValue, 5d) && SequenceEquals(result.EvaluationSequence, [3,4]),
        2 => Nearly(result.OutputValue, 15d) && result.OperationCount == 3,
        3 => Nearly(result.OutputValue, 25d) && result.Nodes.Any(node => node.Operation == ComputationalGraphOperation.Square && node.HasValue),
        4 => Nearly(result.OutputValue, -1d) && SequenceEquals(result.EvaluationSequence, [4,5,6]),
        5 => Nearly(result.OutputValue, 0d),
        _ => false
    };

    private void CompletePracticeTask(PracticeTaskDefinition task, ComputationalGraphRunResult result)
    {
        var evidence = new PracticeCompletionEvidence(task.Id, task.Title, result.Summary, RunActionExplanation(result), "Each node record keeps dependency indexes and one scalar value slot. Inputs start computed; operation nodes change from waiting → ready → computed, while evaluationSequence[] records the forward order.", RunWhyExplanation(result), [new("Output", Format(result.OutputValue)), new("Operations", result.OperationCount.ToString(CultureInfo.InvariantCulture)), new("Edges", result.EdgeCount.ToString(CultureInfo.InvariantCulture)), new("Order", ResultSequenceText(result))], $"output={Format(result.OutputValue)} · order={ResultSequenceText(result)}");
        _completedTaskIds.Add(task.Id);
        PracticeProgress.Complete(ModuleKey, _practiceProgress, task.Id, evidence);
        _activeTaskId = null;
    }

    private PracticeCompletionEvidence? GetTaskEvidence(int taskId) => PracticeProgress.GetEvidence(_practiceProgress, taskId);
    private void OpenTaskEvidence(int taskId) => _practiceEvidencePopup = GetTaskEvidence(taskId);
    private void CloseTaskEvidence() => _practiceEvidencePopup = null;
    private void ToggleRunPopups(ChangeEventArgs args) { _showRunPopups = args.Value is bool value ? value : bool.TryParse(args.Value?.ToString(), out var parsed) && parsed; try { LearningStore.SetItem(PopupSettingStorageKey, _showRunPopups.ToString()); } catch { } }
    private void OpenLastRunPopup() { if (_lastResult is not null) _lastRunPopupOpen = true; }
    private void CloseLastRunPopup() => _lastRunPopupOpen = false;
    private string PresetClass(Preset preset) => _preset == preset ? "active" : string.Empty;
    private string PredictionClass(OutputSign sign) => _prediction == sign ? "active" : string.Empty;

    private bool TryReadInputs(out double[] values, out string error)
    {
        values = new double[_inputs.Length];
        for (var index = 0; index < _inputs.Length; index++)
        {
            if (!TryParseDouble(_inputs[index].Text, out var value) || !double.IsFinite(value)) { error = $"{_inputs[index].Symbol} must be a finite number."; values = []; return false; }
            values[index] = value;
        }
        error = string.Empty;
        return true;
    }

    private static ComputationalGraphConfiguration BuildConfiguration(Preset preset, IReadOnlyList<double> values) => preset switch
    {
        Preset.BranchMerge => new([
            Input(0,"x",values[0]), Input(1,"y",values[1]),
            Operation(2,"x + y",ComputationalGraphOperation.Add,0,1), Operation(3,"x − y",ComputationalGraphOperation.Subtract,0,1),
            Operation(4,"output",ComputationalGraphOperation.Multiply,2,3)],4),
        Preset.SquareSum => new([
            Input(0,"x",values[0]), Input(1,"b",values[1]), Operation(2,"x + b",ComputationalGraphOperation.Add,0,1), Operation(3,"output",ComputationalGraphOperation.Square,2)],3),
        Preset.TwoBranches => new([
            Input(0,"x",values[0]), Input(1,"w",values[1]), Input(2,"y",values[2]), Input(3,"v",values[3]),
            Operation(4,"x × w",ComputationalGraphOperation.Multiply,0,1), Operation(5,"y × v",ComputationalGraphOperation.Multiply,2,3), Operation(6,"output",ComputationalGraphOperation.Add,4,5)],6),
        _ => new([
            Input(0,"x",values[0]), Input(1,"w",values[1]), Input(2,"b",values[2]), Operation(3,"x × w",ComputationalGraphOperation.Multiply,0,1), Operation(4,"output",ComputationalGraphOperation.Add,3,2)],4)
    };

    private static ComputationalGraphNodeDefinition Input(int id, string label, double value) => new(id,label,ComputationalGraphNodeKind.Input,ComputationalGraphOperation.None,[],value);
    private static ComputationalGraphNodeDefinition Operation(int id, string label, ComputationalGraphOperation operation, params int[] dependencies) => new(id,label,ComputationalGraphNodeKind.Operation,operation,dependencies);

    private string DependencyText(ComputationalGraphNodeSnapshot node)
    {
        if (node.InputNodeIds.Length == 0) return "—";
        var parts = new string[node.InputNodeIds.Length];
        for (var index = 0; index < node.InputNodeIds.Length; index++) parts[index] = DisplayedSnapshot.Nodes[node.InputNodeIds[index]].Label;
        return string.Join(", ", parts);
    }

    private string EvaluationSequenceText(ComputationalGraphSnapshot snapshot)
    {
        if (snapshot.EvaluationSequence.Length == 0) return "—";
        var parts = new string[snapshot.EvaluationSequence.Length];
        for (var index = 0; index < parts.Length; index++) parts[index] = snapshot.Nodes[snapshot.EvaluationSequence[index]].Label;
        return string.Join(" → ", parts);
    }

    private static string ResultSequenceText(ComputationalGraphRunResult result)
    {
        if (result.EvaluationSequence.Length == 0) return "—";
        var parts = new string[result.EvaluationSequence.Length];
        for (var index = 0; index < parts.Length; index++) parts[index] = result.Nodes[result.EvaluationSequence[index]].Label;
        return string.Join(" → ", parts);
    }

    private static string KindText(ComputationalGraphNodeKind kind) => kind == ComputationalGraphNodeKind.Input ? "input value" : "operation";
    private static string MemoryStatus(ComputationalGraphNodeSnapshot node) => node.IsActive ? "evaluating" : node.IsReady ? "ready" : node.HasValue ? "computed" : "waiting";
    private static string PhaseText(ComputationalGraphPhase phase) => phase switch { ComputationalGraphPhase.InputsLoaded => "inputs", ComputationalGraphPhase.SelectingReadyNode => "ready scan", ComputationalGraphPhase.Evaluating => "evaluate", ComputationalGraphPhase.Complete => "complete", _ => "ready" };
    private static string OutputMetric(ComputationalGraphSnapshot snapshot) => snapshot.OutputValue is double value ? Format(value) : "—";
    private static string RunHeadline(ComputationalGraphRunResult result) => $"Forward pass produced output {Format(result.OutputValue)}.";
    private static string RunActionExplanation(ComputationalGraphRunResult result) => $"The graph evaluated {result.OperationCount} operation nodes only after their dependencies were available. Forward order: {ResultSequenceText(result)}.";
    private static string RunMemoryExplanation(ComputationalGraphRunResult result) => $"The run kept {result.NodeCount} node records and {result.EdgeCount} dependency references. Intermediate values stayed stored on their producing nodes so downstream operations could reuse them.";
    private static string RunWhyExplanation(ComputationalGraphRunResult result) => "The final number is only half the lesson. The graph also preserves exactly which stored values produced it, which is the structure later reverse-mode differentiation needs.";

    private static OutputSign SignOf(double value) => Math.Abs(value) <= 1e-10d ? OutputSign.Zero : value < 0d ? OutputSign.Negative : OutputSign.Positive;
    private static string SignText(OutputSign sign) => sign switch { OutputSign.Negative => "Negative", OutputSign.Zero => "Zero", _ => "Positive" };
    private static bool Nearly(double left, double right) => Math.Abs(left - right) <= 1e-9d;
    private static bool SequenceEquals(IReadOnlyList<int> actual, IReadOnlyList<int> expected) { if (actual.Count != expected.Count) return false; for (var i = 0; i < actual.Count; i++) if (actual[i] != expected[i]) return false; return true; }
    private static bool TryParseDouble(string? text, out double value) => double.TryParse(text, NumberStyles.Float, CultureInfo.InvariantCulture, out value) || double.TryParse(text, NumberStyles.Float, CultureInfo.CurrentCulture, out value);
    private static string Format(double value) => Math.Abs(value) < 1e-12d ? "0" : value.ToString("0.###", CultureInfo.InvariantCulture);

    private static InputEditor[] WeightedBiasInputs() => [new("x","input x","2"),new("w","weight","3"),new("b","bias","-1")];
    private static InputEditor[] BranchMergeInputs() => [new("x","shared input x","4"),new("y","shared input y","1")];
    private static InputEditor[] SquareSumInputs() => [new("x","input x","2"),new("b","added value","3")];
    private static InputEditor[] TwoBranchesInputs() => [new("x","first input","2"),new("w","first weight","0.5"),new("y","second input","-1"),new("v","second weight","2")];
    private static InputEditor[] ZeroOutputInputs() => [new("x","input x","2"),new("w","weight","2"),new("b","bias","-4")];

    public void Dispose() => SimulationState.Changed -= HandleSimulationChanged;

    private sealed record RunFrame(string StepText, ComputationalGraphSnapshot Snapshot);
    private sealed record PracticeTaskDefinition(int Id, string Title, string Goal, string Suggested, Preset Preset);
    private sealed class InputEditor(string symbol, string label, string text) { public string Symbol { get; } = symbol; public string Label { get; } = label; public string Text { get; set; } = text; }
    private enum Preset { WeightedBias, BranchMerge, SquareSum, TwoBranches, ZeroOutput }
    private enum OutputSign { Negative, Zero, Positive }
    private enum StateView { Visual, Memory }
}
