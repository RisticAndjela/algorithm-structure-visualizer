@page "/deep-learning/optimizers"
@using System.Globalization
@using AlgorithmVisualizer.Core.MachineLearning.DeepLearning.Optimizers
@implements IDisposable
@inject SimulationState SimulationState
@inject OptimizerSimulation OptimizerLab
@inject LearningSessionStore LearningStore
@inject PracticeProgressStore PracticeProgress

<PageTitle>SGD / Momentum / Adam — Deep Learning — Algorithm Visualizer</PageTitle>

<div class="learning-module-page learning-module-shell ml-module-page">
    <section class="learn-launchpad" aria-labelledby="opt-learn-title">
        <div class="learn-copy"><span class="section-kicker">LEARN FIRST</span><h2 id="opt-learn-title">The gradient says where loss increases. The optimizer decides how to use that signal over time.</h2><p>All three modes see the same cyclic stream of training samples. SGD uses the current sample gradient, Momentum remembers a smoothed direction, and Adam remembers both direction and recent squared magnitude.</p><ConceptLink class="learn-launchpad-link" Href="/learn/concepts/optimizers">Open SGD / Momentum / Adam concepts &amp; memory →</ConceptLink></div>
        <div class="learn-grid"><article class="learn-card purple"><span>1 · SAMPLE</span><strong>Use one training example.</strong><small>The order is deterministic so optimizer differences are comparable.</small></article><article class="learn-card blue"><span>2 · GRADIENT</span><strong>Compute dw and db at the current parameters.</strong><small>Optimizer state starts after the gradient exists.</small></article><article class="learn-card mint"><span>3 · REMEMBER</span><strong>Momentum and Adam keep history.</strong><small>Velocity / first moment / second moment change the effective update.</small></article><article class="learn-card gold"><span>4 · UPDATE</span><strong>Move weight and bias.</strong><small>Then measure full-dataset MSE before the next sample.</small></article></div>
    </section>

    <header class="module-header"><div class="header-copy"><div class="module-eyebrow"><span>DEEP LEARNING · PHASE 2 STEP 13</span><span class="separator">/</span><span class="live-status"><i></i> Interactive</span></div><h1>SGD / Momentum / Adam</h1><p>Compare three optimizer-state machines on the same dataset, start point, and cyclic sample order.</p></div><div class="complexity-summary"><div><span>Each step</span><strong>Θ(1)</strong><small>two scalar parameters in this lab</small></div><div><span>Extra state</span><strong>0 / 2 / 4</strong><small>SGD / Momentum / Adam scalars</small></div><div><span>Training edits</span><strong>Restart</strong><small>sample order and optimizer history are trace state</small></div></div></header>

    <section class="smart-tip"><span class="tip-icon">✦</span><div><strong>Compare optimizers under the same training conditions.</strong><p>Keep the dataset, sample order, start parameters, step budget, and learning-rate choice controlled. Once optimizers take different paths, their later gradients can legitimately differ.</p></div><ConceptLink Href="/learn/concepts/optimizers">See optimizer state equations →</ConceptLink></section>

    <section class="builder-section">
        <div class="section-heading-row"><div class="heading-with-step"><span class="step-number">1</span><div><span class="section-kicker">CHOOSE THE UPDATE RULE</span><h2>Keep the training stream fixed; change only the optimizer.</h2><p>These are real algorithm variants, so the mode selector is intentional rather than decorative.</p></div></div></div>
        <div class="dl-mode-row optimizer-modes"><span>OPTIMIZER</span>@foreach(var kind in Enum.GetValues<OptimizerKind>()){<button class="secondary-action @(_kind==kind?"active":string.Empty)" @onclick="() => SetKind(kind)" disabled="@IsBusy">@KindName(kind)</button>}</div>
        <div class="preset-row"><span>TRY A DATASET</span>@foreach(var p in Enum.GetValues<Preset>()){<button class="@(p==_preset?"active":string.Empty)" @onclick="() => LoadPreset(p)" disabled="@IsBusy">@PresetName(p)</button>}</div>
        <div class="dl-builder-card"><div class="dl-control-grid"><label><span>LEARNING RATE</span><input value="@_learningRateText" @oninput="LearningRateChanged" inputmode="decimal" disabled="@IsBusy" /></label><label><span>STOCHASTIC STEPS</span><input value="@_steps" @oninput="StepsChanged" inputmode="numeric" disabled="@IsBusy" /></label><label><span>START · w, b</span><input value="@_startText" @oninput="StartChanged" disabled="@IsBusy" /></label></div><div class="dl-inline-actions"><button class="secondary-action" @onclick="ToggleAdvanced" disabled="@IsBusy">@(_showAdvanced?"Hide dataset":"Inspect / edit dataset")</button></div>@if(_showAdvanced){<div class="dl-advanced"><div class="dl-control-grid two"><label><span>X VALUES</span><input value="@_xText" @oninput="XChanged" disabled="@IsBusy" /></label><label><span>Y VALUES</span><input value="@_yText" @oninput="YChanged" disabled="@IsBusy" /></label></div><small>Samples are consumed in the displayed order, then the index wraps around.</small></div>}@if(!string.IsNullOrWhiteSpace(_inputError)){<div class="input-error"><strong>Check optimizer settings.</strong><span>@_inputError</span></div>}</div>
    </section>

    <section class="predict-section"><div class="prediction-copy"><span class="step-number">2</span><div><span class="section-kicker">PREDICT FIRST</span><h2>After the selected number of stochastic updates, what happens to full-dataset MSE?</h2><p>Commit before the parameter path is revealed.</p></div></div><div class="prediction-card"><div class="prediction-actions"><button class="@PredictionClass(LossPrediction.Lower)" @onclick="() => SetPrediction(LossPrediction.Lower)">Lower</button><button class="@PredictionClass(LossPrediction.Same)" @onclick="() => SetPrediction(LossPrediction.Same)">Almost unchanged</button><button class="@PredictionClass(LossPrediction.Higher)" @onclick="() => SetPrediction(LossPrediction.Higher)">Higher</button></div>@if(_predictionAnswered){<p class="prediction-feedback @(_predictionCorrect?"correct":"incorrect")">@PredictionFeedback</p>}</div></section>

    <section class="lab-section">
        <div class="lab-heading"><div class="heading-with-step"><span class="step-number">3</span><div><span class="section-kicker">WATCH OPTIMIZER STATE</span><h2>Sample → gradient → optimizer memory → parameter update.</h2></div></div><div class="lab-actions"><label class="popup-toggle"><input type="checkbox" checked="@_showRunPopups" @onchange="ToggleRunPopups" /><span>Open explanation after run</span></label>@if(_lastResult is not null){<button class="secondary-action" @onclick="OpenLastRunPopup">Last explanation</button>}<button class="sort-button" @onclick="RunAsync" disabled="@IsBusy"><span>▶</span> Run @KindName(_kind)</button></div></div>
        <SimulationToolbar OnPlay="PlayTimelineAsync" OnPause="PauseTimelineAsync" OnStepBack="StepBackAsync" OnStepForward="StepForwardAsync" OnReset="ResetPlaybackAsync" CanStepBack="@CanStepBack" CanStepForwardOverride="@CanStepForward" StepTextOverride="@DisplayedStepText" TimelinePosition="@TimelinePosition" TimelineCount="@TimelineCount" />
        <div class="state-tabs-row"><div class="state-tabs"><button class="@(_view==StateView.Visual?"active":string.Empty)" @onclick="() => _view=StateView.Visual">Visual state</button><button class="@(_view==StateView.Memory?"active":string.Empty)" @onclick="() => _view=StateView.Memory">Memory state</button></div><p>@ViewExplanation</p></div>
        <div class="lesson-reference-links"><ConceptLink Href="/learn/concepts/optimizers">Optimizer concepts →</ConceptLink><ConceptLink Href="/deep-learning/backpropagation">Where gradients come from →</ConceptLink><ConceptLink Href="/ml-foundations/gradient-descent">Gradient Descent refresher →</ConceptLink></div>
        <div class="state-surface ml-state-surface">@if(_view==StateView.Visual){<div class="ml-visual-board" tabindex="0"><OptimizerPath Snapshot="@DisplayedSnapshot" TargetWeight="@_targetWeight" TargetBias="@_targetBias" /></div>}else{<div class="dl-memory-grid"><article class="dl-memory-card"><span>PARAMETERS</span><strong>w=@F(DisplayedSnapshot.Weight) · b=@F(DisplayedSnapshot.Bias)</strong><small>The model has two trainable scalar parameters.</small></article><article class="dl-memory-card"><span>CURRENT GRADIENT</span><strong>dw=@F(DisplayedSnapshot.GradientWeight) · db=@F(DisplayedSnapshot.GradientBias)</strong><small>Computed from one stochastic sample.</small></article><article class="dl-memory-card"><span>FIRST MOMENT / VELOCITY</span><strong>@F(DisplayedSnapshot.FirstMomentWeight), @F(DisplayedSnapshot.FirstMomentBias)</strong><small>SGD leaves these at zero; Momentum and Adam update them.</small></article><article class="dl-memory-card"><span>SECOND MOMENT</span><strong>@F(DisplayedSnapshot.SecondMomentWeight), @F(DisplayedSnapshot.SecondMomentBias)</strong><small>Only Adam tracks squared-gradient magnitude.</small></article></div>}</div>
        <div class="run-dashboard compact-run-metrics"><div><span>MODE</span><strong>@KindName(DisplayedSnapshot.Kind)</strong></div><div><span>STEP</span><strong>@DisplayedSnapshot.StepIndex / @_steps</strong></div><div><span>MSE</span><strong>@F(DisplayedSnapshot.DatasetMse)</strong></div><div><span>w / b</span><strong>@F(DisplayedSnapshot.Weight) / @F(DisplayedSnapshot.Bias)</strong></div></div>
    </section>

    <section class="fit-section"><div class="section-heading-row"><div><span class="section-kicker">WHEN SHOULD I USE IT?</span><h2>Choose an optimizer when gradients are available but raw repeated updates are noisy, slow, or badly scaled.</h2></div></div><div class="fit-grid"><article class="fit-card good"><span>GOOD FIT</span><strong>SGD for a simple baseline; Momentum for persistent direction; Adam for adaptive per-parameter scaling</strong><p>The right choice depends on model, gradient noise, learning-rate tuning, and generalization behavior — not just which curve falls fastest in one demo.</p></article><article class="fit-card avoid"><span>AVOID FOR</span><strong>Treating Adam as a guarantee of better final models</strong><p>Fast early optimization does not automatically mean better validation performance. Optimizer state changes the training dynamics, not the learning objective.</p></article><article class="fit-card better"><span>BETTER ALTERNATIVE</span><strong>Use plain Gradient Descent when stochasticity is not the lesson</strong><p>Use Backpropagation when you need to understand gradient computation itself. This lab starts after gradients already exist.</p><div class="fit-links"><a href="/ml-foundations/gradient-descent">Gradient Descent →</a><a href="/deep-learning/backpropagation">Backpropagation →</a></div></article></div></section>

    <section class="practice-section"><div class="practice-heading"><div><span class="section-kicker">GUIDED PRACTICE</span><h2>Compare optimizer memory, not just the final number.</h2></div><strong>@_completedTaskIds.Count / @PracticeTasks.Length complete</strong></div><div class="practice-grid">@foreach(var t in PracticeTasks){<PracticeTaskCard TaskId="@t.Id" Title="@t.Title" Description="@t.Goal" InputText="@t.Suggested" HelpHref="/learn/concepts/optimizers" Completed="@_completedTaskIds.Contains(t.Id)" Active="@(_activeTaskId==t.Id)" Busy="@IsBusy" HasEvidence="@(GetTaskEvidence(t.Id)is not null)" Start="@(() => StartTask(t.Id))" OpenEvidence="@(() => OpenTaskEvidence(t.Id))" />}</div></section>

    <NextLessonCard Eyebrow="NEXT TRACK · GRAPH ML" Level="14 · Planned" Title="Sparse Matrix" Description="Phase 2 is complete. Next, connect graph-scale data to compact sparse storage before PageRank, spectral methods, and message passing." Href="/graph-ml/sparse-matrix" LinkLabel="Preview Sparse Matrix" />
</div>

@if(_lastRunPopupOpen&&_lastResult is not null){<div class="run-popup-backdrop" @onclick="CloseLastRunPopup"><section class="run-popup" role="dialog" aria-modal="true" @onclick:stopPropagation="true"><header><div><span class="section-kicker">LAST RUN</span><h2>@KindName(_lastResult.Kind): MSE @F(_lastResult.InitialMse) → @F(_lastResult.FinalMse)</h2></div><button class="popup-close" @onclick="CloseLastRunPopup">×</button></header><div class="popup-body"><p>@_lastResult.Summary</p><div class="popup-metrics"><div><span>STEPS</span><strong>@_lastResult.Steps</strong></div><div><span>FINAL w</span><strong>@F(_lastResult.FinalWeight)</strong></div><div><span>FINAL b</span><strong>@F(_lastResult.FinalBias)</strong></div><div><span>MSE LOWER?</span><strong>@(_lastResult.Improved?"Yes":"No")</strong></div></div><p class="popup-memory">SGD stores no running optimizer state. Momentum stores one first-moment/velocity pair. Adam stores both first- and second-moment pairs and bias-corrects them by step index.</p></div></section></div>}
<PracticeEvidencePopup Evidence="@_practiceEvidencePopup" OnClose="CloseTaskEvidence" />

@code {
    private const string ModuleKey="optimizers";private const string PopupKey="algorithm-visualizer.optimizers.show-run-popup.v1";private readonly List<RunFrame> _frames=[];private PracticeModuleProgress _practiceProgress=new();private HashSet<int> _completedTaskIds=[];private PracticeCompletionEvidence? _practiceEvidencePopup;private OptimizerRunResult? _lastResult;private string? _lastCapturedStep;private string? _inputError;private OptimizerKind _kind=OptimizerKind.Sgd;private Preset? _preset=Preset.CleanLine;private string _learningRateText="0.08",_startText="0, 0",_xText="-1, 0, 1, 2",_yText="-1, 1, 3, 5";private int _steps=16;private double _targetWeight=2,_targetBias=1;private bool _showAdvanced,_showRunPopups=true,_lastRunPopupOpen,_predictionAnswered,_predictionCorrect;private LossPrediction? _prediction;private int _frameIndex=-1;private int? _activeTaskId;private StateView _view=StateView.Visual;
    private static readonly PracticeTaskDefinition[] PracticeTasks=[new(1,"Run plain SGD","Verify SGD lowers MSE without storing running first or second moments.","SGD · clean line",OptimizerKind.Sgd,Preset.CleanLine),new(2,"Build momentum memory","Run Momentum and verify its first-moment state becomes non-zero.","Momentum · clean line",OptimizerKind.Momentum,Preset.CleanLine),new(3,"Build Adam moments","Run Adam and verify both first and second moment state become non-zero.","Adam · clean line",OptimizerKind.Adam,Preset.CleanLine),new(4,"Handle a steeper line","Run one optimizer on the steep dataset and still reduce MSE from the shared start.","Steep line",OptimizerKind.Adam,Preset.SteepLine)];
    private OptimizerSnapshot DisplayedSnapshot=>_frameIndex>=0&&_frameIndex<_frames.Count?_frames[_frameIndex].Snapshot:OptimizerLab.CreateSnapshot();private string DisplayedStepText=>_frameIndex>=0&&_frameIndex<_frames.Count?_frames[_frameIndex].StepText:SimulationState.CurrentStepText;private bool IsBusy=>SimulationState.IsRunning;private int TimelineCount=>_frames.Count;private int TimelinePosition=>_frameIndex<0?0:_frameIndex+1;private bool CanStepBack=>_frameIndex>0;private bool CanStepForward=>(_frameIndex>=0&&_frameIndex<_frames.Count-1)||SimulationState.IsRunning;private string ViewExplanation=>_view==StateView.Visual?"Follow the parameter path in (weight,bias) space. The board scrolls independently if the path grows beyond the viewport.":"Compare raw gradient, first-moment/velocity state, second-moment state, and the actual parameters.";private string PredictionFeedback=>_predictionCorrect?"Correct — the full-dataset MSE moved in that direction.":$"MSE changed {F(_lastResult?.InitialMse??0)} → {F(_lastResult?.FinalMse??0)}.";
    protected override void OnInitialized(){SimulationState.Changed+=HandleSimulationChanged;try{_showRunPopups=!bool.TryParse(LearningStore.GetItem(PopupKey),out var saved)||saved;}catch{_showRunPopups=true;}_practiceProgress=PracticeProgress.Load(ModuleKey,null,PracticeTasks.Select(t=>t.Id));_completedTaskIds=_practiceProgress.CompletedTaskIds;ApplyInputs();}
    private void ToggleAdvanced()=>_showAdvanced=!_showAdvanced;private void SetKind(OptimizerKind k){if(IsBusy)return;_kind=k;ApplyInputs();}private void LearningRateChanged(ChangeEventArgs e){_learningRateText=e.Value?.ToString()??"";_preset=null;ApplyInputs();}private void StepsChanged(ChangeEventArgs e){if(int.TryParse(e.Value?.ToString(),out var s)){_steps=Math.Clamp(s,1,80);ApplyInputs();}}private void StartChanged(ChangeEventArgs e){_startText=e.Value?.ToString()??"";_preset=null;ApplyInputs();}private void XChanged(ChangeEventArgs e){_xText=e.Value?.ToString()??"";_preset=null;ApplyInputs();}private void YChanged(ChangeEventArgs e){_yText=e.Value?.ToString()??"";_preset=null;ApplyInputs();}private void SetPrediction(LossPrediction p){_prediction=p;_predictionAnswered=false;_predictionCorrect=false;}
    private void LoadPreset(Preset p){if(IsBusy)return;_preset=p;_startText="0, 0";_steps=16;if(p==Preset.CleanLine){_xText="-1, 0, 1, 2";_yText="-1, 1, 3, 5";_targetWeight=2;_targetBias=1;}else if(p==Preset.SteepLine){_xText="-1, 0, 1, 2";_yText="-2, 1, 4, 7";_targetWeight=3;_targetBias=1;}else{_xText="-2, -1, 0, 1, 2";_yText="-2.7, -1.2, 0.7, 2.2, 3.9";_targetWeight=1.65;_targetBias=.6;}_learningRateText="0.08";ApplyInputs();}
    private void ApplyInputs(){if(!TryVector(_xText,out var x)||!TryVector(_yText,out var y)||!TryVector(_startText,out var start)||start.Length!=2||!TryDouble(_learningRateText,out var lr)){_inputError="Use finite comma-separated x/y values, start as w,b, and a finite learning rate.";return;}try{OptimizerLab.Configure(new OptimizerConfiguration(x,y,start[0],start[1],lr,_steps,_kind));_inputError=null;ClearReview();}catch(ArgumentException ex){_inputError=ex.Message;}StateHasChanged();}
    private async Task RunAsync(){ApplyInputs();if(_inputError is not null)return;_frames.Clear();_frameIndex=-1;_lastCapturedStep=null;var token=SimulationState.Start($"Starting {KindName(_kind)}.");Capture();try{var r=await OptimizerLab.ExecuteAsync(token);if(!IsCurrent(token))return;_lastResult=r;SimulationState.Complete(r.Summary);Capture();EvaluatePrediction(r);RecordPractice(r);if(_showRunPopups)OpenLastRunPopup();}catch(OperationCanceledException)when(!IsCurrent(token)){} }
    private void Capture(){var step=SimulationState.CurrentStepText;if(step==_lastCapturedStep)return;var follow=_frameIndex<0||_frameIndex==_frames.Count-1;_frames.Add(new RunFrame(step,OptimizerLab.CreateSnapshot()));_lastCapturedStep=step;if(follow)_frameIndex=_frames.Count-1;}private void HandleSimulationChanged(){if(SimulationState.IsRunning)Capture();_=InvokeAsync(StateHasChanged);}private bool IsCurrent(CancellationToken t)=>!t.IsCancellationRequested&&SimulationState.SimulationCancellationToken==t;private void ClearReview(){SimulationState.Reset();_frames.Clear();_frameIndex=-1;_lastCapturedStep=null;_lastResult=null;_lastRunPopupOpen=false;_predictionAnswered=false;}
    private Task PlayTimelineAsync(){if(_frames.Count>0)_frameIndex=_frames.Count-1;SimulationState.Resume();return InvokeAsync(StateHasChanged);}private Task PauseTimelineAsync(){SimulationState.Pause();return Task.CompletedTask;}private Task StepBackAsync(){if(SimulationState.IsRunning&&!SimulationState.IsPaused)SimulationState.Pause();if(_frameIndex>0)_frameIndex--;return InvokeAsync(StateHasChanged);}private Task StepForwardAsync(){if(_frameIndex>=0&&_frameIndex<_frames.Count-1){_frameIndex++;return InvokeAsync(StateHasChanged);}if(SimulationState.IsRunning)SimulationState.Step();return Task.CompletedTask;}private Task ResetPlaybackAsync(){SimulationState.Reset();_frames.Clear();_frameIndex=-1;_lastCapturedStep=null;return InvokeAsync(StateHasChanged);}
    private void EvaluatePrediction(OptimizerRunResult r){if(_prediction is null)return;var d=r.FinalMse-r.InitialMse;var actual=Math.Abs(d)<1e-6?LossPrediction.Same:d<0?LossPrediction.Lower:LossPrediction.Higher;_predictionAnswered=true;_predictionCorrect=_prediction==actual;}private string PredictionClass(LossPrediction p)=>_prediction==p?"active":string.Empty;
    private void ToggleRunPopups(ChangeEventArgs e){_showRunPopups=e.Value is bool b&&b;LearningStore.SetItem(PopupKey,_showRunPopups.ToString());}private void OpenLastRunPopup()=>_lastRunPopupOpen=_lastResult is not null;private void CloseLastRunPopup()=>_lastRunPopupOpen=false;
    private void StartTask(int id){var t=PracticeTasks.First(x=>x.Id==id);_activeTaskId=id;_kind=t.Kind;LoadPreset(t.Preset);}private void RecordPractice(OptimizerRunResult r){if(_activeTaskId is null)return;var t=PracticeTasks.First(x=>x.Id==_activeTaskId);var s=OptimizerLab.CreateSnapshot();var firstNonZero=Math.Abs(s.FirstMomentWeight)+Math.Abs(s.FirstMomentBias)>1e-10;var secondNonZero=Math.Abs(s.SecondMomentWeight)+Math.Abs(s.SecondMomentBias)>1e-10;var ok=t.Id switch{1=>r.Kind==OptimizerKind.Sgd&&r.Improved&&!firstNonZero&&!secondNonZero,2=>r.Kind==OptimizerKind.Momentum&&r.Improved&&firstNonZero&&!secondNonZero,3=>r.Kind==OptimizerKind.Adam&&r.Improved&&firstNonZero&&secondNonZero,4=>r.Improved,_=>false};if(!ok)return;var ev=new PracticeCompletionEvidence(t.Id,t.Title,r.Summary,$"{KindName(r.Kind)} moved MSE {F(r.InitialMse)} → {F(r.FinalMse)}.",$"Optimizer state after the run: first moment ({F(s.FirstMomentWeight)}, {F(s.FirstMomentBias)}), second moment ({F(s.SecondMomentWeight)}, {F(s.SecondMomentBias)}).","The same sample sequence can create different gradient histories and parameter paths because optimizer memory changes each effective update.",[new("Mode",KindName(r.Kind)),new("Initial MSE",F(r.InitialMse)),new("Final MSE",F(r.FinalMse)),new("Steps",r.Steps.ToString())],$"{KindName(r.Kind)} · mse={F(r.InitialMse)}->{F(r.FinalMse)}");_completedTaskIds.Add(t.Id);PracticeProgress.Complete(ModuleKey,_practiceProgress,t.Id,ev);_activeTaskId=null;}
    private PracticeCompletionEvidence? GetTaskEvidence(int id)=>PracticeProgress.GetEvidence(_practiceProgress,id);private void OpenTaskEvidence(int id)=>_practiceEvidencePopup=GetTaskEvidence(id);private void CloseTaskEvidence()=>_practiceEvidencePopup=null;
    private static bool TryVector(string s,out double[] v){var p=s.Split(',',StringSplitOptions.RemoveEmptyEntries|StringSplitOptions.TrimEntries);v=new double[p.Length];if(p.Length<1||p.Length>20)return false;for(var i=0;i<p.Length;i++)if(!double.TryParse(p[i],NumberStyles.Float,CultureInfo.InvariantCulture,out v[i])||!double.IsFinite(v[i]))return false;return true;}private static bool TryDouble(string s,out double v)=>double.TryParse(s,NumberStyles.Float,CultureInfo.InvariantCulture,out v)&&double.IsFinite(v);private static string F(double v)=>Math.Abs(v)<1e-10?"0":v.ToString("0.####",CultureInfo.InvariantCulture);private static string KindName(OptimizerKind k)=>k switch{OptimizerKind.Sgd=>"SGD",OptimizerKind.Momentum=>"Momentum",OptimizerKind.Adam=>"Adam",_=>k.ToString()};private static string PresetName(Preset p)=>p switch{Preset.CleanLine=>"Clean line",Preset.SteepLine=>"Steep line",Preset.NoisyLine=>"Noisy line",_=>p.ToString()};public void Dispose()=>SimulationState.Changed-=HandleSimulationChanged;
    private sealed record RunFrame(string StepText,OptimizerSnapshot Snapshot);private sealed record PracticeTaskDefinition(int Id,string Title,string Goal,string Suggested,OptimizerKind Kind,Preset Preset);private enum Preset{CleanLine,SteepLine,NoisyLine}private enum LossPrediction{Lower,Same,Higher}private enum StateView{Visual,Memory}
}
