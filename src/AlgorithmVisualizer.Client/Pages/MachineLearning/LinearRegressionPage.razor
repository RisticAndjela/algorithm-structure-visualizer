@page "/ml-foundations/linear-regression"
@using System.Globalization
@using AlgorithmVisualizer.Core.MachineLearning.Supervised.LinearRegression
@implements IDisposable
@inject SimulationState SimulationState
@inject LinearRegressionSimulation LinearRegressionLab
@inject LearningSessionStore LearningStore
@inject PracticeProgressStore PracticeProgress

<PageTitle>Linear Regression — Machine Learning — Algorithm Visualizer</PageTitle>

<div class="lr-page learning-module-page learning-module-shell">
    <section class="learn-launchpad" aria-labelledby="lr-learn-title">
        <div class="learn-copy">
            <span class="section-kicker">LEARN FIRST</span>
            <h2 id="lr-learn-title">Linear Regression fits one line by repeatedly making prediction error smaller.</h2>
            <p>For each x value, the model predicts ŷ = w·x + b. Residuals show how far predictions miss the real points; mean squared error turns those misses into one loss.</p>
            <ConceptLink class="learn-launchpad-link" Href="/learn/concepts/linear-regression">Open Linear Regression concepts &amp; memory →</ConceptLink>
        </div>
        <div class="learn-grid">
            <article class="learn-card purple"><span>1 · PREDICT</span><strong>Use the current line.</strong><small>ŷ = w·x + b gives one prediction for every x.</small></article>
            <article class="learn-card blue"><span>2 · COMPARE</span><strong>Prediction − actual = residual.</strong><small>The sign shows which side of the point the line lands on.</small></article>
            <article class="learn-card mint"><span>3 · MEASURE</span><strong>MSE summarizes all residuals.</strong><small>Square the misses, then average them.</small></article>
            <article class="learn-card gold"><span>4 · IMPROVE</span><strong>Gradient Descent moves w and b.</strong><small>Training changes the line, then measures again.</small></article>
        </div>
    </section>

    <header class="module-header">
        <div class="header-copy">
            <div class="module-eyebrow"><span>MACHINE LEARNING · PHASE 1 STEP 3</span><span class="separator">/</span><span class="live-status"><i></i> Interactive</span></div>
            <h1>Linear Regression</h1>
            <p>Fit a straight line to training examples using the Gradient Descent idea from the previous lesson.</p>
        </div>
        <div class="complexity-summary" aria-label="Linear Regression training complexity">
            <div><span>Training work</span><strong>Θ(k·n)</strong><small>k updates across n examples</small></div>
            <div><span>Working memory</span><strong>O(n)</strong><small>predictions + residuals</small></div>
            <div><span>Edit during run</span><strong>Restart</strong><small>training uses one fixed dataset</small></div>
        </div>
    </header>

    <section class="smart-tip" aria-label="Linear Regression learning tip">
        <span class="tip-icon">✦</span>
        <div><strong>Keep model and optimizer separate.</strong><p>Linear Regression defines prediction, residuals, MSE and the gradients. Gradient Descent is the repeated rule that uses those gradients to update weight and bias.</p></div>
        <ConceptLink Href="/learn/concepts/linear-regression">See the full training loop →</ConceptLink>
    </section>

    <section class="builder-section" aria-labelledby="lr-build-title">
        <div class="section-heading-row">
            <div class="heading-with-step"><span class="step-number">1</span><div><span class="section-kicker">BUILD THE TRAINING EXAMPLE</span><h2 id="lr-build-title">Choose points, then choose where the line starts.</h2><p>Start with a preset. Edit raw points only when you want a custom dataset.</p></div></div>
            <ConceptLink Href="/learn/concepts/linear-regression">What are weight and bias? →</ConceptLink>
        </div>

        <div class="preset-row" aria-label="Linear Regression dataset examples">
            <span>TRY AN EXAMPLE</span>
            <button type="button" class="@PresetClass(Preset.Upward)" @onclick="() => LoadPreset(Preset.Upward)" disabled="@IsBusy">Upward line</button>
            <button type="button" class="@PresetClass(Preset.Downward)" @onclick="() => LoadPreset(Preset.Downward)" disabled="@IsBusy">Downward line</button>
            <button type="button" class="@PresetClass(Preset.Offset)" @onclick="() => LoadPreset(Preset.Offset)" disabled="@IsBusy">Different intercept</button>
            <button type="button" class="@PresetClass(Preset.Noisy)" @onclick="() => LoadPreset(Preset.Noisy)" disabled="@IsBusy">Noisy points</button>
            <button type="button" class="@PresetClass(Preset.AlreadyFit)" @onclick="() => LoadPreset(Preset.AlreadyFit)" disabled="@IsBusy">Already fitted</button>
        </div>

        <div class="lr-builder-card">
            <div class="lr-dataset-preview" aria-label="Current training dataset">
                <div class="dataset-heading"><span>TRAINING POINTS</span><strong>@_x.Length examples</strong></div>
                <div class="dataset-points">
                    @for (var index = 0; index < _x.Length; index++)
                    {
                        <span><small>x = @Format(_x[index])</small><strong>y = @Format(_y[index])</strong></span>
                    }
                </div>
            </div>

            <div class="lr-model-settings">
                <label><span>STARTING WEIGHT · w</span><input value="@_weightText" @oninput="WeightChanged" disabled="@IsBusy" inputmode="decimal" /></label>
                <label><span>STARTING BIAS · b</span><input value="@_biasText" @oninput="BiasChanged" disabled="@IsBusy" inputmode="decimal" /></label>
                <label><span>STEP SIZE · LEARNING RATE</span><input value="@_learningRateText" @oninput="LearningRateChanged" disabled="@IsBusy" inputmode="decimal" /></label>
            </div>

            <div class="settings-actions">
                <button class="secondary-action" type="button" @onclick="ToggleAdvancedSettings" disabled="@IsBusy">@(_showAdvancedSettings ? "Hide extra settings" : "Edit dataset / stopping")</button>
                <button class="primary-action" type="button" @onclick="ApplyInputs" disabled="@IsBusy">Use these values</button>
            </div>

            @if (_showAdvancedSettings)
            {
                <div class="advanced-settings-panel">
                    <label class="dataset-editor"><span>CUSTOM POINTS · x,y; x,y; ...</span><textarea value="@_datasetText" @oninput="DatasetChanged" disabled="@IsBusy" rows="3"></textarea><small>Use 2–8 finite points. Example: 0,1; 1,3; 2,5</small></label>
                    <div class="lr-model-settings advanced-grid">
                        <label><span>MAX UPDATES</span><input value="@_iterationsText" @oninput="IterationsChanged" disabled="@IsBusy" inputmode="numeric" /></label>
                        <label><span>STOP WHEN GRADIENT ≤</span><input value="@_toleranceText" @oninput="ToleranceChanged" disabled="@IsBusy" inputmode="decimal" /></label>
                    </div>
                </div>
            }
        </div>

        @if (!string.IsNullOrWhiteSpace(_inputError))
        {
            <div class="input-error" role="alert"><strong>Check the training setup.</strong><span>@_inputError</span></div>
        }
    </section>

    <section class="predict-section" aria-labelledby="lr-predict-title">
        <div class="prediction-copy">
            <span class="step-number">2</span>
            <div><span class="section-kicker">PREDICT FIRST</span><h2 id="lr-predict-title">What should happen to the weight on the first update?</h2><p>Commit before training. The app checks the first real Gradient Descent update.</p></div>
        </div>
        <div class="prediction-card">
            <div class="prediction-actions">
                <button type="button" class="@PredictionClass(WeightPrediction.Increase)" @onclick="() => SetPrediction(WeightPrediction.Increase)" disabled="@IsBusy">Weight increases</button>
                <button type="button" class="@PredictionClass(WeightPrediction.Decrease)" @onclick="() => SetPrediction(WeightPrediction.Decrease)" disabled="@IsBusy">Weight decreases</button>
                <button type="button" class="@PredictionClass(WeightPrediction.Same)" @onclick="() => SetPrediction(WeightPrediction.Same)" disabled="@IsBusy">Almost unchanged</button>
            </div>
            @if (_predictionAnswered)
            {
                <p class="prediction-feedback @(_predictionCorrect ? "correct" : "incorrect")">@PredictionFeedback</p>
            }
        </div>
    </section>

    <section class="lab-section" aria-labelledby="lr-lab-title">
        <div class="lab-heading">
            <div class="heading-with-step"><span class="step-number">3</span><div><span class="section-kicker">WATCH THE MODEL TRAIN</span><h2 id="lr-lab-title">Predict → measure error → compute gradient → update the line.</h2></div></div>
            <div class="lab-actions">
                <label class="popup-toggle"><input type="checkbox" checked="@_showRunPopups" @onchange="ToggleRunPopups" /><span>Open explanation after run</span></label>
                @if (_lastResult is not null)
                {
                    <button class="secondary-action" type="button" @onclick="OpenLastRunPopup">Last explanation</button>
                }
                <button class="sort-button" type="button" @onclick="RunAsync" disabled="@IsBusy"><span>▶</span> Train this line</button>
            </div>
        </div>

        <div class="state-tabs-row">
            <div class="state-tabs" role="tablist" aria-label="Linear Regression state view">
                <button type="button" role="tab" aria-selected="@(_view == StateView.Visual)" class="@(_view == StateView.Visual ? "active" : string.Empty)" @onclick="() => _view = StateView.Visual">Visual state</button>
                <button type="button" role="tab" aria-selected="@(_view == StateView.Memory)" class="@(_view == StateView.Memory ? "active" : string.Empty)" @onclick="() => _view = StateView.Memory">Memory state</button>
            </div>
            <p>@ViewExplanation</p>
        </div>

        <div class="lesson-reference-links" aria-label="Linear Regression concept links">
            <ConceptLink Href="/learn/concepts/linear-regression">Linear Regression concepts →</ConceptLink>
            <ConceptLink Href="/learn/concepts/gradient-descent">Gradient Descent refresher →</ConceptLink>
            <ConceptLink Href="/structures/vector">Vector storage refresher →</ConceptLink>
        </div>

        <div class="state-surface">
            @if (_view == StateView.Visual)
            {
                <LinearRegressionPlot Snapshot="@DisplayedSnapshot" />
            }
            else
            {
                <section class="lr-memory-state" aria-label="Linear Regression memory state">
                    <div class="memory-intro"><span>MEMORY STATE</span><strong>Four aligned numeric vectors + two model parameters</strong><p>At index i, x[i], y[i], prediction[i], and residual[i] always describe the same training example.</p></div>
                    <div class="parameter-strip">
                        <span><small>WEIGHT · w</small><strong>@Format(DisplayedSnapshot.Weight)</strong></span>
                        <span><small>BIAS · b</small><strong>@Format(DisplayedSnapshot.Bias)</strong></span>
                        <span><small>dw</small><strong>@Format(DisplayedSnapshot.WeightGradient)</strong></span>
                        <span><small>db</small><strong>@Format(DisplayedSnapshot.BiasGradient)</strong></span>
                        <span><small>MSE</small><strong>@Format(DisplayedSnapshot.Loss)</strong></span>
                    </div>
                    <div class="table-scroll"><table><thead><tr><th>Index</th><th>x[]</th><th>y[]</th><th>prediction[]</th><th>residual[]</th></tr></thead><tbody>
                    @for (var index = 0; index < DisplayedSnapshot.Count; index++)
                    {
                        <tr><td>@index</td><td>@Format(DisplayedSnapshot.X[index])</td><td>@Format(DisplayedSnapshot.Y[index])</td><td>@Format(DisplayedSnapshot.Predictions[index])</td><td>@Format(DisplayedSnapshot.Residuals[index])</td></tr>
                    }
                    </tbody></table></div>
                    <div class="memory-note"><strong>Core uses the project's ManualVector.</strong><span>The model does not call an ML or statistics library. Prediction, MSE, derivatives, and updates are explicit loops.</span></div>
                </section>
            }
        </div>

        <SimulationToolbar OnPlay="PlayTimelineAsync"
                           OnPause="PauseTimelineAsync"
                           OnStepBack="StepBackAsync"
                           OnStepForward="StepForwardAsync"
                           OnReset="ResetPlaybackAsync"
                           CanStepBack="@CanStepBack"
                           CanStepForwardOverride="@CanStepForward"
                           StepTextOverride="@DisplayedStepText"
                           TimelinePosition="@TimelinePosition"
                           TimelineCount="@TimelineCount" />

        <div class="run-dashboard" aria-label="Linear Regression live metrics">
            <article><span>Iteration</span><strong>@DisplayedSnapshot.Iteration</strong><small>One full batch update of weight and bias.</small></article>
            <article><span>Weight</span><strong>@Format(DisplayedSnapshot.Weight)</strong><small>Controls the slope of the line.</small></article>
            <article><span>Bias</span><strong>@Format(DisplayedSnapshot.Bias)</strong><small>Moves the line up or down.</small></article>
            <article><span>MSE</span><strong>@Format(DisplayedSnapshot.Loss)</strong><small>Average squared prediction error.</small></article>
        </div>
    </section>

    <section class="fit-section" aria-labelledby="lr-fit-title">
        <div class="section-heading-row"><div><span class="section-kicker">WHEN IT FITS</span><h2 id="lr-fit-title">Linear Regression is useful when one straight trend is a reasonable model for a continuous value.</h2></div></div>
        <div class="fit-grid">
            <article class="fit-card"><span>GOOD FIT</span><strong>Continuous prediction</strong><p>Predict a numeric target such as a measurement or score.</p></article>
            <article class="fit-card"><span>GOOD FIT</span><strong>Readable relationship</strong><p>Weight tells you how much y changes when x increases by one.</p></article>
            <article class="fit-card"><span>AVOID FOR</span><strong>Strongly curved patterns</strong><p>A single straight line cannot represent every relationship.</p></article>
            <article class="fit-card"><span>NEXT CONNECTION</span><strong>Logistic Regression</strong><p>Keep the weighted sum, but convert it into a probability for classification.</p></article>
        </div>
    </section>

    <section class="practice-section" aria-labelledby="lr-practice-title">
        <div class="practice-heading"><div><span class="section-kicker">GUIDED PRACTICE</span><h2 id="lr-practice-title">Test what weight, bias, residuals, and learning rate actually do.</h2><p>Tasks load a useful setup, but completion comes from the real training result.</p></div><strong>@_completedTaskIds.Count / @PracticeTasks.Length complete</strong></div>
        <div class="practice-grid">
            @foreach (var task in PracticeTasks)
            {
                <PracticeTaskCard TaskId="@task.Id" Title="@task.Title" Description="@task.Goal" InputText="@task.Suggested" HelpHref="/learn/concepts/linear-regression" Completed="@_completedTaskIds.Contains(task.Id)" Active="@(_activeTaskId == task.Id)" Busy="@IsBusy" HasEvidence="@(GetTaskEvidence(task.Id) is not null)" Start="@(() => StartTask(task.Id))" OpenEvidence="@(() => OpenTaskEvidence(task.Id))" />
            }
        </div>
    </section>

    <NextLessonCard Eyebrow="NEXT MACHINE-LEARNING LESSON" Level="04 · Interactive" Title="Logistic Regression" Description="Reuse the weighted sum, then map it through a sigmoid so the output becomes a probability for binary classification." Href="/ml-foundations/logistic-regression" LinkLabel="Open Logistic Regression" />
</div>

@if (_lastRunPopupOpen && _lastResult is not null)
{
    <div class="run-popup-backdrop" role="presentation" @onclick="CloseLastRunPopup">
        <section class="run-popup" role="dialog" aria-modal="true" @onclick:stopPropagation="true">
            <header><div><span class="section-kicker">LAST RUN</span><h2>@LastRunHeadline</h2></div><button type="button" class="popup-close" @onclick="CloseLastRunPopup" aria-label="Close result explanation">×</button></header>
            <div class="popup-body">
                <p>@RunActionExplanation(_lastResult)</p>
                <div class="popup-metrics">
                    <div><span>MSE</span><strong>@Format(_lastResult.InitialLoss) → @Format(_lastResult.FinalLoss)</strong></div>
                    <div><span>WEIGHT</span><strong>@Format(_lastResult.FinalWeight)</strong></div>
                    <div><span>BIAS</span><strong>@Format(_lastResult.FinalBias)</strong></div>
                    <div><span>UPDATES</span><strong>@_lastResult.IterationsCompleted</strong></div>
                </div>
                <p class="popup-memory">@RunMlExplanation(_lastResult)</p>
            </div>
        </section>
    </div>
}

<PracticeEvidencePopup Evidence="@_practiceEvidencePopup" OnClose="CloseTaskEvidence" />

@code {
    private const string ModuleKey = "linear-regression";
    private const string PopupSettingStorageKey = "algorithm-visualizer.linear-regression.show-run-popup.v1";
    private readonly List<RunFrame> _frames = [];
    private readonly List<LinearRegressionRunResult> _practiceResults = [];
    private PracticeModuleProgress _practiceProgress = new();
    private HashSet<int> _completedTaskIds = [];
    private PracticeCompletionEvidence? _practiceEvidencePopup;
    private LinearRegressionRunResult? _lastResult;
    private string? _lastCapturedStep;
    private double[] _x = [0d, 1d, 2d, 3d, 4d];
    private double[] _y = [1d, 3d, 5d, 7d, 9d];
    private string _datasetText = "0,1; 1,3; 2,5; 3,7; 4,9";
    private string _weightText = "0";
    private string _biasText = "0";
    private string _learningRateText = "0.05";
    private string _iterationsText = "30";
    private string _toleranceText = "0.01";
    private string? _inputError;
    private Preset? _preset = Preset.Upward;
    private bool _showRunPopups = true;
    private bool _showAdvancedSettings;
    private bool _lastRunPopupOpen;
    private bool _predictionAnswered;
    private bool _predictionCorrect;
    private WeightPrediction? _prediction;
    private int _frameIndex = -1;
    private int? _activeTaskId;
    private StateView _view = StateView.Visual;

    private static readonly PracticeTaskDefinition[] PracticeTasks =
    [
        new(1, "Fit an upward trend", "Train a line whose final weight is positive and whose MSE is lower than it started.", "Try Upward line", Preset.Upward),
        new(2, "Fit a downward trend", "Train a line whose final weight becomes negative.", "Try Downward line", Preset.Downward),
        new(3, "Start already fitted", "Use the exact line and confirm training stops without changing the model.", "Try Already fitted", Preset.AlreadyFit),
        new(4, "Fit points with noise", "Reduce MSE even though no single line passes through every point.", "Try Noisy points", Preset.Noisy),
        new(5, "Make training unstable", "Use an intentionally oversized learning rate and trigger the divergence guard.", "Task loads a large step size", Preset.Diverge)
    ];

    private LinearRegressionSnapshot Current => LinearRegressionLab.CreateSnapshot();
    private LinearRegressionSnapshot DisplayedSnapshot => _frameIndex >= 0 && _frameIndex < _frames.Count ? _frames[_frameIndex].Snapshot : Current;
    private string DisplayedStepText => _frameIndex >= 0 && _frameIndex < _frames.Count ? _frames[_frameIndex].StepText : SimulationState.CurrentStepText;
    private int TimelineCount => _frames.Count;
    private int TimelinePosition => _frameIndex < 0 ? 0 : _frameIndex + 1;
    private bool CanStepBack => _frameIndex > 0;
    private bool CanStepForward => (_frameIndex >= 0 && _frameIndex < _frames.Count - 1) || SimulationState.IsRunning;
    private bool IsBusy => SimulationState.IsRunning;
    private string ViewExplanation => _view == StateView.Visual ? "See the real points, current predictions, residual distances, and the line that weight + bias define." : "See the aligned ManualVector storage used for x, y, predictions, and residuals, plus the two scalar parameters.";
    private string PredictionFeedback => _predictionCorrect ? "Correct — the first real update moved weight in the direction you predicted." : $"Not quite. The first update made the weight {ActualFirstWeightDirection}.";
    private string ActualFirstWeightDirection => FirstWeightDirection(_lastResult);
    private string LastRunHeadline => _lastResult is null ? "Linear Regression run" : _lastResult.Diverged ? "The learning rate made training unstable." : _lastResult.Converged ? "The line reached a small enough gradient." : "Training improved the line for every allowed update.";

    protected override void OnInitialized()
    {
        SimulationState.Changed += HandleSimulationChanged;
        try { _showRunPopups = !bool.TryParse(LearningStore.GetItem(PopupSettingStorageKey), out var saved) || saved; } catch { _showRunPopups = true; }
        _practiceProgress = PracticeProgress.Load(ModuleKey, null, PracticeTasks.Select(task => task.Id));
        _completedTaskIds = _practiceProgress.CompletedTaskIds;
        ApplyInputs();
    }

    private void WeightChanged(ChangeEventArgs args) { _weightText = args.Value?.ToString() ?? string.Empty; ClearPresetSelection(); ClearReview(); }
    private void BiasChanged(ChangeEventArgs args) { _biasText = args.Value?.ToString() ?? string.Empty; ClearPresetSelection(); ClearReview(); }
    private void LearningRateChanged(ChangeEventArgs args) { _learningRateText = args.Value?.ToString() ?? string.Empty; ClearPresetSelection(); ClearReview(); }
    private void IterationsChanged(ChangeEventArgs args) { _iterationsText = args.Value?.ToString() ?? string.Empty; ClearPresetSelection(); ClearReview(); }
    private void ToleranceChanged(ChangeEventArgs args) { _toleranceText = args.Value?.ToString() ?? string.Empty; ClearPresetSelection(); ClearReview(); }
    private void DatasetChanged(ChangeEventArgs args) { _datasetText = args.Value?.ToString() ?? string.Empty; ClearPresetSelection(); ClearReview(); }
    private void ToggleAdvancedSettings() { if (!IsBusy) _showAdvancedSettings = !_showAdvancedSettings; }
    private void SetPrediction(WeightPrediction prediction) { if (IsBusy) return; _prediction = prediction; _predictionAnswered = false; _predictionCorrect = false; }

    private void ApplyInputs()
    {
        if (!TryParseDouble(_weightText, out var weight) || !TryParseDouble(_biasText, out var bias)) { _inputError = "Weight and bias must be finite real numbers."; return; }
        if (!TryParseDouble(_learningRateText, out var learningRate) || learningRate <= 0d) { _inputError = "Learning rate must be greater than 0."; return; }
        if (!int.TryParse(_iterationsText, NumberStyles.Integer, CultureInfo.InvariantCulture, out var iterations) || iterations is < 1 or > 80) { _inputError = "Use between 1 and 80 updates in this visual lesson."; return; }
        if (!TryParseDouble(_toleranceText, out var tolerance) || tolerance <= 0d) { _inputError = "Gradient tolerance must be greater than 0."; return; }
        if (!TryParseDataset(_datasetText, out var x, out var y, out var datasetError)) { _inputError = datasetError; return; }
        if (!double.IsFinite(weight) || !double.IsFinite(bias) || !double.IsFinite(learningRate) || !double.IsFinite(tolerance)) { _inputError = "NaN and infinity are not accepted."; return; }

        _x = x;
        _y = y;
        _inputError = null;
        try
        {
            LinearRegressionLab.Configure(new LinearRegressionConfiguration(_x, _y, weight, bias, learningRate, iterations, tolerance));
        }
        catch (ArgumentException ex)
        {
            _inputError = ex.Message;
            return;
        }
        ClearReview();
        StateHasChanged();
    }

    private async Task RunAsync()
    {
        ApplyInputs();
        if (!string.IsNullOrWhiteSpace(_inputError)) return;
        _frames.Clear(); _frameIndex = -1; _lastCapturedStep = null; _lastRunPopupOpen = false;
        var token = SimulationState.Start("Starting Linear Regression training.");
        Capture();
        try
        {
            var result = await LinearRegressionLab.ExecuteAsync(token);
            if (!IsCurrent(token)) return;
            _lastResult = result;
            SimulationState.Complete(result.Summary);
            Capture();
            EvaluatePrediction(result);
            RecordPracticeResult(result);
            if (_showRunPopups) OpenLastRunPopup();
        }
        catch (OperationCanceledException) { }
        finally { await InvokeAsync(StateHasChanged); }
    }

    private void Capture()
    {
        var step = SimulationState.CurrentStepText;
        if (step == _lastCapturedStep) return;
        var followTail = _frameIndex < 0 || _frameIndex == _frames.Count - 1;
        _frames.Add(new RunFrame(step, LinearRegressionLab.CreateSnapshot()));
        _lastCapturedStep = step;
        if (followTail) _frameIndex = _frames.Count - 1;
    }

    private void HandleSimulationChanged() { if (SimulationState.IsRunning) Capture(); _ = InvokeAsync(StateHasChanged); }
    private bool IsCurrent(CancellationToken token) => !token.IsCancellationRequested && SimulationState.SimulationCancellationToken == token;
    private void ClearReview() { SimulationState.Reset(); _frames.Clear(); _frameIndex = -1; _lastCapturedStep = null; _lastRunPopupOpen = false; _lastResult = null; _predictionAnswered = false; }
    private Task PlayTimelineAsync() { if (_frames.Count > 0) _frameIndex = _frames.Count - 1; SimulationState.Resume(); return InvokeAsync(StateHasChanged); }
    private Task PauseTimelineAsync() { SimulationState.Pause(); return Task.CompletedTask; }
    private Task StepBackAsync() { if (SimulationState.IsRunning && !SimulationState.IsPaused) SimulationState.Pause(); if (_frameIndex > 0) _frameIndex--; return InvokeAsync(StateHasChanged); }
    private Task StepForwardAsync() { if (_frameIndex >= 0 && _frameIndex < _frames.Count - 1) { _frameIndex++; return InvokeAsync(StateHasChanged); } if (SimulationState.IsRunning) SimulationState.Step(); return Task.CompletedTask; }
    private Task ResetPlaybackAsync() { SimulationState.Reset(); _frames.Clear(); _frameIndex = -1; _lastCapturedStep = null; return InvokeAsync(StateHasChanged); }

    private void EvaluatePrediction(LinearRegressionRunResult result)
    {
        _predictionAnswered = _prediction.HasValue;
        if (!_predictionAnswered) return;
        _predictionCorrect = FirstWeightPrediction(result) == _prediction.Value;
    }

    private static WeightPrediction FirstWeightPrediction(LinearRegressionRunResult result)
    {
        if (result.History.Length < 2) return WeightPrediction.Same;
        var delta = result.History[1].Weight - result.History[0].Weight;
        if (Math.Abs(delta) <= 1e-9) return WeightPrediction.Same;
        return delta > 0d ? WeightPrediction.Increase : WeightPrediction.Decrease;
    }

    private static string FirstWeightDirection(LinearRegressionRunResult? result) => result is null ? "unavailable" : FirstWeightPrediction(result) switch { WeightPrediction.Increase => "increase", WeightPrediction.Decrease => "decrease", _ => "stay almost unchanged" };

    private void LoadPreset(Preset preset, bool keepActiveTask = false)
    {
        if (IsBusy) return;
        _preset = preset;
        switch (preset)
        {
            case Preset.Downward: SetDataset([0d, 1d, 2d, 3d, 4d], [9d, 7d, 5d, 3d, 1d], 0d, 0d, 0.05d, 40, 0.02d); break;
            case Preset.Offset: SetDataset([0d, 1d, 2d, 3d, 4d], [5d, 7d, 9d, 11d, 13d], 0d, 0d, 0.04d, 50, 0.02d); break;
            case Preset.Noisy: SetDataset([0d, 1d, 2d, 3d, 4d, 5d], [1d, 3.4d, 4.6d, 7.4d, 8.5d, 11.2d], 0d, 0d, 0.035d, 50, 0.02d); break;
            case Preset.AlreadyFit: SetDataset([0d, 1d, 2d, 3d, 4d], [1d, 3d, 5d, 7d, 9d], 2d, 1d, 0.05d, 30, 0.01d); break;
            case Preset.Diverge: SetDataset([0d, 1d, 2d, 3d, 4d], [1d, 3d, 5d, 7d, 9d], 0d, 0d, 1.2d, 20, 0.01d); break;
            default: SetDataset([0d, 1d, 2d, 3d, 4d], [1d, 3d, 5d, 7d, 9d], 0d, 0d, 0.05d, 40, 0.02d); break;
        }
        _prediction = null;
        _predictionAnswered = false;
        ApplyInputs();
        if (!keepActiveTask) _activeTaskId = null;
    }

    private void SetDataset(double[] x, double[] y, double weight, double bias, double learningRate, int iterations, double tolerance)
    {
        _x = x; _y = y; _datasetText = FormatDataset(x, y); _weightText = Format(weight); _biasText = Format(bias); _learningRateText = Format(learningRate); _iterationsText = iterations.ToString(CultureInfo.InvariantCulture); _toleranceText = Format(tolerance);
    }

    private string PresetClass(Preset preset) => _preset == preset ? "active" : string.Empty;
    private void ClearPresetSelection() => _preset = null;
    private string PredictionClass(WeightPrediction prediction) => _prediction == prediction ? "active" : string.Empty;

    private void StartTask(int taskId)
    {
        if (IsBusy) return;
        var task = PracticeTasks.First(item => item.Id == taskId);
        _activeTaskId = taskId;
        LoadPreset(task.Preset, keepActiveTask: true);
    }

    private void RecordPracticeResult(LinearRegressionRunResult result)
    {
        _practiceResults.Add(result);
        if (_practiceResults.Count > 30) _practiceResults.RemoveAt(0);
        foreach (var task in PracticeTasks)
        {
            if (_completedTaskIds.Contains(task.Id) && GetTaskEvidence(task.Id) is not null && _activeTaskId != task.Id) continue;
            var complete = task.Id switch
            {
                1 => !result.Diverged && result.FinalWeight > 0d && result.FinalLoss < result.InitialLoss,
                2 => !result.Diverged && result.FinalWeight < 0d && result.FinalLoss < result.InitialLoss,
                3 => result.Converged && result.IterationsCompleted == 0 && result.InitialLoss <= 1e-12,
                4 => !result.Diverged && IsNoisyDataset(result.X, result.Y) && result.FinalLoss < result.InitialLoss,
                5 => result.Diverged,
                _ => false
            };
            if (complete) CompletePracticeTask(task, result);
        }
    }

    private void CompletePracticeTask(PracticeTaskDefinition task, LinearRegressionRunResult result)
    {
        var evidence = new PracticeCompletionEvidence(
            task.Id,
            task.Title,
            result.Summary,
            RunActionExplanation(result),
            "X, Y, prediction, and residual values are stored in project-owned ManualVector instances. Weight and bias are scalar model parameters; rewind history is UI-only teaching state.",
            RunMlExplanation(result),
            [new("Initial MSE", Format(result.InitialLoss)), new("Final MSE", Format(result.FinalLoss)), new("Weight", Format(result.FinalWeight)), new("Bias", Format(result.FinalBias)), new("Updates", result.IterationsCompleted.ToString(CultureInfo.InvariantCulture))],
            $"points={FormatDataset(result.X, result.Y)} · final line: {FormatLine(result.FinalWeight, result.FinalBias)}");
        _completedTaskIds.Add(task.Id);
        PracticeProgress.Complete(ModuleKey, _practiceProgress, task.Id, evidence);
        if (_activeTaskId == task.Id) _activeTaskId = null;
    }

    private PracticeCompletionEvidence? GetTaskEvidence(int taskId) => PracticeProgress.GetEvidence(_practiceProgress, taskId);
    private void OpenTaskEvidence(int taskId) => _practiceEvidencePopup = GetTaskEvidence(taskId);
    private void CloseTaskEvidence() => _practiceEvidencePopup = null;
    private void ToggleRunPopups(ChangeEventArgs args) { _showRunPopups = args.Value is bool value ? value : bool.TryParse(args.Value?.ToString(), out var parsed) && parsed; try { LearningStore.SetItem(PopupSettingStorageKey, _showRunPopups.ToString()); } catch { } }
    private void OpenLastRunPopup() { if (_lastResult is null) return; _lastRunPopupOpen = true; }
    private void CloseLastRunPopup() => _lastRunPopupOpen = false;

    private static string RunActionExplanation(LinearRegressionRunResult result) => $"Training started at {FormatLine(result.InitialWeight, result.InitialBias)} and finished at {FormatLine(result.FinalWeight, result.FinalBias)}. MSE changed from {Format(result.InitialLoss)} to {Format(result.FinalLoss)}.";
    private static string RunMlExplanation(LinearRegressionRunResult result) => result.Diverged ? "The model formula is still valid, but this learning rate makes the Gradient Descent updates too large." : result.Converged ? "The loss gradient is now small enough for this lesson to treat the fitted line as stable." : "The run used every allowed update. It can still be a useful fit even when the strict gradient stop rule has not fired yet.";

    private static bool TryParseDataset(string text, out double[] x, out double[] y, out string error)
    {
        var groups = text.Split(';', StringSplitOptions.RemoveEmptyEntries | StringSplitOptions.TrimEntries);
        if (groups.Length is < 2 or > 8)
        {
            x = []; y = []; error = "Use between 2 and 8 points, separated with semicolons."; return false;
        }
        x = new double[groups.Length]; y = new double[groups.Length];
        for (var index = 0; index < groups.Length; index++)
        {
            var pair = groups[index].Split(',', StringSplitOptions.TrimEntries);
            if (pair.Length != 2 || !TryParseDouble(pair[0], out x[index]) || !TryParseDouble(pair[1], out y[index]) || !double.IsFinite(x[index]) || !double.IsFinite(y[index]))
            {
                x = []; y = []; error = $"Point {index + 1} must use the form x,y with finite numbers."; return false;
            }
        }
        error = string.Empty; return true;
    }

    private static bool IsNoisyDataset(IReadOnlyList<double> x, IReadOnlyList<double> y) => x.Count == 6 && y.Count == 6 && Math.Abs(y[1] - 3.4d) < 1e-9 && Math.Abs(y[5] - 11.2d) < 1e-9;
    private static bool TryParseDouble(string? text, out double value) => double.TryParse(text, NumberStyles.Float, CultureInfo.InvariantCulture, out value) || double.TryParse(text, NumberStyles.Float, CultureInfo.CurrentCulture, out value);
    private static string Format(double value) => Math.Abs(value) < 1e-12 ? "0" : value.ToString("0.####", CultureInfo.InvariantCulture);
    private static string FormatLine(double weight, double bias) => bias < 0d ? $"yHat={Format(weight)}x - {Format(Math.Abs(bias))}" : $"yHat={Format(weight)}x + {Format(bias)}";
    private static string FormatDataset(IReadOnlyList<double> x, IReadOnlyList<double> y) { var parts = new string[x.Count]; for (var index = 0; index < x.Count; index++) parts[index] = $"{Format(x[index])},{Format(y[index])}"; return string.Join("; ", parts); }

    public void Dispose() => SimulationState.Changed -= HandleSimulationChanged;

    private sealed record RunFrame(string StepText, LinearRegressionSnapshot Snapshot);
    private sealed record PracticeTaskDefinition(int Id, string Title, string Goal, string Suggested, Preset Preset);
    private enum WeightPrediction { Increase, Decrease, Same }
    private enum StateView { Visual, Memory }
    private enum Preset { Upward, Downward, Offset, Noisy, AlreadyFit, Diverge }
}
