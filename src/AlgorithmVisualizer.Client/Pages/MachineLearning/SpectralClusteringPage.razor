@page "/graph-ml/spectral-clustering"
@using AlgorithmVisualizer.Core.MachineLearning.GraphMl.SpectralClustering
@implements IDisposable
@inject SimulationState SimulationState
@inject SpectralClusteringSimulation SpectralLab
@inject LearningSessionStore LearningStore
@inject PracticeProgressStore PracticeProgress

<PageTitle>Spectral Clustering — Graph ML — Algorithm Visualizer</PageTitle>

<div class="learning-module-page learning-module-shell ml-module-page">
    <section class="learn-launchpad"><div class="learn-copy"><span class="section-kicker">LEARN FIRST</span><h2>Spectral clustering turns connectivity into coordinates before it asks K-Means to separate groups.</h2><p>Degree normalizes adjacency, the graph Laplacian reveals slow-changing directions, the smallest eigenvectors embed nodes, and the existing manual K-Means clusters that embedding.</p><ConceptLink class="learn-launchpad-link" Href="/learn/concepts/spectral-clustering">Open Spectral Clustering concepts &amp; memory →</ConceptLink></div><div class="learn-grid"><article class="learn-card purple"><span>1 · DEGREE</span><strong>Measure local connectivity.</strong><small>Degree scales raw adjacency so high-degree nodes do not dominate automatically.</small></article><article class="learn-card blue"><span>2 · LAPLACIAN</span><strong>Build L = I − D⁻¹ᐟ²AD⁻¹ᐟ².</strong><small>Connectivity structure becomes a symmetric matrix.</small></article><article class="learn-card mint"><span>3 · EIGENVECTORS</span><strong>Keep the smallest directions.</strong><small>Jacobi rotations solve the symmetric eigenproblem from scratch.</small></article><article class="learn-card gold"><span>4 · CLUSTER</span><strong>Run K-Means in spectral space.</strong><small>Graph structure becomes ordinary geometric coordinates.</small></article></div></section>

    <header class="module-header"><div class="header-copy"><div class="module-eyebrow"><span>GRAPH ML · PHASE 3 STEP 16</span><span class="separator">/</span><span class="live-status"><i></i> Interactive</span></div><h1>Spectral Clustering</h1><p>Find graph communities that are hard to describe with raw Euclidean coordinates by clustering Laplacian eigenvector embeddings.</p></div><div class="complexity-summary"><div><span>Laplacian</span><strong>O(V²)</strong><small>small teaching dense matrix</small></div><div><span>Eigen solve</span><strong>O(R·V²)</strong><small>R Jacobi rotations</small></div><div><span>Cluster</span><strong>K-Means</strong><small>reuse the existing manual implementation</small></div></div></header>
    <section class="smart-tip"><span class="tip-icon">✦</span><div><strong>The clustering happens after a representation change.</strong><p>Two nodes can be far apart in a drawing yet close in spectral coordinates when they share similar connectivity. Screen geometry never decides the clusters.</p></div><ConceptLink Href="/ml-foundations/k-means">Review K-Means →</ConceptLink></section>

    <section class="builder-section"><div class="section-heading-row"><div class="heading-with-step"><span class="step-number">1</span><div><span class="section-kicker">BUILD THE UNDIRECTED GRAPH</span><h2>Choose a connectivity pattern with communities to discover.</h2><p>The visible node positions are only a drawing. The algorithm receives adjacency, not x/y coordinates.</p></div></div></div><div class="preset-row"><span>START WITH</span>@foreach(var p in Enum.GetValues<Preset>()){<button class="@PresetClass(p)" @onclick="() => LoadPreset(p)" disabled="@IsBusy">@PresetName(p)</button>}</div><div class="dl-builder-card"><div class="dl-mode-row"><span>CLUSTERS</span><button class="@(_clusters==2?"secondary-action active":"secondary-action")" @onclick="() => SetClusters(2)" disabled="@IsBusy">2 clusters</button><button class="@(_clusters==3?"secondary-action active":"secondary-action")" @onclick="() => SetClusters(3)" disabled="@IsBusy">3 clusters</button></div><div class="graphml-summary-row"><div><span>NODES</span><strong>@_adjacency.Length</strong></div><div><span>UNDIRECTED EDGES</span><strong>@EdgeCount(_adjacency)</strong></div><div><span>EMBEDDING</span><strong>@_clusters D</strong></div></div><div class="dl-inline-actions"><button class="secondary-action" @onclick="ToggleAdvanced" disabled="@IsBusy">@(_showAdvanced?"Hide edge editor":"Edit undirected edges")</button></div>@if(_showAdvanced){<div class="dl-advanced"><label class="dl-field"><span>UNDIRECTED EDGES · A-B, B-C, ...</span><textarea value="@_edgesText" @oninput="EdgesChanged" rows="3" disabled="@IsBusy"></textarea><small>Every node must have at least one edge. The Core validates symmetry before building the normalized Laplacian.</small></label></div>}@if(!string.IsNullOrWhiteSpace(_inputError)){<div class="input-error"><strong>Check spectral input.</strong><span>@_inputError</span></div>}</div></section>

    <section class="predict-section"><div class="prediction-card"><div class="prediction-copy"><span class="step-number">2</span><div><span class="section-kicker">PREDICT FIRST</span><h2>Will nodes A and B finish in the same spectral cluster?</h2><p>Judge their connectivity roles. The answer is checked against the actual K-Means result in spectral space.</p></div></div><div class="prediction-actions"><button class="@PredictionClass(true)" @onclick="() => SetPrediction(true)">Same cluster</button><button class="@PredictionClass(false)" @onclick="() => SetPrediction(false)">Different clusters</button></div>@if(_predictionAnswered){<p class="prediction-feedback @(_predictionCorrect?"correct":"incorrect")">@PredictionFeedback</p>}</div></section>

    <section class="lab-section"><div class="lab-heading"><div class="heading-with-step"><span class="step-number">3</span><div><span class="section-kicker">WATCH CONNECTIVITY BECOME GEOMETRY</span><h2>Degree → normalized Laplacian → eigenvectors → K-Means.</h2></div></div><div class="lab-actions"><label class="popup-toggle"><input type="checkbox" checked="@_showRunPopups" @onchange="ToggleRunPopups" /><span>Open explanation after run</span></label>@if(_lastResult is not null){<button class="secondary-action" @onclick="OpenLastRunPopup">Last explanation</button>}<button class="sort-button" @onclick="RunAsync" disabled="@IsBusy"><span>▶</span> Run Spectral Clustering</button></div></div>
        <SimulationToolbar OnPlay="PlayTimelineAsync" OnPause="PauseTimelineAsync" OnStepBack="StepBackAsync" OnStepForward="StepForwardAsync" OnReset="ResetPlaybackAsync" CanStepBack="@CanStepBack" CanStepForwardOverride="@CanStepForward" StepTextOverride="@DisplayedStepText" TimelinePosition="@TimelinePosition" TimelineCount="@TimelineCount" />
        <div class="state-tabs-row"><div class="state-tabs"><button class="@(_view==StateView.Visual?"active":"")" @onclick="() => _view=StateView.Visual">Visual state</button><button class="@(_view==StateView.Memory?"active":"")" @onclick="() => _view=StateView.Memory">Memory state</button></div><p>@ViewExplanation</p></div><div class="lesson-reference-links"><ConceptLink Href="/learn/concepts/spectral-clustering">Spectral concepts →</ConceptLink><ConceptLink Href="/structures/matrix">Matrix / Laplacian storage →</ConceptLink><ConceptLink Href="/ml-foundations/k-means">K-Means reused at the end →</ConceptLink></div>
        <div class="state-surface ml-state-surface">@if(_view==StateView.Visual){<div class="ml-visual-board" tabindex="0"><SpectralClusteringView Snapshot="@DisplayedSnapshot" /></div>}else{<div class="dl-memory-grid"><article class="dl-memory-card"><span>DEGREES</span><strong>@Vector(DisplayedSnapshot.Degrees)</strong><small>D supplies the normalization factors.</small></article><article class="dl-memory-card"><span>SMALLEST EIGENVALUES</span><strong>@EigenHeadline</strong><small>The first k eigenvectors form the spectral coordinates.</small></article><article class="dl-memory-card"><span>NORMALIZED LAPLACIAN</span><strong>@MatrixHeadline(DisplayedSnapshot.LaplacianValues,DisplayedSnapshot.NodeCount)</strong><small>Stored row-major in the project ManualMatrix during the eigensolve.</small></article><article class="dl-memory-card"><span>ASSIGNMENTS</span><strong>@AssignmentText(DisplayedSnapshot.Assignments)</strong><small>Final labels come from the existing manual K-Means over spectral rows.</small></article></div>}</div>
        <div class="run-dashboard compact-run-metrics"><div><span>PHASE</span><strong>@PhaseText(DisplayedSnapshot.Phase)</strong></div><div><span>ROTATIONS</span><strong>@DisplayedSnapshot.JacobiRotations</strong></div><div><span>λ₁</span><strong>@EigenAt(1)</strong></div><div><span>CLUSTERS</span><strong>@ClusterCount(DisplayedSnapshot.Assignments)</strong></div></div>
    </section>

    <section class="fit-section"><div class="section-heading-row"><div><span class="section-kicker">WHEN SHOULD I USE IT?</span><h2>Use spectral clustering when graph connectivity forms communities that ordinary feature-space centroids miss.</h2></div></div><div class="fit-grid"><article class="fit-card good"><span>GOOD FIT</span><strong>Community structure, non-convex connectivity, similarity graphs</strong><p>The Laplacian embedding can separate groups using graph relationships rather than raw coordinate shape.</p></article><article class="fit-card avoid"><span>AVOID FOR</span><strong>Large graphs when a dense eigensolve is unaffordable</strong><p>This teaching implementation is intentionally small. Production spectral methods need scalable sparse eigensolvers and careful graph construction.</p></article><article class="fit-card better"><span>BETTER ALTERNATIVE</span><strong>Use K-Means directly when the original feature geometry is already meaningful</strong><p>Do not pay for an eigenproblem when compact Euclidean groups are already visible in feature space.</p><div class="fit-links"><a href="/ml-foundations/k-means">K-Means →</a></div></article></div></section>

    <section class="practice-section"><div class="practice-heading"><div><span class="section-kicker">GUIDED PRACTICE</span><h2>Separate communities, inspect eigenvalues, and reuse K-Means deliberately.</h2></div><strong>@_completedTaskIds.Count / @PracticeTasks.Length complete</strong></div><div class="practice-grid">@foreach(var t in PracticeTasks){<PracticeTaskCard TaskId="@t.Id" Title="@t.Title" Description="@t.Goal" InputText="@t.Suggested" HelpHref="/learn/concepts/spectral-clustering" Completed="@_completedTaskIds.Contains(t.Id)" Active="@(_activeTaskId==t.Id)" Busy="@IsBusy" HasEvidence="@(GetTaskEvidence(t.Id)is not null)" Start="@(() => StartTask(t.Id))" OpenEvidence="@(() => OpenTaskEvidence(t.Id))" />}</div></section>
    <NextLessonCard Eyebrow="NEXT · GRAPH ML" Level="17 · Interactive" Title="Message Passing / basic GNN" Description="Keep the graph, add node feature vectors, and explicitly gather, aggregate, transform, and update embeddings." Href="/graph-ml/message-passing" LinkLabel="Open Message Passing / GNN" />
</div>

@if(_lastRunPopupOpen&&_lastResult is not null){<div class="run-popup-backdrop" @onclick="CloseLastRunPopup"><section class="run-popup" role="dialog" aria-modal="true" @onclick:stopPropagation="true"><header><div><span class="section-kicker">LAST RUN</span><h2>@_lastResult.ClusterCount spectral clusters formed.</h2></div><button class="popup-close" @onclick="CloseLastRunPopup">×</button></header><div class="popup-body"><p>@_lastResult.Summary</p><div class="popup-metrics"><div><span>ROTATIONS</span><strong>@_lastResult.JacobiRotations</strong></div><div><span>λ₀</span><strong>@F(_lastResult.Eigenvalues[0])</strong></div><div><span>λ₁</span><strong>@F(_lastResult.Eigenvalues[Math.Min(1,_lastResult.Eigenvalues.Length-1)])</strong></div><div><span>LABELS</span><strong>@AssignmentText(_lastResult.Assignments)</strong></div></div><p class="popup-memory">ManualMatrix stores Lsym; Jacobi rotations produce sorted eigenpairs; embedding rows are then passed to the already implemented manual K-Means rather than duplicating a clustering library.</p></div></section></div>}
<PracticeEvidencePopup Evidence="@_practiceEvidencePopup" OnClose="CloseTaskEvidence" />

@code{
    private const string ModuleKey="spectral-clustering";private const string PopupKey="algorithm-visualizer.spectral.show-run-popup.v1";private readonly List<RunFrame> _frames=[];private PracticeModuleProgress _practiceProgress=new();private HashSet<int> _completedTaskIds=[];private PracticeCompletionEvidence? _practiceEvidencePopup;private SpectralClusteringRunResult? _lastResult;private string? _lastCapturedStep,_inputError;private double[][] _adjacency=TwoCommunities();private string _edgesText=FormatEdges(TwoCommunities());private int _clusters=2;private Preset? _preset=Preset.TwoCommunities;private bool _showAdvanced,_showRunPopups=true,_lastRunPopupOpen,_predictionAnswered,_predictionCorrect;private bool? _prediction;private int _frameIndex=-1;private int? _activeTaskId;private StateView _view=StateView.Visual;
    private static readonly PracticeTaskDefinition[] PracticeTasks=[new(1,"Split two communities","Run two triangles joined by one bridge and separate A from F while keeping A with B.","Two communities",Preset.TwoCommunities,2),new(2,"Keep a dense community together","Run the lopsided community graph and keep A, B, and C in one cluster.","Lopsided",Preset.Lopsided,2),new(3,"Find three groups","Run the three-community graph with k=3 and produce three non-empty labels.","Three communities",Preset.ThreeCommunities,3),new(4,"Inspect sorted eigenvalues","Finish any run and verify the returned eigenvalues are nondecreasing.","Two communities",Preset.TwoCommunities,2)];
    private SpectralClusteringSnapshot DisplayedSnapshot=>_frameIndex>=0&&_frameIndex<_frames.Count?_frames[_frameIndex].Snapshot:SpectralLab.CreateSnapshot();private string DisplayedStepText=>_frameIndex>=0&&_frameIndex<_frames.Count?_frames[_frameIndex].StepText:SimulationState.CurrentStepText;private bool IsBusy=>SimulationState.IsRunning;private int TimelineCount=>_frames.Count;private int TimelinePosition=>_frameIndex<0?0:_frameIndex+1;private bool CanStepBack=>_frameIndex>0;private bool CanStepForward=>(_frameIndex>=0&&_frameIndex<_frames.Count-1)||SimulationState.IsRunning;private string ViewExplanation=>_view==StateView.Visual?"Scroll only the wide board: the original connectivity graph stays left while the same nodes appear in learned spectral coordinates on the right.":"Inspect degree, normalized Laplacian, eigenvalues, spectral rows, and final cluster labels.";private string PredictionFeedback=>_lastResult is null?string.Empty:_predictionCorrect?"Correct — A and B ended with the relationship you predicted.":$"A and B finished {(_lastResult.Assignments[0]==_lastResult.Assignments[1]?"together":"in different clusters")}.";private string EigenHeadline=>DisplayedSnapshot.Eigenvalues.Length==0?"—":string.Join(" · ",DisplayedSnapshot.Eigenvalues.Take(Math.Min(_clusters+1,DisplayedSnapshot.Eigenvalues.Length)).Select(F));
    protected override void OnInitialized(){SimulationState.Changed+=HandleSimulationChanged;try{_showRunPopups=!bool.TryParse(LearningStore.GetItem(PopupKey),out var saved)||saved;}catch{_showRunPopups=true;}_practiceProgress=PracticeProgress.Load(ModuleKey,null,PracticeTasks.Select(t=>t.Id));_completedTaskIds=_practiceProgress.CompletedTaskIds;ApplyInputs();}
    private void LoadPreset(Preset p){if(IsBusy)return;_preset=p;_adjacency=p switch{Preset.Lopsided=>Lopsided(),Preset.ThreeCommunities=>ThreeCommunities(),_=>TwoCommunities()};_clusters=p==Preset.ThreeCommunities?3:2;_edgesText=FormatEdges(_adjacency);ApplyInputs();}private void SetClusters(int k){if(IsBusy)return;_clusters=k;_preset=null;ApplyInputs();}private void ToggleAdvanced(){if(!IsBusy)_showAdvanced=!_showAdvanced;}private void EdgesChanged(ChangeEventArgs e){_edgesText=e.Value?.ToString()??"";_preset=null;ClearReview();}private void SetPrediction(bool same){_prediction=same;_predictionAnswered=false;_predictionCorrect=false;}
    private void ApplyInputs(){if(!TryEdges(_edgesText,out var a,out var error)){_inputError=error;return;}try{SpectralLab.Configure(new SpectralClusteringConfiguration(a,_clusters));_adjacency=a;_inputError=null;ClearReview();}catch(ArgumentException ex){_inputError=ex.Message;}}
    private async Task RunAsync(){ApplyInputs();if(_inputError is not null)return;_frames.Clear();_frameIndex=-1;_lastCapturedStep=null;_lastRunPopupOpen=false;var token=SimulationState.Start("Starting spectral clustering.");Capture();try{var r=await SpectralLab.ExecuteAsync(token);if(!IsCurrent(token))return;_lastResult=r;SimulationState.Complete(r.Summary);Capture();if(_prediction is not null){_predictionAnswered=true;_predictionCorrect=_prediction==(r.Assignments[0]==r.Assignments[1]);}RecordPractice(r);if(_showRunPopups)OpenLastRunPopup();}catch(OperationCanceledException)when(!IsCurrent(token)){} }
    private void Capture(){var step=SimulationState.CurrentStepText;if(step==_lastCapturedStep)return;var follow=_frameIndex<0||_frameIndex==_frames.Count-1;_frames.Add(new(step,SpectralLab.CreateSnapshot()));_lastCapturedStep=step;if(follow)_frameIndex=_frames.Count-1;}private void HandleSimulationChanged(){if(SimulationState.IsRunning)Capture();_=InvokeAsync(StateHasChanged);}private bool IsCurrent(CancellationToken t)=>!t.IsCancellationRequested&&SimulationState.SimulationCancellationToken==t;private void ClearReview(){SimulationState.Reset();_frames.Clear();_frameIndex=-1;_lastCapturedStep=null;_lastResult=null;_lastRunPopupOpen=false;_predictionAnswered=false;}
    private Task PlayTimelineAsync(){if(_frames.Count>0)_frameIndex=_frames.Count-1;SimulationState.Resume();return InvokeAsync(StateHasChanged);}private Task PauseTimelineAsync(){SimulationState.Pause();return Task.CompletedTask;}private Task StepBackAsync(){if(SimulationState.IsRunning&&!SimulationState.IsPaused)SimulationState.Pause();if(_frameIndex>0)_frameIndex--;return InvokeAsync(StateHasChanged);}private Task StepForwardAsync(){if(_frameIndex>=0&&_frameIndex<_frames.Count-1){_frameIndex++;return InvokeAsync(StateHasChanged);}if(SimulationState.IsRunning)SimulationState.Step();return Task.CompletedTask;}private Task ResetPlaybackAsync(){SimulationState.Reset();_frames.Clear();_frameIndex=-1;_lastCapturedStep=null;return InvokeAsync(StateHasChanged);}private void ToggleRunPopups(ChangeEventArgs e){_showRunPopups=e.Value is bool b&&b;LearningStore.SetItem(PopupKey,_showRunPopups.ToString());}private void OpenLastRunPopup()=>_lastRunPopupOpen=_lastResult is not null;private void CloseLastRunPopup()=>_lastRunPopupOpen=false;
    private void StartTask(int id){var t=PracticeTasks.First(x=>x.Id==id);_activeTaskId=id;LoadPreset(t.Preset);_clusters=t.Clusters;ApplyInputs();}private void RecordPractice(SpectralClusteringRunResult r){if(_activeTaskId is null)return;var t=PracticeTasks.First(x=>x.Id==_activeTaskId);var ok=t.Id switch{1=>r.Assignments[0]==r.Assignments[1]&&r.Assignments[0]!=r.Assignments[^1],2=>r.Assignments[0]==r.Assignments[1]&&r.Assignments[1]==r.Assignments[2],3=>ClusterCount(r.Assignments)==3,4=>IsSorted(r.Eigenvalues),_=>false};if(!ok)return;var ev=new PracticeCompletionEvidence(t.Id,t.Title,r.Summary,$"Spectral labels = {AssignmentText(r.Assignments)}.",$"Smallest eigenvalues = {string.Join(", ",r.Eigenvalues.Take(Math.Min(4,r.Eigenvalues.Length)).Select(F))}; embedding rows are then clustered by the existing manual K-Means.","Spectral clustering changes the representation before clustering: graph connectivity becomes coordinates.",[new("Clusters",ClusterCount(r.Assignments).ToString()),new("Jacobi rotations",r.JacobiRotations.ToString())],$"labels={AssignmentText(r.Assignments)}");_completedTaskIds.Add(t.Id);PracticeProgress.Complete(ModuleKey,_practiceProgress,t.Id,ev);_activeTaskId=null;}
    private PracticeCompletionEvidence? GetTaskEvidence(int id)=>PracticeProgress.GetEvidence(_practiceProgress,id);private void OpenTaskEvidence(int id)=>_practiceEvidencePopup=GetTaskEvidence(id);private void CloseTaskEvidence()=>_practiceEvidencePopup=null;private string PresetClass(Preset p)=>_preset==p?"active":"";private string PredictionClass(bool p)=>_prediction==p?"active":"";private static string PresetName(Preset p)=>p switch{Preset.TwoCommunities=>"Two communities",Preset.Lopsided=>"Lopsided bridge",_=>"Three communities"};private static string PhaseText(SpectralClusteringPhase p)=>p switch{SpectralClusteringPhase.EigenSolve=>"eigen solve",_=>p.ToString().ToLowerInvariant()};private static string F(double v)=>Math.Abs(v)<1e-10?"0":v.ToString("0.###",System.Globalization.CultureInfo.InvariantCulture);private string EigenAt(int i)=>DisplayedSnapshot.Eigenvalues.Length>i?F(DisplayedSnapshot.Eigenvalues[i]):"—";private static string Vector(IReadOnlyList<double> v)=>"["+string.Join(", ",v.Select(F))+"]";private static string AssignmentText(IReadOnlyList<int> a)=>a.Count==0?"—":"["+string.Join(", ",a.Select(x=>x<0?"—":(x+1).ToString()))+"]";private static string MatrixHeadline(double[] v,int n)=>v.Length==n*n?$"{n} × {n} · {v.Length} row-major cells":"—";private static int ClusterCount(IReadOnlyList<int> a){var seen=new HashSet<int>();foreach(var x in a)if(x>=0)seen.Add(x);return seen.Count;}private static bool IsSorted(double[] v){for(var i=1;i<v.Length;i++)if(v[i]<v[i-1]-1e-8)return false;return true;}private static int EdgeCount(double[][] a){var c=0;for(var r=0;r<a.Length;r++)for(var col=r+1;col<a.Length;col++)if(a[r][col]>0)c++;return c;}
    private static bool TryEdges(string text,out double[][] a,out string error){error="";var parts=text.Split(',',StringSplitOptions.RemoveEmptyEntries|StringSplitOptions.TrimEntries);var edges=new List<(int,int)>();var max=-1;foreach(var part in parts){var pair=part.Split('-',StringSplitOptions.TrimEntries);if(pair.Length!=2||!TryNode(pair[0],out var x)||!TryNode(pair[1],out var y)||x==y){a=[];error="Use undirected edges like A-B, B-C with different labels A..J.";return false;}edges.Add((x,y));max=Math.Max(max,Math.Max(x,y));}if(max<3){a=[];error="Use at least four nodes.";return false;}var n=max+1;a=new double[n][];for(var i=0;i<n;i++)a[i]=new double[n];foreach(var e in edges){a[e.Item1][e.Item2]=1;a[e.Item2][e.Item1]=1;}return true;}private static bool TryNode(string s,out int n){n=-1;if(s.Length!=1)return false;var c=char.ToUpperInvariant(s[0]);if(c<'A'||c>'J')return false;n=c-'A';return true;}private static string FormatEdges(double[][] a){var list=new List<string>();for(var r=0;r<a.Length;r++)for(var c=r+1;c<a.Length;c++)if(a[r][c]>0)list.Add($"{(char)('A'+r)}-{(char)('A'+c)}");return string.Join(", ",list);}
    private static double[][] TwoCommunities()=>Undirected(6,[(0,1),(0,2),(1,2),(2,3),(3,4),(3,5),(4,5)]);private static double[][] Lopsided()=>Undirected(7,[(0,1),(0,2),(1,2),(2,3),(3,4),(4,5),(4,6),(5,6)]);private static double[][] ThreeCommunities()=>Undirected(9,[(0,1),(0,2),(1,2),(2,3),(3,4),(3,5),(4,5),(5,6),(6,7),(6,8),(7,8)]);private static double[][] Undirected(int n,(int,int)[] edges){var a=new double[n][];for(var i=0;i<n;i++)a[i]=new double[n];foreach(var e in edges){a[e.Item1][e.Item2]=1;a[e.Item2][e.Item1]=1;}return a;}public void Dispose()=>SimulationState.Changed-=HandleSimulationChanged;
    private sealed record RunFrame(string StepText,SpectralClusteringSnapshot Snapshot);private sealed record PracticeTaskDefinition(int Id,string Title,string Goal,string Suggested,Preset Preset,int Clusters);private enum Preset{TwoCommunities,Lopsided,ThreeCommunities}private enum StateView{Visual,Memory}
}
