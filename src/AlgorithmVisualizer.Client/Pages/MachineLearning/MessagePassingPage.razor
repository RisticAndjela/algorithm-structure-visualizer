@page "/graph-ml/message-passing"
@using System.Globalization
@using AlgorithmVisualizer.Core.MachineLearning.GraphMl.MessagePassing
@implements IDisposable
@inject SimulationState SimulationState
@inject MessagePassingSimulation MessageLab
@inject LearningSessionStore LearningStore
@inject PracticeProgressStore PracticeProgress

<PageTitle>Message Passing / basic GNN — Graph ML — Algorithm Visualizer</PageTitle>

<div class="learning-module-page learning-module-shell ml-module-page">
    <section class="learn-launchpad"><div class="learn-copy"><span class="section-kicker">LEARN FIRST</span><h2>A GNN layer lets every node update its feature vector using information from its graph neighbors.</h2><p>Gather neighbor features, aggregate them, transform self and neighbor information separately, combine with bias, apply ReLU, then commit all nodes together.</p><ConceptLink class="learn-launchpad-link" Href="/learn/concepts/message-passing">Open Message Passing / GNN concepts &amp; memory →</ConceptLink></div><div class="learn-grid"><article class="learn-card purple"><span>1 · GATHER</span><strong>Read neighbor embeddings.</strong><small>Adjacency decides who can send a message.</small></article><article class="learn-card blue"><span>2 · AGGREGATE</span><strong>Mean or sum the messages.</strong><small>Aggregation must ignore neighbor order.</small></article><article class="learn-card mint"><span>3 · COMBINE</span><strong>Transform self + neighborhood.</strong><small>Separate weight matrices keep the two information paths visible.</small></article><article class="learn-card gold"><span>4 · COMMIT</span><strong>Apply ReLU, then switch layers together.</strong><small>Synchronous commit prevents update order from leaking into the result.</small></article></div></section>

    <header class="module-header"><div class="header-copy"><div class="module-eyebrow"><span>GRAPH ML · PHASE 3 STEP 15</span><span class="separator">/</span><span class="live-status"><i></i> Interactive</span></div><h1>Message Passing / basic GNN</h1><p>Run a real graph-neural message-passing layer without a tensor or GNN framework: neighbor aggregation, linear transforms, ReLU, and synchronous layer commit are all explicit.</p></div><div class="complexity-summary"><div><span>One layer</span><strong>O(E·d + V·d²)</strong><small>messages + dense feature transforms</small></div><div><span>Storage</span><strong>O(E + V·d)</strong><small>CSR graph + node embeddings</small></div><div><span>Graph edits</span><strong>Restart</strong><small>neighbors define every message</small></div></div></header>
    <section class="smart-tip"><span class="tip-icon">✦</span><div><strong>A GNN does not “look at the picture” of a graph.</strong><p>It receives adjacency plus feature vectors. After one layer a node can mix one-hop information; after two layers it can indirectly contain information from two hops away.</p></div><ConceptLink Href="/graph-ml/sparse-matrix">CSR adjacency underneath →</ConceptLink></section>

    <section class="builder-section"><div class="section-heading-row"><div class="heading-with-step"><span class="step-number">1</span><div><span class="section-kicker">BUILD THE MESSAGE-PASSING CASE</span><h2>Choose graph structure, aggregation, and how many synchronous layers to run.</h2><p>The displayed 2D feature vectors are the actual values used by the Core implementation.</p></div></div></div><div class="preset-row"><span>START WITH</span>@foreach(var p in Enum.GetValues<Preset>()){<button class="@PresetClass(p)" @onclick="() => LoadPreset(p)" disabled="@IsBusy">@PresetName(p)</button>}</div><div class="dl-builder-card"><div class="dl-mode-row"><span>AGGREGATION</span><button class="@AggregationClass(MessageAggregation.Mean)" @onclick="() => SetAggregation(MessageAggregation.Mean)" disabled="@IsBusy">Mean</button><button class="@AggregationClass(MessageAggregation.Sum)" @onclick="() => SetAggregation(MessageAggregation.Sum)" disabled="@IsBusy">Sum</button></div><div class="dl-mode-row"><span>LAYERS</span><button class="@LayerClass(1)" @onclick="() => SetLayers(1)" disabled="@IsBusy">1 layer</button><button class="@LayerClass(2)" @onclick="() => SetLayers(2)" disabled="@IsBusy">2 layers</button></div><div class="graphml-summary-row"><div><span>NODES</span><strong>@_features.Length</strong></div><div><span>EDGES</span><strong>@EdgeCount(_adjacency)</strong></div><div><span>FEATURE DIM</span><strong>@_features[0].Length</strong></div></div><div class="dl-inline-actions"><button class="secondary-action" @onclick="ToggleAdvanced" disabled="@IsBusy">@(_showAdvanced?"Hide model values":"Inspect / edit features + weights")</button></div>@if(_showAdvanced){<div class="dl-advanced"><label class="dl-field"><span>NODE FEATURES · one x,y row per node separated by ;</span><textarea value="@_featuresText" @oninput="FeaturesChanged" rows="3" disabled="@IsBusy"></textarea></label><div class="dl-control-grid two"><label><span>W SELF · a,b;c,d</span><input value="@_selfWeightsText" @oninput="SelfWeightsChanged" disabled="@IsBusy" /></label><label><span>W NEIGHBOR · a,b;c,d</span><input value="@_neighborWeightsText" @oninput="NeighborWeightsChanged" disabled="@IsBusy" /></label></div><label class="dl-field"><span>BIAS</span><input value="@_biasText" @oninput="BiasChanged" disabled="@IsBusy" /></label></div>}@if(!string.IsNullOrWhiteSpace(_inputError)){<div class="input-error"><strong>Check GNN input.</strong><span>@_inputError</span></div>}</div></section>

    <section class="predict-section"><div class="prediction-card"><div class="prediction-copy"><span class="step-number">2</span><div><span class="section-kicker">PREDICT FIRST</span><h2>Which node will gather the most neighbor feature vectors?</h2><p>This checks the graph structure before the weights or activation can distract you.</p></div></div><div class="prediction-actions">@for(var node=0;node<_features.Length;node++){var captured=node;<button class="@PredictionClass(captured)" @onclick="() => SetPrediction(captured)" disabled="@IsBusy">Node @Label(captured)</button>}</div>@if(_predictionAnswered){<p class="prediction-feedback @(_predictionCorrect?"correct":"incorrect")">@PredictionFeedback</p>}</div></section>

    <section class="lab-section"><div class="lab-heading"><div class="heading-with-step"><span class="step-number">3</span><div><span class="section-kicker">WATCH ONE NODE UPDATE AT A TIME</span><h2>Gather → aggregate → transform → ReLU → commit layer.</h2></div></div><div class="lab-actions"><label class="popup-toggle"><input type="checkbox" checked="@_showRunPopups" @onchange="ToggleRunPopups" /><span>Open explanation after run</span></label>@if(_lastResult is not null){<button class="secondary-action" @onclick="OpenLastRunPopup">Last explanation</button>}<button class="sort-button" @onclick="RunAsync" disabled="@IsBusy"><span>▶</span> Run message passing</button></div></div>

        <SimulationToolbar Compact="true" OnPlay="PlayTimelineAsync" OnPause="PauseTimelineAsync" OnStepBack="StepBackAsync" OnStepForward="StepForwardAsync" OnReset="ResetPlaybackAsync" CanStepBack="@CanStepBack" CanStepForwardOverride="@CanStepForward" StepTextOverride="@DisplayedStepText" TimelinePosition="@TimelinePosition" TimelineCount="@TimelineCount" />

        <RunMetricStrip Items="@LiveRunMetrics" AriaLabel="Message Passing live metrics" />

        <div class="state-tabs-row"><div class="state-tabs"><button class="@(_view==StateView.Visual?"active":"")" @onclick="() => _view=StateView.Visual">Visual state</button><button class="@(_view==StateView.Memory?"active":"")" @onclick="() => _view=StateView.Memory">Memory state</button></div><p>@ViewExplanation</p></div>
        <div class="state-surface ml-state-surface">@if(_view==StateView.Visual){<div class="ml-visual-board"><MessagePassingGraph Snapshot="@DisplayedSnapshot" /></div>}else{<div class="dl-memory-grid"><article class="dl-memory-card"><span>CURRENT H</span><strong>@FeatureMatrixText(DisplayedSnapshot.Features)</strong><small>Every node reads from this fully committed layer.</small></article><article class="dl-memory-card"><span>STAGED NEXT H</span><strong>@FeatureMatrixText(DisplayedSnapshot.NextFeatures)</strong><small>Per-node results wait here until the layer commits synchronously.</small></article><article class="dl-memory-card"><span>AGGREGATE</span><strong>@Vector(DisplayedSnapshot.Aggregate)</strong><small>@DisplayedSnapshot.Aggregation is order-invariant across the neighbor set.</small></article><article class="dl-memory-card"><span>PRE-ACTIVATION</span><strong>@Vector(DisplayedSnapshot.PreActivation)</strong><small>Wself·h + Wnbr·aggregate + b before ReLU.</small></article></div>}</div>
        <div class="lesson-reference-links"><ConceptLink Href="/learn/concepts/message-passing">Message Passing concepts →</ConceptLink><ConceptLink Href="/graph-ml/sparse-matrix">Sparse adjacency →</ConceptLink><ConceptLink Href="/deep-learning/mlp">Linear transform / activation refresher →</ConceptLink></div>

    </section>

    <section class="fit-section"><div class="section-heading-row"><div><span class="section-kicker">WHEN SHOULD I USE IT?</span><h2>Use message passing when each example is a node whose meaning depends on both its own features and its graph neighborhood.</h2></div></div><div class="fit-grid"><article class="fit-card good"><span>GOOD FIT</span><strong>Node classification, graph embeddings, relational data</strong><p>GNN layers can mix local feature evidence with structural context while sharing the same update rule across nodes.</p></article><article class="fit-card avoid"><span>AVOID FOR</span><strong>Independent tabular examples with no meaningful edges</strong><p>Inventing a graph just to use a GNN can add noise and complexity. The adjacency must encode a defensible relationship.</p></article><article class="fit-card better"><span>BETTER ALTERNATIVE</span><strong>Use an MLP when examples are independent vectors</strong><p>If there is no neighborhood to aggregate, a normal neural network already handles weighted feature interactions directly.</p><div class="fit-links"><a href="/deep-learning/mlp">Neural Network / MLP →</a></div></article></div></section>

    <section class="practice-section"><div class="practice-heading"><div><span class="section-kicker">GUIDED PRACTICE</span><h2>Compare mean vs sum and watch the receptive field grow across layers.</h2></div><strong>@_completedTaskIds.Count / @PracticeTasks.Length complete</strong></div><div class="practice-grid">@foreach(var t in PracticeTasks){<PracticeTaskCard TaskId="@t.Id" Title="@t.Title" Description="@t.Goal" InputText="@t.Suggested" HelpHref="/learn/concepts/message-passing" Completed="@_completedTaskIds.Contains(t.Id)" Active="@(_activeTaskId==t.Id)" Busy="@IsBusy" HasEvidence="@(GetTaskEvidence(t.Id)is not null)" Start="@(() => StartTask(t.Id))" OpenEvidence="@(() => OpenTaskEvidence(t.Id))" />}</div></section>
    <NextLessonCard Eyebrow="PHASE 3 COMPLETE" Level="15 · Complete" Title="Graph ML track complete" Description="You now have sparse storage, graph ranking, spectral embeddings, and a basic GNN message-passing layer. Review the concepts or return to the curriculum." Href="/learn/concepts/message-passing" LinkLabel="Review Graph ML concepts" />
</div>

@if(_lastRunPopupOpen&&_lastResult is not null){<div class="run-popup-backdrop" @onclick="CloseLastRunPopup"><section class="run-popup" role="dialog" aria-modal="true" @onclick:stopPropagation="true"><header><div><span class="section-kicker">LAST RUN</span><h2>@_lastResult.Layers message-passing layer@(_lastResult.Layers==1?"":"s") committed.</h2></div><button class="popup-close" @onclick="CloseLastRunPopup">×</button></header><div class="popup-body"><p>@_lastResult.Summary</p><div class="popup-metrics"><div><span>AGGREGATION</span><strong>@_lastResult.Aggregation</strong></div><div><span>LAYERS</span><strong>@_lastResult.Layers</strong></div><div><span>MAX DEGREE</span><strong>@MaxDegree(_lastResult.NeighborCounts)</strong></div><div><span>NODES</span><strong>@_lastResult.FinalFeatures.Length</strong></div></div><p class="popup-memory">CSR holds the graph; node features are two aligned V×d buffers so every layer can read old embeddings and stage new ones without order-dependent in-place updates.</p></div></section></div>}
<PracticeEvidencePopup Evidence="@_practiceEvidencePopup" OnClose="CloseTaskEvidence" />

@code {
    private IReadOnlyList<RunMetricItem> LiveRunMetrics => [new("PHASE", PhaseText(DisplayedSnapshot.Phase)), new("LAYER", $"{DisplayedSnapshot.Layer} / {_layers}"), new("NODE", DisplayedSnapshot.CurrentNode >= 0 ? Label(DisplayedSnapshot.CurrentNode) : "—"), new("AGG", DisplayedSnapshot.Aggregation.ToString())];
    private const string ModuleKey="message-passing";
    private const string PopupKey="algorithm-visualizer.message-passing.show-run-popup.v1";
    private readonly List<RunFrame> _frames=[];
    private PracticeModuleProgress _practiceProgress=new();
    private HashSet<int> _completedTaskIds=[];
    private PracticeCompletionEvidence? _practiceEvidencePopup;
    private MessagePassingRunResult? _lastResult;
    private string? _lastCapturedStep,_inputError;
    private double[][] _adjacency=StarAdj();
    private double[][] _features=StarFeatures();
    private double[][] _selfWeights=[[.8,.1],[.1,.8]],_neighborWeights=[[.45,.2],[.2,.45]];
    private double[] _bias=[0,0];
    private string _featuresText=FormatRows(StarFeatures()),_selfWeightsText="0.8,0.1; 0.1,0.8",_neighborWeightsText="0.45,0.2; 0.2,0.45",_biasText="0, 0";
    private MessageAggregation _aggregation=MessageAggregation.Mean;
    private int _layers=1;
    private Preset? _preset=Preset.Star;
    private bool _showAdvanced,_showRunPopups=true,_lastRunPopupOpen,_predictionAnswered,_predictionCorrect;
    private int? _prediction,_activeTaskId;
    private int _frameIndex=-1;
    private StateView _view=StateView.Visual;
    private static readonly PracticeTaskDefinition[] PracticeTasks=[new(1,"Find the busiest node","Run the star and identify node A as the highest-degree gather target.","Star · mean · 1 layer",Preset.Star,MessageAggregation.Mean,1),new(2,"Compare mean aggregation","Run the symmetric-neighbor case with mean and keep symmetric nodes equal.","Symmetric · mean",Preset.Symmetric,MessageAggregation.Mean,1),new(3,"See sum scale with degree","Run the star with sum aggregation and verify the center's result differs from the mean run behavior.","Star · sum",Preset.Star,MessageAggregation.Sum,1),new(4,"Reach two hops","Run the chain for two layers so the end embedding changes after information can travel through an intermediate node.","Chain · 2 layers",Preset.Chain,MessageAggregation.Mean,2),new(5,"Handle isolation","Run a graph with one isolated node and complete with a zero neighbor aggregate rather than an error.","Isolated",Preset.Isolated,MessageAggregation.Mean,1)];
    private MessagePassingSnapshot DisplayedSnapshot=>_frameIndex>=0&&_frameIndex<_frames.Count?_frames[_frameIndex].Snapshot:MessageLab.CreateSnapshot();
    private string DisplayedStepText=>_frameIndex>=0&&_frameIndex<_frames.Count?_frames[_frameIndex].StepText:SimulationState.CurrentStepText;
    private bool IsBusy=>SimulationState.IsRunning;
    private int TimelineCount=>_frames.Count;
    private int TimelinePosition=>_frameIndex<0?0:_frameIndex+1;
    private bool CanStepBack=>_frameIndex>0;
    private bool CanStepForward=>(_frameIndex>=0&&_frameIndex<_frames.Count-1)||SimulationState.IsRunning;
    private string ViewExplanation=>_view==StateView.Visual?"Highlighted edges show the neighborhood of the active node while the side tray exposes its actual aggregate and transforms. The visual stays in normal page flow.":"Inspect current vs staged node embeddings. Synchronous double-buffering is what prevents node update order from changing the layer result.";
    private string PredictionFeedback=>_lastResult is null?string.Empty:_predictionCorrect?"Correct — that node has the largest neighbor set in this graph.":$"Node {Label(MaxDegreeNode(_lastResult.NeighborCounts))} gathers the most neighbors.";
    protected override void OnInitialized(){
        SimulationState.Changed+=HandleSimulationChanged;
        _showRunPopups=!bool.TryParse(LearningStore.GetItem(PopupKey),out var saved)||saved;
        _practiceProgress=PracticeProgress.Load(ModuleKey,null,PracticeTasks.Select(t=>t.Id));
        _completedTaskIds=_practiceProgress.CompletedTaskIds;
        ApplyInputs();
    }
    private void LoadPreset(Preset p){
        if(IsBusy)return;
        _preset=p;
        switch(p){
            case Preset.Chain:_adjacency=ChainAdj();
            _features=ChainFeatures();
            break;
            case Preset.Symmetric:_adjacency=SymmetricAdj();
            _features=SymmetricFeatures();
            break;
            case Preset.Isolated:_adjacency=IsolatedAdj();
            _features=IsolatedFeatures();
            break;
            default:_adjacency=StarAdj();
            _features=StarFeatures();
            break;
        }
        _featuresText=FormatRows(_features);
        ApplyInputs();
    }
    private void SetAggregation(MessageAggregation a){
        if(IsBusy)return;
        _aggregation=a;
        ApplyInputs();
    }
    private void SetLayers(int layers){
        if(IsBusy)return;
        _layers=layers;
        ApplyInputs();
    }
    private void ToggleAdvanced(){
        if(!IsBusy)_showAdvanced=!_showAdvanced;
    }
    private void FeaturesChanged(ChangeEventArgs e){
        _featuresText=e.Value?.ToString()??"";
        _preset=null;
        ClearReview();
    }
    private void SelfWeightsChanged(ChangeEventArgs e){
        _selfWeightsText=e.Value?.ToString()??"";
        ClearReview();
    }
    private void NeighborWeightsChanged(ChangeEventArgs e){
        _neighborWeightsText=e.Value?.ToString()??"";
        ClearReview();
    }
    private void BiasChanged(ChangeEventArgs e){
        _biasText=e.Value?.ToString()??"";
        ClearReview();
    }
    private void SetPrediction(int node){
        _prediction=node;
        _predictionAnswered=false;
        _predictionCorrect=false;
    }
    private void ApplyInputs(){
        if(!TryRows(_featuresText,out var f,out var error)){
            _inputError=error;
            return;
        }
        if(f.Length!=_adjacency.Length){
            _inputError="Feature rows must match the graph node count.";
            return;
        }
        if(!TryRows(_selfWeightsText,out var ws,out error)||!TryRows(_neighborWeightsText,out var wn,out error)){
            _inputError="Weight matrices must use row syntax a,b; c,d.";
            return;
        }
        if(!TryVector(_biasText,out var b)){
            _inputError="Bias must be a finite vector.";
            return;
        }
        try{
            MessageLab.Configure(new MessagePassingConfiguration(_adjacency,f,ws,wn,b,_aggregation,_layers));
            _features=f;
            _selfWeights=ws;
            _neighborWeights=wn;
            _bias=b;
            _inputError=null;
            ClearReview();
        }
        catch(ArgumentException ex){
            _inputError=ex.Message;
        }
    }
    private async Task RunAsync(){
        ApplyInputs();
        if(_inputError is not null)return;
        _frames.Clear();
        _frameIndex=-1;
        _lastCapturedStep=null;
        _lastRunPopupOpen=false;
        var token=SimulationState.Start("Starting message passing.");
        Capture();
        try{
            var r=await MessageLab.ExecuteAsync(token);
            if(!IsCurrent(token))return;
            _lastResult=r;
            SimulationState.Complete(r.Summary);
            Capture();
            if(_prediction is not null){
                _predictionAnswered=true;
                _predictionCorrect=_prediction==MaxDegreeNode(r.NeighborCounts);
            }
            RecordPractice(r);
            if(_showRunPopups)OpenLastRunPopup();
        }
        catch(OperationCanceledException)when(!IsCurrent(token)){
        }
    }
    private void Capture(){
        var step=SimulationState.CurrentStepText;
        if(step==_lastCapturedStep)return;
        var follow=_frameIndex<0||_frameIndex==_frames.Count-1;
        _frames.Add(new(step,MessageLab.CreateSnapshot()));
        _lastCapturedStep=step;
        if(follow)_frameIndex=_frames.Count-1;
    }
    private void HandleSimulationChanged(){
        if(SimulationState.IsRunning)Capture();
        _=InvokeAsync(StateHasChanged);
    }
    private bool IsCurrent(CancellationToken t)=>!t.IsCancellationRequested&&SimulationState.SimulationCancellationToken==t;
    private void ClearReview(){
        SimulationState.Reset();
        _frames.Clear();
        _frameIndex=-1;
        _lastCapturedStep=null;
        _lastResult=null;
        _lastRunPopupOpen=false;
        _predictionAnswered=false;
    }
    private Task PlayTimelineAsync(){
        if(_frames.Count>0)_frameIndex=_frames.Count-1;
        SimulationState.Resume();
        return InvokeAsync(StateHasChanged);
    }
    private Task PauseTimelineAsync(){
        SimulationState.Pause();
        return Task.CompletedTask;
    }
    private Task StepBackAsync(){
        if(SimulationState.IsRunning&&!SimulationState.IsPaused)SimulationState.Pause();
        if(_frameIndex>0)_frameIndex--;
        return InvokeAsync(StateHasChanged);
    }
    private Task StepForwardAsync(){
        if(_frameIndex>=0&&_frameIndex<_frames.Count-1){
            _frameIndex++;
            return InvokeAsync(StateHasChanged);
        }
        if(SimulationState.IsRunning)SimulationState.Step();
        return Task.CompletedTask;
    }
    private Task ResetPlaybackAsync(){
        SimulationState.Reset();
        _frames.Clear();
        _frameIndex=-1;
        _lastCapturedStep=null;
        return InvokeAsync(StateHasChanged);
    }
    private void ToggleRunPopups(ChangeEventArgs e){
        _showRunPopups=e.Value is bool b&&b;
        LearningStore.SetItem(PopupKey,_showRunPopups.ToString());
    }
    private void OpenLastRunPopup()=>_lastRunPopupOpen=_lastResult is not null;
    private void CloseLastRunPopup()=>_lastRunPopupOpen=false;
    private void StartTask(int id){
        var t=PracticeTasks.First(x=>x.Id==id);
        _activeTaskId=id;
        LoadPreset(t.Preset);
        _aggregation=t.Aggregation;
        _layers=t.Layers;
        ApplyInputs();
    }
    private void RecordPractice(MessagePassingRunResult r){
        if(_activeTaskId is null)return;
        var t=PracticeTasks.First(x=>x.Id==_activeTaskId);
        var ok=t.Id switch{
            1=>MaxDegreeNode(r.NeighborCounts)==0,2=>Distance(r.FinalFeatures[1],r.FinalFeatures[2])<1e-9,3=>r.Aggregation==MessageAggregation.Sum&&Distance(r.InitialFeatures[0],r.FinalFeatures[0])>0.1,4=>r.Layers==2&&Distance(r.InitialFeatures[^1],r.FinalFeatures[^1])>0.1,5=>r.NeighborCounts[^1]==0&&AllFinite(r.FinalFeatures[^1]),_=>false
        };
        if(!ok)return;
        var ev=new PracticeCompletionEvidence(t.Id,t.Title,r.Summary,$"Final node embeddings = {FeatureMatrixText(r.FinalFeatures)}.",$"Neighbor counts = [{string.Join(", ",r.NeighborCounts)}]; two V×d buffers keep layer reads and writes separate.","Message passing learns local context by repeatedly aggregating permutation-invariant neighbor information and transforming it with shared weights.",[new("Aggregation",r.Aggregation.ToString()),new("Layers",r.Layers.ToString()),new("Max degree",MaxDegree(r.NeighborCounts).ToString())],$"{r.Aggregation} · layers={r.Layers}");
        _completedTaskIds.Add(t.Id);
        PracticeProgress.Complete(ModuleKey,_practiceProgress,t.Id,ev);
        _activeTaskId=null;
    }
    private PracticeCompletionEvidence? GetTaskEvidence(int id)=>PracticeProgress.GetEvidence(_practiceProgress,id);
    private void OpenTaskEvidence(int id)=>_practiceEvidencePopup=GetTaskEvidence(id);
    private void CloseTaskEvidence()=>_practiceEvidencePopup=null;
    private string PresetClass(Preset p)=>_preset==p?"active":"";
    private string AggregationClass(MessageAggregation a)=>_aggregation==a?"secondary-action active":"secondary-action";
    private string LayerClass(int l)=>_layers==l?"secondary-action active":"secondary-action";
    private string PredictionClass(int n)=>_prediction==n?"active":"";
    private static string PresetName(Preset p)=>p switch{
        Preset.Star=>"Star",Preset.Chain=>"Chain",Preset.Symmetric=>"Symmetric neighbors",_=>"Isolated node"
    };
    private static string PhaseText(MessagePassingPhase p)=>p switch{
        MessagePassingPhase.CommitLayer=>"commit",_=>p.ToString().ToLowerInvariant()
    };
    private static string Label(int n)=>((char)('A'+n)).ToString();
    private static string F(double v)=>Math.Abs(v)<1e-10?"0":v.ToString("0.###",CultureInfo.InvariantCulture);
    private static string Vector(IReadOnlyList<double> v)=>"["+string.Join(", ",v.Select(F))+"]";
    private static string FeatureMatrixText(IReadOnlyList<double[]> f)=>"["+string.Join(" · ",f.Select(Vector))+"]";
    private static string FormatRows(double[][] rows)=>string.Join("; ",rows.Select(row=>string.Join(", ",row.Select(F))));
    private static int EdgeCount(double[][] a){
        var c=0;
        for(var r=0;r<a.Length;r++)for(var col=r+1;col<a.Length;col++)if(a[r][col]>0||a[col][r]>0)c++;
        return c;
    }
    private static int MaxDegree(int[] d){
        var m=0;
        foreach(var x in d)if(x>m)m=x;
        return m;
    }
    private static int MaxDegreeNode(int[] d){
        var m=0;
        for(var i=1;i<d.Length;i++)if(d[i]>d[m])m=i;
        return m;
    }
    private static double Distance(double[] a,double[] b){
        var s=0d;
        for(var i=0;i<a.Length;i++){
            var d=a[i]-b[i];
            s+=d*d;
        }
        return Math.Sqrt(s);
    }
    private static bool AllFinite(double[] v){
        foreach(var x in v)if(!double.IsFinite(x))return false;
        return true;
    }
    private static bool TryRows(string text,out double[][] rows,out string error){
        error="";
        var parts=text.Split(';',StringSplitOptions.RemoveEmptyEntries|StringSplitOptions.TrimEntries);
        rows=new double[parts.Length][];
        if(parts.Length<1||parts.Length>10){
            error="Use 1–10 rows.";
            return false;
        }
        var dim=-1;
        for(var i=0;i<parts.Length;i++){
            if(!TryVector(parts[i],out var v)){
                error=$"Row {i+1} is not a finite comma-separated vector.";
                return false;
            }
            if(dim<0)dim=v.Length;
            if(v.Length!=dim){
                error="All rows must have the same dimension.";
                return false;
            }
            rows[i]=v;
        }
        return true;
    }
    private static bool TryVector(string text,out double[] v){
        var p=text.Split(',',StringSplitOptions.RemoveEmptyEntries|StringSplitOptions.TrimEntries);
        v=new double[p.Length];
        if(p.Length<1||p.Length>4)return false;
        for(var i=0;i<p.Length;i++)if(!double.TryParse(p[i],NumberStyles.Float,CultureInfo.InvariantCulture,out v[i])||!double.IsFinite(v[i]))return false;
        return true;
    }
    private static double[][] StarAdj()=>Undirected(5,[(0,1),(0,2),(0,3),(2,4)]);
    private static double[][] StarFeatures()=>[[1,0],[0,1],[1,1],[2,0],[0,2]];
    private static double[][] ChainAdj()=>Undirected(5,[(0,1),(1,2),(2,3),(3,4)]);
    private static double[][] ChainFeatures()=>[[2,0],[0,0],[0,0],[0,0],[0,1]];
    private static double[][] SymmetricAdj()=>Undirected(4,[(0,1),(0,2),(1,3),(2,3)]);
    private static double[][] SymmetricFeatures()=>[[1,0],[0,1],[0,1],[1,0]];
    private static double[][] IsolatedAdj()=>Undirected(5,[(0,1),(1,2),(2,3)]);
    private static double[][] IsolatedFeatures()=>[[1,0],[0,1],[1,1],[2,0],[0.5,0.5]];
    private static double[][] Undirected(int n,(int,int)[] edges){
        var a=new double[n][];
        for(var i=0;i<n;i++)a[i]=new double[n];
        foreach(var e in edges){
            a[e.Item1][e.Item2]=1;
            a[e.Item2][e.Item1]=1;
        }
        return a;
    }
    public void Dispose()=>SimulationState.Changed-=HandleSimulationChanged;
