@page "/deep-learning/backpropagation"
@using System.Globalization
@using AlgorithmVisualizer.Core.MachineLearning.DeepLearning.Backpropagation
@using AlgorithmVisualizer.Core.MachineLearning.DeepLearning.Common
@implements IDisposable
@inject SimulationState SimulationState
@inject BackpropagationSimulation BackpropLab
@inject LearningSessionStore LearningStore
@inject PracticeProgressStore PracticeProgress

<PageTitle>Backpropagation — Deep Learning — Algorithm Visualizer</PageTitle>

<div class="learning-module-page learning-module-shell ml-module-page">
    <section class="learn-launchpad" aria-labelledby="bp-learn-title">
        <div class="learn-copy"><span class="section-kicker">LEARN FIRST</span><h2 id="bp-learn-title">Backpropagation answers one question: which parameters were responsible for the loss?</h2><p>The forward pass stores z and activation values. The reverse pass starts at loss, applies the chain rule, and gives every weight and bias its own gradient.</p><ConceptLink class="learn-launchpad-link" Href="/learn/concepts/backpropagation">Open Backpropagation concepts &amp; memory →</ConceptLink></div>
        <div class="learn-grid"><article class="learn-card purple"><span>1 · FORWARD</span><strong>Cache the values needed later.</strong><small>Inputs, z values, and activations remain available.</small></article><article class="learn-card blue"><span>2 · LOSS</span><strong>Start from one scalar error.</strong><small>The reverse pass needs a clear objective.</small></article><article class="learn-card mint"><span>3 · CHAIN RULE</span><strong>Move responsibility backward.</strong><small>Upstream gradient × local derivative.</small></article><article class="learn-card gold"><span>4 · UPDATE</span><strong>Every parameter receives a gradient.</strong><small>Optimizer rules decide how those gradients move parameters.</small></article></div>
    </section>

    <header class="module-header"><div class="header-copy"><div class="module-eyebrow"><span>DEEP LEARNING · PHASE 2 STEP 11</span><span class="separator">/</span><span class="live-status"><i></i> Interactive</span></div><h1>Backpropagation</h1><p>Run one forward pass, reverse the chain rule through a one-hidden-layer MLP, and inspect every gradient before the update.</p></div><div class="complexity-summary"><div><span>Backward work</span><strong>Θ(weights)</strong><small>one gradient contribution per connection</small></div><div><span>Gradient memory</span><strong>O(weights)</strong><small>one slot per trainable parameter</small></div><div><span>Edit during run</span><strong>Restart</strong><small>gradients belong to one forward snapshot</small></div></div></header>

    <section class="smart-tip"><span class="tip-icon">✦</span><div><strong>Backprop does not “search” for gradients.</strong><p>It reuses the forward graph's exact local derivatives. The difficult part is bookkeeping: which upstream gradient reaches which parameter through which activation derivative.</p></div><ConceptLink Href="/learn/concepts/backpropagation">Trace the chain rule →</ConceptLink></section>

    <section class="builder-section">
        <div class="section-heading-row"><div class="heading-with-step"><span class="step-number">1</span><div><span class="section-kicker">CHOOSE THE TRAINING CASE</span><h2>Use a tiny network so every gradient stays inspectable.</h2><p>The default network has 2 inputs, 2 hidden neurons, and 1 output. Presets change the case, not the page structure.</p></div></div></div>
        <div class="preset-row"><span>TRY AN EXAMPLE</span>@foreach(var p in Enum.GetValues<Preset>()){<button class="@(p==_preset?"active":string.Empty)" @onclick="() => LoadPreset(p)" disabled="@IsBusy">@PresetName(p)</button>}</div>
        <div class="dl-builder-card">
            <div class="dl-mode-row"><span>HIDDEN ACTIVATION</span>@foreach(var a in HiddenActivations){<button class="secondary-action @(_hiddenActivation==a?"active":string.Empty)" @onclick="() => SetHiddenActivation(a)" disabled="@IsBusy">@ActivationMath.DisplayName(a)</button>}</div>
            <div class="dl-control-grid"><label><span>INPUT VECTOR</span><input value="@_inputsText" @oninput="InputsChanged" disabled="@IsBusy" /></label><label><span>TARGET</span><input value="@_targetText" @oninput="TargetChanged" disabled="@IsBusy" inputmode="decimal" /></label><label><span>LEARNING RATE</span><input value="@_learningRateText" @oninput="LearningRateChanged" disabled="@IsBusy" inputmode="decimal" /></label></div>
            <div class="dl-inline-actions"><button class="secondary-action" @onclick="ToggleAdvanced" disabled="@IsBusy">@(_showAdvanced?"Hide network parameters":"Inspect / edit parameters")</button></div>
            @if(_showAdvanced){<div class="dl-advanced"><div class="dl-control-grid two"><label><span>W₁ · ROW-MAJOR</span><input value="@_hiddenWeightsText" @oninput="HiddenWeightsChanged" disabled="@IsBusy" /></label><label><span>HIDDEN BIASES</span><input value="@_hiddenBiasesText" @oninput="HiddenBiasesChanged" disabled="@IsBusy" /></label><label><span>W₂</span><input value="@_outputWeightsText" @oninput="OutputWeightsChanged" disabled="@IsBusy" /></label><label><span>OUTPUT BIAS</span><input value="@_outputBiasText" @oninput="OutputBiasChanged" disabled="@IsBusy" /></label></div></div>}
            @if(!string.IsNullOrWhiteSpace(_inputError)){<div class="input-error"><strong>Check this training case.</strong><span>@_inputError</span></div>}
        </div>
    </section>

    <section class="predict-section"><div class="prediction-copy"><span class="step-number">2</span><div><span class="section-kicker">PREDICT FIRST</span><h2>After one gradient update, what should happen to the loss?</h2><p>A sensible small learning rate should usually move downhill, but dead activations can block part of the reverse signal.</p></div></div><div class="prediction-card"><div class="prediction-actions"><button class="@PredictionClass(LossPrediction.Lower)" @onclick="() => SetPrediction(LossPrediction.Lower)">Lower</button><button class="@PredictionClass(LossPrediction.Same)" @onclick="() => SetPrediction(LossPrediction.Same)">Almost unchanged</button><button class="@PredictionClass(LossPrediction.Higher)" @onclick="() => SetPrediction(LossPrediction.Higher)">Higher</button></div>@if(_predictionAnswered){<p class="prediction-feedback @(_predictionCorrect?"correct":"incorrect")">@PredictionFeedback</p>}</div></section>

    <section class="lab-section">
        <div class="lab-heading"><div class="heading-with-step"><span class="step-number">3</span><div><span class="section-kicker">WATCH THE REVERSE PASS</span><h2>Forward values move right; gradients move left.</h2></div></div><div class="lab-actions"><label class="popup-toggle"><input type="checkbox" checked="@_showRunPopups" @onchange="ToggleRunPopups" /><span>Open explanation after run</span></label>@if(_lastResult is not null){<button class="secondary-action" @onclick="OpenLastRunPopup">Last explanation</button>}<button class="sort-button" @onclick="RunAsync" disabled="@IsBusy"><span>▶</span> Run backprop</button></div></div>

        <SimulationToolbar Compact="true" OnPlay="PlayTimelineAsync" OnPause="PauseTimelineAsync" OnStepBack="StepBackAsync" OnStepForward="StepForwardAsync" OnReset="ResetPlaybackAsync" CanStepBack="@CanStepBack" CanStepForwardOverride="@CanStepForward" StepTextOverride="@DisplayedStepText" TimelinePosition="@TimelinePosition" TimelineCount="@TimelineCount" />

        <RunMetricStrip Items="@LiveRunMetrics" AriaLabel="Backpropagation live metrics" />

        <div class="state-tabs-row"><div class="state-tabs"><button class="@(_view==StateView.Visual?"active":string.Empty)" @onclick="() => _view=StateView.Visual">Visual state</button><button class="@(_view==StateView.Memory?"active":string.Empty)" @onclick="() => _view=StateView.Memory">Memory state</button></div><p>@ViewExplanation</p></div>

        <div class="state-surface ml-state-surface">@if(_view==StateView.Visual){<div class="ml-visual-board"><BackpropagationFlow Snapshot="@DisplayedSnapshot" /></div>}else{<div class="dl-memory-grid"><article class="dl-memory-card"><span>FORWARD CACHE</span><strong>hidden z @Vector(DisplayedSnapshot.HiddenPreActivations) · a @Vector(DisplayedSnapshot.HiddenActivations)</strong><small>Backprop reuses the exact forward values.</small></article><article class="dl-memory-card"><span>OUTPUT DELTA</span><strong>@F(DisplayedSnapshot.OutputDelta)</strong><small>dL/dz at the output neuron.</small></article><article class="dl-memory-card"><span>HIDDEN DELTAS</span><strong>@Vector(DisplayedSnapshot.HiddenDeltas)</strong><small>Each hidden delta includes its output weight and activation derivative.</small></article><article class="dl-memory-card"><span>GRADIENT BUFFERS</span><strong>W₂ @Vector(DisplayedSnapshot.OutputWeightGradients) · W₁ @Vector(DisplayedSnapshot.HiddenWeightGradients)</strong><small>One gradient slot exists for each trainable connection.</small></article></div>}</div>
        <div class="lesson-reference-links"><ConceptLink Href="/learn/concepts/backpropagation">Backpropagation concepts →</ConceptLink><ConceptLink Href="/deep-learning/mlp">Review MLP →</ConceptLink><ConceptLink Href="/deep-learning/neuron-activations">Activation derivatives →</ConceptLink></div>

    </section>

    <section class="fit-section"><div class="section-heading-row"><div><span class="section-kicker">WHEN SHOULD I USE IT?</span><h2>Use Backpropagation when a differentiable layered model has many parameters that must learn from one scalar objective.</h2></div></div><div class="fit-grid"><article class="fit-card good"><span>GOOD FIT</span><strong>Differentiable neural networks with shared layer structure</strong><p>Backprop reuses intermediate values and local derivatives, making gradient computation scale with the number of connections rather than one full re-run per parameter.</p></article><article class="fit-card avoid"><span>AVOID FOR</span><strong>Non-differentiable discrete decisions or models that do not expose useful derivatives</strong><p>The chain rule needs differentiable paths. Some discrete systems need different optimization strategies.</p></article><article class="fit-card better"><span>BETTER ALTERNATIVE</span><strong>Gradient Descent explains the outer update loop</strong><p>Backprop computes gradients. SGD, Momentum, and Adam decide how those gradients become parameter updates.</p><div class="fit-links"><a href="/ml-foundations/gradient-descent">Gradient Descent →</a><a href="/deep-learning/optimizers">Optimizers →</a></div></article></div></section>

    <section class="practice-section"><div class="practice-heading"><div><span class="section-kicker">GUIDED PRACTICE</span><h2>Test gradient direction, dead ReLU paths, and learning-rate effects.</h2></div><strong>@_completedTaskIds.Count / @PracticeTasks.Length complete</strong></div><div class="practice-grid">@foreach(var t in PracticeTasks){<PracticeTaskCard TaskId="@t.Id" Title="@t.Title" Description="@t.Goal" InputText="@t.Suggested" HelpHref="/learn/concepts/backpropagation" Completed="@_completedTaskIds.Contains(t.Id)" Active="@(_activeTaskId==t.Id)" Busy="@IsBusy" HasEvidence="@(GetTaskEvidence(t.Id)is not null)" Start="@(() => StartTask(t.Id))" OpenEvidence="@(() => OpenTaskEvidence(t.Id))" />}</div></section>
    <NextLessonCard Eyebrow="NEXT DEEP-LEARNING LESSON" Level="12 · Interactive" Title="SGD / Momentum / Adam" Description="Keep the gradients, change the optimizer state, and compare how three update rules move the same model parameters." Href="/deep-learning/optimizers" LinkLabel="Open Optimizers" />
</div>

@if(_lastRunPopupOpen&&_lastResult is not null){<div class="run-popup-backdrop" @onclick="CloseLastRunPopup"><section class="run-popup" role="dialog" aria-modal="true" @onclick:stopPropagation="true"><header><div><span class="section-kicker">LAST RUN</span><h2>Loss @F(_lastResult.LossBefore) → @F(_lastResult.LossAfter)</h2></div><button class="popup-close" @onclick="CloseLastRunPopup">×</button></header><div class="popup-body"><p>@_lastResult.Summary</p><div class="popup-metrics"><div><span>PREDICTION</span><strong>@F(_lastResult.PredictionBefore) → @F(_lastResult.PredictionAfter)</strong></div><div><span>OUTPUT DELTA</span><strong>@F(_lastResult.OutputDelta)</strong></div><div><span>HIDDEN DELTAS</span><strong>@Vector(_lastResult.HiddenDeltas)</strong></div><div><span>LOSS LOWER?</span><strong>@(_lastResult.Improved?"Yes":"No")</strong></div></div><p class="popup-memory">The forward cache and gradient buffers are separate memory. The update happens only after every gradient for this snapshot has been computed.</p></div></section></div>}
<PracticeEvidencePopup Evidence="@_practiceEvidencePopup" OnClose="CloseTaskEvidence" />

@code {
    private IReadOnlyList<RunMetricItem> LiveRunMetrics => [new("PHASE", DisplayedSnapshot.Phase.ToString()), new("LOSS", F(DisplayedSnapshot.Loss)), new("OUTPUT DELTA", F(DisplayedSnapshot.OutputDelta)), new("ACTIVE HIDDEN", DisplayedSnapshot.ActiveHiddenNeuron < 0 ? "—" : $"h{DisplayedSnapshot.ActiveHiddenNeuron + 1}")];
    private const string ModuleKey="backpropagation";private const string PopupKey="algorithm-visualizer.backprop.show-run-popup.v1";private static readonly ActivationKind[] HiddenActivations=[ActivationKind.Tanh,ActivationKind.ReLU,ActivationKind.Sigmoid];private readonly List<RunFrame> _frames=[];private PracticeModuleProgress _practiceProgress=new();private HashSet<int> _completedTaskIds=[];private PracticeCompletionEvidence? _practiceEvidencePopup;private BackpropagationRunResult? _lastResult;private string? _lastCapturedStep;private string? _inputError;private string _inputsText="1, 0.5",_targetText="1",_learningRateText="0.2",_hiddenWeightsText="0.6, -0.2, -0.4, 0.7",_hiddenBiasesText="0.1, -0.1",_outputWeightsText="0.8, -0.6",_outputBiasText="0.05";private ActivationKind _hiddenActivation=ActivationKind.Tanh;private Preset? _preset=Preset.TargetOne;private bool _showAdvanced,_showRunPopups=true,_lastRunPopupOpen,_predictionAnswered,_predictionCorrect;private LossPrediction? _prediction;private int _frameIndex=-1;private int? _activeTaskId;private StateView _view=StateView.Visual;
    private static readonly PracticeTaskDefinition[] PracticeTasks=[new(1,"Reduce loss toward target 1","Run the default tanh network and verify one update lowers the loss.","Target 1",Preset.TargetOne),new(2,"Reverse toward target 0","Change the target and verify the output delta changes direction.","Target 0",Preset.TargetZero),new(3,"Find a dead ReLU path","Use a hidden neuron with negative z and verify its hidden delta becomes zero.","Dead ReLU",Preset.DeadRelu),new(4,"Use a smaller update","Run the small-learning-rate case and verify the loss changes only a little while remaining finite.","Small η",Preset.SmallRate)];
    private BackpropagationSnapshot DisplayedSnapshot=>_frameIndex>=0&&_frameIndex<_frames.Count?_frames[_frameIndex].Snapshot:BackpropLab.CreateSnapshot();private string DisplayedStepText=>_frameIndex>=0&&_frameIndex<_frames.Count?_frames[_frameIndex].StepText:SimulationState.CurrentStepText;private bool IsBusy=>SimulationState.IsRunning;private int TimelineCount=>_frames.Count;private int TimelinePosition=>_frameIndex<0?0:_frameIndex+1;private bool CanStepBack=>_frameIndex>0;private bool CanStepForward=>(_frameIndex>=0&&_frameIndex<_frames.Count-1)||SimulationState.IsRunning;private string ViewExplanation=>_view==StateView.Visual?"Compare the forward lane with the reverse gradient lane. The reverse arrows explain responsibility, not data flow.":"Inspect the forward cache, deltas, and per-parameter gradient buffers used by the update.";private string PredictionFeedback=>_predictionCorrect?"Correct — the loss moved in the direction you predicted.":$"Loss changed {F(_lastResult?.LossBefore??0)} → {F(_lastResult?.LossAfter??0)}.";
    protected override void OnInitialized(){SimulationState.Changed+=HandleSimulationChanged;try{_showRunPopups=!bool.TryParse(LearningStore.GetItem(PopupKey),out var saved)||saved;}catch{_showRunPopups=true;}_practiceProgress=PracticeProgress.Load(ModuleKey,null,PracticeTasks.Select(t=>t.Id));_completedTaskIds=_practiceProgress.CompletedTaskIds;ApplyInputs();}
    private void ToggleAdvanced()=>_showAdvanced=!_showAdvanced;private void InputsChanged(ChangeEventArgs e){_inputsText=e.Value?.ToString()??"";_preset=null;ApplyInputs();}private void TargetChanged(ChangeEventArgs e){_targetText=e.Value?.ToString()??"";_preset=null;ApplyInputs();}private void LearningRateChanged(ChangeEventArgs e){_learningRateText=e.Value?.ToString()??"";_preset=null;ApplyInputs();}private void HiddenWeightsChanged(ChangeEventArgs e){_hiddenWeightsText=e.Value?.ToString()??"";_preset=null;ApplyInputs();}private void HiddenBiasesChanged(ChangeEventArgs e){_hiddenBiasesText=e.Value?.ToString()??"";_preset=null;ApplyInputs();}private void OutputWeightsChanged(ChangeEventArgs e){_outputWeightsText=e.Value?.ToString()??"";_preset=null;ApplyInputs();}private void OutputBiasChanged(ChangeEventArgs e){_outputBiasText=e.Value?.ToString()??"";_preset=null;ApplyInputs();}private void SetHiddenActivation(ActivationKind a){_hiddenActivation=a;_preset=null;ApplyInputs();}private void SetPrediction(LossPrediction p){_prediction=p;_predictionAnswered=false;_predictionCorrect=false;}
    private void LoadPreset(Preset p){if(IsBusy)return;_preset=p;_inputsText="1, 0.5";_hiddenWeightsText="0.6, -0.2, -0.4, 0.7";_hiddenBiasesText="0.1, -0.1";_outputWeightsText="0.8, -0.6";_outputBiasText="0.05";_targetText="1";_learningRateText="0.2";_hiddenActivation=ActivationKind.Tanh;if(p==Preset.TargetZero)_targetText="0";if(p==Preset.SmallRate)_learningRateText="0.02";if(p==Preset.DeadRelu){_hiddenActivation=ActivationKind.ReLU;_hiddenWeightsText="-2, -1, 0.5, 0.3";_hiddenBiasesText="-1, 0";}ApplyInputs();}
    private void ApplyInputs(){if(!TryVector(_inputsText,out var x)||!TryVector(_hiddenWeightsText,out var hw)||!TryVector(_hiddenBiasesText,out var hb)||!TryVector(_outputWeightsText,out var ow)||!TryDouble(_outputBiasText,out var ob)||!TryDouble(_targetText,out var target)||!TryDouble(_learningRateText,out var lr)){_inputError="Use finite numeric inputs, parameters, target, and learning rate.";return;}try{BackpropLab.Configure(new BackpropagationConfiguration(x,hb.Length,hw,hb,ow,ob,_hiddenActivation,ActivationKind.Sigmoid,target,lr));_inputError=null;ClearReview();}catch(ArgumentException ex){_inputError=ex.Message;}StateHasChanged();}
    private async Task RunAsync(){ApplyInputs();if(_inputError is not null)return;_frames.Clear();_frameIndex=-1;_lastCapturedStep=null;var token=SimulationState.Start("Starting backpropagation.");Capture();try{var r=await BackpropLab.ExecuteAsync(token);if(!IsCurrent(token))return;_lastResult=r;SimulationState.Complete(r.Summary);Capture();EvaluatePrediction(r);RecordPractice(r);if(_showRunPopups)OpenLastRunPopup();}catch(OperationCanceledException)when(!IsCurrent(token)){} }
    private void Capture(){var step=SimulationState.CurrentStepText;if(step==_lastCapturedStep)return;var follow=_frameIndex<0||_frameIndex==_frames.Count-1;_frames.Add(new RunFrame(step,BackpropLab.CreateSnapshot()));_lastCapturedStep=step;if(follow)_frameIndex=_frames.Count-1;}private void HandleSimulationChanged(){if(SimulationState.IsRunning)Capture();_=InvokeAsync(StateHasChanged);}private bool IsCurrent(CancellationToken t)=>!t.IsCancellationRequested&&SimulationState.SimulationCancellationToken==t;private void ClearReview(){SimulationState.Reset();_frames.Clear();_frameIndex=-1;_lastCapturedStep=null;_lastResult=null;_lastRunPopupOpen=false;_predictionAnswered=false;}
    private Task PlayTimelineAsync(){if(_frames.Count>0)_frameIndex=_frames.Count-1;SimulationState.Resume();return InvokeAsync(StateHasChanged);}private Task PauseTimelineAsync(){SimulationState.Pause();return Task.CompletedTask;}private Task StepBackAsync(){if(SimulationState.IsRunning&&!SimulationState.IsPaused)SimulationState.Pause();if(_frameIndex>0)_frameIndex--;return InvokeAsync(StateHasChanged);}private Task StepForwardAsync(){if(_frameIndex>=0&&_frameIndex<_frames.Count-1){_frameIndex++;return InvokeAsync(StateHasChanged);}if(SimulationState.IsRunning)SimulationState.Step();return Task.CompletedTask;}private Task ResetPlaybackAsync(){SimulationState.Reset();_frames.Clear();_frameIndex=-1;_lastCapturedStep=null;return InvokeAsync(StateHasChanged);}
    private void EvaluatePrediction(BackpropagationRunResult r){if(_prediction is null)return;var delta=r.LossAfter-r.LossBefore;var actual=Math.Abs(delta)<1e-6?LossPrediction.Same:delta<0?LossPrediction.Lower:LossPrediction.Higher;_predictionAnswered=true;_predictionCorrect=_prediction==actual;}private string PredictionClass(LossPrediction p)=>_prediction==p?"active":string.Empty;
    private void ToggleRunPopups(ChangeEventArgs e){_showRunPopups=e.Value is bool b&&b;LearningStore.SetItem(PopupKey,_showRunPopups.ToString());}private void OpenLastRunPopup()=>_lastRunPopupOpen=_lastResult is not null;private void CloseLastRunPopup()=>_lastRunPopupOpen=false;
    private void StartTask(int id){var t=PracticeTasks.First(x=>x.Id==id);_activeTaskId=id;LoadPreset(t.Preset);}private void RecordPractice(BackpropagationRunResult r){if(_activeTaskId is null)return;var t=PracticeTasks.First(x=>x.Id==_activeTaskId);var ok=t.Preset switch{Preset.TargetOne=>r.Improved,Preset.TargetZero=>r.OutputDelta>0,Preset.DeadRelu=>r.HiddenDeltas.Any(x=>Math.Abs(x)<1e-10),Preset.SmallRate=>r.Improved&&Math.Abs(r.LossAfter-r.LossBefore)<.05,_=>false};if(!ok)return;var ev=new PracticeCompletionEvidence(t.Id,t.Title,r.Summary,$"Loss {F(r.LossBefore)} → {F(r.LossAfter)}; output delta {F(r.OutputDelta)}.","Forward z/a values are cached. Separate arrays/matrices hold hidden deltas and every parameter gradient before the update.","Backpropagation is a structured chain-rule reuse mechanism; optimizer choice happens after gradients exist.",[new("Loss before",F(r.LossBefore)),new("Loss after",F(r.LossAfter)),new("Output delta",F(r.OutputDelta)),new("Hidden deltas",Vector(r.HiddenDeltas))],$"loss={F(r.LossBefore)}->{F(r.LossAfter)} · δout={F(r.OutputDelta)}");_completedTaskIds.Add(t.Id);PracticeProgress.Complete(ModuleKey,_practiceProgress,t.Id,ev);_activeTaskId=null;}
    private PracticeCompletionEvidence? GetTaskEvidence(int id)=>PracticeProgress.GetEvidence(_practiceProgress,id);private void OpenTaskEvidence(int id)=>_practiceEvidencePopup=GetTaskEvidence(id);private void CloseTaskEvidence()=>_practiceEvidencePopup=null;
    private static bool TryVector(string s,out double[] v){var p=s.Split(',',StringSplitOptions.RemoveEmptyEntries|StringSplitOptions.TrimEntries);v=new double[p.Length];if(p.Length<1||p.Length>40)return false;for(var i=0;i<p.Length;i++)if(!double.TryParse(p[i],NumberStyles.Float,CultureInfo.InvariantCulture,out v[i])||!double.IsFinite(v[i]))return false;return true;}private static bool TryDouble(string s,out double v)=>double.TryParse(s,NumberStyles.Float,CultureInfo.InvariantCulture,out v)&&double.IsFinite(v);private static string Vector(IReadOnlyList<double> v)=>"["+string.Join(", ",v.Select(value => F(value)))+"]";private static string F(double v)=>Math.Abs(v)<1e-10?"0":v.ToString("0.#####",CultureInfo.InvariantCulture);private static string PresetName(Preset p)=>p switch{Preset.TargetOne=>"Target 1",Preset.TargetZero=>"Target 0",Preset.DeadRelu=>"Dead ReLU",Preset.SmallRate=>"Small η",_=>p.ToString()};public void Dispose()=>SimulationState.Changed-=HandleSimulationChanged;
    private sealed record RunFrame(string StepText,BackpropagationSnapshot Snapshot);private sealed record PracticeTaskDefinition(int Id,string Title,string Goal,string Suggested,Preset Preset);private enum Preset{TargetOne,TargetZero,DeadRelu,SmallRate}private enum LossPrediction{Lower,Same,Higher}private enum StateView{Visual,Memory}
}
