<a href="@ResolvedHref" class="lesson-link-button @Class" @attributes="AdditionalAttributes">
    @ChildContent
</a>

@code {
    [Parameter, EditorRequired] public string Href { get; set; } = string.Empty;
    [Parameter] public RenderFragment? ChildContent { get; set; }
    [Parameter] public string? Class { get; set; }
    [Parameter(CaptureUnmatchedValues = true)] public IReadOnlyDictionary<string, object>? AdditionalAttributes { get; set; }

    private string ResolvedHref
    {
        get
        {
            const string fragmentPrefix = "/learn/concepts#";
            const string routePrefix = "/learn/concepts/";

            if (Href.StartsWith(fragmentPrefix, StringComparison.OrdinalIgnoreCase))
                return $"{routePrefix}{NormalizeTopic(Href[fragmentPrefix.Length..])}";
            if (Href.StartsWith(routePrefix, StringComparison.OrdinalIgnoreCase))
                return $"{routePrefix}{NormalizeTopic(Href[routePrefix.Length..])}";
            return Href;
        }
    }

    private static string NormalizeTopic(string topic) => topic.Trim().ToLowerInvariant() switch
    {
        "lifo-fifo" => "queue-stack",
        "tree-height" => "bst",
        "matrices" => "matrix",
        "heap" => "general-heap",
        "binary-heap" => "general-heap",
        var value => value
    };
}
