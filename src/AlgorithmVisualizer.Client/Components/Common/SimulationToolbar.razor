@implements IDisposable
@inject SimulationState State

<section class="simulation-toolbar" aria-label="Simulation playback controls">
    <div class="toolbar-section playback-section">
        <div class="toolbar-label">
            <span>PLAYBACK</span>
            <small>Move one learning step at a time</small>
        </div>
        <div class="playback-actions">
            <button class="play-button" type="button"
                    @onclick="PlayAsync"
                    disabled="@(!CanPlay)"
                    aria-label="Play simulation">
                <span class="button-icon" aria-hidden="true">▶</span> Play
            </button>

            <button type="button"
                    @onclick="PauseAsync"
                    disabled="@(!CanPause)"
                    aria-label="Pause simulation">
                <span class="button-icon" aria-hidden="true">Ⅱ</span> Pause
            </button>

            <button type="button"
                    @onclick="StepBackAsync"
                    disabled="@(!CanStepBack)"
                    aria-label="Go back one displayed simulation step">
                <span class="button-icon" aria-hidden="true">|←</span> Step back
            </button>

            <button type="button"
                    @onclick="StepForwardAsync"
                    disabled="@(!CanStepForward)"
                    aria-label="Advance one simulation step">
                <span class="button-icon" aria-hidden="true">→|</span> Step forward
            </button>

            <button class="reset-button" type="button"
                    @onclick="ResetAsync"
                    aria-label="Reset simulation playback">
                <span class="button-icon" aria-hidden="true">↺</span> Reset
            </button>
        </div>
    </div>

    <div class="current-step" aria-live="polite" aria-atomic="true">
        <div class="step-status @GetStatusClass()">
            <span></span>
            @GetStatusText()
        </div>
        <div class="step-copy">
            <span class="current-step-label">CURRENT STEP</span>
            <output>@DisplayedStepText</output>
            @if (TimelineCount > 0)
            {
                <small class="timeline-position">Step @TimelinePosition of @TimelineCount</small>
            }
        </div>
    </div>

    <label class="speed-control">
        <span class="speed-heading">
            <span>
                <span class="toolbar-label-text">STEP DELAY</span>
                <small>Slow down when a step is new.</small>
            </span>
            <strong>@State.StepDelayMs ms</strong>
        </span>
        <input type="range"
               min="@SimulationState.MinDelayMs"
               max="@SimulationState.MaxDelayMs"
               step="50"
               value="@State.StepDelayMs"
               @oninput="ChangeDelay"
               aria-label="Animation step delay in milliseconds" />
        <span class="speed-scale" aria-hidden="true"><span>Faster</span><span>Slower</span></span>
    </label>
</section>

@code {
    [Parameter] public EventCallback OnPlay { get; set; }
    [Parameter] public EventCallback OnPause { get; set; }
    [Parameter] public EventCallback OnStepBack { get; set; }
    [Parameter] public EventCallback OnStepForward { get; set; }
    [Parameter] public EventCallback OnReset { get; set; }
    [Parameter] public bool CanStepBack { get; set; }
    [Parameter] public bool? CanStepForwardOverride { get; set; }
    [Parameter] public string? StepTextOverride { get; set; }
    [Parameter] public int TimelinePosition { get; set; }
    [Parameter] public int TimelineCount { get; set; }

    private bool CanPlay => State.IsRunning && State.IsPaused;
    private bool CanPause => State.IsRunning && !State.IsPaused;
    private bool CanStepForward => CanStepForwardOverride ?? State.IsRunning;
    private string DisplayedStepText => string.IsNullOrWhiteSpace(StepTextOverride)
        ? State.CurrentStepText
        : StepTextOverride;

    protected override void OnInitialized()
    {
        State.Changed += HandleStateChanged;
    }

    private string GetStatusText() => State.IsRunning
        ? State.IsPaused ? "Paused" : "Running"
        : TimelineCount > 0 ? "Review" : "Ready";

    private string GetStatusClass() => State.IsRunning
        ? State.IsPaused ? "is-paused" : "is-running"
        : "is-ready";

    private async Task PlayAsync()
    {
        if (OnPlay.HasDelegate)
        {
            await OnPlay.InvokeAsync();
            return;
        }

        State.Resume();
    }

    private async Task PauseAsync()
    {
        if (OnPause.HasDelegate)
        {
            await OnPause.InvokeAsync();
            return;
        }

        State.Pause();
    }

    private async Task StepBackAsync()
    {
        if (OnStepBack.HasDelegate)
        {
            await OnStepBack.InvokeAsync();
        }
    }

    private async Task StepForwardAsync()
    {
        if (OnStepForward.HasDelegate)
        {
            await OnStepForward.InvokeAsync();
            return;
        }

        State.Step();
    }

    private async Task ResetAsync()
    {
        if (OnReset.HasDelegate)
        {
            await OnReset.InvokeAsync();
            return;
        }

        State.Reset();
    }

    private void ChangeDelay(ChangeEventArgs args)
    {
        if (int.TryParse(args.Value?.ToString(), out var delay))
        {
            State.SetDelay(delay);
        }
    }

    private void HandleStateChanged()
    {
        _ = InvokeAsync(StateHasChanged);
    }

    public void Dispose()
    {
        State.Changed -= HandleStateChanged;
    }
}
