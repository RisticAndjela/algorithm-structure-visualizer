<section class="learning-module-page learning-module-shell">
    <section class="learn-launchpad" aria-label="Learn first">
        <div class="learn-copy">
            <span class="section-kicker">LEARN FIRST</span>
            <h2>@LearnTitle</h2>
            <p>@LearnSummary</p>
            <ConceptLink class="learn-launchpad-link" Href="@ConceptHref">Open concepts &amp; memory →</ConceptLink>
        </div>
        <div class="learn-grid">
            @foreach (var card in ParsedLearnCards)
            {
                <article class="learn-card @card.Tone">
                    <span>@card.Badge</span>
                    <strong>@card.Title</strong>
                    <small>@card.Body</small>
                </article>
            }
        </div>
    </section>

    <header class="module-header">
        <div class="module-header-copy">
            <div class="module-eyebrow">
                <span>@Eyebrow</span>
                <span class="separator">/</span>
                <span class="planned-status"><i></i> Simulation planned</span>
            </div>
            <h1>@Title</h1>
            <p>@Description</p>
        </div>

        <div class="complexity-summary" aria-label="Lesson summary">
            <div><span>COMPLEXITY</span><strong>@Complexity</strong><small>@ComplexityNote</small></div>
            <div><span>LAB STATUS</span><strong>PLANNED</strong><small>The simulation is intentionally still marked TODO.</small></div>
            <div><span>LEARN FIRST</span><strong>READY</strong><small>Concepts and curriculum navigation are available now.</small></div>
        </div>
    </header>

    <section class="smart-tip" aria-label="Learning tip">
        <span class="tip-icon">✦</span>
        <div><strong>@TipTitle</strong><p>@TipText</p></div>
        <ConceptLink Href="@ConceptHref">Open the exact concept →</ConceptLink>
    </section>

    <div class="concept-strip" aria-label="Key concepts">
        @foreach (var concept in ParsedConcepts)
        {
            <span>@concept</span>
        }
    </div>

    <div class="lesson-reference-links" aria-label="Concepts and memory links">
        <ConceptLink Href="@ConceptHref">Concepts &amp; memory for @Title →</ConceptLink>
    </div>

    <div class="module-grid">
        <section class="simulation-shell" aria-label="Planned interactive simulation">
            <div class="simulation-shell-heading">
                <div>
                    <span class="shell-label">INTERACTIVE LAB</span>
                    <h2>See the algorithm change state, step by step.</h2>
                </div>
                <span class="todo-badge">TODO</span>
            </div>

            <div class="todo-stage">
                <div class="todo-orbit orbit-one"></div>
                <div class="todo-orbit orbit-two"></div>
                <div class="todo-center">
                    <span class="todo-mark">+</span>
                    <strong>Interactive simulation</strong>
                    <p>TODO — implementation will plug into this learning workspace.</p>
                </div>
            </div>

            <div class="future-controls" aria-hidden="true">
                <span></span><span></span><span></span><span class="wide"></span>
            </div>
        </section>

        <aside class="learning-sidebar">
            <section class="focus-card">
                <span class="card-kicker">WHEN THE LAB IS BUILT</span>
                <h2>Focus on the invariant.</h2>
                <p>@FocusText</p>
                <div class="focus-prompt">
                    <span>Ask yourself</span>
                    <strong>@PromptText</strong>
                </div>
            </section>
        </aside>
    </div>

    <section class="learning-loop">
        <div class="loop-heading">
            <span class="card-kicker">LEARNING LOOP</span>
            <h2>The simulation should teach, not just animate.</h2>
        </div>
        <div class="loop-steps">
            <article><span>01</span><strong>Predict</strong><p>Decide what should happen before running the next step.</p></article>
            <article><span>02</span><strong>Observe</strong><p>Watch only the state that changed and the elements involved.</p></article>
            <article><span>03</span><strong>Explain</strong><p>Connect the visual mutation to the algorithm rule or invariant.</p></article>
            <article><span>04</span><strong>Challenge</strong><p>Try an edge case and test whether your mental model still holds.</p></article>
        </div>
    </section>


    @if (!string.IsNullOrWhiteSpace(NextLessonHref))
    {
        <NextLessonCard Eyebrow="@NextLessonEyebrow"
                        Title="@NextLessonTitle"
                        Description="@NextLessonDescription"
                        Href="@NextLessonHref"
                        Level="@NextLessonLevel"
                        LinkLabel="@NextLessonLinkLabel" />
    }
</section>

@code {
    [Parameter, EditorRequired]
    public string Title { get; set; } = string.Empty;

    [Parameter]
    public string Eyebrow { get; set; } = "Learning module";

    [Parameter, EditorRequired]
    public string Description { get; set; } = string.Empty;

    [Parameter]
    public string Complexity { get; set; } = "—";

    [Parameter]
    public string ComplexityNote { get; set; } = "Depends on the operation and data shape.";

    [Parameter]
    public string Concepts { get; set; } = string.Empty;

    [Parameter]
    public string TipTitle { get; set; } = "Predict before you play.";

    [Parameter]
    public string TipText { get; set; } = "The visualization becomes much more useful when you commit to an expected next state first.";

    [Parameter]
    public string FocusText { get; set; } = "The future visualization should make the rule that must remain true easy to see after every mutation.";

    [Parameter]
    public string PromptText { get; set; } = "What must still be true after this step?";

    [Parameter]
    public string LearnTitle { get; set; } = "Learn the mental model before the controls.";

    [Parameter]
    public string LearnSummary { get; set; } = "Read the invariant first, then use the future simulator to test it step by step.";

    [Parameter]
    public string ConceptHref { get; set; } = "/learn/concepts";

    [Parameter]
    public string LearnCards { get; set; } = string.Empty;


    [Parameter]
    public string NextLessonEyebrow { get; set; } = "NEXT LESSON";

    [Parameter]
    public string NextLessonTitle { get; set; } = string.Empty;

    [Parameter]
    public string NextLessonDescription { get; set; } = string.Empty;

    [Parameter]
    public string NextLessonHref { get; set; } = string.Empty;

    [Parameter]
    public string NextLessonLevel { get; set; } = string.Empty;

    [Parameter]
    public string NextLessonLinkLabel { get; set; } = "Open next lesson";

    private IReadOnlyList<LearnCard> ParsedLearnCards
    {
        get
        {
            var tones = new[] { "purple", "mint", "blue", "gold" };
            var raw = LearnCards.Split(";;", StringSplitOptions.RemoveEmptyEntries | StringSplitOptions.TrimEntries);
            var cards = new List<LearnCard>();
            for (var index = 0; index < raw.Length && index < 4; index++)
            {
                var parts = raw[index].Split('|', 3, StringSplitOptions.TrimEntries);
                if (parts.Length == 3)
                {
                    cards.Add(new LearnCard(parts[0], parts[1], parts[2], tones[index]));
                }
            }

            if (cards.Count > 0)
            {
                return cards;
            }

            return ParsedConcepts.Take(4)
                .Select((concept, index) => new LearnCard("KEY IDEA", concept, "This idea will stay visible in the interactive lab.", tones[index]))
                .ToArray();
        }
    }

    private sealed record LearnCard(string Badge, string Title, string Body, string Tone);

    private IEnumerable<string> ParsedConcepts =>
        Concepts.Split('·', StringSplitOptions.RemoveEmptyEntries | StringSplitOptions.TrimEntries);
}
