@using System.Globalization
@using AlgorithmVisualizer.Core.DataStructures.Matrix

<section class="matrix-memory" aria-label="@($"{Title} matrix memory state")">
    <header class="memory-header">
        <div class="memory-title">
            <span class="memory-kicker">MEMORY STATE</span>
            <h3>@Title</h3>
        </div>
        <span class="memory-shape">@Snapshot.Rows × @Snapshot.Columns</span>
    </header>

    <div class="nested-list-shell" aria-label="@($"{Title} as an outer list containing one inner list per row")">
        <div class="outer-list-prefix" aria-hidden="true">
            <strong>@Title</strong>
            <span>=</span>
            <span class="outer-bracket">[</span>
        </div>

        <div class="inner-lists">
            @for (var row = 0; row < Snapshot.Rows; row++)
            {
                var currentRow = row;
                <article class="inner-list" aria-label="@($"{Title} row {currentRow}: {FormatRow(currentRow)}")">
                    <span class="inner-list-label">@($"{Title}[{currentRow}]")</span>
                    <code class="inner-list-values">@FormatRow(currentRow)</code>
                </article>
            }
        </div>

        <span class="outer-bracket outer-list-end" aria-hidden="true">]</span>
    </div>

    <p class="memory-note">
        <strong>Outer list → rows.</strong>
        Each card is one inner list; cards run left → right in row order.
    </p>

    <details class="raw-backing-memory">
        <summary>
            <span>Actual implementation storage</span>
            <small>row-major <code>double[]</code></small>
        </summary>

        <div class="raw-memory-body">
            <p>
                The list-of-lists view explains the shape. <code>ManualMatrix</code> stores the same values contiguously:
                <code>index = row × @Snapshot.Columns + column</code>.
            </p>

            <div class="flat-array" aria-label="@($"{Title} flat row-major backing array")">
                <span class="array-bracket" aria-hidden="true">[</span>
                <div class="flat-values">
                    @for (var row = 0; row < Snapshot.Rows; row++)
                    {
                        @for (var column = 0; column < Snapshot.Columns; column++)
                        {
                            var index = (row * Snapshot.Columns) + column;
                            <div class="flat-value">
                                <strong>@Format(Snapshot.GetValue(row, column))</strong>
                                <small>[@index]</small>
                            </div>
                        }
                    }
                </div>
                <span class="array-bracket" aria-hidden="true">]</span>
            </div>
        </div>
    </details>
</section>

@code {
    [Parameter, EditorRequired] public MatrixGridSnapshot Snapshot { get; set; } = default!;
    [Parameter, EditorRequired] public string Title { get; set; } = string.Empty;

    private string FormatRow(int row)
    {
        var values = new string[Snapshot.Columns];
        for (var column = 0; column < Snapshot.Columns; column++)
        {
            values[column] = Format(Snapshot.GetValue(row, column));
        }

        return $"[{string.Join(", ", values)}]";
    }

    private static string Format(double value) =>
        Math.Abs(value) < 1e-9
            ? "0"
            : Math.Round(value, 5).ToString("0.#####", CultureInfo.InvariantCulture);
}
