@using System.Globalization
@using AlgorithmVisualizer.Core.DataStructures.Matrix

<section class="matrix-memory" aria-label="Matrix memory state">
    <header class="memory-header">
        <div>
            <span class="memory-kicker">MEMORY STATE</span>
            <h3>@Title · @Snapshot.Rows × @Snapshot.Columns</h3>
        </div>
        <span class="memory-badge">@Snapshot.Rows rows · @Snapshot.Columns columns</span>
    </header>

    <p class="memory-lead">
        Think of the matrix as an <strong>outer list of rows</strong>. Each row is one inner list, and every value keeps the same row/column position you see in the editor.
    </p>

    <section class="conceptual-memory" aria-label="Matrix as a list of lists">
        <div class="conceptual-heading">
            <div>
                <span>CONCEPTUAL VIEW</span>
                <strong>List of lists</strong>
            </div>
            <code>@($"{Title}[row][column]")</code>
        </div>

        <div class="nested-array">
            <div class="array-open">
                <strong>@Title</strong>
                <span>→ [</span>
            </div>

            <div class="matrix-rows">
                @for (var row = 0; row < Snapshot.Rows; row++)
                {
                    var currentRow = row;
                    <div class="matrix-row">
                        <span class="row-label">@($"{Title}[{currentRow}]")</span>
                        <span class="inner-bracket" aria-hidden="true">[</span>

                        <div class="row-values" style="--matrix-columns: @Snapshot.Columns;" aria-label="Row @currentRow values">
                            @for (var column = 0; column < Snapshot.Columns; column++)
                            {
                                var currentColumn = column;
                                <span class="row-value" title="@($"{Title}[{currentRow}][{currentColumn}]")">
                                    @Format(Snapshot.GetValue(currentRow, currentColumn))
                                </span>
                            }
                        </div>

                        <span class="inner-bracket" aria-hidden="true">]</span>
                    </div>
                }
            </div>

            <div class="array-close" aria-hidden="true">]</div>
        </div>
    </section>

    <div class="memory-explainer">
        <div>
            <strong>Example</strong>
            <span><code>@($"{Title}[1][2]")</code> means row 1, column 2.</span>
        </div>
        <div>
            <strong>Important</strong>
            <span>This is the learner-friendly shape. Our implementation stores the same values contiguously.</span>
        </div>
    </div>

    <details class="raw-backing-memory">
        <summary>
            <span>See the actual row-major <code>double[]</code></span>
            <small>implementation detail</small>
        </summary>

        <div class="raw-memory-body">
            <p>
                <code>ManualMatrix</code> uses one contiguous array, not one C# list object per row. A matrix coordinate is converted to an array slot with
                <code>index = row × @Snapshot.Columns + column</code>.
            </p>

            <div class="flat-array" aria-label="Flat row-major backing array">
                <span class="array-bracket" aria-hidden="true">[</span>
                <div class="flat-values">
                    @for (var row = 0; row < Snapshot.Rows; row++)
                    {
                        @for (var column = 0; column < Snapshot.Columns; column++)
                        {
                            var index = (row * Snapshot.Columns) + column;
                            <div class="flat-value">
                                <strong>@Format(Snapshot.GetValue(row, column))</strong>
                                <small>[@index]</small>
                            </div>
                        }
                    }
                </div>
                <span class="array-bracket" aria-hidden="true">]</span>
            </div>
        </div>
    </details>
</section>

@code {
    [Parameter, EditorRequired] public MatrixGridSnapshot Snapshot { get; set; } = default!;
    [Parameter, EditorRequired] public string Title { get; set; } = string.Empty;

    private static string Format(double value) =>
        Math.Abs(value) < 1e-9
            ? "0"
            : Math.Round(value, 5).ToString("0.#####", CultureInfo.InvariantCulture);
}
