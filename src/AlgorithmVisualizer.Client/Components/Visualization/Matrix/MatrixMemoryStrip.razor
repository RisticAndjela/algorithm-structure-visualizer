@using System.Globalization
@using AlgorithmVisualizer.Core.DataStructures.Matrix

<section class="matrix-memory-strip @(IsResult ? "result" : string.Empty)" aria-label="@($"{Title} as a list of row lists")">
    <header class="strip-identity">
        <span>@Role</span>
        <strong>@Title</strong>
        <small>@Snapshot.Rows × @Snapshot.Columns</small>
    </header>

    <div class="outer-list" aria-label="@($"{Title}: outer list with {Snapshot.Rows} row lists")">
        <span class="outer-bracket" aria-hidden="true">[</span>
        <div class="row-lists">
            @for (var row = 0; row < Snapshot.Rows; row++)
            {
                var currentRow = row;
                <div class="row-list" aria-label="@($"{RowPrefix} row {currentRow}: {FormatRow(currentRow)}")">
                    <span class="row-index">@($"{RowPrefix}[{currentRow}]")</span>
                    <code>@FormatRow(currentRow)</code>
                </div>
            }
        </div>
        <span class="outer-bracket" aria-hidden="true">]</span>
    </div>
</section>

@code {
    [Parameter, EditorRequired] public MatrixGridSnapshot Snapshot { get; set; } = default!;
    [Parameter, EditorRequired] public string Title { get; set; } = string.Empty;
    [Parameter, EditorRequired] public string RowPrefix { get; set; } = string.Empty;
    [Parameter] public string Role { get; set; } = "INPUT";
    [Parameter] public bool IsResult { get; set; }

    private string FormatRow(int row)
    {
        var values = new string[Snapshot.Columns];
        for (var column = 0; column < Snapshot.Columns; column++)
        {
            values[column] = Format(Snapshot.GetValue(row, column));
        }

        return $"[{string.Join(", ", values)}]";
    }

    private static string Format(double value) =>
        Math.Abs(value) < 1e-9
            ? "0"
            : Math.Round(value, 5).ToString("0.#####", CultureInfo.InvariantCulture);
}
