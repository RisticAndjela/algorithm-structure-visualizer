@using AlgorithmVisualizer.Core.Algorithms.Sorting.Merge

<section class="merge-visualization" aria-label="Merge Sort visual state">
    @if (Snapshot.Count == 0)
    {
        <div class="empty-state"><strong>No values yet.</strong><span>Load an array to see one divide-or-merge idea at a time.</span></div>
    }
    else
    {
        <section class="focus-strip @PhaseClass" aria-label="Current Merge Sort focus">
            <div class="focus-step">@FocusStep</div>
            <div><span>NOW</span><strong>@FocusTitle</strong><p>@FocusHelp</p></div>
            <div class="focus-range"><span>ACTIVE RANGE</span><strong>@ActiveRangeLabel</strong><small>depth @Snapshot.CurrentDepth</small></div>
        </section>

        @if (ShowDivideWorkspace)
        {
            <section class="single-workspace divide-workspace" aria-label="Current recursive split">
                <header><div><span>DIVIDE</span><strong>@DivideTitle</strong></div><small>No values move here. We are only defining smaller problems.</small></header>

                @if (Snapshot.Phase == MergeSortPhase.BaseCase)
                {
                    <div class="base-case-card">
                        <span>BASE CASE</span>
                        <strong>@ValueAt(Snapshot.ActiveStart)</strong>
                        <small>One item is already sorted → return this run to its parent.</small>
                    </div>
                }
                else if (Snapshot.ActiveStart >= 0 && Snapshot.ActiveEnd >= Snapshot.ActiveStart)
                {
                    var middle = Snapshot.ActiveStart + ((Snapshot.ActiveEnd - Snapshot.ActiveStart) / 2);
                    <div class="split-story">
                        <RangeCard Label="PARENT RANGE" Start="@Snapshot.ActiveStart" End="@Snapshot.ActiveEnd" Values="@Snapshot.InitialValues" Emphasis="parent" />
                        @if (Snapshot.ActiveStart < Snapshot.ActiveEnd)
                        {
                            <div class="split-arrow" aria-hidden="true">↓ split in half ↓</div>
                            <div class="child-row">
                                <RangeCard Label="LEFT CHILD" Start="@Snapshot.ActiveStart" End="@middle" Values="@Snapshot.InitialValues" Emphasis="left" />
                                <RangeCard Label="RIGHT CHILD" Start="@(middle + 1)" End="@Snapshot.ActiveEnd" Values="@Snapshot.InitialValues" Emphasis="right" />
                            </div>
                        }
                    </div>
                }
                else
                {
                    <div class="waiting"><strong>Ready to divide.</strong><span>Start the run and the first active range will appear here.</span></div>
                }
            </section>
        }
        else if (ShowNaturalRuns)
        {
            <section class="single-workspace natural-workspace" aria-label="Natural Merge Sort run detection">
                <header><div><span>DETECT RUNS</span><strong>Reuse sorted order that already exists.</strong></div><small>Natural mode scans left to right instead of recursively splitting.</small></header>
                <div class="natural-runs">
                    @foreach (var run in NaturalRuns)
                    {
                        <RangeCard Label="SORTED RUN" Start="@run.Start" End="@run.End" Values="@CurrentValues" Emphasis="natural" />
                    }
                </div>
            </section>
        }
        else if (ShowMergeWorkspace)
        {
            <section class="single-workspace merge-workspace" aria-label="Current merge">
                <header><div><span>MERGE BACK</span><strong>@MergeTitle</strong></div><small>@MergeWorkspaceHelp</small></header>

                @if (Snapshot.Phase is MergeSortPhase.Comparing or MergeSortPhase.FillingBuffer)
                {
                    <div class="merge-flow">
                        <article class="run-card left-run">
                            <header><span>LEFT SORTED RUN</span><strong>@RangeText(Snapshot.ActiveStart, Snapshot.LeftEnd)</strong></header>
                            <div class="mini-array">
                                @for (var index = Snapshot.ActiveStart; index <= Snapshot.LeftEnd; index++)
                                {
                                    <div class="mini-cell @(index == Snapshot.LeftReadIndex ? "front" : string.Empty)"><small>@index</small><strong>@Snapshot.Elements[index].Value</strong><span>@(index == Snapshot.LeftReadIndex ? "READ" : "")</span></div>
                                }
                            </div>
                        </article>
                        <div class="flow-arrow">→</div>
                        <article class="run-card right-run">
                            <header><span>RIGHT SORTED RUN</span><strong>@RangeText(Snapshot.RightStart, Snapshot.ActiveEnd)</strong></header>
                            <div class="mini-array">
                                @for (var index = Snapshot.RightStart; index <= Snapshot.ActiveEnd; index++)
                                {
                                    <div class="mini-cell @(index == Snapshot.RightReadIndex ? "front" : string.Empty)"><small>@index</small><strong>@Snapshot.Elements[index].Value</strong><span>@(index == Snapshot.RightReadIndex ? "READ" : "")</span></div>
                                }
                            </div>
                        </article>
                        <div class="flow-arrow">→</div>
                        <article class="run-card buffer-run">
                            <header><span>TEMP BUFFER</span><strong>build one sorted range</strong></header>
                            <div class="mini-array">
                                @for (var index = Snapshot.ActiveStart; index <= Snapshot.ActiveEnd; index++)
                                {
                                    var slot = Snapshot.Buffer[index];
                                    <div class="mini-cell buffer @(slot.Occupied ? "occupied" : string.Empty) @(slot.IsWriteTarget ? "write" : string.Empty)"><small>@index</small><strong>@(slot.Occupied ? slot.Value.ToString() : "·")</strong><span>@(slot.IsWriteTarget ? "WRITE" : "")</span></div>
                                }
                            </div>
                        </article>
                    </div>
                }
                else if (Snapshot.Phase == MergeSortPhase.CopyingBack)
                {
                    <div class="copy-flow">
                        <article class="run-card buffer-run copy-source">
                            <header><span>FINISHED TEMP BUFFER</span><strong>@RangeText(Snapshot.ActiveStart, Snapshot.ActiveEnd)</strong></header>
                            <div class="mini-array">
                                @for (var index = Snapshot.ActiveStart; index <= Snapshot.ActiveEnd; index++)
                                {
                                    var slot = Snapshot.Buffer[index];
                                    <div class="mini-cell buffer occupied @(index == Snapshot.WriteIndex ? "write" : string.Empty)"><small>@index</small><strong>@(slot.Occupied ? slot.Value.ToString() : "·")</strong><span>@(index == Snapshot.WriteIndex ? "COPY" : "")</span></div>
                                }
                            </div>
                        </article>
                        <div class="copy-arrow" aria-hidden="true">↓ copy one slot ↓</div>
                        <article class="run-card copy-target">
                            <header><span>ACTIVE MAIN-ARRAY RANGE</span><strong>@RangeText(Snapshot.ActiveStart, Snapshot.ActiveEnd)</strong></header>
                            <div class="mini-array">
                                @for (var index = Snapshot.ActiveStart; index <= Snapshot.ActiveEnd; index++)
                                {
                                    <div class="mini-cell @(index == Snapshot.WriteIndex ? "write-back" : string.Empty)"><small>@index</small><strong>@Snapshot.Elements[index].Value</strong><span>@(index == Snapshot.WriteIndex ? "WRITE" : "")</span></div>
                                }
                            </div>
                        </article>
                    </div>
                }
                else if (Snapshot.Phase == MergeSortPhase.MergeComplete)
                {
                    <div class="merged-range-card">
                        <span>MERGED RANGE</span>
                        <strong>@RangeText(Snapshot.ActiveStart, Snapshot.ActiveEnd) is sorted</strong>
                        <div class="mini-array">
                            @for (var index = Snapshot.ActiveStart; index <= Snapshot.ActiveEnd; index++)
                            {
                                <div class="mini-cell merged"><small>@index</small><strong>@Snapshot.Elements[index].Value</strong><span>DONE</span></div>
                            }
                        </div>
                        <small>This one sorted run now returns to its parent. The next frame will focus on the next recursive job.</small>
                    </div>
                }
            </section>
        }
        else if (Snapshot.Phase == MergeSortPhase.Complete)
        {
            <section class="complete-workspace"><span>DONE</span><strong>The full array is now one sorted run.</strong><small>Every smaller merge has been copied back into the main array.</small></section>
        }

        <section class="main-array-stage" aria-label="Current main array">
            <header><div><span>MAIN ARRAY · ALWAYS YOUR REFERENCE</span><strong>@MainArrayCaption</strong></div><small>The buffer is temporary; this is the array that survives after each copy-back.</small></header>
            <div class="array-track" role="list">
                @for (var index = 0; index < Snapshot.Elements.Length; index++)
                {
                    var element = Snapshot.Elements[index];
                    <article class="sort-item @StateClass(index, element)" role="listitem">
                        <span class="index-label">index @index</span>
                        <strong>@element.Value</strong>
                        <span class="identity-label">item #@(element.OriginalIndex + 1)</span>
                        <span class="state-label">@StateLabel(index, element)</span>
                    </article>
                }
            </div>
        </section>

    }
</section>

@code {
    [Parameter, EditorRequired] public MergeSortSnapshot Snapshot { get; set; } = default!;

    private sealed record RangeNode(int Start, int End);

    private bool ShowDivideWorkspace => Snapshot.Variant == MergeSortVariant.TopDownRecursive && (Snapshot.Phase is MergeSortPhase.Ready or MergeSortPhase.Splitting or MergeSortPhase.BaseCase);
    private bool ShowNaturalRuns => Snapshot.Variant == MergeSortVariant.NaturalRuns && (Snapshot.Phase is MergeSortPhase.Ready or MergeSortPhase.DetectingRuns);
    private bool ShowMergeWorkspace => Snapshot.ActiveStart >= 0 && Snapshot.RightStart >= 0 && (Snapshot.Phase is MergeSortPhase.Comparing or MergeSortPhase.FillingBuffer or MergeSortPhase.CopyingBack or MergeSortPhase.MergeComplete);

    private int[] CurrentValues
    {
        get
        {
            var values = new int[Snapshot.Elements.Length];
            for (var index = 0; index < values.Length; index++) values[index] = Snapshot.Elements[index].Value;
            return values;
        }
    }
    private IReadOnlyList<RangeNode> NaturalRuns => BuildNaturalRuns();

    private string FocusStep => Snapshot.Phase switch
    {
        MergeSortPhase.Splitting => "1",
        MergeSortPhase.BaseCase => "2",
        MergeSortPhase.DetectingRuns => "1",
        MergeSortPhase.Comparing or MergeSortPhase.FillingBuffer or MergeSortPhase.CopyingBack or MergeSortPhase.MergeComplete => "3",
        MergeSortPhase.Complete => "✓",
        _ => "→"
    };

    private string FocusTitle => Snapshot.Phase switch
    {
        MergeSortPhase.Splitting => "Split only this active range.",
        MergeSortPhase.BaseCase => "Stop: one item is already sorted.",
        MergeSortPhase.DetectingRuns => "Detect existing sorted runs.",
        MergeSortPhase.Comparing => "Compare the two unread front values.",
        MergeSortPhase.FillingBuffer => "Write the smaller front into the buffer.",
        MergeSortPhase.CopyingBack => "Copy the finished buffer back into the same range.",
        MergeSortPhase.MergeComplete => "Two child runs are now one larger sorted run.",
        MergeSortPhase.Complete => "The whole array is sorted.",
        _ => "Divide first; merge only after child ranges are sorted."
    };

    private string FocusHelp => Snapshot.Phase switch
    {
        MergeSortPhase.Splitting => "Ignore every other recursion branch for this frame. This parent becomes exactly two smaller subproblems.",
        MergeSortPhase.BaseCase => "This is where recursion turns around. The one-item run is returned upward without changing its value.",
        MergeSortPhase.DetectingRuns => "Advanced Natural Merge finds maximal nondecreasing runs instead of manufacturing single-item runs recursively.",
        MergeSortPhase.Comparing => "Do not scan the whole runs. Because both are sorted, only their two front unread values need comparison.",
        MergeSortPhase.FillingBuffer => "The chosen value leaves its run front conceptually and occupies the next temporary slot.",
        MergeSortPhase.CopyingBack => "Only now does the main array change for this merge.",
        MergeSortPhase.MergeComplete => "That merged range can now participate as a sorted child in a larger merge.",
        MergeSortPhase.Complete => "The root range has been merged back, so recursion is finished.",
        _ => "Start the simulation to reveal one operation at a time."
    };

    private string PhaseClass => Snapshot.Phase.ToString().ToLowerInvariant();
    private string ActiveRangeLabel => Snapshot.ActiveStart >= 0 ? RangeText(Snapshot.ActiveStart, Snapshot.ActiveEnd) : "—";
    private string DivideTitle => Snapshot.Phase == MergeSortPhase.BaseCase ? "The active range cannot be divided further." : "One parent becomes two child ranges.";
    private string MergeTitle => Snapshot.Phase switch
    {
        MergeSortPhase.Comparing => "Read two fronts; choose the smaller value.",
        MergeSortPhase.FillingBuffer => "Fill the temporary result left to right.",
        MergeSortPhase.CopyingBack => "Commit the sorted buffer to the main array.",
        MergeSortPhase.MergeComplete => "This range is ready to return upward.",
        _ => "Merge two sorted child runs."
    };
    private string MergeWorkspaceHelp => Snapshot.Phase switch
    {
        MergeSortPhase.Comparing or MergeSortPhase.FillingBuffer => "Two sorted child runs feed one temporary buffer. The main array does not change yet.",
        MergeSortPhase.CopyingBack => "The comparison work is finished. Follow only buffer → main array for this frame.",
        MergeSortPhase.MergeComplete => "The active range is now one sorted run and can return upward.",
        _ => "Focus only on the current merge."
    };

    private string MainArrayCaption => Snapshot.Phase switch
    {
        MergeSortPhase.Splitting or MergeSortPhase.BaseCase => "unchanged while recursion divides",
        MergeSortPhase.CopyingBack => $"copying merged range {ActiveRangeLabel}",
        MergeSortPhase.Complete => "final sorted result",
        _ => "changes only during copy-back"
    };

    private string ValueAt(int index) => index >= 0 && index < Snapshot.InitialValues.Length ? Snapshot.InitialValues[index].ToString() : "—";
    private static string RangeText(int start, int end) => start >= 0 && end >= start ? $"[{start}..{end}]" : "—";

    private IReadOnlyList<RangeNode> BuildNaturalRuns()
    {
        var runs = new List<RangeNode>();
        if (Snapshot.Elements.Length == 0) return runs;
        var start = 0;
        for (var index = 1; index < Snapshot.Elements.Length; index++)
        {
            if (Snapshot.Elements[index - 1].Value <= Snapshot.Elements[index].Value) continue;
            runs.Add(new RangeNode(start, index - 1));
            start = index;
        }
        runs.Add(new RangeNode(start, Snapshot.Elements.Length - 1));
        return runs;
    }

    private string StateClass(int index, MergeSortElementSnapshot element)
    {
        if (Snapshot.Phase == MergeSortPhase.Complete) return "is-sorted";
        if (index == Snapshot.LeftReadIndex || index == Snapshot.RightReadIndex) return "is-read";
        if (Snapshot.Phase == MergeSortPhase.CopyingBack && index >= Snapshot.ActiveStart && index <= Snapshot.ActiveEnd) return "is-writing";
        if ((Snapshot.Phase is MergeSortPhase.Splitting or MergeSortPhase.BaseCase) && index >= Snapshot.ActiveStart && index <= Snapshot.ActiveEnd) return "is-divide";
        return element.VisualState == MergeSortElementVisualState.Sorted ? "is-sorted" : string.Empty;
    }

    private string StateLabel(int index, MergeSortElementSnapshot element)
    {
        if (Snapshot.Phase == MergeSortPhase.Complete) return "SORTED";
        if (index == Snapshot.LeftReadIndex || index == Snapshot.RightReadIndex) return "READ";
        if (Snapshot.Phase == MergeSortPhase.CopyingBack && index >= Snapshot.ActiveStart && index <= Snapshot.ActiveEnd) return "COPY";
        if ((Snapshot.Phase is MergeSortPhase.Splitting or MergeSortPhase.BaseCase) && index >= Snapshot.ActiveStart && index <= Snapshot.ActiveEnd) return "ACTIVE";
        return element.VisualState == MergeSortElementVisualState.Sorted ? "SORTED" : string.Empty;
    }
}
