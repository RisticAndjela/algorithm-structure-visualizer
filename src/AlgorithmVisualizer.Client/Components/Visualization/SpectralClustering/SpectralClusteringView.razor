@using System.Globalization
@using AlgorithmVisualizer.Core.MachineLearning.GraphMl.SpectralClustering
@using Microsoft.AspNetCore.Components.Web

<div class="spectral-stage">
    <section class="graph-half">
        <div class="stage-heading">
            <div><span>ORIGINAL GRAPH</span><strong>Connectivity space</strong></div>
            <div class="graph-heading-actions">
                <small>Drag nodes · edges follow · canvas grows only when needed.</small>
                <button type="button" class="reset-layout" @onclick="ResetGraphLayout" disabled="@(!HasManualLayout)">Reset layout</button>
            </div>
        </div>

        <div class="spectral-graph-canvas">
            <svg style="@GraphStageStyle"
                 role="img"
                 aria-label="Interactive original graph for spectral clustering. Drag nodes to reposition them."
                 @onpointermove="HandlePointerMove"
                 @onpointerup="EndDrag"
                 @onpointercancel="EndDrag"
                 @onpointerleave="EndDragOnLeave">
                @for (var a = 0; a < Snapshot.NodeCount; a++)
                {
                    @for (var b = a + 1; b < Snapshot.NodeCount; b++)
                    {
                        if (HasEdge(a, b))
                        {
                            var from = RenderPosition(Position(a));
                            var to = RenderPosition(Position(b));
                            <line x1="@F(from.X)" y1="@F(from.Y)" x2="@F(to.X)" y2="@F(to.Y)" class="graph-edge" />
                        }
                    }
                }

                @for (var node = 0; node < Snapshot.NodeCount; node++)
                {
                    var position = RenderPosition(Position(node));
                    <g class="spectral-node-group @(_draggedNode == node ? "dragging" : string.Empty)"
                       transform="translate(@F(position.X) @F(position.Y))"
                       @onpointerdown="@(args => BeginDrag(node, args))"
                       @onpointerdown:preventDefault="true"
                       @onpointerdown:stopPropagation="true">
                        <foreignObject x="-32" y="-32" width="64" height="64" class="spectral-node-object">
                            <div xmlns="http://www.w3.org/1999/xhtml" class="graph-node @ClusterClass(node)" title="Drag node @Label(node)">
                                <strong>@Label(node)</strong>
                                <small>d=@F(Snapshot.Degrees.Length > node ? Snapshot.Degrees[node] : 0d)</small>
                            </div>
                        </foreignObject>
                    </g>
                }
            </svg>
        </div>
    </section>

    <section class="embedding-half">
        <div class="stage-heading">
            <div><span>SPECTRAL EMBEDDING</span><strong>@EmbeddingCaption</strong></div>
            <small>Eigenvector coordinates · all nodes fit the frame.</small>
        </div>
        <div class="embedding-frame">
            @if (Snapshot.Embedding.Length == Snapshot.NodeCount)
            {
                <svg viewBox="0 0 520 360" role="img" aria-label="Spectral embedding coordinates" preserveAspectRatio="xMidYMid meet">
                    <rect x="20" y="20" width="480" height="320" rx="16" class="embedding-bg" />
                    <line x1="40" y1="180" x2="480" y2="180" class="embedding-axis" />
                    <line x1="260" y1="40" x2="260" y2="320" class="embedding-axis" />
                    @for (var node = 0; node < Snapshot.NodeCount; node++)
                    {
                        var x = EmbedX(node);
                        var y = EmbedY(node);
                        <foreignObject x="@(x - 24)" y="@(y - 24)" width="48" height="48" class="embed-object">
                            <div xmlns="http://www.w3.org/1999/xhtml" class="embed-node @ClusterClass(node)" title="Node @Label(node) · [@EmbeddingValue(node, 0), @EmbeddingValue(node, 1)]">
                                <strong>@Label(node)</strong>
                            </div>
                        </foreignObject>
                    }
                </svg>
            }
            else
            {
                <p class="embedding-empty">Run through the eigen step to place graph nodes in spectral coordinates.</p>
            }
        </div>
    </section>
</div>

@code {
    [Parameter, EditorRequired] public SpectralClusteringSnapshot Snapshot { get; set; } = default!;

    private const double ViewportWidth = 520d;
    private const double ViewportHeight = 360d;
    private const double ContentPadding = 78d;
    private readonly Dictionary<int, Point> _manualPositions = new();
    private int? _draggedNode;
    private long _dragPointerId;
    private double _dragWorldX;
    private double _dragWorldY;
    private double _lastClientX;
    private double _lastClientY;
    private double _stageOriginX;
    private double _stageOriginY;
    private double _stageWidth = ViewportWidth;
    private double _stageHeight = ViewportHeight;

    private bool HasManualLayout => _manualPositions.Count > 0;
    private string GraphStageStyle => $"width:{F(_stageWidth)}px;min-width:100%;height:{F(_stageHeight)}px";
    private string EmbeddingCaption => Snapshot.Eigenvalues.Length >= 2 ? $"λ₀={F(Snapshot.Eigenvalues[0])} · λ₁={F(Snapshot.Eigenvalues[1])}" : "waiting for eigenvectors";

    protected override void OnParametersSet()
    {
        PruneManualPositions();
        RecalculateGraphBounds();
    }

    private bool HasEdge(int a, int b) => Snapshot.AdjacencyValues[(a * Snapshot.NodeCount) + b] > 0d;

    private Point AutoPosition(int node)
    {
        var count = Math.Max(1, Snapshot.NodeCount);
        if (count == 1) return new Point(ViewportWidth / 2d, ViewportHeight / 2d);
        var angle = (-Math.PI / 2d) + ((2d * Math.PI * node) / count);
        return new Point((ViewportWidth / 2d) + (Math.Cos(angle) * 150d), (ViewportHeight / 2d) + (Math.Sin(angle) * 112d));
    }

    private Point Position(int node) => _manualPositions.TryGetValue(node, out var manual) ? manual : AutoPosition(node);
    private Point RenderPosition(Point world) => new(world.X - _stageOriginX, world.Y - _stageOriginY);

    private void BeginDrag(int node, PointerEventArgs args)
    {
        if (args.PointerType == "mouse" && args.Button != 0) return;
        var current = Position(node);
        if (!double.IsFinite(args.ClientX) || !double.IsFinite(args.ClientY)) return;
        _draggedNode = node;
        _dragPointerId = args.PointerId;
        _dragWorldX = current.X;
        _dragWorldY = current.Y;
        _lastClientX = args.ClientX;
        _lastClientY = args.ClientY;
    }

    private void HandlePointerMove(PointerEventArgs args)
    {
        if (_draggedNode is not int node || args.PointerId != _dragPointerId) return;
        var dx = args.ClientX - _lastClientX;
        var dy = args.ClientY - _lastClientY;
        if (!double.IsFinite(dx) || !double.IsFinite(dy)) return;
        _lastClientX = args.ClientX;
        _lastClientY = args.ClientY;
        _dragWorldX += dx;
        _dragWorldY += dy;
        _manualPositions[node] = new Point(_dragWorldX, _dragWorldY);
        RecalculateGraphBounds();
    }

    private void EndDrag(PointerEventArgs args)
    {
        if (_draggedNode is null || args.PointerId != _dragPointerId) return;
        ClearDrag();
    }

    private void EndDragOnLeave(PointerEventArgs args)
    {
        if (_draggedNode is not null && args.PointerId == _dragPointerId) ClearDrag();
    }

    private void ClearDrag()
    {
        _draggedNode = null;
        _dragPointerId = 0;
    }

    private void ResetGraphLayout()
    {
        _manualPositions.Clear();
        ClearDrag();
        RecalculateGraphBounds();
    }

    private void PruneManualPositions()
    {
        if (_manualPositions.Count == 0) return;
        foreach (var node in _manualPositions.Keys.Where(node => node < 0 || node >= Snapshot.NodeCount).ToArray()) _manualPositions.Remove(node);
    }

    private void RecalculateGraphBounds()
    {
        if (Snapshot.NodeCount == 0)
        {
            _stageOriginX = 0d;
            _stageOriginY = 0d;
            _stageWidth = ViewportWidth;
            _stageHeight = ViewportHeight;
            return;
        }

        var minX = double.PositiveInfinity;
        var minY = double.PositiveInfinity;
        var maxX = double.NegativeInfinity;
        var maxY = double.NegativeInfinity;
        for (var node = 0; node < Snapshot.NodeCount; node++)
        {
            var p = Position(node);
            minX = Math.Min(minX, p.X);
            minY = Math.Min(minY, p.Y);
            maxX = Math.Max(maxX, p.X);
            maxY = Math.Max(maxY, p.Y);
        }

        _stageOriginX = Math.Min(0d, minX - ContentPadding);
        _stageOriginY = Math.Min(0d, minY - ContentPadding);
        var rightBound = Math.Max(ViewportWidth, maxX + ContentPadding);
        var bottomBound = Math.Max(ViewportHeight, maxY + ContentPadding);
        _stageWidth = Math.Max(ViewportWidth, rightBound - _stageOriginX);
        _stageHeight = Math.Max(ViewportHeight, bottomBound - _stageOriginY);
    }

    private string ClusterClass(int node) => Snapshot.Assignments.Length > node && Snapshot.Assignments[node] >= 0 ? $"cluster-{Snapshot.Assignments[node] % 3}" : "unassigned";

    private double EmbedX(int node) => Scale(EmbeddingValueRaw(node, 0), EmbedMin(0), EmbedMax(0), 52d, 468d);
    private double EmbedY(int node) => Scale(EmbeddingValueRaw(node, 1), EmbedMin(1), EmbedMax(1), 308d, 52d);
    private double EmbedMin(int axis)
    {
        var min = 0d;
        for (var node = 0; node < Snapshot.Embedding.Length; node++) min = Math.Min(min, EmbeddingValueRaw(node, axis));
        var max = EmbedRawMax(axis);
        var pad = Math.Max(.15d, (max - min) * .12d);
        return min - pad;
    }
    private double EmbedMax(int axis)
    {
        var max = EmbedRawMax(axis);
        var min = 0d;
        for (var node = 0; node < Snapshot.Embedding.Length; node++) min = Math.Min(min, EmbeddingValueRaw(node, axis));
        var pad = Math.Max(.15d, (max - min) * .12d);
        return max + pad;
    }
    private double EmbedRawMax(int axis)
    {
        var max = 0d;
        for (var node = 0; node < Snapshot.Embedding.Length; node++) max = Math.Max(max, EmbeddingValueRaw(node, axis));
        return max;
    }
    private double EmbeddingValueRaw(int node, int axis) => Snapshot.Embedding.Length > node && Snapshot.Embedding[node].Length > axis ? Snapshot.Embedding[node][axis] : 0d;
    private string EmbeddingValue(int node, int axis) => F(EmbeddingValueRaw(node, axis));

    private static double Scale(double value, double min, double max, double outMin, double outMax) => Math.Abs(max - min) < 1e-12d ? (outMin + outMax) / 2d : outMin + (((value - min) / (max - min)) * (outMax - outMin));
    private static string Label(int node) => ((char)('A' + node)).ToString();
    private static string F(double value) => Math.Abs(value) < 1e-10 ? "0" : value.ToString("0.###", CultureInfo.InvariantCulture);
    private readonly record struct Point(double X, double Y);
}
