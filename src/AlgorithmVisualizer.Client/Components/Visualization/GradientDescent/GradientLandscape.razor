@using System.Globalization
@using AlgorithmVisualizer.Core.MachineLearning.Optimization.GradientDescent

<section class="gradient-landscape" aria-label="Gradient descent parameter landscape">
    <div class="landscape-copy">
        <div class="landscape-copy-main">
            <span>PARAMETER SPACE</span>
            <strong>See the complete path, the current point and the minimum in one frame.</strong>
            <small>Every significant simulation point is fitted inside the canvas. Hover or focus any marker to inspect the exact iteration, parameters and loss.</small>
        </div>
        <div class="landscape-visibility-badge" title="The viewport is fitted from the target, current point, candidate and every committed history point.">
            <span>COMPLETE VIEW</span>
            <strong>@VisiblePointCount markers</strong>
        </div>
    </div>

    <div class="landscape-canvas ml-visual-board" tabindex="0">
        <div class="landscape-stage">
            <svg viewBox="@($"0 0 {FormatCoordinate(StageWidth)} {FormatCoordinate(StageHeight)}")"
                 role="img"
                 aria-label="Gradient descent path toward the loss minimum"
                 preserveAspectRatio="xMidYMid meet">
                <defs>
                    <marker id="gd-candidate-arrow" markerWidth="7" markerHeight="7" refX="6" refY="3.5" orient="auto" markerUnits="strokeWidth">
                        <path d="M0,0 L7,3.5 L0,7 z" class="candidate-arrow-head" />
                    </marker>
                    <clipPath id="gd-plot-clip" clipPathUnits="userSpaceOnUse">
                        <rect x="@FormatCoordinate(PlotLeft)"
                              y="@FormatCoordinate(PlotTop)"
                              width="@FormatCoordinate(PlotWidth)"
                              height="@FormatCoordinate(PlotHeight)"
                              rx="10" />
                    </clipPath>
                </defs>

                <rect class="plot-boundary" x="@FormatCoordinate(PlotLeft)" y="@FormatCoordinate(PlotTop)" width="@FormatCoordinate(PlotWidth)" height="@FormatCoordinate(PlotHeight)" rx="10" />
                <g clip-path="url(#gd-plot-clip)">
                <line class="origin-axis" x1="@FormatCoordinate(PlotLeft)" y1="@FormatCoordinate(CenterY)" x2="@FormatCoordinate(PlotRight)" y2="@FormatCoordinate(CenterY)" />
                <line class="origin-axis" x1="@FormatCoordinate(CenterX)" y1="@FormatCoordinate(PlotTop)" x2="@FormatCoordinate(CenterX)" y2="@FormatCoordinate(PlotBottom)" />

                <ellipse class="loss-contour outer" cx="@FormatCoordinate(CenterX)" cy="@FormatCoordinate(CenterY)" rx="@ContourRx(0.43d)" ry="@ContourRy(0.43d)" />
                <ellipse class="loss-contour middle" cx="@FormatCoordinate(CenterX)" cy="@FormatCoordinate(CenterY)" rx="@ContourRx(0.30d)" ry="@ContourRy(0.30d)" />
                <ellipse class="loss-contour inner" cx="@FormatCoordinate(CenterX)" cy="@FormatCoordinate(CenterY)" rx="@ContourRx(0.17d)" ry="@ContourRy(0.17d)" />

                @if (!string.IsNullOrWhiteSpace(PathPoints))
                {
                    <polyline class="trajectory-line" points="@PathPoints" />
                }

                @for (var index = 0; index < Snapshot.History.Length; index++)
                {
                    var point = Snapshot.History[index];
                    if (IsPlottable(point.Parameters))
                    {
                        var pointX = MapX(point.Parameters[0]);
                        var pointY = MapY(point.Parameters[1]);
                        <g class="trajectory-node @(index == 0 ? "start" : string.Empty)"
                           tabindex="0"
                           role="img"
                           aria-label="@HistoryPointTooltip(point)">
                            <title>@HistoryPointTooltip(point)</title>
                            <circle class="point-hit-area" cx="@FormatCoordinate(pointX)" cy="@FormatCoordinate(pointY)" r="13" />
                            <circle class="trajectory-point" cx="@FormatCoordinate(pointX)" cy="@FormatCoordinate(pointY)" r="5.2" />
                            @if (ShouldShowIterationLabel(index))
                            {
                                <foreignObject class="iteration-label-host"
                                               x="@FormatCoordinate(pointX + 7d)"
                                               y="@FormatCoordinate(pointY - 20d)"
                                               width="44"
                                               height="18">
                                    <span xmlns="http://www.w3.org/1999/xhtml" class="iteration-label">@point.Iteration</span>
                                </foreignObject>
                            }
                            <foreignObject class="svg-point-tooltip" x="@FormatCoordinate(TooltipX(pointX))" y="@FormatCoordinate(TooltipY(pointY))" width="240" height="82">
                                <div xmlns="http://www.w3.org/1999/xhtml" class="svg-tooltip-card">
                                    <span>COMMITTED · ITERATION @point.Iteration</span>
                                    <strong>θ = [@ParameterValue(point.Parameters, 0), @ParameterValue(point.Parameters, 1)]</strong>
                                    <small>loss @FormatValue(point.Loss) · η @FormatValue(point.LearningRate)</small>
                                </div>
                            </foreignObject>
                        </g>
                    }
                }

                @if (HasCandidate)
                {
                    <line class="candidate-line" x1="@FormatCoordinate(CurrentX)" y1="@FormatCoordinate(CurrentY)" x2="@FormatCoordinate(CandidateX)" y2="@FormatCoordinate(CandidateY)" marker-end="url(#gd-candidate-arrow)" />
                    <g class="candidate-node" tabindex="0" role="img" aria-label="@CandidateTooltip">
                        <title>@CandidateTooltip</title>
                        <circle class="point-hit-area" cx="@FormatCoordinate(CandidateX)" cy="@FormatCoordinate(CandidateY)" r="14" />
                        <circle class="candidate-point" cx="@FormatCoordinate(CandidateX)" cy="@FormatCoordinate(CandidateY)" r="6.2" />
                        <foreignObject class="svg-point-tooltip" x="@FormatCoordinate(TooltipX(CandidateX))" y="@FormatCoordinate(TooltipY(CandidateY))" width="240" height="82">
                            <div xmlns="http://www.w3.org/1999/xhtml" class="svg-tooltip-card candidate-tip">
                                <span>CANDIDATE · θ′</span>
                                <strong>θ′ = [@ParameterValue(Snapshot.NextParameters, 0), @ParameterValue(Snapshot.NextParameters, 1)]</strong>
                                <small>candidate loss @FormatValue(CandidateLoss)</small>
                            </div>
                        </foreignObject>
                    </g>
                }

                <g class="minimum-node" tabindex="0" role="img" aria-label="@MinimumTooltip">
                    <title>@MinimumTooltip</title>
                    <circle class="minimum-crosshair" cx="@FormatCoordinate(CenterX)" cy="@FormatCoordinate(CenterY)" r="17" />
                    <circle class="point-hit-area" cx="@FormatCoordinate(CenterX)" cy="@FormatCoordinate(CenterY)" r="17" />
                    <circle class="minimum-halo" cx="@FormatCoordinate(CenterX)" cy="@FormatCoordinate(CenterY)" r="11.5" />
                    <circle class="minimum-point" cx="@FormatCoordinate(CenterX)" cy="@FormatCoordinate(CenterY)" r="4.8" />
                    <foreignObject class="svg-point-tooltip" x="@FormatCoordinate(TooltipX(CenterX))" y="@FormatCoordinate(TooltipY(CenterY))" width="240" height="82">
                        <div xmlns="http://www.w3.org/1999/xhtml" class="svg-tooltip-card minimum-tip">
                            <span>MINIMUM · TARGET θ*</span>
                            <strong>θ* = [@ParameterValue(Snapshot.Target, 0), @ParameterValue(Snapshot.Target, 1)]</strong>
                            <small>loss = 0 for this teaching objective</small>
                        </div>
                    </foreignObject>
                </g>

                <g class="current-node" tabindex="0" role="img" aria-label="@CurrentTooltip">
                    <title>@CurrentTooltip</title>
                    <circle class="point-hit-area" cx="@FormatCoordinate(CurrentX)" cy="@FormatCoordinate(CurrentY)" r="15" />
                    <circle class="current-halo" cx="@FormatCoordinate(CurrentX)" cy="@FormatCoordinate(CurrentY)" r="8.5" />
                    <circle class="current-point" cx="@FormatCoordinate(CurrentX)" cy="@FormatCoordinate(CurrentY)" r="4" />
                    <foreignObject class="svg-point-tooltip" x="@FormatCoordinate(TooltipX(CurrentX))" y="@FormatCoordinate(TooltipY(CurrentY))" width="240" height="82">
                        <div xmlns="http://www.w3.org/1999/xhtml" class="svg-tooltip-card current-tip">
                            <span>CURRENT · ITERATION @Snapshot.Iteration</span>
                            <strong>θ = [@ParameterValue(Snapshot.Parameters, 0), @ParameterValue(Snapshot.Parameters, 1)]</strong>
                            <small>loss @FormatValue(Snapshot.Loss) · ∥∇J∥ @FormatValue(Snapshot.GradientNorm)</small>
                        </div>
                    </foreignObject>
                </g>
                </g>
            </svg>

            <div class="landscape-label minimum-label" style="left:@CssX(LabelX(CenterX));top:@CssY(LabelYAbove(CenterY));">minimum θ*</div>
            <div class="landscape-label current-label" style="left:@CssX(LabelX(CurrentX));top:@CssY(LabelYBelow(CurrentY));">current θ</div>
            @if (Snapshot.History.Length > 0 && IsPlottable(Snapshot.History[0].Parameters))
            {
                var startX = MapX(Snapshot.History[0].Parameters[0]);
                var startY = MapY(Snapshot.History[0].Parameters[1]);
                <div class="landscape-label start-label" style="left:@CssX(LabelX(startX));top:@CssY(LabelYBelow(startY));">start</div>
            }
        </div>
    </div>

    <div class="gradient-legend" aria-label="Gradient Descent visual legend">
        <span><i class="path"></i>Committed path</span>
        <span><i class="current"></i>Current θ</span>
        <span><i class="candidate"></i>Candidate θ′</span>
        <span><i class="minimum"></i>Minimum / target</span>
        <small>Every marker supports hover and keyboard focus.</small>
    </div>
</section>

@code {
    [Parameter, EditorRequired] public GradientDescentSnapshot Snapshot { get; set; } = default!;

    private const double StageWidth = 1000d;
    private const double StageHeight = 500d;
    private const double HorizontalPadding = 76d;
    private const double VerticalPadding = 62d;
    private const double MarkerSafeInsetX = 34d;
    private const double MarkerSafeInsetY = 28d;

    private double PlotLeft => HorizontalPadding;
    private double PlotRight => StageWidth - HorizontalPadding;
    private double PlotTop => VerticalPadding;
    private double PlotBottom => StageHeight - VerticalPadding;
    private double PlotWidth => PlotRight - PlotLeft;
    private double PlotHeight => PlotBottom - PlotTop;
    private double DataLeft => PlotLeft + MarkerSafeInsetX;
    private double DataRight => PlotRight - MarkerSafeInsetX;
    private double DataTop => PlotTop + MarkerSafeInsetY;
    private double DataBottom => PlotBottom - MarkerSafeInsetY;
    private double DataWidth => DataRight - DataLeft;
    private double DataHeight => DataBottom - DataTop;

    private double XHalfSpan => AxisHalfSpan(0);
    private double YHalfSpan => AxisHalfSpan(1);
    private double XMin => TargetValue(0) - XHalfSpan;
    private double XMax => TargetValue(0) + XHalfSpan;
    private double YMin => TargetValue(1) - YHalfSpan;
    private double YMax => TargetValue(1) + YHalfSpan;

    private double CenterX => MapX(TargetValue(0));
    private double CenterY => MapY(TargetValue(1));
    private double CurrentX => IsFiniteAt(Snapshot.Parameters, 0) ? MapX(Snapshot.Parameters[0]) : CenterX;
    private double CurrentY => IsFiniteAt(Snapshot.Parameters, 1) ? MapY(Snapshot.Parameters[1]) : CenterY;
    private double CandidateX => IsFiniteAt(Snapshot.NextParameters, 0) ? MapX(Snapshot.NextParameters[0]) : CurrentX;
    private double CandidateY => IsFiniteAt(Snapshot.NextParameters, 1) ? MapY(Snapshot.NextParameters[1]) : CurrentY;
    private bool HasCandidate => Snapshot.Phase == GradientDescentPhase.UpdatingParameters && IsPlottable(Snapshot.NextParameters);
    private int VisiblePointCount => Snapshot.History.Count(point => IsPlottable(point.Parameters)) + 2 + (HasCandidate ? 1 : 0);
    private double CandidateLoss => EvaluateLoss(Snapshot.NextParameters);

    private string PathPoints
    {
        get
        {
            var points = new List<string>(Snapshot.History.Length);
            for (var index = 0; index < Snapshot.History.Length; index++)
            {
                var point = Snapshot.History[index];
                if (!IsPlottable(point.Parameters)) continue;
                points.Add($"{CoordinateX(point.Parameters[0])},{CoordinateY(point.Parameters[1])}");
            }
            return string.Join(' ', points);
        }
    }

    private string ContourRx(double proportion)
    {
        var curvature = CurvatureValue(0);
        var anisotropy = 1d / Math.Sqrt(curvature);
        var normalized = Math.Clamp(anisotropy, 0.55d, 1.8d);
        return FormatCoordinate(Math.Min(DataWidth * proportion * normalized, DataWidth * 0.47d));
    }

    private string ContourRy(double proportion)
    {
        var curvature = CurvatureValue(1);
        var anisotropy = 1d / Math.Sqrt(curvature);
        var normalized = Math.Clamp(anisotropy, 0.55d, 1.8d);
        return FormatCoordinate(Math.Min(DataHeight * proportion * normalized, DataHeight * 0.47d));
    }

    private double TargetValue(int axis) => IsFiniteAt(Snapshot.Target, axis) ? Snapshot.Target[axis] : 0d;

    private double CurvatureValue(int axis) => IsFiniteAt(Snapshot.Curvature, axis)
        ? Math.Max(0.05d, Snapshot.Curvature[axis])
        : 1d;

    private double AxisHalfSpan(int axis)
    {
        var target = TargetValue(axis);
        var furthestDistance = 0d;

        void Include(IReadOnlyList<double> values)
        {
            if (!IsFiniteAt(values, axis)) return;
            furthestDistance = Math.Max(furthestDistance, Math.Abs(values[axis] - target));
        }

        Include(Snapshot.Parameters);
        Include(Snapshot.NextParameters);
        for (var index = 0; index < Snapshot.History.Length; index++) Include(Snapshot.History[index].Parameters);

        // Keep the target/minimum in the centre and reserve 32% breathing room beyond the
        // furthest real simulation point. This prevents markers, labels and hover cards from
        // being visually pinned to the plot boundary while still fitting the entire run.
        var minimumLandscapeRoom = 2.2d / Math.Sqrt(CurvatureValue(axis));
        var contentRoom = furthestDistance <= 1e-9d ? 1d : (furthestDistance * 1.32d) + 0.24d;
        return Math.Max(minimumLandscapeRoom, contentRoom);
    }

    private double MapX(double value)
    {
        var ratio = (value - XMin) / Math.Max(1e-9d, XMax - XMin);
        return DataLeft + (Math.Clamp(ratio, 0d, 1d) * DataWidth);
    }

    private double MapY(double value)
    {
        var ratio = (value - YMin) / Math.Max(1e-9d, YMax - YMin);
        return DataBottom - (Math.Clamp(ratio, 0d, 1d) * DataHeight);
    }

    private bool ShouldShowIterationLabel(int index)
    {
        if (Snapshot.History.Length <= 9) return true;
        if (index == 0 || index == Snapshot.History.Length - 1) return true;
        var stride = Math.Max(2, Snapshot.History.Length / 6);
        return index % stride == 0;
    }

    private double TooltipX(double pointX)
    {
        var preferred = pointX + 16d;
        if (preferred + 240d > PlotRight) preferred = pointX - 256d;
        return Math.Clamp(preferred, PlotLeft + 4d, PlotRight - 244d);
    }

    private double TooltipY(double pointY)
    {
        var preferred = pointY - 94d;
        if (preferred < PlotTop) preferred = pointY + 16d;
        return Math.Clamp(preferred, PlotTop + 4d, PlotBottom - 86d);
    }

    private double EvaluateLoss(IReadOnlyList<double> parameters)
    {
        var length = Math.Min(parameters.Count, Math.Min(Snapshot.Target.Length, Snapshot.Curvature.Length));
        if (length == 0) return Snapshot.Loss;
        var loss = 0d;
        for (var index = 0; index < length; index++)
        {
            if (!double.IsFinite(parameters[index]) || !double.IsFinite(Snapshot.Target[index]) || !double.IsFinite(Snapshot.Curvature[index])) return double.PositiveInfinity;
            var difference = parameters[index] - Snapshot.Target[index];
            loss += 0.5d * Snapshot.Curvature[index] * difference * difference;
        }
        return loss;
    }

    private string CoordinateX(double value) => FormatCoordinate(MapX(value));
    private string CoordinateY(double value) => FormatCoordinate(MapY(value));
    private double LabelX(double value) => Math.Clamp(value, PlotLeft + 8d, PlotRight - 96d);
    private double LabelYAbove(double value) => Math.Clamp(value - 30d, PlotTop + 8d, PlotBottom - 36d);
    private double LabelYBelow(double value) => Math.Clamp(value + 20d, PlotTop + 24d, PlotBottom - 18d);
    private string CssX(double value) => Percent((value / StageWidth) * 100d);
    private string CssY(double value) => Percent((value / StageHeight) * 100d);

    private string HistoryPointTooltip(GradientDescentHistoryPoint point) => $"Committed iteration {point.Iteration}: θ = [{ParameterValue(point.Parameters, 0)}, {ParameterValue(point.Parameters, 1)}], loss = {FormatValue(point.Loss)}, η = {FormatValue(point.LearningRate)}";
    private string CurrentTooltip => $"Current θ = [{ParameterValue(Snapshot.Parameters, 0)}, {ParameterValue(Snapshot.Parameters, 1)}], loss = {FormatValue(Snapshot.Loss)}";
    private string CandidateTooltip => $"Candidate θ′ = [{ParameterValue(Snapshot.NextParameters, 0)}, {ParameterValue(Snapshot.NextParameters, 1)}], candidate loss = {FormatValue(CandidateLoss)}";
    private string MinimumTooltip => $"Loss minimum / target θ* = [{ParameterValue(Snapshot.Target, 0)}, {ParameterValue(Snapshot.Target, 1)}]";

    private static bool IsFiniteAt(IReadOnlyList<double> values, int index) => values.Count > index && double.IsFinite(values[index]);
    private static bool IsPlottable(IReadOnlyList<double> values) => IsFiniteAt(values, 0) && IsFiniteAt(values, 1);
    private static string ParameterValue(IReadOnlyList<double> values, int index) => IsFiniteAt(values, index) ? FormatValue(values[index]) : "—";
    private static string FormatValue(double value) => double.IsFinite(value) ? value.ToString("0.####", CultureInfo.InvariantCulture) : "∞";
    private static string FormatCoordinate(double value) => value.ToString("0.###", CultureInfo.InvariantCulture);
    private static string Percent(double value) => $"{FormatCoordinate(value)}%";
}
