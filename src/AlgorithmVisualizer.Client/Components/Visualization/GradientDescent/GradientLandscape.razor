@using System.Globalization
@using System.Text
@using AlgorithmVisualizer.Core.MachineLearning.Optimization.GradientDescent

<section class="gradient-landscape" aria-label="Gradient descent parameter landscape">
    <div class="gradient-summary-strip">
        <div><span>UPDATE</span><strong>@Snapshot.Iteration</strong><small>@PhaseLabel</small></div>
        <div><span>LOSS J(θ)</span><strong>@FormatValue(Snapshot.Loss)</strong><small>lower is better</small></div>
        <div><span>GRADIENT NORM</span><strong>@FormatValue(Snapshot.GradientNorm)</strong><small>||∇J||₂</small></div>
        <div><span>EFFECTIVE η</span><strong>@FormatValue(Snapshot.EffectiveLearningRate)</strong><small>step multiplier</small></div>
    </div>

    <div class="landscape-copy">
        <div><span>PARAMETER SPACE</span><strong>Contours show equal-loss regions.</strong></div>
        <small>The path connects committed parameter vectors. The green point marks the minimum; purple marks the current θ.</small>
    </div>

    <div class="landscape-canvas ml-visual-board" tabindex="0">
        <div class="landscape-stage">
        <svg viewBox="0 0 120 70" role="img" aria-label="Gradient descent path toward the loss minimum" preserveAspectRatio="xMidYMid meet">
            <ellipse class="loss-contour outer" cx="@CenterX" cy="@CenterY" rx="@ContourRx(34)" ry="@ContourRy(20)" />
            <ellipse class="loss-contour middle" cx="@CenterX" cy="@CenterY" rx="@ContourRx(24)" ry="@ContourRy(14)" />
            <ellipse class="loss-contour inner" cx="@CenterX" cy="@CenterY" rx="@ContourRx(13)" ry="@ContourRy(8)" />
            @if (!string.IsNullOrWhiteSpace(PathPoints))
            {
                <polyline class="trajectory-line" points="@PathPoints" />
            }
            @foreach (var point in Snapshot.History)
            {
                if (point.Parameters.Length >= 2)
                {
                    <circle class="trajectory-point" cx="@CoordinateX(point.Parameters[0])" cy="@CoordinateY(point.Parameters[1])" r="1.45" />
                }
            }
            @if (HasCandidate)
            {
                <line class="candidate-line" x1="@CurrentX" y1="@CurrentY" x2="@CandidateX" y2="@CandidateY" />
                <circle class="candidate-point" cx="@CandidateX" cy="@CandidateY" r="2" />
            }
            <circle class="minimum-point" cx="@CenterX" cy="@CenterY" r="2.3" />
            <circle class="current-point" cx="@CurrentX" cy="@CurrentY" r="2.7" />
        </svg>
        <div class="landscape-label minimum-label" style="left:@CssX(LabelX(CenterX));top:@CssY(LabelY(CenterY));">minimum</div>
        <div class="landscape-label current-label" style="left:@CssX(LabelX(CurrentX));top:@CssY(LabelY(CurrentY));">θ</div>
        </div>
    </div>

    <div class="gradient-legend" aria-label="Gradient Descent visual legend">
        <span><i class="path"></i>Committed path</span>
        <span><i class="current"></i>Current θ</span>
        <span><i class="candidate"></i>Candidate θ′</span>
        <span><i class="minimum"></i>Minimum</span>
    </div>
</section>

@code {
    [Parameter, EditorRequired] public GradientDescentSnapshot Snapshot { get; set; } = default!;

    private const double PlotWidth = 120d;
    private const double PlotHeight = 70d;
    private const double PlotLeft = 7d;
    private const double PlotRight = 113d;
    private const double PlotTop = 6d;
    private const double PlotBottom = 64d;

    private double CenterX => Snapshot.Target.Length > 0 ? MapX(Snapshot.Target[0]) : 50d;
    private double CenterY => Snapshot.Target.Length > 1 ? MapY(Snapshot.Target[1]) : 50d;
    private double CurrentX => Snapshot.Parameters.Length > 0 ? MapX(Snapshot.Parameters[0]) : 50d;
    private double CurrentY => Snapshot.Parameters.Length > 1 ? MapY(Snapshot.Parameters[1]) : 50d;
    private double CandidateX => Snapshot.NextParameters.Length > 0 ? MapX(Snapshot.NextParameters[0]) : CurrentX;
    private double CandidateY => Snapshot.NextParameters.Length > 1 ? MapY(Snapshot.NextParameters[1]) : CurrentY;
    private double XMin => AxisBound(0, true);
    private double XMax => AxisBound(0, false);
    private double YMin => AxisBound(1, true);
    private double YMax => AxisBound(1, false);
    private bool HasCandidate => Snapshot.Phase == GradientDescentPhase.UpdatingParameters;
    private string PhaseLabel => Snapshot.Phase switch
    {
        GradientDescentPhase.ComputingGradient => "computing gradient",
        GradientDescentPhase.ScalingGradient => "scaling gradient",
        GradientDescentPhase.UpdatingParameters => "updating parameters",
        GradientDescentPhase.EvaluatingLoss => "evaluating loss",
        GradientDescentPhase.Complete => "completed",
        GradientDescentPhase.Diverged => "diverged",
        _ => "ready"
    };

    private string PathPoints
    {
        get
        {
            var builder = new StringBuilder();
            for (var index = 0; index < Snapshot.History.Length; index++)
            {
                var point = Snapshot.History[index];
                if (point.Parameters.Length < 2) continue;
                if (builder.Length > 0) builder.Append(' ');
                builder.Append(CoordinateX(point.Parameters[0]));
                builder.Append(',');
                builder.Append(CoordinateY(point.Parameters[1]));
            }
            return builder.ToString();
        }
    }

    private string ContourRx(double basis)
    {
        var curvature = Snapshot.Curvature.Length > 0 ? Snapshot.Curvature[0] : 1d;
        var requested = Math.Clamp(basis / Math.Sqrt(Math.Max(0.05d, curvature)), 5d, 34d);
        var available = Math.Max(4d, Math.Min(CenterX - PlotLeft, PlotRight - CenterX));
        return FormatCoordinate(Math.Min(requested, available));
    }

    private string ContourRy(double basis)
    {
        var curvature = Snapshot.Curvature.Length > 1 ? Snapshot.Curvature[1] : 1d;
        var requested = Math.Clamp(basis / Math.Sqrt(Math.Max(0.05d, curvature)), 5d, 34d);
        var available = Math.Max(3d, Math.Min(CenterY - PlotTop, PlotBottom - CenterY));
        return FormatCoordinate(Math.Min(requested, available));
    }

    private double AxisBound(int axis, bool minimum)
    {
        var min = double.PositiveInfinity;
        var max = double.NegativeInfinity;

        void Include(IReadOnlyList<double> values)
        {
            if (values.Count <= axis || !double.IsFinite(values[axis])) return;
            min = Math.Min(min, values[axis]);
            max = Math.Max(max, values[axis]);
        }

        Include(Snapshot.Target);
        Include(Snapshot.Parameters);
        Include(Snapshot.NextParameters);
        for (var index = 0; index < Snapshot.History.Length; index++) Include(Snapshot.History[index].Parameters);

        if (!double.IsFinite(min) || !double.IsFinite(max)) return minimum ? -1d : 1d;
        var range = Math.Max(1d, max - min);
        var padding = Math.Max(.75d, range * .16d);
        return minimum ? min - padding : max + padding;
    }

    private double MapX(double value)
    {
        var mapped = PlotLeft + (((value - XMin) / Math.Max(1e-9d, XMax - XMin)) * (PlotRight - PlotLeft));
        return Math.Clamp(mapped, PlotLeft, PlotRight);
    }

    private double MapY(double value)
    {
        var mapped = PlotBottom - (((value - YMin) / Math.Max(1e-9d, YMax - YMin)) * (PlotBottom - PlotTop));
        return Math.Clamp(mapped, PlotTop, PlotBottom);
    }

    private string CoordinateX(double value) => FormatCoordinate(MapX(value));
    private string CoordinateY(double value) => FormatCoordinate(MapY(value));
    private static double LabelX(double value) => Math.Clamp(value, PlotLeft + 1d, PlotRight - 8d);
    private static double LabelY(double value) => Math.Clamp(value, PlotTop + 2d, PlotBottom - 2d);
    private static string CssX(double value) => Percent((value / PlotWidth) * 100d);
    private static string CssY(double value) => Percent((value / PlotHeight) * 100d);
    private static string FormatCoordinate(double value) => value.ToString("0.###", CultureInfo.InvariantCulture);
    private static string FormatValue(double value) => Math.Abs(value) < 1e-12 ? "0" : value.ToString("0.####", CultureInfo.InvariantCulture);
    private static string Percent(double value) => $"{FormatCoordinate(value)}%";
}
