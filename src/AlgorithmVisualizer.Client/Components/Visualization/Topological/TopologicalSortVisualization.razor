@using AlgorithmVisualizer.Core.Algorithms.GraphOrdering.Topological
@using AlgorithmVisualizer.Core.DataStructures.Graph
@using AlgorithmVisualizer.Client.Components.Visualization.Graphs

<section class="topological-visual" aria-label="Topological Sort visual state">
    <GraphVisualization Snapshot="@VisualGraph" ShowDefaultLegend="false" />

    <div class="order-strip" aria-label="Current topological order">
        <span>TOPOLOGICAL OUTPUT</span>
        <div class="order-slots">
            @if (Snapshot.OutputIndices.Length == 0)
            {
                <span class="empty-order">No final output yet</span>
            }
            else
            {
                @for (var index = 0; index < Snapshot.OutputIndices.Length; index++)
                {
                    <span class="order-slot"><small>@index</small><strong>@Label(Snapshot.OutputIndices[index])</strong></span>
                }
            }
        </div>
    </div>

    @if (Snapshot.CycleDetected)
    {
        <div class="cycle-banner"><strong>Cycle detected</strong><span>A directed cycle means no valid topological ordering exists.</span></div>
    }

</section>

@code {
    [Parameter, EditorRequired]
    public TopologicalSortSnapshot Snapshot { get; set; } = new(
        new(true, false, 0, 0, [], [], []), [], [], [], [], -1, -1, null,
        0, 0, 0, 0, 0, false, TopologicalSortPhase.Ready, TopologicalSortVariant.KahnQueue);


    private GraphSnapshot VisualGraph
    {
        get
        {
            var vertices = new GraphVertexSnapshot[Snapshot.Graph.Vertices.Length];
            for (var index = 0; index < vertices.Length; index++)
            {
                var original = Snapshot.Graph.Vertices[index];
                var topo = Snapshot.Vertices.Length > index ? Snapshot.Vertices[index] : null;
                var state = topo?.State switch
                {
                    TopologicalVertexState.Current => GraphVertexVisualState.Source,
                    TopologicalVertexState.InspectingNeighbor => GraphVertexVisualState.Target,
                    TopologicalVertexState.Cycle => GraphVertexVisualState.Removing,
                    TopologicalVertexState.Ready => GraphVertexVisualState.Neighbor,
                    TopologicalVertexState.Visiting => GraphVertexVisualState.Neighbor,
                    TopologicalVertexState.Ordered => GraphVertexVisualState.Matched,
                    TopologicalVertexState.Finished => GraphVertexVisualState.Matched,
                    _ => GraphVertexVisualState.Normal
                };
                vertices[index] = original with { VisualState = state };
            }

            var edges = new GraphEdgeSnapshot[Snapshot.Graph.Edges.Length];
            for (var index = 0; index < edges.Length; index++)
            {
                var original = Snapshot.Graph.Edges[index];
                edges[index] = original with
                {
                    VisualState = Snapshot.CurrentEdgeId == original.Id
                        ? Snapshot.CycleDetected ? GraphEdgeVisualState.Removing : GraphEdgeVisualState.Checking
                        : GraphEdgeVisualState.Normal
                };
            }

            return Snapshot.Graph with { Vertices = vertices, Edges = edges };
        }
    }

    private string Label(int index) => index >= 0 && index < Snapshot.Graph.Vertices.Length ? Snapshot.Graph.Vertices[index].Label : "?";

}
