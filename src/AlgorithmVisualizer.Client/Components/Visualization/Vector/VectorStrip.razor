@using AlgorithmVisualizer.Core.DataStructures.Vector

<section class="vector-strip @(Result ? "result" : string.Empty)">
    <header><span>@Name</span><strong>dimension @Values.Length</strong></header>
    <div class="vector-components">
        @for (var index = 0; index < Values.Length; index++)
        {
            var state = index < States.Length ? States[index] : VectorComponentVisualState.Normal;
            <div class="vector-component @state.ToString().ToLowerInvariant()"><small>[@index]</small><strong>@Format(Values[index])</strong></div>
        }
    </div>
</section>

@code {
    [Parameter, EditorRequired] public string Name { get; set; } = string.Empty;
    [Parameter, EditorRequired] public double[] Values { get; set; } = [];
    [Parameter, EditorRequired] public VectorComponentVisualState[] States { get; set; } = [];
    [Parameter] public bool Result { get; set; }

    private static string Format(double value) => Math.Abs(value) < 1e-12
        ? "0"
        : value.ToString("0.###", System.Globalization.CultureInfo.InvariantCulture);
}
