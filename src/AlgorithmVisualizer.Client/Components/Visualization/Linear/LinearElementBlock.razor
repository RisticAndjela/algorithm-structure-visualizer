<div class="linear-element @GetVisualStateClass()" aria-label="Value @Element.Value">
    <span class="element-value">@Element.Value</span>
    <span class="state-ring" aria-hidden="true"></span>
</div>

@code {
    [Parameter, EditorRequired]
    public LinearElement Element { get; set; } = default!;

    private string GetVisualStateClass() => Element.VisualState switch
    {
        LinearElementVisualState.Adding => "is-adding",
        LinearElementVisualState.Removing => "is-removing",
        LinearElementVisualState.PointerTarget => "is-pointer-target",
        _ => string.Empty
    };
}
