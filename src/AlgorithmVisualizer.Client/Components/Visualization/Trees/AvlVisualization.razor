@using AlgorithmVisualizer.Core.DataStructures.Trees.Avl

<section class="avl-visualization" aria-label="AVL tree visual state">
    <header class="visual-header">
        <div>
            <span class="visual-kicker">VISUAL STATE</span>
            <h3>AVL Tree</h3>
        </div>
        <div class="tree-metrics">
            <span>Nodes <strong>@Count</strong></span>
            <span>Height <strong>@Height</strong></span>
            <span>Root <strong>@(Root is null ? "—" : Root.Value)</strong></span>
        </div>
    </header>

    <div class="visual-note">
        <strong>Screen position explains ordering and balance, not RAM position.</strong>
        <span>Every node shows its cached height <b>h</b> and balance factor <b>BF = left height − right height</b>. Valid AVL balance is −1, 0, or +1.</span>
    </div>

    @if (Root is null)
    {
        <div class="tree-empty">
            <span class="empty-tree-icon" aria-hidden="true">A</span>
            <strong>The AVL tree is empty.</strong>
            <small>Insert a value to create the root node.</small>
        </div>
    }
    else
    {
        <div class="tree-scroll">
            <svg class="tree-canvas"
                 width="@CanvasWidth"
                 height="@CanvasHeight"
                 viewBox="0 0 @CanvasWidth @CanvasHeight"
                 role="img"
                 aria-label="AVL tree with @Count nodes">
                @foreach (var edge in Edges)
                {
                    <g class="tree-edge">
                        <line x1="@edge.ParentX" y1="@edge.ParentY" x2="@edge.ChildX" y2="@edge.ChildY" />
                        <foreignObject x="@(edge.LabelX - 12)" y="@(edge.LabelY - 9)" width="24" height="18">
                            <div class="edge-label">@edge.Label</div>
                        </foreignObject>
                    </g>
                }

                @foreach (var node in Nodes)
                {
                    <g class="tree-node @GetStateClass(node.Node.VisualState)">
                        <foreignObject x="@(node.X - 56)" y="@(node.Y - 42)" width="112" height="84">
                            <div class="node-card">
                                @if (node.Depth == 0)
                                {
                                    <span class="root-label">ROOT</span>
                                }
                                <strong class="node-value">@node.Node.Value</strong>
                                <span class="node-metrics">h @node.Node.Height <b>·</b> BF @FormatBalance(node.Node.BalanceFactor)</span>
                                <span class="node-id">#@node.Node.DisplayId</span>
                                @if (node.Node.VisualState != AvlNodeVisualState.Normal)
                                {
                                    <span class="node-state">@GetStateLabel(node.Node.VisualState)</span>
                                }
                            </div>
                        </foreignObject>
                    </g>
                }
            </svg>
        </div>
    }

    <footer class="state-legend" aria-label="AVL node state legend">
        <span><i class="legend-swatch normal"></i>Normal</span>
        <span><i class="legend-swatch checking"></i>Checking</span>
        <span><i class="legend-swatch visited"></i>Visited</span>
        <span><i class="legend-swatch matched"></i>Match</span>
        <span><i class="legend-swatch adding"></i>New node</span>
        <span><i class="legend-swatch pointer"></i>Insert parent</span>
        <span><i class="legend-swatch unbalanced"></i>Unbalanced</span>
        <span><i class="legend-swatch pivot"></i>Rotation pivot</span>
        <span><i class="legend-swatch rotating"></i>Rotating</span>
        <span><i class="legend-swatch balanced"></i>Balanced</span>
        <span><i class="legend-swatch removing"></i>Removing</span>
        <span><i class="legend-swatch replacement"></i>Replacement</span>
    </footer>
</section>

@code {
    [Parameter]
    public AvlNodeSnapshot? Root { get; set; }

    [Parameter]
    public int Count { get; set; }

    [Parameter]
    public int Height { get; set; }

    private readonly List<NodeLayout> _nodes = [];
    private readonly List<EdgeLayout> _edges = [];

    private IReadOnlyList<NodeLayout> Nodes => _nodes;
    private IReadOnlyList<EdgeLayout> Edges => _edges;
    private int CanvasWidth { get; set; } = 780;
    private int CanvasHeight { get; set; } = 320;

    protected override void OnParametersSet() => BuildLayout();

    private void BuildLayout()
    {
        _nodes.Clear();
        _edges.Clear();

        if (Root is null)
        {
            CanvasWidth = 780;
            CanvasHeight = 320;
            return;
        }

        var cursor = 0;
        AddNodesInOrder(Root, depth: 0, ref cursor);

        CanvasWidth = Math.Max(780, 148 + Math.Max(1, _nodes.Count - 1) * 130);
        CanvasHeight = Math.Max(320, 150 + Math.Max(0, Height - 1) * 128);

        foreach (var parent in _nodes)
        {
            AddEdge(parent, parent.Node.Left, "L");
            AddEdge(parent, parent.Node.Right, "R");
        }
    }

    private void AddNodesInOrder(AvlNodeSnapshot? node, int depth, ref int cursor)
    {
        if (node is null)
        {
            return;
        }

        AddNodesInOrder(node.Left, depth + 1, ref cursor);
        var x = 82 + cursor * 130;
        var y = 78 + depth * 128;
        _nodes.Add(new NodeLayout(node, x, y, depth));
        cursor++;
        AddNodesInOrder(node.Right, depth + 1, ref cursor);
    }

    private void AddEdge(NodeLayout parent, AvlNodeSnapshot? child, string label)
    {
        if (child is null)
        {
            return;
        }

        NodeLayout? childLayout = null;
        foreach (var candidate in _nodes)
        {
            if (candidate.Node.Id == child.Id)
            {
                childLayout = candidate;
                break;
            }
        }

        if (childLayout is null)
        {
            return;
        }

        var parentY = parent.Y + 42;
        var childY = childLayout.Y - 42;
        _edges.Add(new EdgeLayout(
            parent.X,
            parentY,
            childLayout.X,
            childY,
            (parent.X + childLayout.X) / 2,
            (parentY + childY) / 2,
            label));
    }

    private static string FormatBalance(int balance) => balance > 0 ? $"+{balance}" : balance.ToString();

    private static string GetStateLabel(AvlNodeVisualState state) => state switch
    {
        AvlNodeVisualState.Checking => "CHECKING",
        AvlNodeVisualState.Visited => "VISITED",
        AvlNodeVisualState.Matched => "MATCH",
        AvlNodeVisualState.Adding => "NEW",
        AvlNodeVisualState.Removing => "REMOVING",
        AvlNodeVisualState.Replacement => "REPLACEMENT",
        AvlNodeVisualState.PointerTarget => "INSERT PARENT",
        AvlNodeVisualState.Unbalanced => "UNBALANCED",
        AvlNodeVisualState.RotationPivot => "PIVOT",
        AvlNodeVisualState.Rotating => "ROTATING",
        AvlNodeVisualState.Balanced => "BALANCED",
        _ => string.Empty
    };

    private static string GetStateClass(AvlNodeVisualState state) => state switch
    {
        AvlNodeVisualState.Checking => "is-checking",
        AvlNodeVisualState.Visited => "is-visited",
        AvlNodeVisualState.Matched => "is-matched",
        AvlNodeVisualState.Adding => "is-adding",
        AvlNodeVisualState.Removing => "is-removing",
        AvlNodeVisualState.Replacement => "is-replacement",
        AvlNodeVisualState.PointerTarget => "is-pointer",
        AvlNodeVisualState.Unbalanced => "is-unbalanced",
        AvlNodeVisualState.RotationPivot => "is-pivot",
        AvlNodeVisualState.Rotating => "is-rotating",
        AvlNodeVisualState.Balanced => "is-balanced",
        _ => "is-normal"
    };

    private sealed record NodeLayout(AvlNodeSnapshot Node, int X, int Y, int Depth);
    private sealed record EdgeLayout(int ParentX, int ParentY, int ChildX, int ChildY, int LabelX, int LabelY, string Label);
}
