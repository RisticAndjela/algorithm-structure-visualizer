<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
  </PropertyGroup>

  <!--
    KNN, KD-Tree, K-Means, Decision Tree, PCA, and the deep-learning modules were introduced as nested source folders. Keep these compile items
    explicit so IDE/MSBuild project evaluation cannot leave the new namespace out
    when this repository is updated through incremental patch ZIPs. Remove first
    because SDK projects already include **/*.cs by default; re-include once here.
  -->
  <ItemGroup>
    <!-- Computational Graph was intentionally removed from the curriculum. Keep this exclusion so an incremental patch copied over an older checkout cannot compile stale source files. -->
    <Compile Remove="MachineLearning/DeepLearning/ComputationalGraph/**/*.cs" />
    <Compile Remove="MachineLearning/Supervised/Knn/KnnModels.cs" />
    <Compile Remove="MachineLearning/Supervised/Knn/KnnSimulation.cs" />
    <Compile Include="MachineLearning/Supervised/Knn/KnnModels.cs" />
    <Compile Include="MachineLearning/Supervised/Knn/KnnSimulation.cs" />
    <Compile Remove="MachineLearning/Supervised/KdTree/KdTreeModels.cs" />
    <Compile Remove="MachineLearning/Supervised/KdTree/KdTreeSimulation.cs" />
    <Compile Include="MachineLearning/Supervised/KdTree/KdTreeModels.cs" />
    <Compile Include="MachineLearning/Supervised/KdTree/KdTreeSimulation.cs" />
    <Compile Remove="MachineLearning/Unsupervised/KMeans/KMeansModels.cs" />
    <Compile Remove="MachineLearning/Unsupervised/KMeans/KMeansSimulation.cs" />
    <Compile Include="MachineLearning/Unsupervised/KMeans/KMeansModels.cs" />
    <Compile Include="MachineLearning/Unsupervised/KMeans/KMeansSimulation.cs" />
    <Compile Remove="MachineLearning/Supervised/DecisionTree/DecisionTreeModels.cs" />
    <Compile Remove="MachineLearning/Supervised/DecisionTree/DecisionTreeSimulation.cs" />
    <Compile Include="MachineLearning/Supervised/DecisionTree/DecisionTreeModels.cs" />
    <Compile Include="MachineLearning/Supervised/DecisionTree/DecisionTreeSimulation.cs" />
    <Compile Remove="MachineLearning/Unsupervised/Pca/PcaModels.cs" />
    <Compile Remove="MachineLearning/Unsupervised/Pca/PcaSimulation.cs" />
    <Compile Include="MachineLearning/Unsupervised/Pca/PcaModels.cs" />
    <Compile Include="MachineLearning/Unsupervised/Pca/PcaSimulation.cs" />
    <Compile Remove="MachineLearning/DeepLearning/Common/ActivationMath.cs" />
    <Compile Include="MachineLearning/DeepLearning/Common/ActivationMath.cs" />
    <Compile Remove="MachineLearning/DeepLearning/Neuron/NeuronModels.cs" />
    <Compile Remove="MachineLearning/DeepLearning/Neuron/NeuronSimulation.cs" />
    <Compile Include="MachineLearning/DeepLearning/Neuron/NeuronModels.cs" />
    <Compile Include="MachineLearning/DeepLearning/Neuron/NeuronSimulation.cs" />
    <Compile Remove="MachineLearning/DeepLearning/Mlp/MlpModels.cs" />
    <Compile Remove="MachineLearning/DeepLearning/Mlp/MlpSimulation.cs" />
    <Compile Include="MachineLearning/DeepLearning/Mlp/MlpModels.cs" />
    <Compile Include="MachineLearning/DeepLearning/Mlp/MlpSimulation.cs" />
    <Compile Remove="MachineLearning/DeepLearning/Backpropagation/BackpropagationModels.cs" />
    <Compile Remove="MachineLearning/DeepLearning/Backpropagation/BackpropagationSimulation.cs" />
    <Compile Include="MachineLearning/DeepLearning/Backpropagation/BackpropagationModels.cs" />
    <Compile Include="MachineLearning/DeepLearning/Backpropagation/BackpropagationSimulation.cs" />
    <Compile Remove="MachineLearning/DeepLearning/Optimizers/OptimizerModels.cs" />
    <Compile Remove="MachineLearning/DeepLearning/Optimizers/OptimizerSimulation.cs" />
    <Compile Include="MachineLearning/DeepLearning/Optimizers/OptimizerModels.cs" />
    <Compile Include="MachineLearning/DeepLearning/Optimizers/OptimizerSimulation.cs" />
  </ItemGroup>
</Project>
